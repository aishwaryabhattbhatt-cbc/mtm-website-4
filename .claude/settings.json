{
    "permissions": {
        "allow": [
            "Bash(*)",
            "Zsh(*)",
            "Bash(npm *)",
            "Bash(npx *)",
            "Bash(node *)",
            "Bash(git *)",
            "Bash(ls *)",
            "Bash(find *)",
            "Bash(grep *)",
            "Bash(cat *)",
            "Read",
            "Edit",
            "Write"
        ]
    },
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Write|Edit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "jq -r '.tool_input.file_path // empty' | { read -r f; case \"$f\" in *.astro|*.css|*.ts) npx prettier --write \"$f\" ;; esac; } 2>/dev/null || true",
                        "statusMessage": "Formatting..."
                    }
                ]
            }
        ]
    }
}
