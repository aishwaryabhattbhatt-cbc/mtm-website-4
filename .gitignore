# build output — ignored except the generated Markdown page twins, which are
# tracked so changes to what LLM agents read show up in review. Git will not
# descend into an excluded directory, so dist/ cannot be listed on its own here:
# the ** form plus the directory re-include is what makes the negation reachable.
dist/**
!dist/**/
!dist/**/*.md.txt

# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# agent/AI tooling — not needed to build or deploy the site
.agents/
.claude/
.planning/
.playwright-mcp/
docs/superpowers/
CLAUDE.md
SKILLS.md
REVIEW.md
skills-lock.json
