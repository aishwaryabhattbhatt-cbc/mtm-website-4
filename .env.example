# Google Sheets CMS
# Main product sheet ID from URL https://docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEET_ID=

# Optional direct published CSV URLs by page.
# Use this when Google Sheets is published and you want to plug in exact tab/page feeds directly.
# Products & Home: https://docs.google.com/spreadsheets/d/e/2PACX-1vTtJO_WQ583iizQJkxxd7JsA4lvGBfLM5HuqU2uXYEvdyUPWyo3O8JHJgU-9rxB3g/pub?output=csv
# Solutions: https://docs.google.com/spreadsheets/d/e/2PACX-1vQsmnkAj6Ua-ePN8jhlMR7P5DWJMoaeUQax6js_mWYv_-30Sll92GvDW0xKkK-DQA/pub?output=csv
GOOGLE_SHEET_CSV_URL_MAP_JSON={"home":""}

# JSON map: pageId -> tab gid
# Example: {"home":"0","media":"1361843616","advertising":"769668628"}
GOOGLE_SHEET_TAB_MAP_JSON={"home":"0"}

# Runtime refresh interval for near-live updates (milliseconds)
PUBLIC_CMS_REFRESH_MS=30000

# Form handler endpoint on the production server. Receives all four public
# lead forms (demo, newsletter, report download, contact) and forwards them to
# Mailchimp. Leave empty until the backend handler exists — the forms then
# behave exactly as they do today.
PUBLIC_FORM_ENDPOINT=
