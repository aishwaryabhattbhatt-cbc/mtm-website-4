---
import Layout from '../layouts/Layout.astro';
import { DEFAULT_LOCALE } from '../lib/i18n/routing';
const base = import.meta.env.BASE_URL;
const destination = `${base}${DEFAULT_LOCALE}/`;
---

<Layout
    title="Redirecting to MTM"
    description="Redirecting to the MTM homepage."
    locale="en"
    noindex={true}
>
    <Fragment slot="head">
        <meta http-equiv="refresh" content={`0;url=${destination}`} />
        <script is:inline define:vars={{ destination }}>
            window.location.replace(destination);
        </script>
    </Fragment>

    <main class="redirect-main" aria-hidden="true"></main>
</Layout>

<style>
    .redirect-main {
        display: none;
    }
</style>
