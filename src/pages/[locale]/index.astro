---
import Layout from '../../layouts/Layout.astro';
import { toAbsoluteUrl } from '../../lib/i18n/routing';
import Navbar from '../../components/shared/Navbar.astro';
import HomeHeroSection from '../../components/home/HomeHeroSection.astro';
import HomeIntroductionSection from '../../components/home/HomeIntroductionSection.astro';
import HomeMtmSuiteSection from '../../components/home/HomeMtmSuiteSection.astro';
import HomeSolutions from '../../components/home/HomeSolutions.astro';
import HomeFaqsSection from '../../components/home/HomeFaqsSection.astro';
import HomeFooterSection from '../../components/home/HomeFooterSection.astro';
import HomeAskMtmButton from '../../components/home/HomeAskMtmButton.astro';
import { getPageDictionary, getRuntimeCMSConfig } from '../../lib/cms/getPageContent';
import { resolveLocale, SUPPORTED_LOCALES, getLocaleSwitchUrls } from '../../lib/i18n/routing';
import { t } from '../../lib/i18n/t';
import { homeFaqs } from '../../lib/content/homeFaqs';

export function getStaticPaths() {
    return SUPPORTED_LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = resolveLocale(Astro.params.locale);
const pageId = 'home';
const copy = await getPageDictionary(pageId);
const cmsConfig = getRuntimeCMSConfig(pageId);
const base = import.meta.env.BASE_URL;
const resolvedCmsCsvUrl =
    cmsConfig.csvUrl ??
    (cmsConfig.sheetId && cmsConfig.gid
        ? `https://docs.google.com/spreadsheets/d/${cmsConfig.sheetId}/export?format=csv&gid=${cmsConfig.gid}`
        : '');

const localeSwitchUrls = getLocaleSwitchUrls(base);

const pageTitle = t(
    copy,
    'home_page_title',
    locale,
    'MTM Home | Canadian Media & Technology Consumption Data'
);
const pageDescription = t(
    copy,
    'home_page_description',
    locale,
    'Data and insights on how Canadians use technology, content, and media.'
);

const siteRoot = toAbsoluteUrl(Astro.site, base);
const organizationId = `${siteRoot}#organization`;
const websiteId = `${siteRoot}#website`;
const logoUrl = toAbsoluteUrl(Astro.site, `${base}images/mtm-logo.svg`);
const linkedInUrl = 'https://www.linkedin.com/company/media-technology-monitor/';

const organizationJsonLd = {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: 'MTM',
    url: toAbsoluteUrl(Astro.site, localeSwitchUrls[locale]),
    logo: logoUrl,
    description: pageDescription,
    sameAs: [linkedInUrl],
};

const websiteJsonLd = {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': websiteId,
    name: 'MTM',
    url: siteRoot,
    inLanguage: ['en-CA', 'fr-CA'],
    publisher: { '@id': organizationId },
};

const faqPageJsonLd = {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: homeFaqs.map((faq) => ({
        '@type': 'Question',
        name: t(copy, faq.questionKey, locale, faq.questionFallback),
        acceptedAnswer: {
            '@type': 'Answer',
            text: t(copy, faq.answerKey, locale, faq.answerFallback),
        },
    })),
};
---

<Layout
    title={pageTitle}
    description={pageDescription}
    locale={locale}
    alternates={localeSwitchUrls}
>
    <main
        data-locale={locale}
        data-cms-page-id={pageId}
        data-cms-csv-url={resolvedCmsCsvUrl}
        data-cms-sheet-id={cmsConfig.sheetId ?? ''}
        data-cms-tab-gid={cmsConfig.gid ?? ''}
        data-cms-refresh-ms={String(cmsConfig.refreshMs)}
    >
        <Navbar locale={locale} copy={copy} localeSwitchUrls={localeSwitchUrls} />

        <HomeHeroSection locale={locale} copy={copy} />

        <div class="section-gap section-gap-sm" aria-hidden="true"></div>

        <HomeIntroductionSection locale={locale} copy={copy} />

        <HomeMtmSuiteSection locale={locale} copy={copy} />

        <HomeSolutions locale={locale} copy={copy} />

        <HomeFaqsSection locale={locale} copy={copy} />

        <HomeFooterSection locale={locale} copy={copy} />

        <HomeAskMtmButton locale={locale} copy={copy} />
    </main>

    <Fragment slot="head">
        <script
            is:inline
            type="application/ld+json"
            set:html={JSON.stringify(organizationJsonLd)}
        />
        <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
        <script is:inline type="application/ld+json" set:html={JSON.stringify(faqPageJsonLd)} />
    </Fragment>

    <Fragment slot="scripts">
        {
            /* Dev only: parses the sheet CSV for the live-reload in
        runtime/script.js. getRuntimeCMSConfig withholds the sheet details in
        production, so that refresh no-ops there and this was 45KB fetched from
        a CDN for nothing on every page load. */
        }
        {
            import.meta.env.DEV && (
                <script
                    is:inline
                    src="https://cdn.jsdelivr.net/npm/papaparse@5.4.1/papaparse.min.js"
                />
            )
        }
        <script is:inline src={`${base}js/runtime/script.js`}></script>

        <script is:inline type="importmap">
            {
                "imports": {
                    "three": "https://cdn.jsdelivr.net/npm/three@0.128.0/build/three.module.js"
                }
            }
        </script>

        <script is:inline type="module" src={`${base}js/backgrounds/home-hero-background.js`}
        ></script>
        <script is:inline type="module" src={`${base}js/backgrounds/research-hero-background.js`}
        ></script>
    </Fragment>
</Layout>
