---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/shared/Navbar.astro';
import RegisterHeroSection from '../../components/register/RegisterHeroSection.astro';
import HomeFooterSection from '../../components/home/HomeFooterSection.astro';
import LiquidGradientBackgroundScripts from '../../components/shared/LiquidGradientBackgroundScripts.astro';
import { getPageDictionary } from '../../lib/cms/getPageContent';
import { getLocaleSwitchUrls } from '../../lib/i18n/routing';
import { t } from '../../lib/i18n/t';
import type { Locale } from '../../lib/cms/types';

export function getStaticPaths() {
    return [{ params: { locale: 'en' } }, { params: { locale: 'fr' } }];
}

const locale = (Astro.params.locale === 'fr' ? 'fr' : 'en') as Locale;
const copy = await getPageDictionary('register');
const base = import.meta.env.BASE_URL;
const localeSwitchUrls = getLocaleSwitchUrls(base, 'register');

const pageTitle = t(copy, 'register_page_title', locale, 'MTM | Register');
const pageDescription = t(
    copy,
    'register_page_description',
    locale,
    "To gain access through your employer's subscription please fill out the following registration form."
);
---

<Layout
    title={pageTitle}
    description={pageDescription}
    locale={locale}
    alternates={localeSwitchUrls}
    noindex={true}
>
    <main class="register-page">
        <Navbar locale={locale} copy={copy} localeSwitchUrls={localeSwitchUrls} />

        <RegisterHeroSection locale={locale} copy={copy} />

        <HomeFooterSection
            locale={locale}
            copy={copy}
            showCta={false}
            showNewsletter={false}
            showBgLeftCenter={false}
        />
    </main>

    <Fragment slot="scripts">
        <LiquidGradientBackgroundScripts />
    </Fragment>
</Layout>

<style>
    .register-page {
        width: 100%;
    }
</style>
