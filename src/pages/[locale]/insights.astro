---
import Layout from '../../layouts/Layout.astro';
import { toAbsoluteUrl } from '../../lib/i18n/routing';
import { buildBreadcrumbList } from '../../lib/content/breadcrumbs';
import Navbar from '../../components/shared/Navbar.astro';
import InsightsHeroSection from '../../components/insights/InsightsHeroSection.astro';
import InsightsFeaturedReportCard from '../../components/insights/InsightsFeaturedReportCard.astro';
import InsightsReportsLibrarySection from '../../components/insights/InsightsReportsLibrarySection.astro';
import InsightsFreeReportsSection from '../../components/insights/InsightsFreeReportsSection.astro';
import InsightsSneakPeekReportsSection from '../../components/insights/InsightsSneakPeekReportsSection.astro';
import InsightsNewsSection from '../../components/insights/InsightsNewsSection.astro';
import HomeFooterSection from '../../components/home/HomeFooterSection.astro';
import { getPageDictionary, getRuntimeCMSConfig } from '../../lib/cms/getPageContent';
import { t } from '../../lib/i18n/t';
import type { Locale } from '../../lib/cms/types';

export function getStaticPaths() {
    return [{ params: { locale: 'en' } }, { params: { locale: 'fr' } }];
}

const locale = (Astro.params.locale === 'fr' ? 'fr' : 'en') as Locale;
const pageId = 'insights';
const copy = await getPageDictionary(pageId);
const cmsConfig = getRuntimeCMSConfig(pageId);
const base = import.meta.env.BASE_URL;
const resolvedCmsCsvUrl =
    cmsConfig.csvUrl ??
    (cmsConfig.sheetId && cmsConfig.gid
        ? `https://docs.google.com/spreadsheets/d/${cmsConfig.sheetId}/export?format=csv&gid=${cmsConfig.gid}`
        : '');

const localeSwitchUrls: Record<Locale, string> = {
    en: `${base}en/insights/`,
    fr: `${base}fr/insights/`,
};

const pageTitle = t(
    copy,
    'insights_page_title',
    locale,
    'MTM Insights | Reports on Canadian Media Trends'
);
const pageDescription = t(
    copy,
    'insights_page_description',
    locale,
    'Insights and analysis on Canadian media and technology trends.'
);
---

<Layout
    title={pageTitle}
    description={pageDescription}
    locale={locale}
    alternates={localeSwitchUrls}
>
    <main
        data-locale={locale}
        data-cms-page-id={pageId}
        data-cms-csv-url={resolvedCmsCsvUrl}
        data-cms-sheet-id={cmsConfig.sheetId ?? ''}
        data-cms-tab-gid={cmsConfig.gid ?? ''}
        data-cms-refresh-ms={String(cmsConfig.refreshMs)}
    >
        <Navbar locale={locale} copy={copy} localeSwitchUrls={localeSwitchUrls} />

        <InsightsHeroSection
            locale={locale}
            copy={copy}
            ctaHref={`${base}${locale}/request-demo/`}
            bgPatternSrc={`${base}images/tools/analytic-tools/analytic-tools-hero-bg.png`}
        />

        <div class="insights-card-bleed" id="insights-card-bleed">
            <div class="insights-card-bleed__inner">
                <InsightsFeaturedReportCard
                    locale={locale}
                    copy={copy}
                    ctaHref={`${base}${locale}/reports/`}
                    imageSrc={`${base}images/insights/latest-report.png`}
                />
            </div>
        </div>

        <InsightsReportsLibrarySection locale={locale} copy={copy} />

        <InsightsFreeReportsSection locale={locale} copy={copy} />

        <InsightsSneakPeekReportsSection locale={locale} copy={copy} />

        <InsightsNewsSection locale={locale} copy={copy} />

        <HomeFooterSection locale={locale} copy={copy} />
    </main>

    <Fragment slot="head">
        <script
            is:inline
            type="application/ld+json"
            set:html={JSON.stringify({
                '@context': 'https://schema.org',
                '@type': 'WebPage',
                name: pageTitle,
                url: toAbsoluteUrl(Astro.site, localeSwitchUrls[locale]),
            })}
        />
        <script
            is:inline
            type="application/ld+json"
            set:html={JSON.stringify(
                buildBreadcrumbList(
                    toAbsoluteUrl(Astro.site, base),
                    'Insights',
                    toAbsoluteUrl(Astro.site, localeSwitchUrls[locale])
                )
            )}
        />
    </Fragment>

    <Fragment slot="scripts">
        <script is:inline src="https://cdn.jsdelivr.net/npm/papaparse@5.4.1/papaparse.min.js"
        ></script>
        <script is:inline src={`${base}js/runtime/script.js`}></script>
        <script is:inline>
            function updateHeroBleed() {
                const hero = document.getElementById('insights-hero');
                const bleed = document.getElementById('insights-card-bleed');
                const card = bleed && bleed.querySelector('.featured-report-card');
                if (!hero || !bleed || !card) return;
                // Overlap by 15% of card height on mobile, 50% on desktop
                const isMobile = window.innerWidth < 768;
                const overlapPercent = isMobile ? 0.15 : 0.5;
                const overlap = card.offsetHeight * overlapPercent;
                hero.style.setProperty('--hero-bleed-pad', overlap + 'px');
                bleed.style.marginTop = '-' + overlap + 'px';
            }
            updateHeroBleed();
            window.addEventListener('resize', updateHeroBleed);
        </script>
    </Fragment>
</Layout>

<style>
    .insights-card-bleed {
        position: relative;
        z-index: 1;
        padding: 0 var(--content-margin-inline);
    }

    .insights-card-bleed__inner {
        width: 100%;
    }
</style>
