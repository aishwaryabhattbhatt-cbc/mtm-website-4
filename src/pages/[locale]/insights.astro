---
import Layout from '../../layouts/Layout.astro';
import { toAbsoluteUrl } from '../../lib/i18n/routing';
import { buildBreadcrumbList } from '../../lib/content/breadcrumbs';
import Navbar from '../../components/shared/Navbar.astro';
import InsightsHeroSection from '../../components/insights/InsightsHeroSection.astro';
import RuntimeReportTemplate from '../../components/insights/RuntimeReportTemplate.astro';
import InsightsRuntime from '../../components/insights/InsightsRuntime.astro';
import InsightsReportsLibrarySection from '../../components/insights/InsightsReportsLibrarySection.astro';
import InsightsFreeReportsSection from '../../components/insights/InsightsFreeReportsSection.astro';
import InsightsSneakPeekReportsSection from '../../components/insights/InsightsSneakPeekReportsSection.astro';
import InsightsNewsSection from '../../components/insights/InsightsNewsSection.astro';
import HomeFooterSection from '../../components/home/HomeFooterSection.astro';
import { getPageDictionary, getRuntimeCMSConfig } from '../../lib/cms/getPageContent';
import { t } from '../../lib/i18n/t';
import type { Locale } from '../../lib/cms/types';

export function getStaticPaths() {
    return [{ params: { locale: 'en' } }, { params: { locale: 'fr' } }];
}

const locale = (Astro.params.locale === 'fr' ? 'fr' : 'en') as Locale;
const pageId = 'insights';
const copy = await getPageDictionary(pageId);
const cmsConfig = getRuntimeCMSConfig(pageId);
const base = import.meta.env.BASE_URL;
const resolvedCmsCsvUrl =
    cmsConfig.csvUrl ??
    (cmsConfig.sheetId && cmsConfig.gid
        ? `https://docs.google.com/spreadsheets/d/${cmsConfig.sheetId}/export?format=csv&gid=${cmsConfig.gid}`
        : '');

const localeSwitchUrls: Record<Locale, string> = {
    en: `${base}en/insights/`,
    fr: `${base}fr/insights/`,
};

const pageTitle = t(
    copy,
    'insights_page_title',
    locale,
    'MTM Insights | Reports on Canadian Media Trends'
);
const pageDescription = t(
    copy,
    'insights_page_description',
    locale,
    'Insights and analysis on Canadian media and technology trends.'
);
---

<Layout
    title={pageTitle}
    description={pageDescription}
    locale={locale}
    alternates={localeSwitchUrls}
>
    <main
        data-locale={locale}
        data-cms-page-id={pageId}
        data-cms-csv-url={resolvedCmsCsvUrl}
        data-cms-sheet-id={cmsConfig.sheetId ?? ''}
        data-cms-tab-gid={cmsConfig.gid ?? ''}
        data-cms-refresh-ms={String(cmsConfig.refreshMs)}
    >
        <Navbar locale={locale} copy={copy} localeSwitchUrls={localeSwitchUrls} />

        <InsightsHeroSection
            locale={locale}
            copy={copy}
            ctaHref={`${base}${locale}/request-demo/`}
            bgPatternSrc={`${base}images/tools/analytic-tools/analytic-tools-hero-bg.png`}
        />

        <div class="insights-card-bleed" id="insights-card-bleed" data-insights-kind="featured">
            <InsightsRuntime locale={locale} />
            <div class="insights-card-bleed__inner" data-insights-list></div>
            <RuntimeReportTemplate locale={locale} copy={copy} kind="featured" />
        </div>

        <InsightsReportsLibrarySection locale={locale} copy={copy} />

        <InsightsFreeReportsSection locale={locale} copy={copy} />

        <InsightsSneakPeekReportsSection locale={locale} copy={copy} />

        <InsightsNewsSection locale={locale} copy={copy} />

        <HomeFooterSection locale={locale} copy={copy} />
    </main>

    <Fragment slot="head">
        <script
            is:inline
            type="application/ld+json"
            set:html={JSON.stringify({
                '@context': 'https://schema.org',
                '@type': 'WebPage',
                name: pageTitle,
                url: toAbsoluteUrl(Astro.site, localeSwitchUrls[locale]),
            })}
        />
        <script
            is:inline
            type="application/ld+json"
            set:html={JSON.stringify(
                buildBreadcrumbList(
                    toAbsoluteUrl(Astro.site, base),
                    'Insights',
                    toAbsoluteUrl(Astro.site, localeSwitchUrls[locale])
                )
            )}
        />
    </Fragment>

    <Fragment slot="scripts">
        {
            /* Dev only: parses the sheet CSV for the live-reload in
        runtime/script.js. getRuntimeCMSConfig withholds the sheet details in
        production, so that refresh no-ops there and this was 45KB fetched from
        a CDN for nothing on every page load. */
        }
        {
            import.meta.env.DEV && (
                <script
                    is:inline
                    src="https://cdn.jsdelivr.net/npm/papaparse@5.4.1/papaparse.min.js"
                />
            )
        }
        <script is:inline src={`${base}js/runtime/script.js`}></script>
        <script is:inline>
            const hero = document.getElementById('insights-hero');
            const bleed = document.getElementById('insights-card-bleed');
            let updateFrame = 0;
            let observedCard = null;

            const cardObserver = new ResizeObserver(() => updateHeroBleed());

            function updateHeroBleed() {
                cancelAnimationFrame(updateFrame);
                updateFrame = requestAnimationFrame(() => {
                    const card = bleed && bleed.querySelector('.featured-report-card');

                    if (!hero || !bleed || !card) {
                        cardObserver.disconnect();
                        observedCard = null;
                        bleed?.removeAttribute('data-positioned');
                        // Before the API answers there is no state yet, and the
                        // CSS reservation is holding the card's space so the
                        // hero doesn't render short and jump. Only collapse it
                        // once the runtime confirms there is no featured report
                        // to show — otherwise leave the reservation standing.
                        const state = bleed?.dataset.insightsState;
                        if (state === 'empty' || state === 'error') {
                            hero?.style.setProperty('--hero-bleed-pad', 'var(--section-pad-block)');
                            bleed?.style.setProperty('margin-top', '0px');
                        }
                        return;
                    }

                    if (card !== observedCard) {
                        cardObserver.disconnect();
                        cardObserver.observe(card);
                        observedCard = card;
                    }

                    // Overlap by 15% of card height on mobile, 50% on desktop.
                    const overlapPercent = window.innerWidth < 768 ? 0.15 : 0.5;
                    const overlap = card.offsetHeight * overlapPercent;
                    hero.style.setProperty('--hero-bleed-pad', `${overlap}px`);
                    bleed.style.marginTop = `-${overlap}px`;
                    bleed.dataset.positioned = 'true';
                });
            }

            bleed?.addEventListener('insights:rendered', updateHeroBleed);
            updateHeroBleed();
            window.addEventListener('resize', updateHeroBleed);
        </script>
    </Fragment>
</Layout>

<style>
    /* The featured card is fetched after first paint, so nothing can measure it
       server-side. These hold its footprint up front — without them the blue
       hero band renders ~170px short and jumps once the card lands, a layout
       shift on the largest above-the-fold element. updateHeroBleed() replaces
       both values with exact measurements as soon as the real card exists, so
       these only ever need to be close, not perfect. Heights are measured from
       the rendered card at each breakpoint; it stacks below 1024px, which is
       why the reserve grows there rather than shrinking. */
    main {
        --featured-card-reserve: 31rem;
        --featured-card-overlap: calc(var(--featured-card-reserve) * 0.5);
        /* consumed by .insights-hero's padding-bottom fallback */
        --hero-bleed-reserve: var(--featured-card-overlap);
    }

    .insights-card-bleed {
        position: relative;
        z-index: 1;
        padding: 0 var(--content-margin-inline);
        margin-top: calc(-1 * var(--featured-card-overlap));
    }

    .insights-card-bleed__inner {
        width: 100%;
        opacity: 0;
        min-height: var(--featured-card-reserve);
    }

    .insights-card-bleed[data-positioned='true'] .insights-card-bleed__inner {
        opacity: 1;
        /* real card is in and measured — stop reserving */
        min-height: 0;
    }

    @media (max-width: 1023px) {
        main {
            --featured-card-reserve: 52rem;
        }
    }

    /* Below 768px updateHeroBleed() switches the overlap to 15%. */
    @media (max-width: 767px) {
        main {
            --featured-card-reserve: 40rem;
            --featured-card-overlap: calc(var(--featured-card-reserve) * 0.15);
        }
    }
</style>
