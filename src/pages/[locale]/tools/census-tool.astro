---
import Layout from '../../../layouts/Layout.astro';
import { toAbsoluteUrl } from '../../../lib/i18n/routing';
import { buildBreadcrumbList } from '../../../lib/content/breadcrumbs';
import Navbar from '../../../components/shared/Navbar.astro';
import ToolsHeroSection from '../../../components/tools/ToolsHeroSection.astro';
import CensusHighlightsSection from '../../../components/census/CensusHighlightsSection.astro';
import CensusFeaturesTitleSection from '../../../components/census/CensusFeaturesTitleSection.astro';
import CensusPushDownNavSection from '../../../components/census/CensusPushDownNavSection.astro';
import CensusToolFeaturesSection from '../../../components/census/CensusToolFeaturesSection.astro';
import HomeFooterSection from '../../../components/home/HomeFooterSection.astro';
import { getPageDictionary, getRuntimeCMSConfig } from '../../../lib/cms/getPageContent';
import { t } from '../../../lib/i18n/t';
import type { Locale } from '../../../lib/cms/types';

export function getStaticPaths() {
    return [{ params: { locale: 'en' } }, { params: { locale: 'fr' } }];
}

const locale = (Astro.params.locale === 'fr' ? 'fr' : 'en') as Locale;
const pageId = 'census-tool';
const copy = await getPageDictionary(pageId);
const cmsConfig = getRuntimeCMSConfig(pageId);
const homeCmsConfig = getRuntimeCMSConfig('home');
const base = import.meta.env.BASE_URL;
const resolvedCmsCsvUrl =
    cmsConfig.csvUrl ??
    (cmsConfig.sheetId && cmsConfig.gid
        ? `https://docs.google.com/spreadsheets/d/${cmsConfig.sheetId}/export?format=csv&gid=${cmsConfig.gid}`
        : '');
const resolvedHomeCsvUrl =
    homeCmsConfig.csvUrl ??
    (homeCmsConfig.sheetId && homeCmsConfig.gid
        ? `https://docs.google.com/spreadsheets/d/${homeCmsConfig.sheetId}/export?format=csv&gid=${homeCmsConfig.gid}`
        : '');

const localeSwitchUrls = {
    en: `${base}en/tools/census-tool/`,
    fr: `${base}fr/tools/census-tool/`,
};

const pageTitle = t(
    copy,
    'census_tool_page_title',
    locale,
    'MTM | Census Tool for Canadian Demographic Data'
);
const pageDescription = t(
    copy,
    'census_tool_page_description',
    locale,
    'Explore the MTM Census Tool for detailed demographic data.'
);
---

<Layout
    title={pageTitle}
    description={pageDescription}
    locale={locale}
    alternates={localeSwitchUrls}
>
    <main
        data-locale={locale}
        data-cms-page-id={pageId}
        data-cms-csv-url={resolvedCmsCsvUrl}
        data-cms-sheet-id={cmsConfig.sheetId ?? ''}
        data-cms-tab-gid={cmsConfig.gid ?? ''}
        data-cms-refresh-ms={String(cmsConfig.refreshMs)}
        data-cms-secondary-csv-url={resolvedHomeCsvUrl}
    >
        <Navbar locale={locale} copy={copy} localeSwitchUrls={localeSwitchUrls} />

        <ToolsHeroSection
            locale={locale}
            copy={copy}
            ctaHref={`${base}${locale}/request-demo/`}
            heroImageSrc={`${base}images/tools/census-tool/Census-tool.webp`}
            bgPatternSrc={`${base}images/tools/census-tool/census-tool-hero-bg.webp`}
            secondaryCtaHref={`${base}${locale}/census-tool/demo/`}
            secondaryCtaLabel="Watch Video"
        />

        <CensusHighlightsSection locale={locale} copy={copy} />

        <div class="section-gap section-gap-lg" aria-hidden="true"></div>
        <CensusFeaturesTitleSection locale={locale} copy={copy} />

        <div class="section-gap section-gap-sm" aria-hidden="true"></div>
        <CensusPushDownNavSection locale={locale} copy={copy} />

        <div class="section-gap section-gap-lg" aria-hidden="true"></div>
        <CensusToolFeaturesSection locale={locale} copy={copy} />

        <HomeFooterSection locale={locale} copy={copy} />
    </main>

    <Fragment slot="head">
        <script
            is:inline
            type="application/ld+json"
            set:html={JSON.stringify({
                '@context': 'https://schema.org',
                '@type': 'WebPage',
                name: pageTitle,
                url: toAbsoluteUrl(Astro.site, localeSwitchUrls[locale]),
            })}
        />
        <script
            is:inline
            type="application/ld+json"
            set:html={JSON.stringify(
                buildBreadcrumbList(
                    toAbsoluteUrl(Astro.site, base),
                    'Census Tool',
                    toAbsoluteUrl(Astro.site, localeSwitchUrls[locale])
                )
            )}
        />
    </Fragment>

    <Fragment slot="scripts">
        {
            /* Dev only: parses the sheet CSV for the live-reload in
        runtime/script.js. getRuntimeCMSConfig withholds the sheet details in
        production, so that refresh no-ops there and this was 45KB fetched from
        a CDN for nothing on every page load. */
        }
        {
            import.meta.env.DEV && (
                <script
                    is:inline
                    src="https://cdn.jsdelivr.net/npm/papaparse@5.4.1/papaparse.min.js"
                />
            )
        }
        <script is:inline src={`${base}js/runtime/script.js`}></script>
    </Fragment>
</Layout>
