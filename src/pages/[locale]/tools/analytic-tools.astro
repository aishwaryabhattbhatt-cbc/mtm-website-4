---
import Layout from '../../../layouts/Layout.astro';
import { toAbsoluteUrl } from '../../../lib/i18n/routing';
import { buildBreadcrumbList } from '../../../lib/content/breadcrumbs';
import Navbar from '../../../components/shared/Navbar.astro';
import ToolsHeroSection from '../../../components/tools/ToolsHeroSection.astro';
import ToolsPushDownNavSection from '../../../components/tools/ToolsPushDownNavSection.astro';
import ToolsDataAnalysisSection from '../../../components/tools/ToolsDataAnalysisSection.astro';
import ToolsDatFeaturesSection from '../../../components/tools/ToolsDatFeaturesSection.astro';
import AnalyticToolsTrendingToolSection from '../../../components/analytic-tools/AnalyticToolsTrendingToolSection.astro';
import AnalyticToolsForecastingToolSection from '../../../components/analytic-tools/AnalyticToolsForecastingToolSection.astro';
import AnalyticToolsYourDataSectionV2 from '../../../components/analytic-tools/AnalyticToolsYourDataSectionV2.astro';
import HomeFooterSection from '../../../components/home/HomeFooterSection.astro';
import { getPageDictionary, getRuntimeCMSConfig } from '../../../lib/cms/getPageContent';
import { t } from '../../../lib/i18n/t';
import type { Locale } from '../../../lib/cms/types';

export function getStaticPaths() {
    return [{ params: { locale: 'en' } }, { params: { locale: 'fr' } }];
}

const locale = (Astro.params.locale === 'fr' ? 'fr' : 'en') as Locale;
const pageId = 'analytic-tools';
const copy = await getPageDictionary(pageId);
const cmsConfig = getRuntimeCMSConfig(pageId);
const base = import.meta.env.BASE_URL;
const resolvedCmsCsvUrl =
    cmsConfig.csvUrl ??
    (cmsConfig.sheetId && cmsConfig.gid
        ? `https://docs.google.com/spreadsheets/d/${cmsConfig.sheetId}/export?format=csv&gid=${cmsConfig.gid}`
        : '');

const localeSwitchUrls = {
    en: `${base}en/tools/analytic-tools/`,
    fr: `${base}fr/tools/analytic-tools/`,
};

const pageTitle = t(
    copy,
    'analytic_tools_page_title',
    locale,
    'MTM | Analytic Tools for Canadian Media Data'
);
const pageDescription = t(
    copy,
    'analytic_tools_page_description',
    locale,
    'Explore MTM analytic tools for in-depth media insights.'
);
---

<Layout
    title={pageTitle}
    description={pageDescription}
    locale={locale}
    alternates={localeSwitchUrls}
>
    <main
        data-locale={locale}
        data-cms-page-id={pageId}
        data-cms-csv-url={resolvedCmsCsvUrl}
        data-cms-sheet-id={cmsConfig.sheetId ?? ''}
        data-cms-tab-gid={cmsConfig.gid ?? ''}
        data-cms-refresh-ms={String(cmsConfig.refreshMs)}
    >
        <Navbar locale={locale} copy={copy} localeSwitchUrls={localeSwitchUrls} />

        <ToolsHeroSection
            locale={locale}
            copy={copy}
            ctaHref={`${base}${locale}/request-demo/`}
            heroImageSrc={`${base}images/tools/tool-analytic-hero.webp`}
            bgPatternSrc={`${base}images/tools/analytic-tools-hero-bg.png`}
        />

        <ToolsPushDownNavSection locale={locale} copy={copy} />

        <ToolsDataAnalysisSection locale={locale} copy={copy} />

        <ToolsDatFeaturesSection locale={locale} copy={copy} />

        <AnalyticToolsTrendingToolSection locale={locale} copy={copy} />

        <AnalyticToolsForecastingToolSection locale={locale} copy={copy} />

        <AnalyticToolsYourDataSectionV2 locale={locale} copy={copy} />

        <HomeFooterSection locale={locale} copy={copy} />
    </main>

    <Fragment slot="head">
        <script
            is:inline
            type="application/ld+json"
            set:html={JSON.stringify({
                '@context': 'https://schema.org',
                '@type': 'WebPage',
                name: pageTitle,
                url: toAbsoluteUrl(Astro.site, localeSwitchUrls[locale]),
            })}
        />
        <script
            is:inline
            type="application/ld+json"
            set:html={JSON.stringify(
                buildBreadcrumbList(
                    toAbsoluteUrl(Astro.site, base),
                    'Analytic Tools',
                    toAbsoluteUrl(Astro.site, localeSwitchUrls[locale])
                )
            )}
        />
    </Fragment>

    <Fragment slot="scripts">
        <script is:inline src="https://cdn.jsdelivr.net/npm/papaparse@5.4.1/papaparse.min.js"
        ></script>
        <script is:inline src={`${base}js/runtime/script.js`}></script>
    </Fragment>
</Layout>
