---
// Compatibility route for password-reset links generated by the existing
// account service. The canonical Astro route is /{locale}/reset-password/.
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/shared/Navbar.astro';
import ResetPasswordHeroSection from '../../components/reset-password/ResetPasswordHeroSection.astro';
import HomeFooterSection from '../../components/home/HomeFooterSection.astro';
import LiquidGradientBackgroundScripts from '../../components/shared/LiquidGradientBackgroundScripts.astro';
import { getPageDictionary } from '../../lib/cms/getPageContent';
import { getLocaleSwitchUrls } from '../../lib/i18n/routing';
import { t } from '../../lib/i18n/t';
import type { Locale } from '../../lib/cms/types';

export function getStaticPaths() {
    return [{ params: { locale: 'en' } }, { params: { locale: 'fr' } }];
}

const locale = (Astro.params.locale === 'fr' ? 'fr' : 'en') as Locale;
const copy = await getPageDictionary('reset-password');
const base = import.meta.env.BASE_URL;
const localeSwitchUrls = getLocaleSwitchUrls(base, 'reset-password');
const pageTitle = t(copy, 'reset_password_page_title', locale, 'MTM | Reset Password');
const pageDescription = t(
    copy,
    'reset_password_page_description',
    locale,
    'Set a new password for your Media Technology Monitor (MTM) account.'
);
---

<Layout
    title={pageTitle}
    description={pageDescription}
    locale={locale}
    alternates={localeSwitchUrls}
    noindex={true}
>
    <main class="reset-password-page">
        <Navbar locale={locale} copy={copy} localeSwitchUrls={localeSwitchUrls} />
        <ResetPasswordHeroSection locale={locale} copy={copy} />
        <HomeFooterSection
            locale={locale}
            copy={copy}
            showCta={false}
            showNewsletter={false}
            showBgLeftCenter={false}
        />
    </main>

    <Fragment slot="scripts">
        <script is:inline src={`${base}js/runtime/script.js`}></script>
        <LiquidGradientBackgroundScripts />
    </Fragment>
</Layout>

<style>
    .reset-password-page {
        width: 100%;
    }
</style>
