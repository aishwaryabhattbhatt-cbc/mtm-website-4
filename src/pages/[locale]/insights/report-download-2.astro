---
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/shared/Navbar.astro';
import InsightsReportDownloadSection from '../../../components/insights/InsightsReportDownloadSection.astro';
import HomeFooterSection from '../../../components/home/HomeFooterSection.astro';
import { getPageDictionary, getRuntimeCMSConfig } from '../../../lib/cms/getPageContent';
import { t } from '../../../lib/i18n/t';
import type { Locale } from '../../../lib/cms/types';

export function getStaticPaths() {
    return [{ params: { locale: 'en' } }, { params: { locale: 'fr' } }];
}

const locale = (Astro.params.locale === 'fr' ? 'fr' : 'en') as Locale;
// This page has its own 'report-download' tab for its title/description/form
// copy, but its report picker (free_report_1/2/3_tag/date/title) deliberately
// reuses the same rows shown on /insights/ — so it also merges in the shared
// 'insights' dictionary. report-download's own keys win on any collision.
const pageId = 'report-download';
const copy = { ...(await getPageDictionary('insights')), ...(await getPageDictionary(pageId)) };
const cmsConfig = getRuntimeCMSConfig(pageId);
const base = import.meta.env.BASE_URL;
const resolvedCmsCsvUrl =
    cmsConfig.csvUrl ??
    (cmsConfig.sheetId && cmsConfig.gid
        ? `https://docs.google.com/spreadsheets/d/${cmsConfig.sheetId}/export?format=csv&gid=${cmsConfig.gid}`
        : '');

const localeSwitchUrls: Record<Locale, string> = {
    en: `${base}en/insights/report-download-2/`,
    fr: `${base}fr/insights/report-download-2/`,
};

// The one report this page hands over. Swap this object for the backend lookup
// (e.g. by Astro.url.searchParams.get('report')) — the card reads title/date/tags
// straight off it, and falls back to the *Key CMS copy for anything left unset.
const report = {
    imageSrc: `${base}images/insights/report-library/Picture.png`,
    imageAlt: '',
    title: undefined as string | undefined,
    date: undefined as string | undefined,
    tags: undefined as string[] | undefined,
    pillVariant: 'mtm18plus' as const,
    // Placeholder copy used until the fields above come from the backend.
    tagKey: 'free_report_1_tag',
    dateKey: 'free_report_1_date',
    titleKey: 'free_report_1_title',
    value: 'free_report_1',
};

const pageTitle = t(copy, 'report_download_page_title', locale, 'Download Report');
const pageDescription = t(
    copy,
    'report_download_page_description',
    locale,
    'Download this MTM report.'
);
---

<Layout
    title={pageTitle}
    description={pageDescription}
    locale={locale}
    alternates={localeSwitchUrls}
    noindex={true}
>
    <main
        data-locale={locale}
        data-cms-page-id={pageId}
        data-cms-csv-url={resolvedCmsCsvUrl}
        data-cms-sheet-id={cmsConfig.sheetId ?? ''}
        data-cms-tab-gid={cmsConfig.gid ?? ''}
        data-cms-refresh-ms={String(cmsConfig.refreshMs)}
    >
        <Navbar locale={locale} copy={copy} localeSwitchUrls={localeSwitchUrls} />

        <InsightsReportDownloadSection locale={locale} copy={copy} singleCard reports={[report]} />

        <HomeFooterSection
            locale={locale}
            copy={copy}
            showCta={false}
            showNewsletter={false}
            showBgLeftCenter={false}
        />
    </main>

    <Fragment slot="scripts">
        {
            /* Dev only: parses the sheet CSV for the live-reload in
        runtime/script.js. getRuntimeCMSConfig withholds the sheet details in
        production, so that refresh no-ops there and this was 45KB fetched from
        a CDN for nothing on every page load. */
        }
        {
            import.meta.env.DEV && (
                <script
                    is:inline
                    src="https://cdn.jsdelivr.net/npm/papaparse@5.4.1/papaparse.min.js"
                />
            )
        }
        <script is:inline src={`${base}js/runtime/script.js`}></script>
    </Fragment>
</Layout>
