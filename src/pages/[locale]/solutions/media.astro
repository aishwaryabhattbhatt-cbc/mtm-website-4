---
import Layout from '../../../layouts/Layout.astro';
import { toAbsoluteUrl } from '../../../lib/i18n/routing';
import { buildBreadcrumbList } from '../../../lib/content/breadcrumbs';
import Navbar from '../../../components/shared/Navbar.astro';
import SolutionsHeroSection from '../../../components/solutions/SolutionsHeroSection.astro';
import SolutionsTrustedBySection from '../../../components/solutions/SolutionsTrustedBySection.astro';
import SolutionsMediaInsightsSection from '../../../components/solutions/SolutionsMediaInsightsSection.astro';
import SolutionsToolsSection from '../../../components/solutions/SolutionsToolsSection.astro';
import SolutionsWorkflowSection from '../../../components/solutions/SolutionsWorkflowSection.astro';
import SolutionsUseCasesSection from '../../../components/solutions/SolutionsUseCasesSection.astro';
import SolutionsMediaTestimonialsSection from '../../../components/solutions/SolutionsMediaTestimonialsSection.astro';
import HomeFooterSection from '../../../components/home/HomeFooterSection.astro';
import { getPageDictionary, getRuntimeCMSConfig } from '../../../lib/cms/getPageContent';
import { t } from '../../../lib/i18n/t';
import type { Locale } from '../../../lib/cms/types';
import { icons } from '../../../lib/icons/registry';

export function getStaticPaths() {
    return [{ params: { locale: 'en' } }, { params: { locale: 'fr' } }];
}

const locale = (Astro.params.locale === 'fr' ? 'fr' : 'en') as Locale;
const pageId = 'media';
const copy = await getPageDictionary(pageId);
const cmsConfig = getRuntimeCMSConfig(pageId);
const base = import.meta.env.BASE_URL;
const resolvedCmsCsvUrl =
    cmsConfig.csvUrl ??
    (cmsConfig.sheetId && cmsConfig.gid
        ? `https://docs.google.com/spreadsheets/d/${cmsConfig.sheetId}/export?format=csv&gid=${cmsConfig.gid}`
        : '');

const localeSwitchUrls = {
    en: `${base}en/solutions/media/`,
    fr: `${base}fr/solutions/media/`,
};

// Icons shown on the hero panel grid — edit here to change them.
const heroIcons = [
    icons.gen.monitorAdoption,
    icons.gen.anticipateShifts,
    icons.gen.multipleOutputs,
    icons.gen.topicBars,
    icons.gen.cycle,
    icons.gen.perceptionSearch,
];

const pageTitle = t(
    copy,
    'media_page_title',
    locale,
    'MTM | Media Companies: Canadian Audience Data & Insights'
);
const pageDescription =
    locale === 'fr'
        ? 'Solutions MTM pour les entreprises médiatiques.'
        : 'MTM solutions for media companies.';

const trustedByLogos = [
    { src: `${base}images/home/solutions/logos/media/quebecor.svg`, alt: 'Quebecor' },
    { src: `${base}images/home/solutions/logos/media/ami-tv.svg`, alt: 'Accessible Media Inc.' },
    { src: `${base}images/home/solutions/logos/media/videotron.svg`, alt: 'Videotron' },
    { src: `${base}images/home/solutions/logos/media/rogers.svg`, alt: 'Rogers' },
    { src: `${base}images/home/solutions/logos/media/bell.svg`, alt: 'Bell' },
    { src: `${base}images/home/solutions/logos/media/telus.svg`, alt: 'Telus' },
    { src: `${base}images/home/solutions/logos/media/tva.svg`, alt: 'TVA' },
    { src: `${base}images/home/solutions/logos/media/tvo.svg`, alt: 'TVO' },
    { src: `${base}images/home/solutions/logos/media/tv5.svg`, alt: 'TV5' },
    { src: `${base}images/home/solutions/logos/media/tele-quebec.svg`, alt: 'Télé-Québec' },
    { src: `${base}images/home/solutions/logos/media/tfo.svg`, alt: 'TFO' },
    { src: `${base}images/home/solutions/logos/media/abc.svg`, alt: 'ABC' },
    { src: `${base}images/home/solutions/logos/media/bbc.svg`, alt: 'BBC' },
    {
        src: `${base}images/home/solutions/logos/media/wildbrain-television.svg`,
        alt: 'WildBrain Television',
    },
    { src: `${base}images/home/solutions/logos/media/aqpm.svg`, alt: 'AQPM' },
    { src: `${base}images/home/solutions/logos/media/nexxen.svg`, alt: 'Nexxen' },
    { src: `${base}images/home/solutions/logos/media/pelmorex.svg`, alt: 'Pelmorex' },
    { src: `${base}images/home/solutions/logos/technology/samsung.svg`, alt: 'Samsung' },
];
---

<Layout
    title={pageTitle}
    description={pageDescription}
    locale={locale}
    alternates={localeSwitchUrls}
>
    <main
        data-locale={locale}
        data-cms-page-id={pageId}
        data-cms-csv-url={resolvedCmsCsvUrl}
        data-cms-sheet-id={cmsConfig.sheetId ?? ''}
        data-cms-tab-gid={cmsConfig.gid ?? ''}
        data-cms-refresh-ms={String(cmsConfig.refreshMs)}
    >
        <Navbar locale={locale} copy={copy} localeSwitchUrls={localeSwitchUrls} />

        <SolutionsHeroSection
            locale={locale}
            copy={copy}
            ctaHref={`${base}${locale}/request-demo/`}
            heroImageSrc={`${base}images/solutions/media/hero/hero-solutions-media.webp`}
            maskImageSrc={`${base}images/solutions/media/hero/hero-solutions-media-mask.webp`}
            layoutId="media"
            heroIcons={heroIcons}
            fallbackEyebrow={t(copy, 'solutions_item_2', locale, 'Media and Broadcasting')}
            fallbackTitle="Know your audience"
            fallbackDescription="In a rapidly evolving media landscape, guesswork is a liability."
        />

        <SolutionsTrustedBySection locale={locale} copy={copy} logos={trustedByLogos} />

        <SolutionsMediaInsightsSection locale={locale} copy={copy} base={base} />

        <SolutionsToolsSection
            locale={locale}
            copy={copy}
            analyticDescriptionKey="media_tools_analytic_description"
            censusDescriptionKey="media_tools_census_description"
        />

        <SolutionsWorkflowSection locale={locale} copy={copy} />

        <SolutionsUseCasesSection locale={locale} copy={copy} />

        <SolutionsMediaTestimonialsSection locale={locale} copy={copy} base={base} />

        <HomeFooterSection locale={locale} copy={copy} />
    </main>

    <Fragment slot="head">
        <script
            is:inline
            type="application/ld+json"
            set:html={JSON.stringify({
                '@context': 'https://schema.org',
                '@type': 'WebPage',
                name: pageTitle,
                url: toAbsoluteUrl(Astro.site, localeSwitchUrls[locale]),
            })}
        />
        <script
            is:inline
            type="application/ld+json"
            set:html={JSON.stringify({
                '@context': 'https://schema.org',
                '@type': 'Service',
                name: 'MTM Solutions for Media Companies',
                url: toAbsoluteUrl(Astro.site, localeSwitchUrls[locale]),
                description: pageDescription,
                provider: { '@id': `${toAbsoluteUrl(Astro.site, base)}#organization` },
                audience: { '@type': 'BusinessAudience', audienceType: 'Media companies' },
                areaServed: { '@type': 'Country', name: 'Canada' },
            })}
        />
        <script
            is:inline
            type="application/ld+json"
            set:html={JSON.stringify(
                buildBreadcrumbList(
                    toAbsoluteUrl(Astro.site, base),
                    'Media',
                    toAbsoluteUrl(Astro.site, localeSwitchUrls[locale])
                )
            )}
        />
    </Fragment>

    <Fragment slot="scripts">
        <script is:inline src="https://cdn.jsdelivr.net/npm/papaparse@5.4.1/papaparse.min.js"
        ></script>
        <script is:inline src={`${base}js/runtime/script.js`}></script>
    </Fragment>
</Layout>
