---
import Layout from '../../../layouts/Layout.astro';
import { toAbsoluteUrl } from '../../../lib/i18n/routing';
import Navbar from '../../../components/shared/Navbar.astro';
import SolutionsHeroSection from '../../../components/solutions/SolutionsHeroSection.astro';
import SolutionsTrustedBySection from '../../../components/solutions/SolutionsTrustedBySection.astro';
import SolutionsAdvertisingInsightsSection from '../../../components/solutions/SolutionsAdvertisingInsightsSection.astro';
import SolutionsReportsLibrarySection from '../../../components/solutions/SolutionsReportsLibrarySection.astro';
import SolutionsWorkflowSection from '../../../components/solutions/SolutionsWorkflowSection.astro';
import SolutionsUseCasesSection from '../../../components/solutions/SolutionsUseCasesSection.astro';
import SolutionsMediaTestimonialsSection from '../../../components/solutions/SolutionsMediaTestimonialsSection.astro';
import HomeFooterSection from '../../../components/home/HomeFooterSection.astro';
import { getPageDictionary, getRuntimeCMSConfig } from '../../../lib/cms/getPageContent';
import { t } from '../../../lib/i18n/t';
import type { Locale } from '../../../lib/cms/types';

export function getStaticPaths() {
    return [{ params: { locale: 'en' } }, { params: { locale: 'fr' } }];
}

const locale = (Astro.params.locale === 'fr' ? 'fr' : 'en') as Locale;
const pageId = 'advertising';
const copy = await getPageDictionary(pageId);
const insightsCopy = await getPageDictionary('insights');
const cmsConfig = getRuntimeCMSConfig(pageId);
const base = import.meta.env.BASE_URL;
const resolvedCmsCsvUrl =
    cmsConfig.csvUrl ??
    (cmsConfig.sheetId && cmsConfig.gid
        ? `https://docs.google.com/spreadsheets/d/${cmsConfig.sheetId}/export?format=csv&gid=${cmsConfig.gid}`
        : '');

const localeSwitchUrls = {
    en: `${base}en/solutions/advertising/`,
    fr: `${base}fr/solutions/advertising/`,
};

const pageTitle = locale === 'fr' ? 'MTM | Publicité' : 'MTM | Advertising';
const pageDescription =
    locale === 'fr'
        ? "Solutions MTM pour l'industrie publicitaire."
        : 'MTM solutions for the advertising industry.';

const trustedByLogos = [
    { src: `${base}images/home/solutions/logos/advertising/cosette.svg`, alt: 'Cossette' },
    {
        src: `${base}images/home/solutions/logos/advertising/essencemediacom.svg`,
        alt: 'EssenceMediacom',
    },
    { src: `${base}images/home/solutions/logos/advertising/group-m.svg`, alt: 'GroupM' },
    {
        src: `${base}images/home/solutions/logos/advertising/hearts-and-science.png`,
        alt: 'Hearts & Science',
    },
    { src: `${base}images/home/solutions/logos/advertising/initiative.png`, alt: 'Initiative' },
    { src: `${base}images/home/solutions/logos/advertising/jungle.svg`, alt: 'Jungle' },
    {
        src: `${base}images/home/solutions/logos/advertising/media-experts.svg`,
        alt: 'Media Experts',
    },
    { src: `${base}images/home/solutions/logos/advertising/mindshare.svg`, alt: 'Mindshare' },
    { src: `${base}images/home/solutions/logos/advertising/omnicom.svg`, alt: 'Omnicom' },
    { src: `${base}images/home/solutions/logos/advertising/phd.svg`, alt: 'PHD' },
    {
        src: `${base}images/home/solutions/logos/advertising/time-space-media.png`,
        alt: 'Time & Space',
    },
    { src: `${base}images/home/solutions/logos/advertising/touche.SVG`, alt: 'Touché!' },
    { src: `${base}images/home/solutions/logos/advertising/um-worldwide.svg`, alt: 'UM Worldwide' },
];
---

<Layout
    title={pageTitle}
    description={pageDescription}
    locale={locale}
    alternates={localeSwitchUrls}
>
    <main
        data-locale={locale}
        data-cms-page-id={pageId}
        data-cms-csv-url={resolvedCmsCsvUrl}
        data-cms-sheet-id={cmsConfig.sheetId ?? ''}
        data-cms-tab-gid={cmsConfig.gid ?? ''}
        data-cms-refresh-ms={String(cmsConfig.refreshMs)}
    >
        <Navbar locale={locale} copy={copy} localeSwitchUrls={localeSwitchUrls} />

        <SolutionsHeroSection
            locale={locale}
            copy={copy}
            ctaHref={`${base}${locale}/request-demo/`}
            heroImageSrc={`${base}images/solutions/hero/Advertising.webp`}
            fallbackEyebrow={t(copy, 'solutions_item_3', locale, 'Advertising and Marketing')}
            fallbackTitle="Drive stronger campaign outcomes"
            fallbackDescription="Use trusted MTM data to plan, pitch, and optimize campaigns with confidence."
        />

        <SolutionsTrustedBySection locale={locale} copy={copy} logos={trustedByLogos} />

        <SolutionsAdvertisingInsightsSection locale={locale} copy={copy} base={base} />

        <SolutionsReportsLibrarySection locale={locale} copy={insightsCopy} />

        <SolutionsWorkflowSection locale={locale} copy={copy} />

        <SolutionsUseCasesSection locale={locale} copy={copy} />

        <SolutionsMediaTestimonialsSection
            locale={locale}
            copy={copy}
            base={base}
            logoSrc={`${base}images/home/solutions/logos/advertising/mindshare.svg`}
            logoAlt="Mindshare"
        />

        <HomeFooterSection locale={locale} copy={copy} />
    </main>

    <Fragment slot="head">
        <script
            is:inline
            type="application/ld+json"
            set:html={JSON.stringify({
                '@context': 'https://schema.org',
                '@type': 'WebPage',
                name: pageTitle,
                url: toAbsoluteUrl(Astro.site, localeSwitchUrls[locale]),
            })}
        />
        <script
            is:inline
            type="application/ld+json"
            set:html={JSON.stringify({
                '@context': 'https://schema.org',
                '@type': 'Service',
                name: 'MTM Solutions for Advertising',
                url: toAbsoluteUrl(Astro.site, localeSwitchUrls[locale]),
                description: pageDescription,
                provider: { '@id': `${toAbsoluteUrl(Astro.site, base)}#organization` },
                audience: {
                    '@type': 'BusinessAudience',
                    audienceType: 'Advertising agencies and brands',
                },
                areaServed: { '@type': 'Country', name: 'Canada' },
            })}
        />
    </Fragment>

    <Fragment slot="scripts">
        <script is:inline src="https://cdn.jsdelivr.net/npm/papaparse@5.4.1/papaparse.min.js"
        ></script>
        <script is:inline src={`${base}js/runtime/script.js`}></script>
    </Fragment>
</Layout>
