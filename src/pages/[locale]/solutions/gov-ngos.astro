---
import Layout from '../../../layouts/Layout.astro';
import { toAbsoluteUrl } from '../../../lib/i18n/routing';
import { buildBreadcrumbList } from '../../../lib/content/breadcrumbs';
import Navbar from '../../../components/shared/Navbar.astro';
import SolutionsHeroSection from '../../../components/solutions/SolutionsHeroSection.astro';
import SolutionsTrustedBySection from '../../../components/solutions/SolutionsTrustedBySection.astro';
import SolutionsGovNgosInsightsSection from '../../../components/solutions/SolutionsGovNgosInsightsSection.astro';
import SolutionsReportsLibrarySection from '../../../components/solutions/SolutionsReportsLibrarySection.astro';
import SolutionsToolsSection from '../../../components/solutions/SolutionsToolsSection.astro';
import SolutionsUseCasesSection from '../../../components/solutions/SolutionsUseCasesSection.astro';
import SolutionsMediaTestimonialsSection from '../../../components/solutions/SolutionsMediaTestimonialsSection.astro';
import HomeFooterSection from '../../../components/home/HomeFooterSection.astro';
import { getPageDictionary, getRuntimeCMSConfig } from '../../../lib/cms/getPageContent';
import { t } from '../../../lib/i18n/t';
import type { Locale } from '../../../lib/cms/types';
import { icons } from '../../../lib/icons/registry';

export function getStaticPaths() {
    return [{ params: { locale: 'en' } }, { params: { locale: 'fr' } }];
}

const locale = (Astro.params.locale === 'fr' ? 'fr' : 'en') as Locale;
const pageId = 'gov-ngos';
const copy = await getPageDictionary(pageId);
const insightsCopy = await getPageDictionary('insights');
const cmsConfig = getRuntimeCMSConfig(pageId);
const base = import.meta.env.BASE_URL;
const resolvedCmsCsvUrl =
    cmsConfig.csvUrl ??
    (cmsConfig.sheetId && cmsConfig.gid
        ? `https://docs.google.com/spreadsheets/d/${cmsConfig.sheetId}/export?format=csv&gid=${cmsConfig.gid}`
        : '');

const localeSwitchUrls = {
    en: `${base}en/solutions/gov-ngos/`,
    fr: `${base}fr/solutions/gov-ngos/`,
};

// Icons shown on the hero panel grid — edit here to change them.
const heroIcons = [
    icons.gen.coastToCoast,
    icons.gen.bilingual,
    icons.gen.reliableData,
    icons.gen.backMajorDecisions,
    icons.gen.methodologyRepresentation,
    icons.gen.summaryExecutive,
];

const pageTitle =
    locale === 'fr'
        ? 'MTM | Données médiatiques pour gouvernements et ONG'
        : 'MTM | Media Data for Government & NGOs';
const pageDescription =
    locale === 'fr'
        ? 'Solutions MTM pour le gouvernement et les organisations non gouvernementales.'
        : 'MTM solutions for government and non-governmental organizations.';

const trustedByLogos = [
    { src: `${base}images/home/solutions/logos/gov-ngo/canada.svg`, alt: 'Government of Canada' },
    { src: `${base}images/home/solutions/logos/gov-ngo/crtc.svg`, alt: 'CRTC' },
    {
        src: `${base}images/home/solutions/logos/gov-ngo/first-nation-market.svg`,
        alt: 'First Nations Market Housing Fund',
    },
    { src: `${base}images/home/solutions/logos/gov-ngo/quebec.svg`, alt: 'Québec' },
    {
        src: `${base}images/home/solutions/logos/gov-ngo/Telefilm_Canada.svg`,
        alt: 'Telefilm Canada',
    },
    {
        src: `${base}images/home/solutions/logos/gov-ngo/R613-EN-RGB-Colour.svg`,
        alt: 'Canadian Heritage',
    },
];
---

<Layout
    title={pageTitle}
    description={pageDescription}
    locale={locale}
    alternates={localeSwitchUrls}
>
    <main
        data-locale={locale}
        data-cms-page-id={pageId}
        data-cms-csv-url={resolvedCmsCsvUrl}
        data-cms-sheet-id={cmsConfig.sheetId ?? ''}
        data-cms-tab-gid={cmsConfig.gid ?? ''}
        data-cms-refresh-ms={String(cmsConfig.refreshMs)}
    >
        <Navbar locale={locale} copy={copy} localeSwitchUrls={localeSwitchUrls} />

        <SolutionsHeroSection
            locale={locale}
            copy={copy}
            ctaHref={`${base}${locale}/request-demo/`}
            heroImageSrc={`${base}images/solutions/govngo/hero/hero-solutions-govngo.webp`}
            maskImageSrc={`${base}images/solutions/govngo/hero/hero-solutions-govngo-mask.webp`}
            layoutId="gov-ngos"
            heroIcons={heroIcons}
            fallbackEyebrow={t(copy, 'solutions_item_5', locale, 'Government and NGOs')}
            fallbackTitle="Support policy and public outcomes with data"
            fallbackDescription="Use robust audience and technology insights to inform programs, policy, and public service strategy."
        />

        <SolutionsTrustedBySection locale={locale} copy={copy} logos={trustedByLogos} />

        <SolutionsGovNgosInsightsSection locale={locale} copy={copy} />

        <SolutionsReportsLibrarySection locale={locale} copy={insightsCopy} />

        <SolutionsToolsSection
            locale={locale}
            copy={copy}
            cards={['census', 'analytic-slim']}
            analyticDescriptionKey="gov_ngos_tools_analytic_description"
            censusDescriptionKey="gov_ngos_tools_census_description"
        />

        <SolutionsUseCasesSection locale={locale} copy={copy} />

        <SolutionsMediaTestimonialsSection
            locale={locale}
            copy={copy}
            base={base}
            logoSrc={`${base}images/home/solutions/logos/gov-ngo/crtc.svg`}
            logoAlt="CRTC"
        />

        <HomeFooterSection locale={locale} copy={copy} />
    </main>

    <Fragment slot="head">
        <script
            is:inline
            type="application/ld+json"
            set:html={JSON.stringify({
                '@context': 'https://schema.org',
                '@type': 'WebPage',
                name: pageTitle,
                url: toAbsoluteUrl(Astro.site, localeSwitchUrls[locale]),
            })}
        />
        <script
            is:inline
            type="application/ld+json"
            set:html={JSON.stringify({
                '@context': 'https://schema.org',
                '@type': 'Service',
                name: 'MTM Solutions for Government & NGOs',
                url: toAbsoluteUrl(Astro.site, localeSwitchUrls[locale]),
                description: pageDescription,
                provider: { '@id': `${toAbsoluteUrl(Astro.site, base)}#organization` },
                audience: {
                    '@type': 'BusinessAudience',
                    audienceType: 'Government and non-governmental organizations',
                },
                areaServed: { '@type': 'Country', name: 'Canada' },
            })}
        />
        <script
            is:inline
            type="application/ld+json"
            set:html={JSON.stringify(
                buildBreadcrumbList(
                    toAbsoluteUrl(Astro.site, base),
                    'Government & NGOs',
                    toAbsoluteUrl(Astro.site, localeSwitchUrls[locale])
                )
            )}
        />
    </Fragment>

    <Fragment slot="scripts">
        <script is:inline src="https://cdn.jsdelivr.net/npm/papaparse@5.4.1/papaparse.min.js"
        ></script>
        <script is:inline src={`${base}js/runtime/script.js`}></script>
    </Fragment>
</Layout>
