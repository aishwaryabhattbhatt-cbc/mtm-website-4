---
import Layout from '../../../layouts/Layout.astro';
import { toAbsoluteUrl } from '../../../lib/i18n/routing';
import { buildBreadcrumbList } from '../../../lib/content/breadcrumbs';
import Navbar from '../../../components/shared/Navbar.astro';
import SolutionsHeroSection from '../../../components/solutions/SolutionsHeroSection.astro';
import SolutionsTrustedBySection from '../../../components/solutions/SolutionsTrustedBySection.astro';
import SolutionsTopicsSection from '../../../components/solutions/SolutionsTopicsSection.astro';
import SolutionsToolsSection from '../../../components/solutions/SolutionsToolsSection.astro';
import SolutionsStatDividerSection from '../../../components/solutions/SolutionsStatDividerSection.astro';
import SolutionsWorkflowSection from '../../../components/solutions/SolutionsWorkflowSection.astro';
import SolutionsUseCasesSection from '../../../components/solutions/SolutionsUseCasesSection.astro';
import SolutionsMediaTestimonialsSection from '../../../components/solutions/SolutionsMediaTestimonialsSection.astro';
import HomeFooterSection from '../../../components/home/HomeFooterSection.astro';
import { getPageDictionary, getRuntimeCMSConfig } from '../../../lib/cms/getPageContent';
import { t } from '../../../lib/i18n/t';
import type { Locale } from '../../../lib/cms/types';
import { icons } from '../../../lib/icons/registry';

export function getStaticPaths() {
    return [{ params: { locale: 'en' } }, { params: { locale: 'fr' } }];
}

const locale = (Astro.params.locale === 'fr' ? 'fr' : 'en') as Locale;
const pageId = 'education';
const copy = await getPageDictionary(pageId);
const cmsConfig = getRuntimeCMSConfig(pageId);
const base = import.meta.env.BASE_URL;
const resolvedCmsCsvUrl =
    cmsConfig.csvUrl ??
    (cmsConfig.sheetId && cmsConfig.gid
        ? `https://docs.google.com/spreadsheets/d/${cmsConfig.sheetId}/export?format=csv&gid=${cmsConfig.gid}`
        : '');

const localeSwitchUrls = {
    en: `${base}en/solutions/education/`,
    fr: `${base}fr/solutions/education/`,
};

// Icons shown on the hero panel grid — edit here to change them.
const heroIcons = [
    icons.gen.training,
    icons.gen.faq,
    icons.gen.accreditedResearch,
    icons.gen.largeSamples,
    icons.gen.surveyDesign,
    icons.gen.qa,
];

const pageTitle =
    locale === 'fr'
        ? 'MTM | Données de recherche médiatique pour éducateurs'
        : 'MTM | Media Research Data for Educators';
const pageDescription =
    locale === 'fr'
        ? "Solutions MTM pour le secteur de l'éducation."
        : 'MTM solutions for the education sector.';

const trustedByLogos = [
    { src: `${base}images/home/solutions/logos/education/HEC_Montreal.svg`, alt: 'HEC Montréal' },
    {
        src: `${base}images/home/solutions/logos/education/Mount-Royal-University.svg`,
        alt: 'Mount Royal University',
    },
    {
        src: `${base}images/home/solutions/logos/education/humber-polytechnic.svg`,
        alt: 'Humber Polytechnic',
    },
    {
        src: `${base}images/home/solutions/logos/education/toronto-metro-univerity-logo.svg`,
        alt: 'Toronto Metropolitan University',
    },
    {
        src: `${base}images/home/solutions/logos/education/uOttawa.svg`,
        alt: 'University of Ottawa',
    },
    {
        src: `${base}images/home/solutions/logos/education/universite-de-montreal.svg`,
        alt: 'Université de Montréal',
    },
    {
        src: `${base}images/home/solutions/logos/education/university-of-manitoba.svg`,
        alt: 'University of Manitoba',
    },
];
---

<Layout
    title={pageTitle}
    description={pageDescription}
    locale={locale}
    alternates={localeSwitchUrls}
>
    <main
        data-locale={locale}
        data-cms-page-id={pageId}
        data-cms-csv-url={resolvedCmsCsvUrl}
        data-cms-sheet-id={cmsConfig.sheetId ?? ''}
        data-cms-tab-gid={cmsConfig.gid ?? ''}
        data-cms-refresh-ms={String(cmsConfig.refreshMs)}
    >
        <Navbar locale={locale} copy={copy} localeSwitchUrls={localeSwitchUrls} />

        <SolutionsHeroSection
            locale={locale}
            copy={copy}
            ctaHref={`${base}${locale}/request-demo/`}
            heroImageSrc={`${base}images/solutions/education/hero-solutions-education.webp`}
            maskImageSrc={`${base}images/solutions/education/hero-solutions-education-mask.webp`}
            layoutId="education"
            heroIcons={heroIcons}
            fallbackEyebrow={t(copy, 'solutions_item_4', locale, 'Education and Research')}
            fallbackTitle="Bring media intelligence into the classroom"
            fallbackDescription="Give faculty and students access to credible, real-world media and technology data."
        />

        <SolutionsTrustedBySection locale={locale} copy={copy} logos={trustedByLogos} />

        <SolutionsTopicsSection locale={locale} copy={copy} />

        <SolutionsToolsSection
            locale={locale}
            copy={copy}
            cards={['analytic', 'census-slim']}
            analyticDescriptionKey="education_tools_analytic_description"
            censusDescriptionKey="education_tools_census_description"
        />

        <SolutionsStatDividerSection
            locale={locale}
            copy={copy}
            imageSrc={`${base}images/tools/census/split-frame-1.webp`}
            fallbackValue="Unlimited seats"
            fallbackDescription="No extra charge for faculty, students and staff"
        />

        <SolutionsWorkflowSection locale={locale} copy={copy} />

        <SolutionsUseCasesSection locale={locale} copy={copy} />

        <SolutionsMediaTestimonialsSection
            locale={locale}
            copy={copy}
            base={base}
            logoSrc={`${base}images/home/solutions/logos/education/uOttawa.svg`}
            logoAlt="University of Ottawa"
        />

        <HomeFooterSection locale={locale} copy={copy} />
    </main>

    <Fragment slot="head">
        <script
            is:inline
            type="application/ld+json"
            set:html={JSON.stringify({
                '@context': 'https://schema.org',
                '@type': 'WebPage',
                name: pageTitle,
                url: toAbsoluteUrl(Astro.site, localeSwitchUrls[locale]),
            })}
        />
        <script
            is:inline
            type="application/ld+json"
            set:html={JSON.stringify({
                '@context': 'https://schema.org',
                '@type': 'Service',
                name: 'MTM Solutions for Education',
                url: toAbsoluteUrl(Astro.site, localeSwitchUrls[locale]),
                description: pageDescription,
                provider: { '@id': `${toAbsoluteUrl(Astro.site, base)}#organization` },
                audience: { '@type': 'BusinessAudience', audienceType: 'Educational institutions' },
                areaServed: { '@type': 'Country', name: 'Canada' },
            })}
        />
        <script
            is:inline
            type="application/ld+json"
            set:html={JSON.stringify(
                buildBreadcrumbList(
                    toAbsoluteUrl(Astro.site, base),
                    'Education',
                    toAbsoluteUrl(Astro.site, localeSwitchUrls[locale])
                )
            )}
        />
    </Fragment>

    <Fragment slot="scripts">
        <script is:inline src="https://cdn.jsdelivr.net/npm/papaparse@5.4.1/papaparse.min.js"
        ></script>
        <script is:inline src={`${base}js/runtime/script.js`}></script>
    </Fragment>
</Layout>
