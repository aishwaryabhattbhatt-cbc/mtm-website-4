---
import Layout from '../../../layouts/Layout.astro';
import { toAbsoluteUrl } from '../../../lib/i18n/routing';
import { buildBreadcrumbList } from '../../../lib/content/breadcrumbs';
import Navbar from '../../../components/shared/Navbar.astro';
import ProductsHeroSection from '../../../components/products/ProductsHeroSection.astro';
import Mtm18PlusFeaturesSection from '../../../components/products/Mtm18PlusFeaturesSection.astro';
import Mtm18PlusToolsSection from '../../../components/products/Mtm18PlusToolsSection.astro';
import Mtm18PlusReportsSection from '../../../components/products/Mtm18PlusReportsSection.astro';
import ProductMethodologySection from '../../../components/products/ProductMethodologySection.astro';
import Mtm18PlusExploreMoreSection from '../../../components/products/Mtm18PlusExploreMoreSection.astro';
import HomeFooterSection from '../../../components/home/HomeFooterSection.astro';
import { getPageDictionary, getRuntimeCMSConfig } from '../../../lib/cms/getPageContent';
import type { Locale } from '../../../lib/cms/types';
import { icons } from '../../../lib/icons/registry';

export function getStaticPaths() {
    return [{ params: { locale: 'en' } }, { params: { locale: 'fr' } }];
}

const locale = (Astro.params.locale === 'fr' ? 'fr' : 'en') as Locale;
const pageId = 'mtm-18-plus';
const copy = await getPageDictionary(pageId);
const cmsConfig = getRuntimeCMSConfig(pageId);
const base = import.meta.env.BASE_URL;
const resolvedCmsCsvUrl =
    cmsConfig.csvUrl ??
    (cmsConfig.sheetId && cmsConfig.gid
        ? `https://docs.google.com/spreadsheets/d/${cmsConfig.sheetId}/export?format=csv&gid=${cmsConfig.gid}`
        : '');

const localeSwitchUrls = {
    en: `${base}en/products/mtm-18-plus/`,
    fr: `${base}fr/products/mtm-18-plus/`,
};

const pageTitle =
    locale === 'fr'
        ? 'Données médiatiques des adultes canadiens | MTM 18+'
        : 'Canadian Adult Media & Technology Data | MTM 18+';
const pageDescription =
    locale === 'fr'
        ? 'Données sur les habitudes médiatiques et technologiques des Canadiens de 18 ans et plus.'
        : 'Data on media and technology habits of Canadians aged 18 and over.';
---

<Layout
    title={pageTitle}
    description={pageDescription}
    locale={locale}
    alternates={localeSwitchUrls}
>
    <main
        data-locale={locale}
        data-cms-page-id={pageId}
        data-cms-csv-url={resolvedCmsCsvUrl}
        data-cms-sheet-id={cmsConfig.sheetId ?? ''}
        data-cms-tab-gid={cmsConfig.gid ?? ''}
        data-cms-refresh-ms={String(cmsConfig.refreshMs)}
    >
        <Navbar locale={locale} copy={copy} localeSwitchUrls={localeSwitchUrls} />

        <ProductsHeroSection
            locale={locale}
            copy={copy}
            ctaHref={`${base}${locale}/request-demo/`}
            heroIconSrc={`${base}${icons['demographics-group'].adult}`}
            heroIconAlt=""
        />

        <Mtm18PlusFeaturesSection locale={locale} copy={copy} />

        <Mtm18PlusToolsSection locale={locale} copy={copy} />

        <Mtm18PlusReportsSection locale={locale} copy={copy} />

        <ProductMethodologySection
            locale={locale}
            copy={copy}
            providerLogoSrc={`${base}images/products/mtm-18-plus/forum_research_logo.png`}
            dataAsOfEn="Data released twice yearly — Fall wave in February, Spring wave in July."
            dataAsOfFr="Données publiées deux fois par année — vague d'automne en février, vague de printemps en juillet."
        />

        <Mtm18PlusExploreMoreSection locale={locale} copy={copy} />

        <HomeFooterSection locale={locale} copy={copy} />
    </main>

    <Fragment slot="head">
        <script
            is:inline
            type="application/ld+json"
            set:html={JSON.stringify({
                '@context': 'https://schema.org',
                '@type': 'WebPage',
                name: pageTitle,
                url: toAbsoluteUrl(Astro.site, localeSwitchUrls[locale]),
            })}
        />
        <script
            is:inline
            type="application/ld+json"
            set:html={JSON.stringify({
                '@context': 'https://schema.org',
                '@type': 'Service',
                name: 'MTM 18+',
                url: toAbsoluteUrl(Astro.site, localeSwitchUrls[locale]),
                description: pageDescription,
                provider: { '@id': `${toAbsoluteUrl(Astro.site, base)}#organization` },
                areaServed: { '@type': 'Country', name: 'Canada' },
                serviceType: 'Media and technology research data',
            })}
        />
        <script
            is:inline
            type="application/ld+json"
            set:html={JSON.stringify(
                buildBreadcrumbList(
                    toAbsoluteUrl(Astro.site, base),
                    'MTM 18+',
                    toAbsoluteUrl(Astro.site, localeSwitchUrls[locale])
                )
            )}
        />
    </Fragment>

    <Fragment slot="scripts">
        <script is:inline src="https://cdn.jsdelivr.net/npm/papaparse@5.4.1/papaparse.min.js"
        ></script>
        <script is:inline src={`${base}js/runtime/script.js`}></script>
    </Fragment>
</Layout>
