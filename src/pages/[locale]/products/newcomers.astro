---
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/shared/Navbar.astro';
import ProductsHeroSection from '../../../components/products/ProductsHeroSection.astro';
import NewcomersFeaturesSection from '../../../components/products/NewcomersFeaturesSection.astro';
import NewcomersToolsSection from '../../../components/products/NewcomersToolsSection.astro';
import NewcomersReportsSection from '../../../components/products/NewcomersReportsSection.astro';
import ProductMethodologySection from '../../../components/products/ProductMethodologySection.astro';
import NewcomersExploreMoreSection from '../../../components/products/NewcomersExploreMoreSection.astro';
import HomeFooterSection from '../../../components/home/HomeFooterSection.astro';
import { getPageDictionary, getRuntimeCMSConfig } from '../../../lib/cms/getPageContent';
import type { Locale } from '../../../lib/cms/types';

export function getStaticPaths() {
    return [{ params: { locale: 'en' } }, { params: { locale: 'fr' } }];
}

const locale = (Astro.params.locale === 'fr' ? 'fr' : 'en') as Locale;
const pageId = 'newcomers';
const copy = await getPageDictionary(pageId);
const cmsConfig = getRuntimeCMSConfig(pageId);
const base = import.meta.env.BASE_URL;
const resolvedCmsCsvUrl =
    cmsConfig.csvUrl ??
    (cmsConfig.sheetId && cmsConfig.gid
        ? `https://docs.google.com/spreadsheets/d/${cmsConfig.sheetId}/export?format=csv&gid=${cmsConfig.gid}`
        : '');

const localeSwitchUrls = {
    en: `${base}en/products/newcomers/`,
    fr: `${base}fr/products/newcomers/`,
};

const pageTitle = locale === 'fr' ? 'MTM | Nouveaux arrivants' : 'MTM | Newcomers';
const pageDescription =
    locale === 'fr'
        ? 'Données sur les habitudes médiatiques et technologiques des nouveaux arrivants au Canada.'
        : 'Data on media and technology habits of newcomers to Canada.';
---

<Layout
    title={pageTitle}
    description={pageDescription}
    locale={locale}
    alternates={localeSwitchUrls}
>
    <main
        data-locale={locale}
        data-cms-page-id={pageId}
        data-cms-csv-url={resolvedCmsCsvUrl}
        data-cms-sheet-id={cmsConfig.sheetId ?? ''}
        data-cms-tab-gid={cmsConfig.gid ?? ''}
        data-cms-refresh-ms={String(cmsConfig.refreshMs)}
    >
        <Navbar locale={locale} copy={copy} localeSwitchUrls={localeSwitchUrls} />

        <ProductsHeroSection
            locale={locale}
            copy={copy}
            ctaHref={`${base}${locale}/request-demo/`}
            heroImageSrc={`${base}images/products/mtm-newcomers/hero-banner.png`}
        />

        <NewcomersFeaturesSection locale={locale} copy={copy} />

        <NewcomersToolsSection locale={locale} copy={copy} />

        <NewcomersReportsSection locale={locale} copy={copy} />

        <ProductMethodologySection
            locale={locale}
            copy={copy}
            showComposition={false}
            providerLogoSrc={`${base}images/products/mtm-newcomers/leger_logo.png`}
        />

        <NewcomersExploreMoreSection locale={locale} copy={copy} />

        <HomeFooterSection locale={locale} copy={copy} />
    </main>

    <Fragment slot="head">
        <script
            is:inline
            type="application/ld+json"
            set:html={JSON.stringify({
                '@context': 'https://schema.org',
                '@type': 'WebPage',
                name: pageTitle,
                url: localeSwitchUrls[locale],
            })}
        />
    </Fragment>

    <Fragment slot="scripts">
        <script is:inline src="https://cdn.jsdelivr.net/npm/papaparse@5.4.1/papaparse.min.js"
        ></script>
        <script is:inline src={`${base}js/runtime/script.js`}></script>
    </Fragment>
</Layout>
