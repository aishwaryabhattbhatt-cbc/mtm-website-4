---
import Layout from '../../../layouts/Layout.astro';
import type { Locale } from '../../../lib/cms/types';

export function getStaticPaths() {
    return [{ params: { locale: 'en' } }, { params: { locale: 'fr' } }];
}

const locale = (Astro.params.locale === 'fr' ? 'fr' : 'en') as Locale;
const base = import.meta.env.BASE_URL;
const destination = `${base}${locale}/tools/census-tool/`;

const pageTitle = locale === 'fr' ? 'MTM | Recensement' : 'MTM | Census';
const pageDescription =
    locale === 'fr'
        ? 'Redirection vers l’outil de recensement MTM.'
        : 'Redirecting to the MTM Census Tool.';
---

<Layout title={pageTitle} description={pageDescription} locale={locale} noindex={true}>
    <Fragment slot="head">
        <meta http-equiv="refresh" content={`0;url=${destination}`} />
        <script is:inline define:vars={{ destination }}>
            window.location.replace(destination);
        </script>
    </Fragment>

    <main class="redirect-main" aria-hidden="true"></main>
</Layout>

<style>
    .redirect-main {
        display: none;
    }
</style>
