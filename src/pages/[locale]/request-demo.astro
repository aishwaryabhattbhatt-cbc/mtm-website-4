---
import Layout from '../../layouts/Layout.astro';
import { toAbsoluteUrl } from '../../lib/i18n/routing';
import { buildBreadcrumbList } from '../../lib/content/breadcrumbs';
import Navbar from '../../components/shared/Navbar.astro';
import RequestDemoHeroSection from '../../components/request-demo/RequestDemoHeroSection.astro';
import SolutionsTrustedBySection from '../../components/solutions/SolutionsTrustedBySection.astro';
import SolutionsMediaTestimonialsSection from '../../components/solutions/SolutionsMediaTestimonialsSection.astro';
import HomeFooterSection from '../../components/home/HomeFooterSection.astro';
import { getPageDictionary, getRuntimeCMSConfig } from '../../lib/cms/getPageContent';
import { t } from '../../lib/i18n/t';
import type { Locale } from '../../lib/cms/types';

export function getStaticPaths() {
    return [{ params: { locale: 'en' } }, { params: { locale: 'fr' } }];
}

const locale = (Astro.params.locale === 'fr' ? 'fr' : 'en') as Locale;
const pageId = 'request-demo';
const copy = await getPageDictionary(pageId);
const cmsConfig = getRuntimeCMSConfig(pageId);
const base = import.meta.env.BASE_URL;
const resolvedCmsCsvUrl =
    cmsConfig.csvUrl ??
    (cmsConfig.sheetId && cmsConfig.gid
        ? `https://docs.google.com/spreadsheets/d/${cmsConfig.sheetId}/export?format=csv&gid=${cmsConfig.gid}`
        : '');

const localeSwitchUrls: Record<Locale, string> = {
    en: `${base}en/request-demo/`,
    fr: `${base}fr/request-demo/`,
};

const pageTitle = t(copy, 'request_demo_page_title', locale, 'MTM | Request a Demo');
const pageDescription = t(
    copy,
    'request_demo_description',
    locale,
    'Book a demo with an MTM expert to see our products and tools in action.'
);

const mediaTrustedByLogos = [
    { src: `${base}images/home/solutions/logos/media/ami-tv.svg`, alt: 'AMI' },
    { src: `${base}images/home/solutions/logos/media/videotron.svg`, alt: 'Vidéotron' },
    { src: `${base}images/home/solutions/logos/media/rogers.svg`, alt: 'Rogers' },
    { src: `${base}images/home/solutions/logos/media/bell.svg`, alt: 'Bell' },
    { src: `${base}images/home/solutions/logos/media/telus.svg`, alt: 'Telus' },
    { src: `${base}images/home/solutions/logos/media/tva.svg`, alt: 'TVA' },
    { src: `${base}images/home/solutions/logos/media/tvo.svg`, alt: 'TVO' },
    { src: `${base}images/home/solutions/logos/media/tv5.svg`, alt: 'TV5 Québec' },
    { src: `${base}images/home/solutions/logos/media/tele-quebec.svg`, alt: 'Télé-Québec' },
    { src: `${base}images/home/solutions/logos/media/tfo.svg`, alt: 'TFO' },
    { src: `${base}images/home/solutions/logos/media/abc.svg`, alt: 'ABC' },
    { src: `${base}images/home/solutions/logos/media/aqpm.svg`, alt: 'AQPM' },
    { src: `${base}images/home/solutions/logos/media/pelmorex.svg`, alt: 'Pelmorex' },
    { src: `${base}images/home/solutions/logos/technology/samsung.svg`, alt: 'Samsung' },
];

const advertisingTrustedByLogos = [
    {
        src: `${base}images/home/solutions/logos/advertising/essencemediacom.jpeg`,
        alt: 'EssenceMediacom',
    },
    { src: `${base}images/home/solutions/logos/advertising/group-m.svg`, alt: 'GroupM' },
    {
        src: `${base}images/home/solutions/logos/advertising/hearts-and-science.png`,
        alt: 'Hearts & Science',
    },
    {
        src: `${base}images/home/solutions/logos/advertising/initiative.png`,
        alt: 'Initiative Media',
    },
    {
        src: `${base}images/home/solutions/logos/advertising/media-experts.svg`,
        alt: 'Media Experts',
    },
    { src: `${base}images/home/solutions/logos/advertising/mindshare.svg`, alt: 'Mindshare' },
    {
        src: `${base}images/home/solutions/logos/advertising/omnicom.svg`,
        alt: 'Omnicom Media Group',
    },
    { src: `${base}images/home/solutions/logos/advertising/phd.svg`, alt: 'PHD Media' },
    { src: `${base}images/home/solutions/logos/advertising/remitly.svg`, alt: 'Remitly' },
    {
        src: `${base}images/home/solutions/logos/advertising/time-space-media.png`,
        alt: 'Time + Space Media',
    },
    { src: `${base}images/home/solutions/logos/advertising/touche.SVG`, alt: 'Touché!' },
    { src: `${base}images/home/solutions/logos/advertising/um-worldwide.svg`, alt: 'UM Worldwide' },
];

const industryTrustedByLogos = [
    {
        src: `${base}images/home/solutions/logos/industry/EBU-European_Broadcasting_Union.svg`,
        alt: 'European Broadcasting Union',
    },
    { src: `${base}images/home/solutions/logos/industry/cmf-blk.svg`, alt: 'CMF' },
    { src: `${base}images/home/solutions/logos/industry/numeris.png`, alt: 'Numeris (BBM Canada)' },
];

const educationTrustedByLogos = [
    { src: `${base}images/home/solutions/logos/education/HEC_Montreal.svg`, alt: 'HEC Montréal' },
    {
        src: `${base}images/home/solutions/logos/education/Mount-Royal-University.svg`,
        alt: 'Mount Royal University',
    },
    {
        src: `${base}images/home/solutions/logos/education/humber-polytechnic.svg`,
        alt: 'Humber Polytechnic',
    },
    {
        src: `${base}images/home/solutions/logos/education/toronto-metro-univerity-logo.svg`,
        alt: 'Toronto Metropolitan University',
    },
    {
        src: `${base}images/home/solutions/logos/education/uOttawa.svg`,
        alt: 'University of Ottawa',
    },
    {
        src: `${base}images/home/solutions/logos/education/universite-de-montreal.svg`,
        alt: 'Université de Montréal',
    },
    {
        src: `${base}images/home/solutions/logos/education/university-of-manitoba.svg`,
        alt: 'University of Manitoba',
    },
];

const govNgosTrustedByLogos = [
    { src: `${base}images/home/solutions/logos/gov-ngo/canada.svg`, alt: 'Government of Canada' },
    { src: `${base}images/home/solutions/logos/gov-ngo/crtc.svg`, alt: 'CRTC' },
    {
        src: `${base}images/home/solutions/logos/gov-ngo/first-nation-market.svg`,
        alt: 'First Nations Market Housing Fund',
    },
    { src: `${base}images/home/solutions/logos/gov-ngo/quebec.svg`, alt: 'Quebec Government' },
    {
        src: `${base}images/home/solutions/logos/gov-ngo/Telefilm_Canada.svg`,
        alt: 'Téléfilm Canada',
    },
];

const trustedByLogoSets = [
    mediaTrustedByLogos,
    advertisingTrustedByLogos,
    industryTrustedByLogos,
    govNgosTrustedByLogos,
    educationTrustedByLogos,
];

const testimonials = [
    {
        logoSrc: `${base}images/home/solutions/logos/media/the-weather-network.svg`,
        logoAlt: 'The Weather Network',
        quoteKey: 'request_demo_testimonial_1_quote',
        quoteFallback:
            'When it comes to technology ownership and usage in Canada, the MTM is THE go-to source of information. For our team, this resource is invaluable because it allows us to make informed decisions with confidence and stay one step ahead in an ever-changing media landscape. It is a fundamental tool for our strategic planning and innovation efforts.',
        attributionKey: 'request_demo_testimonial_1_attribution',
        attributionFallback: 'Élise Roy-Pepin, The Weather Network',
    },
    {
        logoSrc: `${base}images/home/solutions/logos/advertising/time-space-media.png`,
        logoAlt: 'Time + Space Media',
        quoteKey: 'request_demo_testimonial_2_quote',
        quoteFallback:
            'MTM is a valuable resource for effective media planning and research for our clients. The comprehensive data, forecasting and frequent reports give us deep insight into Canadian audience behaviors and media trends.',
        attributionKey: 'request_demo_testimonial_2_attribution',
        attributionFallback: 'Ryan Casey, Director, Media Operations - Time & Space Media',
    },
    {
        logoSrc: `${base}images/home/solutions/logos/gov-ngo/manso.svg`,
        logoAlt: 'MANSO',
        quoteKey: 'request_demo_testimonial_5_quote',
        quoteFallback:
            "Thanks to our subscription to MTM Newcomers, we have access to newcomer data insights and their settlement and integration journey in Manitoba. We particularly appreciate seeing information that is not available through any other sources, like newcomers' use of media, devices, and newcomer knowledge of services available through our sector. This information helps our members ensure that their services are well adapted to the needs and characteristics of the newcomers they serve.",
        attributionKey: 'request_demo_testimonial_5_attribution',
        attributionFallback: 'Valeria Castellanos,  Language Support and Program Manager - MANSO',
    },
    {
        logoSrc: `${base}images/home/solutions/logos/education/uOttawa.svg`,
        logoAlt: 'University of Ottawa',
        quoteKey: 'request_demo_testimonial_4_quote',
        quoteFallback:
            'As the author of nine editions of a Canadian Advertising textbook, I have included data from Media Technology Monitor (MTM) for the past five editions to enhance the Broadcast, Internet and Social Media Chapters. I believe the data improved the quality allowing students to understand the complexities of advertising planning decisions.',
        attributionKey: 'request_demo_testimonial_4_attribution',
        attributionFallback: 'Michael Guolla, Professor, University of Ottawa',
    },
];
---

<Layout
    title={pageTitle}
    description={pageDescription}
    locale={locale}
    alternates={localeSwitchUrls}
>
    <main
        data-locale={locale}
        data-cms-page-id={pageId}
        data-cms-csv-url={resolvedCmsCsvUrl}
        data-cms-sheet-id={cmsConfig.sheetId ?? ''}
        data-cms-tab-gid={cmsConfig.gid ?? ''}
        data-cms-refresh-ms={String(cmsConfig.refreshMs)}
    >
        <Navbar locale={locale} copy={copy} localeSwitchUrls={localeSwitchUrls} />

        <RequestDemoHeroSection locale={locale} copy={copy} />

        <SolutionsTrustedBySection
            locale={locale}
            copy={copy}
            logoSets={trustedByLogoSets}
            rotationIntervalMs={45000}
            topPadding={true}
        />

        <SolutionsMediaTestimonialsSection
            locale={locale}
            copy={copy}
            base={base}
            testimonials={testimonials}
            rotationIntervalMs={45000}
            topPadding={false}
            showTitle={false}
        />

        <HomeFooterSection
            locale={locale}
            copy={copy}
            showCta={false}
            showNewsletter={false}
            showBgLeftCenter={false}
        />
    </main>

    <Fragment slot="head">
        <script
            is:inline
            type="application/ld+json"
            set:html={JSON.stringify({
                '@context': 'https://schema.org',
                '@type': 'WebPage',
                name: pageTitle,
                url: toAbsoluteUrl(Astro.site, localeSwitchUrls[locale]),
            })}
        />
        <script
            is:inline
            type="application/ld+json"
            set:html={JSON.stringify(
                buildBreadcrumbList(
                    toAbsoluteUrl(Astro.site, base),
                    'Request a Demo',
                    toAbsoluteUrl(Astro.site, localeSwitchUrls[locale])
                )
            )}
        />
    </Fragment>

    <Fragment slot="scripts">
        {
            /* Dev only: parses the sheet CSV for the live-reload in
        runtime/script.js. getRuntimeCMSConfig withholds the sheet details in
        production, so that refresh no-ops there and this was 45KB fetched from
        a CDN for nothing on every page load. */
        }
        {
            import.meta.env.DEV && (
                <script
                    is:inline
                    src="https://cdn.jsdelivr.net/npm/papaparse@5.4.1/papaparse.min.js"
                />
            )
        }
        <script is:inline src={`${base}js/runtime/script.js`}></script>
    </Fragment>
</Layout>
