---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/shared/Navbar.astro';
import HomeFooterSection from '../../components/home/HomeFooterSection.astro';
import AboutUsHeroSection from '../../components/about-us/AboutUsHeroSection.astro';
import LiquidGradientBackgroundScripts from '../../components/shared/LiquidGradientBackgroundScripts.astro';
import AboutUsValuesSection from '../../components/about-us/AboutUsValuesSection.astro';
import AboutUsTimelineSection from '../../components/about-us/AboutUsTimelineSection.astro';
import InsightsNewsSection from '../../components/insights/InsightsNewsSection.astro';
// AboutUsTeamSection and AboutUsFaqSection hidden for now — see usage below.
// import AboutUsTeamSection from '../../components/about-us/AboutUsTeamSection.astro';
// import AboutUsFaqSection from '../../components/about-us/AboutUsFaqSection.astro';
import { getPageDictionary } from '../../lib/cms/getPageContent';
import { getLocaleSwitchUrls, toAbsoluteUrl } from '../../lib/i18n/routing';
import { buildBreadcrumbList } from '../../lib/content/breadcrumbs';
import { t } from '../../lib/i18n/t';
import type { Locale } from '../../lib/cms/types';

export function getStaticPaths() {
    return [{ params: { locale: 'en' } }, { params: { locale: 'fr' } }];
}

const locale = (Astro.params.locale === 'fr' ? 'fr' : 'en') as Locale;
const copy = await getPageDictionary('about-us');
const base = import.meta.env.BASE_URL;
const localeSwitchUrls = getLocaleSwitchUrls(base, 'about-us');
const isFrench = locale === 'fr';

const pageTitle = t(copy, 'about_page_title', locale, 'MTM | About Us');
const pageDescription = t(
    copy,
    'about_page_description',
    locale,
    'Media Technology Monitor (MTM) is a continuous, independent research initiative measuring how Canadians use media and technology since 2005.'
);

const pageUrl = toAbsoluteUrl(Astro.site, localeSwitchUrls[locale]);
const siteRoot = toAbsoluteUrl(Astro.site, base);
const webPageJsonLd = {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: pageTitle,
    url: pageUrl,
};
const breadcrumbJsonLd = buildBreadcrumbList(siteRoot, isFrench ? 'À propos' : 'About Us', pageUrl);
---

<Layout
    title={pageTitle}
    description={pageDescription}
    locale={locale}
    alternates={localeSwitchUrls}
>
    <main class="about-us-page">
        <Navbar locale={locale} copy={copy} localeSwitchUrls={localeSwitchUrls} />

        <AboutUsHeroSection locale={locale} copy={copy} />

        <AboutUsValuesSection locale={locale} copy={copy} />

        <div class="section-gap section-gap-sm" aria-hidden="true"></div>

        <AboutUsTimelineSection locale={locale} copy={copy} />

        <div class="section-gap section-gap-sm" aria-hidden="true"></div>

        <InsightsNewsSection locale={locale} copy={copy} />

        <div class="section-gap section-gap-sm" aria-hidden="true"></div>

        {
            /* AboutUsTeamSection hidden for now — re-enable when the team
               section is ready. AboutUsFaqSection hidden for now — re-enable
               when the FAQ content is ready. */
        }

        <HomeFooterSection locale={locale} copy={copy} />
    </main>

    <Fragment slot="head">
        <script is:inline type="application/ld+json" set:html={JSON.stringify(webPageJsonLd)} />
        <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
    </Fragment>

    <Fragment slot="scripts">
        <LiquidGradientBackgroundScripts />
    </Fragment>
</Layout>

<style>
    .about-us-page {
        width: 100%;
    }
</style>
