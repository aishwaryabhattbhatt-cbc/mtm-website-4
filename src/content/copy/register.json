  "request_demo_testimonial_title": {
    "key": "request_demo_testimonial_title",
    "en": "What clients are saying about us",
    "fr": ""
  },
  "request_demo_testimonial_1_quote": {
    "key": "request_demo_testimonial_1_quote",
    "en": "When it comes to technology ownership and usage in Canada, the MTM is THE go-to source of information. For our team, this resource is invaluable because it allows us to make informed decisions with confidence and stay one step ahead in an ever-changing media landscape. It is a fundamental tool for our strategic planning and innovation efforts.",
    "fr": ""
  },
  "request_demo_testimonial_1_attribution": {
    "key": "request_demo_testimonial_1_attribution",
    "en": "Élise Roy-Pepin, The Weather Network",
    "fr": ""
  },
  "request_demo_testimonial_2_quote": {
    "key": "request_demo_testimonial_2_quote",
    "en": "MTM is a valuable resource for effective media planning and research for our clients. The comprehensive data, forecasting and frequent reports give us deep insight into Canadian audience behaviors and media trends.",
    "fr": ""
  },
  "request_demo_testimonial_2_attribution": {
    "key": "request_demo_testimonial_2_attribution",
    "en": "Ryan Casey, Director, Media Operations - Time & Space Media",
    "fr": ""
  },
  "request_demo_testimonial_3_quote": {
    "key": "request_demo_testimonial_3_quote",
    "en": "Our decisions have to stand up to scrutiny — from where funding goes to how impact is measured. MTM's data gives us that credibility. It connects audience behaviour to real outcomes, helping us plan investments and policies that actually reflect how Canadians consume media today.",
    "fr": ""
  },
  "request_demo_testimonial_3_attribution": {
    "key": "request_demo_testimonial_3_attribution",
    "en": "Director of Audience Strategy",
    "fr": ""
  },
  "request_demo_testimonial_4_quote": {
    "key": "request_demo_testimonial_4_quote",
    "en": "As the author of nine editions of a Canadian Advertising textbook, I have included data from Media Technology Monitor (MTM) for the past five editions to enhance the Broadcast, Internet and Social Media Chapters. I believe the data improved the quality allowing students to understand the complexities of advertising planning decisions. The textbook contains the most current consumer media technology usage and adoption data to keep it in a leading market position. MTM is a wonderful partner and I look forward to working with them for the next edition.",
    "fr": ""
  },
  "request_demo_testimonial_4_attribution": {
    "key": "request_demo_testimonial_4_attribution",
    "en": "Michael Guolla, Professor, University of Ottawa",
    "fr": ""
  },
  "request_demo_testimonial_5_quote": {
    "key": "request_demo_testimonial_5_quote",
    "en": "Thanks to our subscription to MTM Newcomers, we have access to newcomer data insights and their settlement and integration journey in Manitoba. We particularly appreciate seeing information that is not available through any other sources, like newcomers' use of media, devices, and newcomer knowledge of services available through our sector. This information helps our members ensure that their services are well adapted to the needs and characteristics of the newcomers they serve.",
    "fr": ""
  },
  "request_demo_testimonial_5_attribution": {
    "key": "request_demo_testimonial_5_attribution",
    "en": "Valeria Castellanos, Language Support and Program Manager - MANSO",
    "fr": ""
  },
