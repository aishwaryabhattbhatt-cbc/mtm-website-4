  },
  "request_demo_explore_trending_description": {
    "key": "request_demo_explore_trending_description",
    "en": "Understand the evolution of your business and where your clients interests are heading with the user-friendly Trending Tool. Filter over 25 years data to better understand where media consumption and technology adoption is heading.",
