  "faq_1_question": {
    "key": "faq_1_question",
    "en": "When is data released for MTM 18+, MTM Jr., MTM Newcomers, and the MTM Census Tool?",
    "fr": ""
  },
  "faq_1_answer": {
    "key": "faq_1_answer",
    "en": "Release schedules vary by product:\n\nMTM 18+: Releases twice a year, with Fall data available in February and Spring data available in July.\n\nMTM Junior: Releases annually in May.\n\nMTM Newcomers: Releases annually in October or November.\n\nMTM Census Tool: Updated with new Statistics Canada Census data following each national census. The next update, based on the 2026 Census, is expected in Spring/Summer 2027.",
    "fr": ""
  },
  "faq_2_question": {
    "key": "faq_2_question",
    "en": "How much does it cost for an MTM subscription?",
    "fr": ""
  },
  "faq_2_answer": {
    "key": "faq_2_answer",
    "en": "Costs will vary based on the size of your organization as well as which MTM products you opt in for. We offer discounts for those who subscribe to multiple MTM products. Contact us today for a quote and more details.",
    "fr": ""
  },
  "faq_3_question": {
    "key": "faq_3_question",
    "en": "How many accounts/seats does an MTM subscription come with?",
    "fr": ""
  },
  "faq_3_answer": {
    "key": "faq_3_answer",
    "en": "We offer an unlimited amount of seats for subscribers and include a self-sign up page for users.",
    "fr": ""
  },
  "faq_4_question": {
    "key": "faq_4_question",
    "en": "Can I buy an individual report?",
    "fr": ""
  },
  "faq_4_answer": {
    "key": "faq_4_answer",
    "en": "A subscription to an MTM product includes full access to its suite of reports and web-based tools. Reports are not available for individual purchase.",
    "fr": ""
  },
