---
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { t } from '../../lib/i18n/t';
import Button from '../shared/Button.astro';
import FormField from '../shared/FormField.astro';
import LiquidGradientBackground from '../shared/LiquidGradientBackground.astro';

interface Props {
    locale: Locale;
    copy: CMSDictionary;
}

const { locale, copy } = Astro.props as Props;
const base = import.meta.env.BASE_URL;
---

<section class="reset-password-hero section-height-100">
    <LiquidGradientBackground id="webgl-background-reset-password" />

    <div class="reset-password-hero__content">
        <div class="reset-password-hero__stack">
            <div class="reset-password-hero__intro hero-fade-in" style="animation-delay: 0.1s">
                <h1
                    class="reset-password-hero__title"
                    data-reset-password-title
                    data-reset-title={t(
                        copy,
                        'reset_password_hero_title',
                        locale,
                        'Reset Password'
                    )}
                    data-create-title={t(
                        copy,
                        'reset_password_hero_create_title',
                        locale,
                        'Create Password'
                    )}
                >
                    {t(copy, 'reset_password_hero_title', locale, 'Reset Password')}
                </h1>

                <p class="text-body-p2 reset-password-hero__subtitle">
                    {
                        t(
                            copy,
                            'reset_password_hero_subtitle',
                            locale,
                            'Enter a new password for your MTM account.'
                        )
                    }
                </p>
            </div>

            <div class="reset-password-hero__card hero-fade-in" style="animation-delay: 0.2s">
                <form
                    class="reset-password-hero__form"
                    data-error-invalid-token={t(
                        copy,
                        'reset_password_error_invalid_token',
                        locale,
                        locale === 'fr'
                            ? 'Cette demande a expiré. Veuillez utiliser le lien le plus récent envoyé à votre adresse courriel.'
                            : 'This request has expired. Please use the newest link sent to your email address.'
                    )}
                    data-error-mismatch={t(
                        copy,
                        'reset_password_error_mismatch',
                        locale,
                        locale === 'fr'
                            ? 'Les mots de passe ne correspondent pas.'
                            : 'The passwords do not match.'
                    )}
                    data-error-password-length={t(
                        copy,
                        'reset_password_error_length',
                        locale,
                        locale === 'fr'
                            ? 'Le mot de passe doit contenir au moins 8 caractères.'
                            : 'Password must contain at least 8 characters.'
                    )}
                    data-error-password-case={t(
                        copy,
                        'reset_password_error_case',
                        locale,
                        locale === 'fr'
                            ? 'Le mot de passe doit contenir des lettres majuscules et minuscules.'
                            : 'Password must contain uppercase and lowercase letters.'
                    )}
                    data-error-password-symbol={t(
                        copy,
                        'reset_password_error_symbol',
                        locale,
                        locale === 'fr'
                            ? 'Le mot de passe doit contenir au moins un symbole.'
                            : 'Password must contain at least one symbol.'
                    )}
                    data-error-rate-limit={t(
                        copy,
                        'reset_password_error_rate_limit',
                        locale,
                        locale === 'fr'
                            ? 'Trop de demandes ont été envoyées. Veuillez réessayer dans quelques minutes.'
                            : 'Too many requests have been submitted. Please try again in a few minutes.'
                    )}
                    data-error-generic={t(
                        copy,
                        'reset_password_error_generic',
                        locale,
                        locale === 'fr'
                            ? 'Une erreur est survenue. Veuillez réessayer ou communiquer avec nous au 1-855-898-4999.'
                            : 'An error has occurred. Please try again or contact us at 1-855-898-4999.'
                    )}
                    novalidate
                >
                    <div
                        class="reset-password-hero__message reset-password-hero__message--error text-body-p3"
                        data-reset-password-error
                        role="alert"
                        aria-live="polite"
                        hidden
                    >
                    </div>

                    <FormField
                        locale={locale}
                        copy={copy}
                        variant="field-with-label"
                        type="password"
                        name="password"
                        labelKey="reset_password_form_password_label"
                        label="New Password"
                        placeholderKey="reset_password_form_password_placeholder"
                        placeholder="Enter your new password"
                        labelColor="primary"
                        required
                    />

                    <FormField
                        locale={locale}
                        copy={copy}
                        variant="field-with-label"
                        type="password"
                        name="confirmPassword"
                        labelKey="reset_password_form_confirm_label"
                        label="Confirm Password"
                        placeholderKey="reset_password_form_confirm_placeholder"
                        placeholder="Re-enter your new password"
                        labelColor="primary"
                        required
                    />

                    <div class="reset-password-hero__actions">
                        <Button
                            variant="primary"
                            size="lg"
                            type="submit"
                            class="reset-password-hero__submit"
                        >
                            {t(copy, 'reset_password_form_submit', locale, 'Save Password')}
                        </Button>
                    </div>
                </form>

                <div
                    class="reset-password-hero__success"
                    data-reset-password-success
                    role="status"
                    aria-live="polite"
                    hidden
                >
                    <h2 class="text-h4">
                        {t(copy, 'reset_password_success_title', locale, 'Password Updated')}
                    </h2>
                    <p class="text-body-p3">
                        {
                            t(
                                copy,
                                'reset_password_success_message',
                                locale,
                                'Your password has been updated. You can now sign in.'
                            )
                        }
                    </p>
                    <Button variant="primary" size="lg" href={`${base}${locale}/sign-in/`}>
                        {t(copy, 'reset_password_success_cta', locale, 'Sign In')}
                    </Button>
                </div>

                <p class="text-body-p3 reset-password-hero__back" data-reset-password-back>
                    <a href={`${base}${locale}/sign-in/`}>
                        {t(copy, 'reset_password_back_to_sign_in', locale, 'Go Back to Sign In')}
                    </a>
                </p>
            </div>
        </div>
    </div>
</section>

<style>
    .reset-password-hero {
        position: relative;
        width: 100%;
        height: auto;
        overflow: clip;
        margin-top: var(--navbar-height);
        padding: var(--section-pad-block) var(--content-margin-inline);
        background: var(--surface-white);
        display: flex;
        align-items: flex-start;
        justify-content: center;
    }

    .reset-password-hero__content {
        position: relative;
        z-index: 1;
        width: 100%;
        display: flex;
        justify-content: center;
    }

    .reset-password-hero__stack {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--space-6);
    }

    .reset-password-hero__intro {
        max-width: 40rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--title-desc-gap);
        text-align: center;
    }

    .reset-password-hero__title {
        margin: 0;
        font-family: var(--font-heading);
        font-size: var(--fs-subsection-h2);
        font-weight: var(--fw-semibold);
        line-height: var(--lh-tight);
        letter-spacing: var(--ls-heading-lg);
        color: var(--text-primary);
    }

    .reset-password-hero__subtitle,
    .reset-password-hero__back,
    .reset-password-hero__success h2,
    .reset-password-hero__success p {
        margin: 0;
    }

    .reset-password-hero__subtitle,
    .reset-password-hero__back {
        color: var(--text-secondary);
    }

    .reset-password-hero__card {
        width: 100%;
        max-width: 37.5rem;
        padding: var(--space-9);
        border-radius: var(--radius-m);
        background: var(--surface-blue);
        box-shadow: var(--shadow-card);
        display: flex;
        flex-direction: column;
        gap: var(--space-5);
    }

    .reset-password-hero__form,
    .reset-password-hero__success {
        display: flex;
        flex-direction: column;
        gap: var(--space-5);
    }

    .reset-password-hero__form[hidden],
    .reset-password-hero__success[hidden],
    .reset-password-hero__message[hidden],
    .reset-password-hero__back[hidden] {
        display: none;
    }

    .reset-password-hero__message {
        margin: 0;
        padding: var(--space-3) var(--space-4);
        border-radius: var(--radius-s);
    }

    .reset-password-hero__message--error {
        background: color-mix(in srgb, var(--feedback-error) 10%, var(--surface-white));
        color: var(--feedback-error);
    }

    .reset-password-hero__actions {
        display: flex;
        margin-top: var(--space-3);
    }

    .reset-password-hero__submit {
        width: 100%;
        text-align: center;
    }

    .reset-password-hero__back a {
        color: var(--text-primary);
    }

    .hero-fade-in {
        opacity: 0;
        animation: hero-fade-in-up var(--motion-duration-heading) var(--motion-ease-standard)
            forwards;
    }

    @keyframes hero-fade-in-up {
        from {
            opacity: 0;
            transform: translateY(1.625rem);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .hero-fade-in {
            animation: none;
            opacity: 1;
        }
    }

    @media (max-width: 1023px) {
        .reset-password-hero {
            min-height: var(--section-height-100);
            margin-top: 0;
        }
    }

    @media (max-width: 767px) {
        .reset-password-hero {
            padding: var(--space-11) var(--content-margin-inline) var(--space-9);
        }

        .reset-password-hero__card {
            padding: var(--space-6);
        }
    }
</style>

<script>
    import { ApiClientError, postJson } from '../../lib/forms/api';

    const form = document.querySelector<HTMLFormElement>('.reset-password-hero__form');
    const passwordInput = form?.querySelector<HTMLInputElement>('input[name="password"]');
    const confirmInput = form?.querySelector<HTMLInputElement>('input[name="confirmPassword"]');
    const submitButton = form?.querySelector<HTMLButtonElement>('.reset-password-hero__submit');
    const errorElement = form?.querySelector<HTMLElement>('[data-reset-password-error]');
    const successElement = document.querySelector<HTMLElement>('[data-reset-password-success]');
    const backElement = document.querySelector<HTMLElement>('[data-reset-password-back]');
    const titleElement = document.querySelector<HTMLElement>('[data-reset-password-title]');
    const query = new URLSearchParams(window.location.search);
    const email = query.get('u') || query.get('email') || '';
    const code = query.get('code') || '';

    if (query.has('c') && titleElement?.dataset.createTitle) {
        titleElement.textContent = titleElement.dataset.createTitle;
    }

    document
        .querySelectorAll<HTMLAnchorElement>('.navbar-language a[data-lang]')
        .forEach((link) => {
            const target = new URL(link.href, window.location.origin);
            target.search = window.location.search;
            link.href = target.toString();
        });

    const showError = (message: string) => {
        if (!errorElement) return;
        errorElement.textContent = message;
        errorElement.hidden = false;
    };

    const clearError = () => {
        if (!errorElement) return;
        errorElement.textContent = '';
        errorElement.hidden = true;
    };

    if ((!email || !code) && form && submitButton) {
        showError(form.dataset.errorInvalidToken || 'This password-reset link is invalid.');
        submitButton.disabled = true;
    }

    form?.addEventListener('submit', async (event) => {
        event.preventDefault();

        if (!form.checkValidity()) {
            form.reportValidity();
            return;
        }

        if (!passwordInput || !confirmInput || !submitButton || !email || !code) return;

        clearError();

        if (passwordInput.value !== confirmInput.value) {
            showError(form.dataset.errorMismatch || 'The passwords do not match.');
            return;
        }

        submitButton.disabled = true;
        submitButton.setAttribute('aria-busy', 'true');

        try {
            await postJson('/api/auth/reset-password', {
                email,
                password: passwordInput.value,
                code,
            });

            form.hidden = true;
            if (backElement) backElement.hidden = true;
            if (successElement) successElement.hidden = false;
        } catch (error) {
            console.error('Password reset failed.', error);

            let message = form.dataset.errorGeneric || 'Unable to reset the password.';

            if (error instanceof ApiClientError) {
                if (error.status === 429) {
                    message = form.dataset.errorRateLimit || message;
                } else if (error.errorCode === 'invalid_token') {
                    message = form.dataset.errorInvalidToken || message;
                } else if (error.errors.length > 0) {
                    const validationMessages: Record<string, string | undefined> = {
                        password_length: form.dataset.errorPasswordLength,
                        password_case: form.dataset.errorPasswordCase,
                        password_symbol: form.dataset.errorPasswordSymbol,
                    };

                    message = error.errors
                        .map((validationError) => validationMessages[validationError])
                        .filter((value): value is string => Boolean(value))
                        .join(' ');
                }
            }

            showError(message || form.dataset.errorGeneric || 'Unable to reset the password.');
        } finally {
            submitButton.disabled = false;
            submitButton.removeAttribute('aria-busy');
        }
    });
</script>
