---
// src/components/analytic-tools/AnalyticToolsForecastingToolSection.astro
// Duplicated from TrendingToolSection — Forecasting Tool variant
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { t } from '../../lib/i18n/t';
import { icons } from '../../lib/icons/registry';
import ProductPill from '../shared/ProductPill.astro';
import EyebrowIcon from '../shared/EyebrowIcon.astro';

interface Props {
    locale: Locale;
    copy: CMSDictionary;
}

const { locale, copy } = Astro.props as Props;
const base = import.meta.env.BASE_URL;
---

<section class="forecasting-tool-section" id="forecasting-tool">
    <!-- row 1: image (8 cols) + content (4 cols) -->
    <div class="forecasting-tool__visual content-fly-in">
        <img
            class="forecasting-tool__screen"
            src={`${base}images/tools/forecasting-tool.webp`}
            alt={locale === 'fr' ? "Aperçu de l'outil Prévisions" : 'Forecasting Tool preview'}
            loading="lazy"
        />
    </div>

    <div class="forecasting-tool__content">
        <div class="forecasting-tool__header">
            <div class="forecasting-tool__title-row heading-fly-in">
                <img
                    class="icon-3xl forecasting-tool__title-icon"
                    src={`${base}${icons.tool.forecast}`}
                    alt=""
                    aria-hidden="true"
                    loading="lazy"
                />
                <h2 data-copy-key="tool_3_title">
                    {t(copy, 'tool_3_title', locale, 'Forecasting Tool')}
                </h2>
            </div>
            <div class="forecasting-tool__pills content-fly-in">
                <ProductPill variant="mtm18plus" size="big" copy={copy} locale={locale} />
            </div>
            <p
                class="text-body-p1 forecasting-tool__description content-fly-in"
                data-copy-key="tool_3_description"
            >
                {
                    t(
                        copy,
                        'tool_3_description',
                        locale,
                        'Project future technology adoption and model scenarios. Know where things are headed in the next 1 to 5 years.'
                    )
                }
            </p>
        </div>
    </div>

    <!-- row 2: 3 feature cards -->
    <div class="forecasting-tool__features">
        <div class="forecasting-tool__feature forecasting-tool__feature--blue card-fly-in">
            <EyebrowIcon
                iconSrc={`${base}${icons.gen.sampleCoverage}`}
                label={t(copy, 'forecasting_feature_1_eyebrow', locale, 'What You Project')}
                copyKey="forecasting_feature_1_eyebrow"
                variant="white"
            />
            <div class="forecasting-tool__feature-content">
                <p
                    class="text-body-p1 forecasting-tool__feature-title"
                    data-copy-key="forecasting_feature_1_title"
                >
                    {
                        t(
                            copy,
                            'forecasting_feature_1_title',
                            locale,
                            'Where technology adoption is heading and when'
                        )
                    }
                </p>
                <p
                    class="text-body-p2 forecasting-tool__feature-desc"
                    data-copy-key="forecasting_feature_1_description"
                >
                    {
                        t(
                            copy,
                            'forecasting_feature_1_description',
                            locale,
                            "Multi-year projections built on MTM's nationally representative dataset and refined by industry experts."
                        )
                    }
                </p>
            </div>
        </div>

        <div class="forecasting-tool__feature forecasting-tool__feature--teal card-fly-in">
            <EyebrowIcon
                iconSrc={`${base}${icons.gen.surveyDesign}`}
                label={t(copy, 'forecasting_feature_2_eyebrow', locale, 'What You Model')}
                copyKey="forecasting_feature_2_eyebrow"
                variant="white"
            />
            <div class="forecasting-tool__feature-content">
                <p
                    class="text-body-p1 forecasting-tool__feature-title"
                    data-copy-key="forecasting_feature_2_title"
                >
                    {
                        t(
                            copy,
                            'forecasting_feature_2_title',
                            locale,
                            'Key technologies like podcasts, AI tool usage, paid TV subscriptions and more'
                        )
                    }
                </p>
                <p
                    class="text-body-p2 forecasting-tool__feature-desc"
                    data-copy-key="forecasting_feature_2_description"
                >
                    {
                        t(
                            copy,
                            'forecasting_feature_2_description',
                            locale,
                            'Explore a variety of different media and technology within a few clicks.'
                        )
                    }
                </p>
            </div>
        </div>

        <div class="forecasting-tool__feature forecasting-tool__feature--purple card-fly-in">
            <EyebrowIcon
                iconSrc={`${base}${icons.gen.sampleComposition}`}
                label={t(copy, 'forecasting_feature_3_eyebrow', locale, 'What You Compare')}
                copyKey="forecasting_feature_3_eyebrow"
                variant="white"
            />
            <div class="forecasting-tool__feature-content">
                <p
                    class="text-body-p1 forecasting-tool__feature-title"
                    data-copy-key="forecasting_feature_3_title"
                >
                    {
                        t(
                            copy,
                            'forecasting_feature_3_title',
                            locale,
                            'National, Anglophone and Francophone markets'
                        )
                    }
                </p>
                <p
                    class="text-body-p2 forecasting-tool__feature-desc"
                    data-copy-key="forecasting_feature_3_description"
                >
                    {
                        t(
                            copy,
                            'forecasting_feature_3_description',
                            locale,
                            'Find out how these markets align or differ with an eye toward the future.'
                        )
                    }
                </p>
            </div>
        </div>
    </div>
</section>

<style>
    .forecasting-tool-section {
        width: 100%;
        scroll-margin-top: calc(var(--navbar-height) + 4.25rem + var(--space-3));
        background: var(--surface-white);
        padding: var(--section-pad-block) var(--content-margin-inline);
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        column-gap: var(--layout-card-gap);
        row-gap: var(--section-header-gap);
        align-items: start;
    }

    .forecasting-tool__visual {
        grid-column: span 8;
        background: var(--surface-blue);
        border-radius: var(--radius-m);
        padding: var(--space-10);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .forecasting-tool__content {
        grid-column: span 4;
        display: flex;
        flex-direction: column;
        gap: var(--space-5);
    }

    .forecasting-tool__header {
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
    }

    .forecasting-tool__title-row {
        display: flex;
        align-items: center;
        gap: var(--space-2);
    }

    .forecasting-tool__pills {
        display: flex;
        gap: var(--space-4);
        flex-wrap: wrap;
    }

    .forecasting-tool__description {
        margin: 0;
        color: var(--text-primary);
    }

    .forecasting-tool__screen {
        width: 85%;
        border-radius: var(--radius-s);
        box-shadow: var(--shadow-card);
        display: block;
    }

    .forecasting-tool__features {
        grid-column: span 12;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: var(--layout-card-gap);
    }

    .forecasting-tool__feature {
        align-self: stretch;
        display: flex;
        flex-direction: column;
        gap: var(--space-8);
        padding: var(--card-pad);
        border-radius: var(--radius-m);
    }

    .forecasting-tool__feature--blue {
        background: #e8f3fd;
    }
    .forecasting-tool__feature--teal {
        background: #e8f7f5;
    }
    .forecasting-tool__feature--purple {
        background: #f7f4ff;
    }

    .forecasting-tool__feature-content {
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
    }

    .forecasting-tool__feature-title {
        margin: 0;
        color: var(--text-primary);
    }

    .forecasting-tool__feature-desc {
        margin: 0;
        color: var(--text-secondary);
    }

    @media (max-width: 1125px) {
        .forecasting-tool-section {
            grid-template-columns: 1fr;
        }

        .forecasting-tool__visual,
        .forecasting-tool__content,
        .forecasting-tool__features {
            grid-column: auto;
        }

        .forecasting-tool__features {
            grid-template-columns: 1fr;
        }

        /* DOM order is visual-then-content (desktop places the image on the
           left); reorder to content-first when stacked so title precedes
           image, matching Trending Tool's stacked order. */
        .forecasting-tool__content {
            order: -1;
        }

        .forecasting-tool__visual {
            margin-inline: calc(-1 * var(--content-margin-inline));
            border-radius: 0;
        }
    }

    @media (max-width: 767px) {
        .forecasting-tool-section {
            padding: var(--section-pad-block) var(--content-margin-inline);
        }

        .forecasting-tool__content {
            gap: var(--space-6);
        }

        .forecasting-tool__visual {
            padding: var(--space-9) var(--space-4);
        }

        .forecasting-tool__feature {
            padding: var(--space-4);
        }
    }

    .heading-fly-in {
        opacity: 0;
        transform: translateY(1.625rem);
        transition:
            opacity var(--motion-duration-heading) ease,
            transform var(--motion-duration-heading) var(--motion-ease-standard);
    }

    .heading-fly-in.is-visible {
        opacity: 1;
        transform: translateY(0);
    }

    .content-fly-in {
        opacity: 0;
        transform: translateY(1.625rem);
        transition:
            opacity var(--motion-duration-heading) ease,
            transform var(--motion-duration-heading) var(--motion-ease-standard);
    }

    .content-fly-in.is-visible {
        opacity: 1;
        transform: translateY(0);
    }

    /* Per-card entrance, staggered — same spring/duration/delay as the
       homepage Solutions cards (.solutions-card-fly-in). */
    .card-fly-in {
        opacity: 0;
        transform: translateY(1.625rem);
        transition:
            opacity var(--motion-duration-card) cubic-bezier(0.22, 1, 0.36, 1),
            transform var(--motion-duration-card) cubic-bezier(0.22, 1, 0.36, 1);
    }

    .card-fly-in.is-visible {
        opacity: 1;
        transform: translateY(0);
    }
</style>

<script>
    // Every fly-in element observes itself, not the (much larger) section —
    // an IntersectionObserver threshold is a fraction of the target's own
    // area, so watching the whole tall section skews the trigger point for
    // elements that don't span its full height (the heading could end up
    // firing later than the cards below it, since 15% of a big section is a
    // lot more scroll than 20% of one small card).
    document.querySelectorAll<HTMLElement>('.forecasting-tool-section').forEach((section) => {
        const heading = section.querySelector<HTMLElement>('.heading-fly-in');
        if (heading) {
            const headingObserver = new IntersectionObserver(
                ([entry]) => {
                    if (entry.isIntersecting) {
                        heading.classList.add('is-visible');
                        headingObserver.disconnect();
                    }
                },
                { threshold: 0.15 }
            );
            headingObserver.observe(heading);
        }

        const contentObserver = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('is-visible');
                        contentObserver.unobserve(entry.target);
                    }
                });
            },
            { threshold: 0.15 }
        );
        section.querySelectorAll<HTMLElement>('.content-fly-in').forEach((el) => {
            contentObserver.observe(el);
        });

        // Cards sit in a single row (desktop) that would all cross a
        // per-card threshold together, so trigger off the row itself and
        // keep the JS stagger between cards.
        const cardsRow = section.querySelector<HTMLElement>('.forecasting-tool__features');
        const cards = section.querySelectorAll<HTMLElement>('.card-fly-in');
        if (cardsRow && cards.length) {
            const cardObserver = new IntersectionObserver(
                ([entry]) => {
                    if (entry.isIntersecting) {
                        cards.forEach((card, i) => {
                            setTimeout(() => card.classList.add('is-visible'), i * 250);
                        });
                        cardObserver.disconnect();
                    }
                },
                { threshold: 0.2 }
            );
            cardObserver.observe(cardsRow);
        }
    });
</script>

<style is:global>
    /* Switch big pills to small size at mobile — crosses component boundary */
    @media (max-width: 767px) {
        .forecasting-tool__pills .product-pill--big {
            padding: var(--space-2) var(--space-4);
            font-size: var(--fs-label-xs);
        }
    }
</style>
