---
// src/components/analytic-tools/AnalyticToolsTrendingToolSection.astro
// Figma node: 2:27512 — "Trending Tool section"
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { t } from '../../lib/i18n/t';
import { icons } from '../../lib/icons/registry';
import ProductPill from '../shared/ProductPill.astro';
import EyebrowIcon from '../shared/EyebrowIcon.astro';

interface Props {
    locale: Locale;
    copy: CMSDictionary;
}

const { locale, copy } = Astro.props as Props;
const base = import.meta.env.BASE_URL;
---

<section class="trending-tool-section" id="trending-tool">
    <!-- row 1: content (4 cols) + image (8 cols) -->
    <div class="trending-tool__content">
        <div class="trending-tool__header">
            <div class="trending-tool__title-row heading-fly-in">
                <img
                    class="icon-3xl trending-tool__title-icon"
                    src={`${base}${icons.tool.trending}`}
                    alt=""
                    aria-hidden="true"
                    loading="lazy"
                />
                <h2 data-copy-key="tool_2_title">
                    {t(copy, 'tool_2_title', locale, 'Trending Tool')}
                </h2>
            </div>
            <div class="trending-tool__pills content-fly-in">
                <ProductPill variant="mtm18plus" size="big" copy={copy} locale={locale} />
                <ProductPill variant="junior" size="big" copy={copy} locale={locale} />
            </div>
            <p
                class="text-body-p1 trending-tool__description content-fly-in"
                data-copy-key="tool_2_description"
            >
                {
                    t(
                        copy,
                        'tool_2_description',
                        locale,
                        '20+ years of data all in one place. Find all you need to know about past and present media technology with the Trending Tool.'
                    )
                }
            </p>
        </div>
    </div>

    <div class="trending-tool__visual content-fly-in">
        <img
            class="trending-tool__screen"
            src={`${base}images/tools/analytic-tools/trending-tool.webp`}
            alt={locale === 'fr' ? "Aperçu de l'outil Tendances" : 'Trending Tool preview'}
            loading="lazy"
        />
    </div>

    <!-- row 2: 3 feature cards -->
    <div class="trending-tool__features">
        <div class="trending-tool__feature trending-tool__feature--blue card-fly-in">
            <EyebrowIcon
                iconSrc={`${base}${icons.gen.sampleCoverage}`}
                label={t(copy, 'trending_feature_1_eyebrow', locale, 'What You See')}
                copyKey="trending_feature_1_eyebrow"
                variant="white"
            />
            <div class="trending-tool__feature-content">
                <p
                    class="text-body-p1 trending-tool__feature-title"
                    data-copy-key="trending_feature_1_title"
                >
                    {
                        t(
                            copy,
                            'trending_feature_1_title',
                            locale,
                            'Which technologies are rising or losing ground'
                        )
                    }
                </p>
                <p
                    class="text-body-p2 trending-tool__feature-desc"
                    data-copy-key="trending_feature_1_description"
                >
                    {
                        t(
                            copy,
                            'trending_feature_1_description',
                            locale,
                            'Track adoption curves across media types. Know which platforms are winning the streaming wars when it comes to your target audiences.'
                        )
                    }
                </p>
            </div>
        </div>

        <div class="trending-tool__feature trending-tool__feature--teal card-fly-in">
            <EyebrowIcon
                iconSrc={`${base}${icons.gen.surveyDesign}`}
                label={t(copy, 'trending_feature_2_eyebrow', locale, 'What You Track')}
                copyKey="trending_feature_2_eyebrow"
                variant="white"
            />
            <div class="trending-tool__feature-content">
                <p
                    class="text-body-p1 trending-tool__feature-title"
                    data-copy-key="trending_feature_2_title"
                >
                    {
                        t(
                            copy,
                            'trending_feature_2_title',
                            locale,
                            'Where your audiences are heading towards'
                        )
                    }
                </p>
                <p
                    class="text-body-p2 trending-tool__feature-desc"
                    data-copy-key="trending_feature_2_description"
                >
                    {
                        t(
                            copy,
                            'trending_feature_2_description',
                            locale,
                            'Multiple years of quarterly data means you can show momentum, not just a snapshot. Bring a trajectory to the next client meeting.'
                        )
                    }
                </p>
            </div>
        </div>

        <div class="trending-tool__feature trending-tool__feature--purple card-fly-in">
            <EyebrowIcon
                iconSrc={`${base}${icons.gen.sampleComposition}`}
                label={t(copy, 'trending_feature_3_eyebrow', locale, 'What You Compare')}
                copyKey="trending_feature_3_eyebrow"
                variant="white"
            />
            <div class="trending-tool__feature-content">
                <p
                    class="text-body-p1 trending-tool__feature-title"
                    data-copy-key="trending_feature_3_title"
                >
                    {
                        t(
                            copy,
                            'trending_feature_3_title',
                            locale,
                            'How different regions and languages are moving'
                        )
                    }
                </p>
                <p
                    class="text-body-p2 trending-tool__feature-desc"
                    data-copy-key="trending_feature_3_description"
                >
                    {
                        t(
                            copy,
                            'trending_feature_3_description',
                            locale,
                            "Quebec and Ontario don't always move together. Compare Anglophone and Francophone audiences side by side across any trend."
                        )
                    }
                </p>
            </div>
        </div>
    </div>
</section>

<style>
    .trending-tool-section {
        width: 100%;
        scroll-margin-top: calc(var(--navbar-height) + 4.25rem + var(--space-3));
        background: var(--surface-white);
        padding-block-start: var(--section-pad-block);
        padding-block-end: var(--space-8);
        padding-inline: var(--content-margin-inline);
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        column-gap: var(--layout-card-gap);
        row-gap: var(--section-header-gap);
        align-items: start;
    }

    .trending-tool__content {
        grid-column: span 4;
        display: flex;
        flex-direction: column;
        gap: var(--space-5);
    }

    .trending-tool__visual {
        grid-column: span 8;
        background: var(--surface-blue);
        border-radius: var(--radius-m);
        padding: var(--space-10);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .trending-tool__header {
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
    }

    .trending-tool__title-row {
        display: flex;
        align-items: center;
        gap: var(--space-2);
    }

    .trending-tool__pills {
        display: flex;
        gap: var(--space-4);
        flex-wrap: wrap;
    }

    .trending-tool__description {
        margin: 0;
        color: var(--text-primary);
    }

    .trending-tool__screen {
        width: 85%;
        border-radius: var(--radius-s);
        box-shadow: var(--shadow-card);
        display: block;
    }

    .trending-tool__features {
        grid-column: span 12;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: var(--layout-card-gap);
    }

    .trending-tool__feature {
        align-self: stretch;
        display: flex;
        flex-direction: column;
        gap: var(--space-8);
        padding: var(--card-pad);
        border-radius: var(--radius-m);
    }

    .trending-tool__feature--blue {
        background: #e8f3fd;
    }
    .trending-tool__feature--teal {
        background: #e8f7f5;
    }
    .trending-tool__feature--purple {
        background: #f7f4ff;
    }

    .trending-tool__feature-content {
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
    }

    .trending-tool__feature-title {
        margin: 0;
        color: var(--text-primary);
    }

    .trending-tool__feature-desc {
        margin: 0;
        color: var(--text-secondary);
    }

    @media (max-width: 1125px) {
        .trending-tool-section {
            grid-template-columns: 1fr;
        }

        .trending-tool__content,
        .trending-tool__visual,
        .trending-tool__features {
            grid-column: auto;
        }

        .trending-tool__features {
            grid-template-columns: 1fr;
        }

        .trending-tool__visual {
            margin-inline: calc(-1 * var(--content-margin-inline));
            border-radius: 0;
        }
    }

    @media (max-width: 767px) {
        .trending-tool-section {
            padding: var(--section-pad-block) var(--content-margin-inline);
        }

        .trending-tool__content {
            gap: var(--space-6);
        }

        .trending-tool__visual {
            padding: var(--space-9) var(--space-4);
        }

        .trending-tool__feature {
            padding: var(--space-4);
        }
    }

    /* Per-card entrance, staggered — same spring/duration as the
       homepage Solutions cards (.solutions-card-fly-in). */
</style>

<script>
    // Every fly-in element observes itself, not the (much larger) section —
    // an IntersectionObserver threshold is a fraction of the target's own
    // area, so watching the whole tall section skews the trigger point for
    // elements that don't span its full height.
    document.querySelectorAll<HTMLElement>('.trending-tool-section').forEach((section) => {
        const heading = section.querySelector<HTMLElement>('.heading-fly-in');
        if (heading) {
            const headingObserver = new IntersectionObserver(
                ([entry]) => {
                    if (entry.isIntersecting) {
                        heading.classList.add('is-visible');
                        headingObserver.disconnect();
                    }
                },
                { threshold: 0.15 }
            );
            headingObserver.observe(heading);
        }

        const contentObserver = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('is-visible');
                        contentObserver.unobserve(entry.target);
                    }
                });
            },
            { threshold: 0.15 }
        );
        section.querySelectorAll<HTMLElement>('.content-fly-in').forEach((el) => {
            contentObserver.observe(el);
        });

        // Cards sit in a single row (desktop) that would all cross a
        // per-card threshold together, so trigger off the row itself and
        // keep the JS stagger between cards.
        const cardsRow = section.querySelector<HTMLElement>('.trending-tool__features');
        const cards = section.querySelectorAll<HTMLElement>('.card-fly-in');
        if (cardsRow && cards.length) {
            const cardObserver = new IntersectionObserver(
                ([entry]) => {
                    if (entry.isIntersecting) {
                        cards.forEach((card, i) => {
                            setTimeout(() => card.classList.add('is-visible'), i * 250);
                        });
                        cardObserver.disconnect();
                    }
                },
                { threshold: 0.2 }
            );
            cardObserver.observe(cardsRow);
        }
    });
</script>

<style is:global>
    /* Switch big pills to small size at mobile — crosses component boundary */
    @media (max-width: 767px) {
        .trending-tool__pills .product-pill--big {
            padding: var(--space-2) var(--space-4);
            font-size: var(--fs-label-xs);
        }
    }
</style>
