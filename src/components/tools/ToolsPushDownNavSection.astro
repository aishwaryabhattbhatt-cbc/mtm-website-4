---
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { t } from '../../lib/i18n/t';

interface Props {
    locale: Locale;
    copy: CMSDictionary;
}

const { locale, copy } = Astro.props;

const tabs = [
    { number: '01', key: 'tool_1_title', fallback: 'Data Analysis Tool', id: 'data-analysis-tool' },
    { number: '02', key: 'tool_2_title', fallback: 'Trending Tool', id: 'trending-tool' },
    { number: '03', key: 'tool_3_title', fallback: 'Forecasting Tool', id: 'forecasting-tool' },
];
---

<nav
    class="push-down-nav"
    aria-label={locale === 'fr' ? 'Navigation des outils' : 'Tool navigation'}
>
    <div class="push-down-nav__row">
        <button
            class="push-down-nav__chevron push-down-nav__chevron--left"
            type="button"
            aria-label={locale === 'fr' ? 'Faire défiler vers la gauche' : 'Scroll tabs left'}
        >
            <span class="icon-control push-down-nav__chevron-icon" aria-hidden="true">
                <svg
                    width="100%"
                    height="100%"
                    viewBox="0 0 20 20"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                >
                    <path
                        d="M5 7.5L10 12.5L15 7.5"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"></path>
                </svg>
            </span>
        </button>
        <div class="push-down-nav__tabs">
            {
                tabs.map((tab, i) => (
                    <button
                        class={`push-down-nav__tab ${i === 0 ? 'text-body-p2-bold-upper push-down-nav__tab--active' : 'text-body-p2-upper'}`}
                        data-tab-id={tab.id}
                        aria-pressed={i === 0 ? 'true' : 'false'}
                    >
                        <span class="push-down-nav__number">{tab.number}</span>
                        <span class="push-down-nav__label">
                            {t(copy, tab.key, locale, tab.fallback)}
                        </span>
                    </button>
                ))
            }
        </div>
        <button
            class="push-down-nav__chevron push-down-nav__chevron--right"
            type="button"
            aria-label={locale === 'fr' ? 'Faire défiler vers la droite' : 'Scroll tabs right'}
        >
            <span class="icon-control push-down-nav__chevron-icon" aria-hidden="true">
                <svg
                    width="100%"
                    height="100%"
                    viewBox="0 0 20 20"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                >
                    <path
                        d="M5 7.5L10 12.5L15 7.5"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"></path>
                </svg>
            </span>
        </button>
    </div>
</nav>

<style>
    .push-down-nav {
        position: sticky;
        top: var(--navbar-height);
        z-index: 10;
        width: 100%;
        background: var(--surface-white);
        box-shadow: var(--shadow-e1);
        padding: var(--space-4) var(--space-3) 0;
        transition:
            opacity 0.2s,
            visibility 0.2s;
    }

    .push-down-nav--static {
        position: static;
        box-shadow: none;
    }

    .push-down-nav--hidden {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
    }

    .push-down-nav__row {
        display: flex;
        align-items: center;
        gap: var(--space-2);
    }

    /* Chevrons sit near the true edge (nav's own --space-3 padding above);
       tabs keep their own inline padding so the first/last tab still aligns
       with --content-margin-inline, matching the rest of the page's content. */
    .push-down-nav__tabs {
        display: flex;
        align-items: center;
        min-width: 0;
        padding-inline: calc(var(--content-margin-inline) - var(--space-3));
        scroll-padding-inline-start: calc(var(--content-margin-inline) - var(--space-3));
    }

    .push-down-nav__chevron {
        display: none;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        padding: 0;
        background: transparent;
        border: none;
        color: var(--text-primary);
        cursor: pointer;
    }

    .push-down-nav__chevron--visible {
        display: inline-flex;
    }

    .push-down-nav__chevron-icon svg {
        width: 100%;
        height: 100%;
        display: block;
    }

    .push-down-nav__chevron--left .push-down-nav__chevron-icon {
        transform: rotate(90deg);
    }

    .push-down-nav__chevron--right .push-down-nav__chevron-icon {
        transform: rotate(-90deg);
    }

    .push-down-nav__chevron:disabled {
        opacity: 0.3;
        cursor: default;
        pointer-events: none;
    }

    .push-down-nav__chevron:focus-visible {
        outline: var(--stroke-2) solid var(--border-primary);
        outline-offset: var(--space-1);
    }

    .push-down-nav__tab {
        display: flex;
        align-items: center;
        gap: var(--space-3);
        padding: var(--space-3) var(--space-6);
        background: transparent;
        border: none;
        border-bottom: var(--stroke-2) solid transparent;
        cursor: pointer;
        color: var(--neutral-grey-2);
        transition:
            color 0.2s,
            border-bottom-color 0.2s;
    }

    .push-down-nav__tab--active {
        border-bottom-color: var(--text-primary);
        color: var(--text-primary);
    }

    .push-down-nav__tab:focus-visible {
        outline: var(--stroke-2) solid var(--border-primary);
        outline-offset: var(--space-1);
    }

    .push-down-nav__number,
    .push-down-nav__label {
        white-space: nowrap;
    }

    @media (max-width: 767px) {
        .push-down-nav__tabs {
            overflow-x: auto;
            scrollbar-width: none;
        }

        .push-down-nav__tabs::-webkit-scrollbar {
            display: none;
        }

        .push-down-nav__tab {
            padding: var(--space-3) var(--space-4);
            gap: var(--space-2);
        }
    }

    @media (max-width: 480px) {
        .push-down-nav__number {
            display: none;
        }
    }
</style>

<script>
    const nav = document.querySelector('.push-down-nav');
    if (nav) {
        const buttons = nav.querySelectorAll<HTMLButtonElement>('.push-down-nav__tab');
        const sectionIds = ['data-analysis-tool', 'trending-tool', 'forecasting-tool'];
        // Support both V1 (#yourdata) and V2 (#yourdata-v2) id
        const yourDataSection =
            document.getElementById('yourdata-v2') || document.getElementById('yourdata');
        const tabsEl = nav.querySelector<HTMLElement>('.push-down-nav__tabs');
        const chevronLeft = nav.querySelector<HTMLButtonElement>('.push-down-nav__chevron--left');
        const chevronRight = nav.querySelector<HTMLButtonElement>('.push-down-nav__chevron--right');

        // Pre-calculate the absolute scroll threshold at which yourdata reaches the nav.
        // We use offsetTop (stable, not affected by sticky) so toggling --static
        // never creates a measurement feedback loop.
        let hideThreshold = Infinity;
        const calcHideThreshold = () => {
            if (!yourDataSection) return;
            const navbarEl = document.querySelector<HTMLElement>('.navbar');
            const navbarHeight = navbarEl ? navbarEl.getBoundingClientRect().height : 0;
            const navHeight = nav.getBoundingClientRect().height;
            hideThreshold = yourDataSection.offsetTop - navbarHeight - navHeight;
        };
        calcHideThreshold();
        window.addEventListener('resize', calcHideThreshold);

        // Chevrons are hidden entirely when the tabs fit without scrolling, and
        // each one disables itself at the scroll boundary it points toward.
        const updateChevrons = () => {
            if (!tabsEl || !chevronLeft || !chevronRight) return;
            const isScrollable = tabsEl.scrollWidth > tabsEl.clientWidth + 1;
            chevronLeft.classList.toggle('push-down-nav__chevron--visible', isScrollable);
            chevronRight.classList.toggle('push-down-nav__chevron--visible', isScrollable);
            if (!isScrollable) return;
            chevronLeft.disabled = tabsEl.scrollLeft <= 0;
            chevronRight.disabled =
                tabsEl.scrollLeft + tabsEl.clientWidth >= tabsEl.scrollWidth - 1;
        };

        const scrollTabsBy = (direction: 1 | -1) => {
            if (!tabsEl) return;
            tabsEl.scrollBy({ left: direction * tabsEl.clientWidth * 0.8, behavior: 'smooth' });
        };

        chevronLeft?.addEventListener('click', () => scrollTabsBy(-1));
        chevronRight?.addEventListener('click', () => scrollTabsBy(1));
        tabsEl?.addEventListener('scroll', updateChevrons, { passive: true });
        window.addEventListener('resize', updateChevrons);
        updateChevrons();

        const scrollTabIntoView = (btn: HTMLButtonElement) => {
            if (!tabsEl) return;
            const scrollPadding =
                parseFloat(getComputedStyle(tabsEl).scrollPaddingInlineStart) || 0;
            const btnLeft = btn.offsetLeft;
            const btnRight = btnLeft + btn.offsetWidth;
            const visibleLeft = tabsEl.scrollLeft + scrollPadding;
            const visibleRight = tabsEl.scrollLeft + tabsEl.clientWidth;
            if (btnLeft < visibleLeft) {
                tabsEl.scrollTo({ left: btnLeft - scrollPadding, behavior: 'smooth' });
            } else if (btnRight > visibleRight) {
                tabsEl.scrollTo({ left: btnRight - tabsEl.clientWidth, behavior: 'smooth' });
            }
        };

        const setActiveTab = (index: number) => {
            buttons.forEach((b, i) => {
                const isActive = i === index;
                b.classList.toggle('push-down-nav__tab--active', isActive);
                b.classList.toggle('text-body-p2-bold-upper', isActive);
                b.classList.toggle('text-body-p2-upper', !isActive);
                b.setAttribute('aria-pressed', isActive ? 'true' : 'false');
            });
            const activeBtn = buttons[index];
            if (activeBtn) scrollTabIntoView(activeBtn);
        };

        let clickScrolling = false;
        let clickScrollTimer = 0;

        const spaceS =
            parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--space-5')) *
            16;

        const onScroll = () => {
            const pastThreshold = window.scrollY >= hideThreshold;

            // Stop sticky and hide when the yourdata section reaches the nav
            nav.classList.toggle('push-down-nav--static', pastThreshold);
            nav.classList.toggle('push-down-nav--hidden', pastThreshold);

            // Skip scroll-spy while a click-triggered scroll is in flight
            if (clickScrolling) return;

            // Activate the tab whose section is closest to (and at/past) the push-down nav's bottom.
            // Use the tab nav's bottom edge (not just navbar), and add spaceS lookahead to match
            // the scroll offset applied during click-to-section navigation.
            const navBottom = nav.getBoundingClientRect().bottom;
            let activeIndex = 0;
            sectionIds.forEach((id, i) => {
                const el = document.getElementById(id);
                if (el && el.getBoundingClientRect().top <= navBottom + spaceS) {
                    activeIndex = i;
                }
            });
            setActiveTab(activeIndex);
        };

        window.addEventListener('scroll', onScroll, { passive: true });
        // Clear the flag when the browser finishes a smooth scroll
        window.addEventListener(
            'scrollend',
            () => {
                clickScrolling = false;
            },
            { passive: true }
        );
        onScroll();

        // If the page loaded with a hash matching one of the sections, activate
        // that tab directly — scroll-spy runs before the browser anchor-scrolls
        // so it always defaults to tab 01 on initial load.
        const hashIndex = sectionIds.indexOf(window.location.hash.slice(1));
        if (hashIndex !== -1) setActiveTab(hashIndex);

        const scrollToSection = (target: HTMLElement, behavior: ScrollBehavior) => {
            // Measure the rendered navbar directly rather than parsing the
            // --navbar-height custom property: parseFloat() strips units, and
            // that value switches from px (desktop) to rem (tablet/mobile),
            // silently under-counting the offset below 1024px.
            const navbarEl = document.querySelector<HTMLElement>('.navbar');
            const navbarHeight = navbarEl ? navbarEl.getBoundingClientRect().height : 0;
            const tabNavHeight = nav.getBoundingClientRect().height;
            const targetTop =
                target.getBoundingClientRect().top + window.scrollY - navbarHeight - tabNavHeight;
            window.scrollTo({ top: targetTop, behavior });
        };

        buttons.forEach((btn, clickedIndex) => {
            btn.addEventListener('click', () => {
                const targetId = btn.getAttribute('data-tab-id');
                if (targetId) {
                    const target = document.getElementById(targetId);
                    if (target) {
                        setActiveTab(clickedIndex);

                        clickScrolling = true;
                        clearTimeout(clickScrollTimer);
                        clickScrollTimer = window.setTimeout(() => {
                            clickScrolling = false;
                        }, 1000);

                        scrollToSection(target, 'smooth');
                    }
                }
            });
        });
    }
</script>
