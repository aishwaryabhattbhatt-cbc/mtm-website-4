---
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { t } from '../../lib/i18n/t';
import { icons } from '../../lib/icons/registry';
import CarouselNavArrows from '../shared/CarouselNavArrows.astro';
import EyebrowIcon from '../shared/EyebrowIcon.astro';

interface Props {
    locale: Locale;
    copy: CMSDictionary;
}

const { locale, copy } = Astro.props;
const base = import.meta.env.BASE_URL;

const features = [
    {
        pillKey: 'dat_feature_1_title',
        titleKey: 'dat_feature_1_label',
        descKey: 'dat_feature_1_description',
        pillFb: 'Query Building',
        titleFb: 'Easily create a custom query',
        descFb: 'Select query parameters, drag variables from the master list into output rows and columns. What you arrange is exactly what you get. No SQL or python, no analyst handoff, no waiting. Go from brief to cross-tab in minutes.',
        icon: icons.tool.queryParameters,
        image: 'images/tools/dat/dat-query.webp',
        videoSrc: 'videos/dat-compressed/tools-query.mp4',
        coverSrc: 'videos/dat-compressed/tools-query-cover.jpg',
    },
    {
        pillKey: 'dat_feature_2_title',
        titleKey: 'dat_feature_2_label',
        descKey: 'dat_feature_2_description',
        pillFb: 'Variables',
        titleFb: 'Large, robust data sets at your fingertips',
        descFb: 'Thousands of variables covering demographics, device ownership, media habits, platform usage — all in a single searchable list by categories.',
        icon: icons.gen.multipleVariables,
        image: 'images/tools/dat/dat-select-variables.webp',
        videoSrc: 'videos/dat-compressed/tools-select-variables.mp4',
        coverSrc: 'videos/dat-compressed/tools-select-variables-cover.jpg',
    },
    {
        pillKey: 'dat_feature_3_title',
        titleKey: 'dat_feature_3_label',
        descKey: 'dat_feature_3_description',
        pillFb: 'Filters',
        titleFb: 'Refine your query with Quick or Additional Filters',
        descFb: 'Narrow your results by age, gender or region with Quick Filters or apply any variable in the tool as a filter using Additional Filters.',
        icon: icons.tool.datFiltersQuickFilters,
        image: 'images/tools/dat/dat-quick-filters.webp',
        videoSrc: 'videos/dat-compressed/tools-quick-filters.mp4',
        coverSrc: 'videos/dat-compressed/tools-quick-filters-cover.jpg',
    },
    {
        pillKey: 'dat_feature_4_title',
        titleKey: 'dat_feature_4_label',
        descKey: 'dat_feature_4_description',
        pillFb: 'Custom Tables',
        titleFb: 'Our data, your way',
        descFb: 'Easily adjust or refine your query with drag and drop functionality. No headaches, just a new table with new results in seconds.',
        icon: icons.gen.clickDrag,
        image: 'images/tools/dat/dat-drag-drop.webp',
        videoSrc: 'videos/dat-compressed/tools-drag-drop.mp4',
        coverSrc: 'videos/dat-compressed/tools-drag-drop-cover.jpg',
    },
    {
        pillKey: 'dat_feature_5_title',
        titleKey: 'dat_feature_5_label',
        descKey: 'dat_feature_5_description',
        pillFb: 'Output Formats',
        titleFb: 'Results in multiple formats',
        descFb: 'Choose your chart type: bar, pie, line; then export to Excel, PDF, Word, or image. No reformatting required.',
        icon: icons.gen.multipleOutputs,
        image: 'images/tools/dat/dat-export.webp',
        videoSrc: 'videos/dat-compressed/tools-export.mp4',
        coverSrc: 'videos/dat-compressed/tools-export-cover.jpg',
    },
];
---

<section class="dat-features">
    <div class="dat-features__header">
        <h4 class="text-body-p0 dat-features__tagline" data-copy-key="dat_features_tagline">
            {t(copy, 'dat_features_tagline', locale, 'Unlock insights with precision')}
        </h4>
        <CarouselNavArrows
            scrollTargetSelector="#datFeaturesScroll"
            ariaLabel={locale === 'fr' ? 'Navigation des fonctionnalités' : 'Feature navigation'}
            prevLabel={locale === 'fr' ? 'Fonctionnalité précédente' : 'Previous feature'}
            nextLabel={locale === 'fr' ? 'Fonctionnalité suivante' : 'Next feature'}
            class="dat-features__nav"
        />
    </div>

    <div class="dat-features__cards" id="datFeaturesScroll">
        {
            features.map((f) => (
                <article class="dat-features__card">
                    <div class="dat-features__card-slot" aria-hidden="true">
                        <img
                            class="dat-features__card-slot-img dat-features__card-cover"
                            src={`${base}${f.coverSrc ?? f.image}`}
                            alt=""
                            loading="lazy"
                            decoding="async"
                        />
                        <video
                            class="dat-features__card-slot-video"
                            muted
                            playsinline
                            loop
                            preload="metadata"
                            aria-hidden="true"
                        >
                            <source src={`${base}${f.videoSrc}`} type="video/mp4" />
                        </video>
                    </div>
                    <div class="dat-features__card-body">
                        <EyebrowIcon
                            iconSrc={`${base}${f.icon}`}
                            label={t(copy, f.pillKey, locale, f.pillFb)}
                            copyKey={f.pillKey}
                        />
                        <div class="dat-features__card-content">
                            <p
                                class="text-body-p1 dat-features__card-title"
                                data-copy-key={f.titleKey}
                            >
                                {t(copy, f.titleKey, locale, f.titleFb)}
                            </p>
                            <p
                                class="text-body-p2 dat-features__card-desc"
                                data-copy-key={f.descKey}
                            >
                                {t(copy, f.descKey, locale, f.descFb)}
                            </p>
                        </div>
                    </div>
                </article>
            ))
        }
    </div>
</section>

<style>
    .dat-features {
        width: 100%;
        background: var(--surface-blue);
        /* top deliberately shallow — flows directly from the DAT section above */
        padding: var(--space-6) var(--content-margin-inline) var(--section-pad-block);
        display: flex;
        flex-direction: column;
        gap: 0;
        overflow-x: clip;
    }

    .dat-features__header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-6);
    }

    .dat-features__tagline {
        margin: 0;
    }

    .dat-features__cards {
        display: flex;
        gap: var(--layout-card-gap);
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        scrollbar-width: none;
        margin-inline: calc(-1 * var(--content-margin-inline));
        padding: var(--space-8) var(--content-margin-inline) var(--space-12);
        scroll-padding-inline-start: var(--content-margin-inline);
    }

    .dat-features__cards::-webkit-scrollbar {
        display: none;
    }

    .dat-features__card {
        background: var(--surface-white);
        border-radius: var(--radius-m);
        box-shadow: var(--shadow-card);
        display: flex;
        flex-direction: column;
        scroll-snap-align: start;
        flex-shrink: 0;
        width: 24rem;
    }

    .dat-features__card-slot {
        aspect-ratio: 11 / 5;
        background: var(--surface-blue);
        border-radius: var(--radius-s);
        position: relative;
        flex-shrink: 0;
        overflow: hidden;
        margin: var(--space-2) var(--space-2) 0;
    }

    .dat-features__card-slot-img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: opacity 0.2s ease;
    }

    .dat-features__card-slot-video {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        opacity: 0;
        transition: opacity 0.2s ease;
    }

    .dat-features__card.is-playing .dat-features__card-cover {
        opacity: 0;
    }

    .dat-features__card.is-playing .dat-features__card-slot-video {
        opacity: 1;
    }

    .dat-features__card-body {
        display: flex;
        flex-direction: column;
        gap: var(--card-stack-gap);
        padding: var(--card-pad);
    }

    .dat-features__card-content {
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
    }

    .dat-features__card-title {
        color: var(--text-primary);
        margin: 0;
    }

    .dat-features__card-desc {
        color: var(--text-secondary);
        margin: 0;
    }

    @media (max-width: 767px) {
        .dat-features {
            padding-top: var(--space-7);
            padding-bottom: var(--space-9);
        }

        .dat-features__card {
            width: clamp(15rem, 80vw, 20rem);
        }

        .dat-features__card-body {
            padding: var(--space-4);
            gap: var(--space-3);
        }
    }
</style>

<script>
    const cards = document.querySelectorAll<HTMLElement>('.dat-features__card');

    const stopVideo = (card: HTMLElement) => {
        const video = card.querySelector<HTMLVideoElement>('.dat-features__card-slot-video');
        if (!video) return;

        card.classList.remove('is-playing');
        video.pause();
        video.currentTime = 0;
    };

    const playVideo = (card: HTMLElement) => {
        const video = card.querySelector<HTMLVideoElement>('.dat-features__card-slot-video');
        if (!video) return;

        card.classList.add('is-playing');
        video.currentTime = 0;
        void video.play();
    };

    cards.forEach((card) => {
        card.addEventListener('mouseenter', () => playVideo(card));
        card.addEventListener('mouseleave', () => stopVideo(card));
    });
</script>
