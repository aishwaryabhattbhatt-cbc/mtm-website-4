---
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { t } from '../../lib/i18n/t';
import { icons } from '../../lib/icons/registry';

interface Props {
    locale: Locale;
    copy: CMSDictionary;
}

const { locale, copy } = Astro.props;
const base = import.meta.env.BASE_URL;

const features = [
    {
        pillKey: 'dat_feature_1_title',
        titleKey: 'dat_feature_1_label',
        descKey: 'dat_feature_1_description',
        pillFb: 'Query Building',
        titleFb: 'Easily create a custom query',
        descFb: 'Select query parameters, drag variables from the master list into output rows and columns. What you arrange is exactly what you get. No SQL or python, no analyst handoff, no waiting. Go from brief to cross-tab in minutes.',
        icon: icons.tool.queryParameters,
        image: 'images/tools/dat/query.png',
    },
    {
        pillKey: 'dat_feature_2_title',
        titleKey: 'dat_feature_2_label',
        descKey: 'dat_feature_2_description',
        pillFb: 'Variables',
        titleFb: 'Large, robust data sets at your fingertips',
        descFb: 'Thousands of variables covering demographics, device ownership, media habits, platform usage — all in a single searchable list by categories.',
        icon: icons.gen.multipleVariables,
        image: 'images/tools/dat/variables.png',
    },
    {
        pillKey: 'dat_feature_3_title',
        titleKey: 'dat_feature_3_label',
        descKey: 'dat_feature_3_description',
        pillFb: 'Filters',
        titleFb: 'Refine your query with Quick or Additional Filters',
        descFb: 'Narrow your results by age, gender or region with Quick Filters or apply any variable in the tool as a filter using Additional Filters.',
        icon: icons.tool.datFiltersQuickFilters,
    },
    {
        pillKey: 'dat_feature_4_title',
        titleKey: 'dat_feature_4_label',
        descKey: 'dat_feature_4_description',
        pillFb: 'Custom Tables',
        titleFb: 'Our data, your way',
        descFb: 'Easily adjust or refine your query with drag and drop functionality. No headaches, just a new table with new results in seconds.',
        icon: icons.gen.clickDrag,
        image: 'images/tools/dat/custom-tables.png',
    },
    {
        pillKey: 'dat_feature_5_title',
        titleKey: 'dat_feature_5_label',
        descKey: 'dat_feature_5_description',
        pillFb: 'Output Formats',
        titleFb: 'Results in multiple formats',
        descFb: 'Choose your chart type: bar, pie, line; then export to Excel, PDF, Word, or image. No reformatting required.',
        icon: icons.gen.multipleOutputs,
        image: 'images/tools/dat/output-format.png',
    },
];
---

<section class="dat-features">
    <div class="dat-features__header">
        <h4 class="text-body-p0 dat-features__tagline" data-copy-key="dat_features_tagline">
            {t(copy, 'dat_features_tagline', locale, 'Unlock insights with precision')}
        </h4>
        <div
            class="dat-features__nav"
            aria-label={locale === 'fr' ? 'Navigation des fonctionnalités' : 'Feature navigation'}
        >
            <button
                class="dat-features__nav-btn dat-features__nav-prev"
                type="button"
                aria-label={locale === 'fr' ? 'Fonctionnalité précédente' : 'Previous feature'}
            >
                <svg
                    width="8"
                    height="13"
                    viewBox="0 0 8 13"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                    aria-hidden="true"
                >
                    <path
                        d="M7 1L1 6.5L7 12"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"></path>
                </svg>
            </button>
            <button
                class="dat-features__nav-btn dat-features__nav-next"
                type="button"
                aria-label={locale === 'fr' ? 'Fonctionnalité suivante' : 'Next feature'}
            >
                <svg
                    width="8"
                    height="13"
                    viewBox="0 0 8 13"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                    aria-hidden="true"
                >
                    <path
                        d="M1 1L7 6.5L1 12"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"></path>
                </svg>
            </button>
        </div>
    </div>

    <div class="dat-features__cards" id="datFeaturesScroll">
        {
            features.map((f) => (
                <article class="dat-features__card">
                    <div class="dat-features__card-slot" aria-hidden="true">
                        {f.image && (
                            <img
                                class="dat-features__card-slot-img"
                                src={`${base}${f.image}`}
                                alt=""
                                loading="lazy"
                            />
                        )}
                    </div>
                    <div class="dat-features__card-body">
                        <div class="dat-features__card-pill">
                            <img
                                class="icon-xl dat-features__card-icon"
                                src={`${base}${f.icon}`}
                                alt=""
                                aria-hidden="true"
                                loading="lazy"
                            />
                            <span
                                class="text-label-small dat-features__card-pill-label"
                                data-copy-key={f.pillKey}
                            >
                                {t(copy, f.pillKey, locale, f.pillFb)}
                            </span>
                        </div>
                        <div class="dat-features__card-content">
                            <p
                                class="text-body-p1 dat-features__card-title"
                                data-copy-key={f.titleKey}
                            >
                                {t(copy, f.titleKey, locale, f.titleFb)}
                            </p>
                            <p
                                class="text-body-p2 dat-features__card-desc"
                                data-copy-key={f.descKey}
                            >
                                {t(copy, f.descKey, locale, f.descFb)}
                            </p>
                        </div>
                    </div>
                </article>
            ))
        }
    </div>
</section>

<style>
    .dat-features {
        width: 100%;
        background: var(--surface-blue);
        padding: var(--space-6) var(--content-margin-inline) var(--space-12);
        display: flex;
        flex-direction: column;
        gap: 0;
        overflow-x: clip;
    }

    .dat-features__header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-6);
    }

    .dat-features__tagline {
        margin: 0;
    }

    .dat-features__nav {
        display: flex;
        gap: var(--space-2);
        flex-shrink: 0;
    }

    .dat-features__nav-btn {
        width: 2.625rem;
        height: 2.625rem;
        border-radius: var(--radius-full);
        border: var(--stroke-1) solid var(--text-primary);
        background: transparent;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--text-primary);
        transition:
            background-color 0.2s,
            color 0.2s;
        flex-shrink: 0;
    }

    .dat-features__nav-btn:hover {
        background: var(--text-primary);
        color: var(--text-white);
    }

    .dat-features__nav-btn:focus-visible {
        outline: var(--stroke-2) solid var(--border-primary);
        outline-offset: var(--space-1);
    }

    .dat-features__cards {
        display: flex;
        gap: var(--layout-card-gap);
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        scrollbar-width: none;
        margin-inline: calc(-1 * var(--content-margin-inline));
        padding: var(--space-8) var(--content-margin-inline) var(--space-12);
        scroll-padding-inline-start: var(--content-margin-inline);
    }

    .dat-features__cards::-webkit-scrollbar {
        display: none;
    }

    .dat-features__card {
        background: var(--surface-white);
        border-radius: var(--radius-m);
        box-shadow: var(--shadow-card);
        display: flex;
        flex-direction: column;
        scroll-snap-align: start;
        flex-shrink: 0;
        width: 24rem;
    }

    .dat-features__card-slot {
        aspect-ratio: 488 / 266;
        background: var(--surface-blue);
        border-radius: var(--radius-s);
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: var(--space-4);
        margin: var(--space-2) var(--space-2) 0;
    }

    .dat-features__card-slot-img {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .dat-features__card-body {
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
        padding: var(--space-6);
    }

    .dat-features__card-pill {
        display: flex;
        align-items: center;
        gap: var(--space-3);
        background: var(--surface-blue);
        border-radius: var(--radius-s);
        padding: var(--space-1) var(--space-3);
        width: fit-content;
    }

    .dat-features__card-pill-label {
        color: var(--text-primary);
        white-space: nowrap;
    }

    .dat-features__card-content {
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
    }

    .dat-features__card-title {
        color: var(--text-primary);
        margin: 0;
    }

    .dat-features__card-desc {
        color: var(--text-secondary);
        margin: 0;
    }

    @media (max-width: 767px) {
        .dat-features {
            padding-top: var(--space-7);
            padding-bottom: var(--space-9);
        }

        .dat-features__card {
            width: clamp(15rem, 80vw, 20rem);
        }

        .dat-features__card-body {
            padding: var(--space-4);
            gap: var(--space-3);
        }

        .dat-features__card-pill {
            border-radius: var(--radius-xs);
            gap: var(--space-2);
            padding: var(--space-1) var(--space-2);
        }

        /* Downsize from icon-xl to icon-m at mobile; values match icon-sizes.css */
        .dat-features__card-icon {
            width: 1.5rem;
            height: 1.5rem;
        }
    }
</style>

<script>
    const scroll = document.getElementById('datFeaturesScroll');
    const prev = document.querySelector<HTMLButtonElement>('.dat-features__nav-prev');
    const next = document.querySelector<HTMLButtonElement>('.dat-features__nav-next');

    if (scroll && prev && next) {
        const getScrollAmount = () => {
            const card = scroll.firstElementChild as HTMLElement | null;
            if (!card) return 0;
            const gap = parseFloat(getComputedStyle(scroll).gap) || 0;
            return card.offsetWidth + gap;
        };

        prev.addEventListener('click', () => {
            scroll.scrollBy({ left: -getScrollAmount(), behavior: 'smooth' });
        });

        next.addEventListener('click', () => {
            scroll.scrollBy({ left: getScrollAmount(), behavior: 'smooth' });
        });
    }
</script>
