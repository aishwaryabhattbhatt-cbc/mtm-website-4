---
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { t } from '../../lib/i18n/t';
import { icons } from '../../lib/icons/registry';
import ProductPill from '../shared/ProductPill.astro';
import Button from '../shared/Button.astro';

interface Props {
    locale: Locale;
    copy: CMSDictionary;
    ctaHref?: string;
}

const { locale, copy, ctaHref = '#' } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<section class="dat-section" id="data-analysis-tool">
    <div class="dat-section__inner">
        <div class="dat-section__header">
            <div class="dat-section__title-row heading-fly-in">
                <img
                    class="icon-3xl dat-section__title-icon"
                    src={`${base}${icons.tool.dat}`}
                    alt=""
                    aria-hidden="true"
                    loading="lazy"
                />
                <h2 data-copy-key="tool_1_title">
                    {t(copy, 'tool_1_title', locale, 'Data Analysis Tool')}
                </h2>
            </div>
            <div class="dat-section__pills content-fly-in">
                <ProductPill variant="mtm18plus" size="big" />
                <ProductPill variant="junior" size="big" />
                <ProductPill variant="newcomers" size="big" />
            </div>
            <p
                class="text-body-p1 dat-section__description content-fly-in"
                data-copy-key="tool_1_description"
            >
                {
                    t(
                        copy,
                        'tool_1_description',
                        locale,
                        'The Data Analysis Tool (DAT) offers subscribers easy access to MTM 18+, Junior and Newcomers data. Select data, filter results and get answers to burning questions.'
                    )
                }
            </p>
        </div>
        <div class="dat-section__cta content-fly-in">
            <Button variant="secondary" size="md" href={ctaHref}>
                {t(copy, 'tool_1_cta', locale, 'View Demo')}
            </Button>
        </div>
    </div>
</section>

<style>
    .dat-section {
        width: 100%;
        background: var(--surface-blue);
        /* bottom deliberately shallow — flows into the DAT features section below */
        padding: var(--section-pad-block) var(--content-margin-inline) var(--space-6);
    }

    .dat-section__inner {
        display: flex;
        flex-direction: column;
        gap: var(--space-5);
    }

    .dat-section__header {
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
    }

    .dat-section__title-row {
        display: flex;
        align-items: center;
        gap: var(--space-2);
    }

    .dat-section__pills {
        display: flex;
        gap: var(--space-4);
        flex-wrap: wrap;
    }

    .dat-section__description {
        max-width: 54rem;
        margin: 0;
        color: var(--text-primary);
    }

    .dat-section__cta {
        width: fit-content;
    }

    @media (max-width: 767px) {
        .dat-section {
            padding: var(--space-9) var(--content-margin-inline);
        }

        .dat-section__inner {
            gap: var(--space-6);
        }

        .dat-section__header {
            gap: var(--space-5);
        }
    }

    .heading-fly-in {
        opacity: 0;
        transform: translateY(1.625rem);
        transition:
            opacity var(--motion-duration-heading) ease,
            transform var(--motion-duration-heading) var(--motion-ease-standard);
    }

    .heading-fly-in.is-visible {
        opacity: 1;
        transform: translateY(0);
    }

    .content-fly-in {
        opacity: 0;
        transform: translateY(1.625rem);
        transition:
            opacity var(--motion-duration-heading) ease 0.9s,
            transform var(--motion-duration-heading) var(--motion-ease-standard) 0.9s;
    }

    .content-fly-in.is-visible {
        opacity: 1;
        transform: translateY(0);
    }
</style>

<style is:global>
    /* Switch big pills to small size at mobile — crosses component boundary */
    @media (max-width: 767px) {
        .dat-section__pills .product-pill--big {
            padding: var(--space-2) var(--space-4);
            font-size: var(--fs-label-xs);
        }
    }
</style>

<script>
    // Each fly-in element observes itself, not the (potentially much larger)
    // section — an IntersectionObserver threshold is a fraction of the
    // target's own area, so watching the whole section skews the trigger
    // point for elements that don't span the section's full height.
    document.querySelectorAll<HTMLElement>('.dat-section').forEach((section) => {
        const heading = section.querySelector<HTMLElement>('.heading-fly-in');
        if (heading) {
            const headingObserver = new IntersectionObserver(
                ([entry]) => {
                    if (entry.isIntersecting) {
                        heading.classList.add('is-visible');
                        headingObserver.disconnect();
                    }
                },
                { threshold: 0.15 }
            );
            headingObserver.observe(heading);
        }

        const contentObserver = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('is-visible');
                        contentObserver.unobserve(entry.target);
                    }
                });
            },
            { threshold: 0.15 }
        );
        section.querySelectorAll<HTMLElement>('.content-fly-in').forEach((el) => {
            contentObserver.observe(el);
        });
    });
</script>
