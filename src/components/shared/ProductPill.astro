---
// src/components/shared/ProductPill.astro
// Figma node: 362:11068 — Product badge pill for MTM product lines

import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { t } from '../../lib/i18n/t';

export type ProductVariant = 'mtm18plus' | 'junior' | 'newcomers' | 'census';
export type PillSize = 'xsmall' | 'small' | 'big' | 'large';

interface Props {
    variant: ProductVariant;
    size?: PillSize;
    responsive?: boolean;
    class?: string;
    copy?: CMSDictionary;
    locale?: Locale;
}

const {
    variant,
    size = 'small',
    responsive = false,
    class: className = '',
    copy,
    locale,
} = Astro.props as Props;

// Fallback labels — used verbatim when a call site doesn't pass copy/locale
// (most don't yet), and as the t() fallback when the CMS key is missing.
const fallbackLabels: Record<ProductVariant, string> = {
    mtm18plus: 'MTM 18+',
    junior: 'Junior',
    newcomers: 'Newcomers',
    census: 'Census',
};

// Sourced from the home CMS tab — merged into every page's dictionary already.
const cmsKeys: Record<ProductVariant, string> = {
    mtm18plus: 'product_1_title',
    junior: 'product_2_title',
    newcomers: 'product_3_title',
    census: 'product_4_title',
};

const label =
    copy && locale
        ? t(copy, cmsKeys[variant], locale, fallbackLabels[variant])
        : fallbackLabels[variant];
---

<span
    class={`product-pill product-pill--${variant} product-pill--${size}${responsive ? ' product-pill--responsive' : ''}${className ? ` ${className}` : ''}`}
>
    {label}
</span>

<style>
    .product-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: var(--radius-full);
        color: var(--neutral-white, #fff);
        white-space: nowrap;
    }

    /* Sizes */
    .product-pill--xsmall {
        padding: var(--space-1) var(--space-3);
    }
    .product-pill--xsmall {
        font-family: var(--font-body);
        font-size: var(--fs-input-label);
        font-weight: var(--fw-regular);
        line-height: 1.1;
        letter-spacing: var(--ls-pill);
    }

    .product-pill--small {
        padding: var(--space-2) var(--space-4);
    }
    .product-pill--small {
        font-family: var(--font-body);
        font-size: var(--fs-label-xs);
        font-weight: var(--fw-regular);
        line-height: 1.1;
        letter-spacing: var(--ls-pill);
    }

    .product-pill--big {
        padding: var(--space-2) var(--space-4);
    }
    .product-pill--big {
        font-family: var(--font-body);
        font-size: var(--fs-label-small);
        font-weight: var(--fw-regular);
        line-height: 1.1;
        letter-spacing: var(--ls-pill);
    }

    .product-pill--large {
        padding: var(--space-2) var(--space-5);
    }
    .product-pill--large {
        font-family: var(--font-body);
        font-size: var(--fs-body-m);
        font-weight: var(--fw-regular);
        line-height: 1.1;
        letter-spacing: var(--ls-pill);
    }

    /* Variants */
    .product-pill--mtm18plus {
        background: var(--badge-mtm-18);
    }
    .product-pill--junior {
        background: var(--badge-juniors);
    }
    .product-pill--newcomers {
        background: var(--badge-newcomers);
    }
    .product-pill--census {
        background: var(--badge-census);
    }

    .product-pill--responsive.product-pill--small {
        padding: calc(var(--space-2) * var(--reports-scale, 1))
            calc(var(--space-4) * var(--reports-scale, 1));
        font-size: calc(var(--fs-label-xs) * var(--reports-scale, 1));
        line-height: 1.1;
    }

    .product-pill--responsive.product-pill--big {
        padding: calc(var(--space-2) * var(--reports-scale, 1))
            calc(var(--space-6) * var(--reports-scale, 1));
        /* body-m, not button-regular: pills must not inherit button tap-target inflation on mobile */
        font-size: calc(var(--fs-body-m) * var(--reports-scale, 1));
        line-height: var(--lh-tight);
    }
</style>
