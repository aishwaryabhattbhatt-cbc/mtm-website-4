---
// src/components/shared/LiquidGradientBackgroundScripts.astro
// Drop inside a page's <Fragment slot="scripts"> alongside
// <LiquidGradientBackground />. Loads the WebGL liquid-gradient
// effect (public/js/backgrounds/liquid-gradient-background.js); the "three"
// import map lives in Layout.astro's <head>.
const base = import.meta.env.BASE_URL;
---

<script is:inline type="module" src={`${base}js/backgrounds/liquid-gradient-background.js`}
></script>
