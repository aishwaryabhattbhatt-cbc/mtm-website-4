---
import Button from './Button.astro';

interface StatItem {
    iconSrc: string;
    iconAlt?: string;
    metric: string;
    description: string;
}

interface Props {
    imageSrc: string;
    imageAlt?: string;
    graphIconSrc?: string;
    graphIconAlt?: string;
    graphTitle: string;
    graphDetail: string;
    chartSrc: string;
    chartAlt?: string;
    insightsHref: string;
    sampleReportHref: string;
    stats?: StatItem[];
}

const {
    imageSrc,
    imageAlt = '',
    graphIconSrc,
    graphIconAlt = '',
    graphTitle,
    graphDetail,
    chartSrc,
    chartAlt = '',
    insightsHref,
    sampleReportHref,
    stats = [],
} = Astro.props as Props;
---

<div class="report-card report-card-fly-in">
    <div class="report-card-photo">
        <img src={imageSrc} alt={imageAlt} loading="lazy" decoding="async" />
    </div>
    <div class="report-card-graph">
        <div class="report-card-graph-header">
            {
                graphIconSrc && (
                    <img
                        src={graphIconSrc}
                        alt={graphIconAlt}
                        class="icon-3xl report-card-graph-icon"
                        loading="lazy"
                        decoding="async"
                    />
                )
            }
            <div class="report-card-graph-title-group">
                <p class="text-body-p1-bold report-card-graph-name">{graphTitle}</p>
                <p class="text-body-p3 report-card-graph-detail">{graphDetail}</p>
            </div>
        </div>
        <img
            src={chartSrc}
            alt={chartAlt}
            class="report-card-chart"
            loading="lazy"
            decoding="async"
        />
    </div>
</div>

{
    stats.length > 0 && (
        <div class="report-stats">
            {stats.map((stat) => (
                <div class="report-stat-card report-card-fly-in">
                    <img
                        src={stat.iconSrc}
                        alt={stat.iconAlt ?? ''}
                        class="icon-3xl report-stat-icon"
                        loading="lazy"
                        decoding="async"
                    />
                    <div class="report-stat-body">
                        <p class="text-metrics report-stat-metric">{stat.metric}</p>
                        <p class="text-body-p1 report-stat-description">{stat.description}</p>
                    </div>
                </div>
            ))}
        </div>
    )
}

<div class="report-action-card report-card-fly-in">
    <p class="text-body-p1 report-action-text">
        Explore our full library of reports or download a free sneak peek.
    </p>
    <div class="report-action-buttons">
        <Button variant="secondary" size="lg" href={insightsHref}>GO TO INSIGHTS</Button>
        <Button variant="primary" size="lg" href={sampleReportHref}>
            <span class="report-action-btn-inner">
                SAMPLE REPORT
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="7 10 12 15 17 10"></polyline>
                    <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
            </span>
        </Button>
    </div>
</div>

<style>
    .report-action-card {
        display: grid;
        grid-template-columns: 1fr auto;
        align-items: center;
        gap: var(--space-8);
        margin-top: var(--space-8);
        background-color: var(--surface-white);
        border-radius: var(--layout-card-radius);
        padding: var(--space-7);
        box-shadow: var(--shadow-card);
    }

    .report-action-text {
        margin: 0;
        color: var(--text-primary);
    }

    .report-action-buttons {
        display: flex;
        flex-direction: row;
        gap: var(--space-4);
        flex-shrink: 0;
    }

    .report-action-btn-inner {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
    }

    .report-card {
        display: flex;
        align-items: center;
        background-color: var(--surface-white);
        border-radius: var(--layout-card-radius);
        padding: var(--card-pad);
        gap: var(--space-6);
        box-shadow: var(--shadow-card);
    }

    .report-card-photo {
        flex: 0 0 52%;
        border-radius: var(--radius-s);
        overflow: hidden;
        align-self: stretch;
    }

    .report-card-photo img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .report-card-graph {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-self: stretch;
        padding: var(--space-3) 0;
        gap: var(--space-5);
    }

    .report-card-graph-header {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        overflow: hidden;
    }

    .report-card-graph-icon {
        flex-shrink: 0;
    }

    .report-card-graph-title-group {
        display: flex;
        flex-direction: column;
        gap: var(--space-1);
        min-width: 0;
        overflow: hidden;
    }

    .report-card-graph-name {
        margin: 0;
        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 1;
        overflow: hidden;
    }

    .report-card-graph-detail {
        margin: 0;
        color: var(--text-secondary);
    }

    .report-card-chart {
        width: 100%;
        height: auto;
        display: block;
    }

    .report-stats {
        display: flex;
        flex-direction: row;
        gap: var(--layout-card-gap);
        margin-top: var(--space-8);
    }

    .report-stat-card {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: var(--space-8);
        background-color: var(--surface-white);
        border-radius: var(--layout-card-radius);
        padding: var(--space-7);
        box-shadow: var(--shadow-card);
    }

    .report-stat-body {
        display: flex;
        align-items: flex-start;
        gap: var(--space-5);
    }

    .report-stat-metric {
        margin: 0;
        white-space: nowrap;
        flex-shrink: 0;
    }

    .report-stat-description {
        margin: 0;
        color: var(--text-primary);
    }

    @media (max-width: 1023px) {
        .report-card {
            flex-direction: column;
        }

        .report-card-photo {
            flex: none;
            width: 100%;
            height: auto;
        }

        .report-card-photo img {
            height: auto;
        }

        .report-card-graph {
            width: 100%;
            padding: 0;
        }

        .report-stats {
            flex-direction: column;
            gap: var(--space-4);
        }

        .report-stat-card {
            display: grid;
            grid-template-columns: auto 1fr;
            align-items: center;
            gap: var(--card-stack-gap);
        }

        .report-stat-icon {
            grid-column: 1;
            grid-row: 1;
        }

        .report-stat-body {
            display: contents;
        }

        .report-stat-metric {
            grid-column: 2;
            grid-row: 1;
            align-self: center;
        }

        .report-stat-description {
            grid-column: 1 / -1;
            grid-row: 2;
        }

        .report-action-card {
            grid-template-columns: 1fr;
            text-align: center;
        }

        .report-action-buttons {
            flex-direction: column;
            justify-content: center;
            width: 100%;
        }

        .report-action-buttons :global(.btn) {
            width: 100%;
            text-align: center;
        }
    }

    .report-card-fly-in {
        opacity: 0;
        transform: translateY(1.625rem);
        transition:
            opacity var(--motion-duration-card) cubic-bezier(0.22, 1, 0.36, 1),
            transform var(--motion-duration-card) cubic-bezier(0.22, 1, 0.36, 1);
    }

    .report-card-fly-in.is-visible {
        opacity: 1;
        transform: translateY(0);
    }
</style>

<script>
    // report-card and report-action-card sit at different vertical scroll
    // positions than each other and than the stats row, so each row gets
    // its own observer (per animation-conventions: never observe a single
    // shared wrapper spanning multiple rows — a threshold is a fraction of
    // the target's own area, so a tall shared wrapper skews the trigger
    // point badly and was the reason this used to feel late).
    document.querySelectorAll<HTMLElement>('.report-card').forEach((card) => {
        const observer = new IntersectionObserver(
            ([entry]) => {
                if (entry.isIntersecting) {
                    card.classList.add('is-visible');
                    observer.disconnect();
                }
            },
            { threshold: 0.2 }
        );
        observer.observe(card);
    });

    document.querySelectorAll<HTMLElement>('.report-action-card').forEach((card) => {
        const observer = new IntersectionObserver(
            ([entry]) => {
                if (entry.isIntersecting) {
                    card.classList.add('is-visible');
                    observer.disconnect();
                }
            },
            { threshold: 0.2 }
        );
        observer.observe(card);
    });

    // The stat cards sit side by side in one row, so they'd all cross an
    // individual threshold together — observe the row once instead and
    // stagger the children in JS.
    document.querySelectorAll<HTMLElement>('.report-stats').forEach((row) => {
        const cards = row.querySelectorAll<HTMLElement>('.report-stat-card');
        if (!cards.length) return;
        const observer = new IntersectionObserver(
            ([entry]) => {
                if (entry.isIntersecting) {
                    cards.forEach((card, i) => {
                        setTimeout(() => card.classList.add('is-visible'), i * 300);
                    });
                    observer.disconnect();
                }
            },
            { threshold: 0.2 }
        );
        observer.observe(row);
    });
</script>
