---
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { t } from '../../lib/i18n/t';
import CountUpValue from './CountUpValue.astro';

interface Props {
    locale: Locale;
    copy: CMSDictionary;
    imageSrc: string;
    mobileImageSrc?: string;
    imageAlt?: string;
    align?: 'left' | 'right';
    /* Vertical center of the callout, as a CSS percentage of the image's
       height. '61.5%' for the standard asset template (top 23% transparent/
       gradient zone + bottom 77% photo band, centered within that band).
       Use '50%' for a fully opaque photo with no header band. */
    calloutTop?: string;
    valueKey: string;
    fallbackValue?: string;
    descriptionKey: string;
    fallbackDescription?: string;
}

const {
    locale,
    copy,
    imageSrc,
    mobileImageSrc,
    imageAlt = '',
    align = 'right',
    calloutTop = '61.5%',
    valueKey,
    fallbackValue = '',
    descriptionKey,
    fallbackDescription = '',
} = Astro.props as Props;
---

<div class="split-frame-stat content-fly-in" style={`--callout-top: ${calloutTop}`}>
    <picture>
        {mobileImageSrc && <source media="(max-width: 767px)" srcset={mobileImageSrc} />}
        <img src={imageSrc} alt={imageAlt} loading="lazy" decoding="async" />
    </picture>
    <div class={`split-frame-stat__callout split-frame-stat__callout--${align}`}>
        <CountUpValue
            value={t(copy, valueKey, locale, fallbackValue)}
            class="text-hero split-frame-stat__value split-frame-stat__value--lg"
        />
        <CountUpValue
            value={t(copy, valueKey, locale, fallbackValue)}
            class="text-metrics split-frame-stat__value split-frame-stat__value--sm"
        />
        <span class="text-body-p1-1-25x split-frame-stat__desc">
            {t(copy, descriptionKey, locale, fallbackDescription)}
        </span>
    </div>
</div>

<style>
    .split-frame-stat {
        position: relative;
        display: grid;
        /* Viewport-relative full-bleed, not parent-padding-relative — this
           component is dropped both inside a padded section (census, whose
           parent already insets by --content-margin-inline) and directly on
           the page (education, no padding to break out of). A
           calc(100% + 2*margin)/negative-margin-inline trick only cancels
           out correctly in the first case; in the second it pushes the
           whole block past the viewport edge. 100vw + this centering margin
           reaches the viewport edge exactly either way. */
        width: 100vw;
        margin-left: calc(50% - 50vw);
        overflow: hidden;
    }

    /* Transparent wrapper — lets .split-frame-stat img's grid-area
       placement reach through <picture> as if img were the direct grid
       child. */
    .split-frame-stat picture {
        display: contents;
    }

    .split-frame-stat img {
        grid-area: 1 / 1;
        width: 100%;
        height: auto;
        display: block;
        /* Reserves the image's box immediately instead of collapsing to 0
           height until the (loading="lazy") asset actually loads — without
           this the callout below it visually overlaps/crops the image on
           slower connections. Desktop asset is 2880x1000; the mobile source
           swapped in below is a different ratio (1280x710). */
        aspect-ratio: 2880 / 1000;
    }

    .split-frame-stat__callout {
        position: absolute;
        top: var(--callout-top);
        transform: translateY(-50%);
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
        max-width: 30%;
    }

    /* Wider below 1440px — 30% of a narrower frame leaves too little room
       for the description before it wraps to too many lines. Still
       overridden by the ≤767px block below, which drops the overlay layout
       entirely. */
    @media (max-width: 1439px) {
        .split-frame-stat__callout {
            max-width: 40%;
        }
    }

    .split-frame-stat__callout--right {
        right: var(--content-margin-inline);
        align-items: flex-end;
        text-align: right;
    }

    .split-frame-stat__callout--left {
        left: var(--content-margin-inline);
        align-items: flex-start;
        text-align: left;
    }

    /* :global — these target CountUpValue's own <span>, which doesn't carry
       this component's scope attribute. */
    :global(.split-frame-stat__value) {
        color: var(--text-primary);
    }

    :global(.split-frame-stat__value--sm) {
        display: none;
    }

    .split-frame-stat__desc {
        color: var(--text-secondary);
    }

    @media (max-width: 1023px) {
        :global(.split-frame-stat__value--lg) {
            display: none;
        }

        :global(.split-frame-stat__value--sm) {
            display: block;
        }
    }

    @media (max-width: 767px) {
        /* Below the image instead of overlaid on it — the callout drops out
           of the grid stack into normal flow, centered under the photo. */
        .split-frame-stat {
            display: flex;
            flex-direction: column;
            gap: 0;
        }

        .split-frame-stat img {
            /* No scale/zoom — how much headroom a mobile crop has above its
               subject varies per photo, so any upward-anchored zoom risks
               clipping into hair/hats against this container's overflow:
               hidden. The image displays uncropped at its full aspect
               ratio, so no zoom is needed anyway. */
            aspect-ratio: 1280 / 710;
        }

        .split-frame-stat__callout {
            position: static;
            transform: none;
            max-width: none;
            align-items: center;
            text-align: center;
            background: var(--surface-blue);
            padding-block: var(--card-pad);
            padding-inline: var(--content-margin-inline);
        }

        .split-frame-stat__callout--right,
        .split-frame-stat__callout--left {
            right: auto;
            left: auto;
        }
    }
</style>

<script>
    // The stat value (CountUpValue) triggers its own count-up independently,
    // on its own scroll-in observer — this only handles the block's fade/slide.
    document.querySelectorAll<HTMLElement>('.split-frame-stat').forEach((el) => {
        const observer = new IntersectionObserver(
            ([entry]) => {
                if (entry.isIntersecting) {
                    el.classList.add('is-visible');
                    observer.disconnect();
                }
            },
            { threshold: 0.15 }
        );
        observer.observe(el);
    });
</script>
