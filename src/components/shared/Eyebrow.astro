---
interface Props {
    class?: string;
    as?: 'div' | 'h2' | 'h3';
}

const { class: className = '', as = 'div' } = Astro.props as Props;
const Tag = as;
---

<Tag class={`eyebrow text-button-small${className ? ` ${className}` : ''}`}>
    <slot />
</Tag>

<style>
    .eyebrow {
        display: inline-flex;
        padding: var(--space-3) var(--space-6);
        background: var(--surface-white);
        border-radius: var(--radius-tag);
        box-shadow: var(--shadow-eyebrow);
        color: var(--text-primary);
        white-space: nowrap;
        align-self: flex-start;
    }
</style>
