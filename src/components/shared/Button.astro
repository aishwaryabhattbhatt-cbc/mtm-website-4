---
type ButtonVariant = 'primary' | 'secondary' | 'scroll' | 'tertiary' | 'secondary-icon';
type ButtonSize = 'md' | 'lg';

interface Props {
    variant?: ButtonVariant;
    size?: ButtonSize;
    href?: string;
    type?: 'button' | 'submit' | 'reset';
    class?: string;
    tabindex?: number | string;
    id?: string;
    'aria-label'?: string;
    iconSrc?: string;
    iconAlt?: string;
}

const {
    variant = 'primary',
    size = 'md',
    href,
    type = 'button',
    class: className = '',
    iconSrc,
    iconAlt = '',
    ...attrs
} = Astro.props as Props & Record<string, unknown>;

const variantClass =
    variant === 'secondary-icon'
        ? 'btn-outline btn-outline-icon'
        : variant === 'secondary'
          ? 'btn-outline'
          : variant === 'scroll'
            ? 'btn-scroll'
            : variant === 'tertiary'
              ? 'btn-tertiary'
              : 'btn-primary';

const isScroll = variant === 'scroll';
const isTertiary = variant === 'tertiary';
const isSecondaryIcon = variant === 'secondary-icon';

const textClass = size === 'lg' ? 'text-button-regular' : 'text-button-small';

const classes = ['btn', variantClass, `btn-size-${size}`, textClass, className]
    .filter(Boolean)
    .join(' ');
---

{
    href ? (
        <a href={href} class={classes} {...attrs}>
            {isScroll ? (
                <>
                    <span class="btn-scroll-label">
                        <slot />
                    </span>
                    <span class="btn-scroll-icon" aria-hidden="true">
                        <svg
                            width="100%"
                            height="100%"
                            viewBox="0 0 20 20"
                            fill="none"
                            xmlns="http://www.w3.org/2000/svg"
                        >
                            <path
                                d="M5 7.5L10 12.5L15 7.5"
                                stroke="currentColor"
                                stroke-width="1.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            />
                        </svg>
                    </span>
                </>
            ) : isTertiary ? (
                <>
                    <span class="btn-tertiary-label">
                        <slot />
                    </span>
                    <span class="btn-tertiary-icon" aria-hidden="true">
                        <svg
                            width="20"
                            height="20"
                            viewBox="0 0 20 20"
                            fill="none"
                            xmlns="http://www.w3.org/2000/svg"
                        >
                            <path
                                d="M3 10H17M12 5L17 10L12 15"
                                stroke="currentColor"
                                stroke-width="1.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            />
                        </svg>
                    </span>
                </>
            ) : isSecondaryIcon ? (
                <>
                    {iconSrc ? (
                        <span
                            class="btn-secondary-icon-wrap"
                            aria-hidden={iconAlt ? undefined : 'true'}
                        >
                            <img
                                class="btn-secondary-icon-asset"
                                src={iconSrc}
                                alt={iconAlt}
                                loading="lazy"
                                decoding="async"
                            />
                        </span>
                    ) : null}
                    <span class="btn-secondary-icon-label">
                        <slot />
                    </span>
                </>
            ) : (
                <slot />
            )}
        </a>
    ) : (
        <button type={type} class={classes} {...attrs}>
            {isScroll ? (
                <>
                    <span class="btn-scroll-label">
                        <slot />
                    </span>
                    <span class="btn-scroll-icon" aria-hidden="true">
                        <svg
                            width="100%"
                            height="100%"
                            viewBox="0 0 20 20"
                            fill="none"
                            xmlns="http://www.w3.org/2000/svg"
                        >
                            <path
                                d="M5 7.5L10 12.5L15 7.5"
                                stroke="currentColor"
                                stroke-width="1.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            />
                        </svg>
                    </span>
                </>
            ) : isTertiary ? (
                <>
                    <span class="btn-tertiary-label">
                        <slot />
                    </span>
                    <span class="btn-tertiary-icon" aria-hidden="true">
                        <svg
                            width="20"
                            height="20"
                            viewBox="0 0 20 20"
                            fill="none"
                            xmlns="http://www.w3.org/2000/svg"
                        >
                            <path
                                d="M3 10H17M12 5L17 10L12 15"
                                stroke="currentColor"
                                stroke-width="1.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            />
                        </svg>
                    </span>
                </>
            ) : isSecondaryIcon ? (
                <>
                    {iconSrc ? (
                        <span
                            class="btn-secondary-icon-wrap"
                            aria-hidden={iconAlt ? undefined : 'true'}
                        >
                            <img
                                class="btn-secondary-icon-asset"
                                src={iconSrc}
                                alt={iconAlt}
                                loading="lazy"
                                decoding="async"
                            />
                        </span>
                    ) : null}
                    <span class="btn-secondary-icon-label">
                        <slot />
                    </span>
                </>
            ) : (
                <slot />
            )}
        </button>
    )
}

<style is:global>
    .btn {
        padding: var(--space-3) var(--space-5);
        border-radius: var(--radius-s);
        text-decoration: none;
        cursor: pointer;
        border: var(--stroke-2) solid transparent;
        transition: all 0.3s ease;
        display: inline-block;
        white-space: nowrap;
    }

    .btn-outline {
        background-color: var(--surface-white);
        color: var(--text-primary);
        border: var(--stroke-1) solid var(--border-secondary);
    }

    .btn-outline:hover {
        background-color: var(--neutral-grey-4);
        transform: translateY(-2px);
        box-shadow: var(--shadow-e2);
    }

    .btn-outline-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: calc(var(--space-2) + (var(--space-3) - var(--space-2)) / 4);
    }

    .btn-secondary-icon-wrap {
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .btn-secondary-icon-asset {
        width: var(--space-7);
        height: var(--space-7);
        display: block;
        flex-shrink: 0;
    }

    .btn-secondary-icon-label {
        display: inline-block;
    }

    .btn-primary {
        background-color: var(--neutral-black);
        color: var(--text-white);
        border: none;
    }

    .btn-primary:hover {
        background-color: var(--neutral-grey-1);
        transform: translateY(-2px);
        box-shadow: var(--shadow-e2);
    }

    .btn-scroll {
        border: none;
        background: transparent;
        color: var(--text-primary);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: var(--space-3);
    }

    .btn-scroll:hover {
        transform: translateY(-2px);
    }

    .btn-scroll-label {
        display: inline-block;
    }

    .btn-scroll-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1rem;
        height: 1rem;
        line-height: var(--lh-tight);
    }

    .btn-scroll-icon svg {
        width: 100%;
        height: 100%;
        display: block;
    }

    .btn-tertiary {
        border: none;
        background: transparent;
        color: var(--text-primary);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: var(--space-3);
    }

    .btn-tertiary:hover {
        transform: translateY(-2px);
    }

    .btn-tertiary-label {
        display: inline-block;
    }

    .btn-tertiary-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.25rem;
        height: 1.25rem;
    }

    .btn-tertiary-icon svg {
        width: 100%;
        height: 100%;
    }

    .btn-size-md {
        padding: var(--space-3) var(--space-5);
    }

    .btn-size-lg {
        padding: var(--space-3) var(--space-5);
    }

    .btn-scroll,
    .btn-tertiary {
        padding-left: 0;
        padding-right: 0;
    }

    @media (max-width: 1023px) {
        .btn-size-md,
        .btn-size-lg {
            padding: var(--space-4) var(--space-5);
            min-height: 2.75rem;
        }

        .btn-scroll,
        .btn-tertiary {
            padding-left: 0;
            padding-right: 0;
        }
    }
</style>
