---
interface Tab {
    label: string;
    value: string;
}

interface Props {
    tabs: Tab[];
    defaultValue?: string;
    showArrows?: boolean;
    id?: string;
}

const { tabs, defaultValue, showArrows = false, id } = Astro.props as Props;
const activeValue = defaultValue ?? tabs[0]?.value ?? '';
---

<div class="tabs-bar" id={id}>
    <div class="tabs-bar__tabs" role="tablist">
        <div class="tabs-bar__indicator" aria-hidden="true"></div>
        {
            tabs.map((tab) => (
                <button
                    class:list={[
                        'tabs-bar__tab',
                        'text-label-regular',
                        { 'tabs-bar__tab--active': tab.value === activeValue },
                    ]}
                    role="tab"
                    aria-selected={tab.value === activeValue ? 'true' : 'false'}
                    data-value={tab.value}
                >
                    {tab.label}
                </button>
            ))
        }
    </div>

    {
        showArrows && (
            <div class="tabs-bar__arrows">
                <button class="tabs-bar__arrow" aria-label="Previous" data-arrow="prev">
                    <svg width="9" height="15" viewBox="0 0 9 15" fill="none" aria-hidden="true">
                        <path
                            d="M7.5 1.5L1.5 7.5L7.5 13.5"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        />
                    </svg>
                </button>
                <button
                    class="tabs-bar__arrow tabs-bar__arrow--filled"
                    aria-label="Next"
                    data-arrow="next"
                >
                    <svg width="9" height="15" viewBox="0 0 9 15" fill="none" aria-hidden="true">
                        <path
                            d="M1.5 1.5L7.5 7.5L1.5 13.5"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        />
                    </svg>
                </button>
            </div>
        )
    }
</div>

<script>
    document.querySelectorAll<HTMLElement>('.tabs-bar').forEach((bar) => {
        const indicator = bar.querySelector<HTMLElement>('.tabs-bar__indicator');

        function moveIndicator(btn: HTMLButtonElement, animate: boolean) {
            if (!indicator) return;
            if (!animate) indicator.style.transition = 'none';
            indicator.style.left = btn.offsetLeft + 'px';
            indicator.style.width = btn.offsetWidth + 'px';
            if (!animate) {
                indicator.getBoundingClientRect(); // force reflow
                indicator.style.transition = '';
            }
        }

        const initialActive = bar.querySelector<HTMLButtonElement>('[aria-selected="true"]');
        if (initialActive) moveIndicator(initialActive, false);

        bar.querySelectorAll<HTMLButtonElement>('[data-value]').forEach((btn) => {
            btn.addEventListener('click', () => {
                bar.querySelectorAll<HTMLButtonElement>('[data-value]').forEach((b) => {
                    b.classList.remove('tabs-bar__tab--active');
                    b.setAttribute('aria-selected', 'false');
                });
                btn.classList.add('tabs-bar__tab--active');
                btn.setAttribute('aria-selected', 'true');
                moveIndicator(btn, true);
                bar.dispatchEvent(
                    new CustomEvent('tabs:change', {
                        bubbles: true,
                        detail: { value: btn.dataset.value },
                    })
                );
            });
        });
    });
</script>

<style>
    .tabs-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-5);
        width: 100%;
    }

    .tabs-bar__tabs {
        position: relative;
        display: flex;
        align-items: center;
        gap: var(--space-3);
        padding: var(--space-1);
        background: var(--surface-blue);
        border-radius: var(--radius-s);
    }

    .tabs-bar__indicator {
        position: absolute;
        top: var(--space-1);
        left: 0;
        height: calc(100% - 2 * var(--space-1));
        background: var(--surface-white);
        border-radius: var(--radius-xs);
        box-shadow: var(--shadow-e1);
        pointer-events: none;
        z-index: 0;
        transition:
            left 0.35s cubic-bezier(0.4, 0, 0.2, 1),
            width 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .tabs-bar__tab {
        position: relative;
        z-index: 1;
        padding: var(--space-2) var(--space-6);
        border-radius: var(--radius-xs);
        color: var(--text-secondary);
        background: transparent;
        border: none;
        cursor: pointer;
        white-space: nowrap;
        transition: color 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .tabs-bar__tab--active {
        color: var(--text-primary);
    }

    .tabs-bar__tab:hover:not(.tabs-bar__tab--active) {
        color: var(--text-primary);
    }

    .tabs-bar__arrows {
        display: flex;
        gap: var(--space-3);
        flex-shrink: 0;
    }

    .tabs-bar__arrow {
        display: flex;
        align-items: center;
        justify-content: center;
        width: var(--space-8);
        height: var(--space-8);
        border-radius: var(--radius-full);
        border: var(--stroke-1) solid var(--border-secondary);
        background: transparent;
        color: var(--text-secondary);
        cursor: pointer;
        transition:
            background 0.15s,
            color 0.15s,
            border-color 0.15s;
    }

    .tabs-bar__arrow--filled {
        background: var(--text-primary);
        color: var(--text-white);
        border-color: var(--text-primary);
    }

    .tabs-bar__arrow:hover:not(.tabs-bar__arrow--filled) {
        background: var(--surface-blue);
        color: var(--text-primary);
        border-color: var(--border-primary);
    }

    @media (max-width: 767px) {
        .tabs-bar__tab {
            padding: var(--space-2) var(--space-4);
        }
    }
</style>
