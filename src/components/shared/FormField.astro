---
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { t } from '../../lib/i18n/t';

interface Option {
    value: string;
    label: string;
    labelKey?: string;
}

interface Props {
    locale: Locale;
    copy: CMSDictionary;
    type?: 'text' | 'email' | 'password' | 'select' | 'textarea';
    variant?: 'field-only' | 'field-with-label' | 'dropdown';
    name: string;
    id?: string;
    placeholder?: string;
    placeholderKey?: string;
    label?: string;
    labelKey?: string;
    required?: boolean;
    options?: Option[];
    value?: string;
    class?: string;
    ariaLabel?: string;
    emailValidation?: 'live' | 'submit-only' | 'none';
    labelColor?: 'secondary' | 'primary';
}

const {
    locale,
    copy,
    type = 'text',
    variant = 'field-only',
    name,
    id,
    placeholder,
    placeholderKey,
    label,
    labelKey,
    required = false,
    options = [],
    value,
    class: className,
    ariaLabel,
    emailValidation = 'live',
    labelColor = 'secondary',
} = Astro.props as Props;

const fieldId = id || `${name}-${Math.random().toString(36).substr(2, 9)}`;
const showLabel = variant === 'field-with-label' || variant === 'dropdown';
const isSelect = type === 'select' || variant === 'dropdown';
const isEmail = type === 'email';
const isPassword = type === 'password';
const isTextarea = type === 'textarea';
const shouldRenderEmailError = isEmail && emailValidation !== 'none';
const emailErrorId = `${fieldId}-error`;

const resolvedPlaceholder = placeholderKey
    ? t(copy, placeholderKey, locale, placeholder || '')
    : placeholder;

const resolvedLabel = labelKey ? t(copy, labelKey, locale, label || '') : label;
const emailErrorMessage =
    locale === 'fr'
        ? 'Veuillez saisir une adresse courriel valide.'
        : 'Please enter a valid email address.';
const passwordToggleLabels =
    locale === 'fr'
        ? { show: 'Afficher le mot de passe', hide: 'Masquer le mot de passe' }
        : { show: 'Show password', hide: 'Hide password' };
---

<div class={`form-field form-field--${variant} ${className || ''}`}>
    {
        showLabel && (
            <label
                for={fieldId}
                class:list={[
                    'form-field__label',
                    'text-body-p3',
                    labelColor === 'primary' && 'form-field__label--primary',
                ]}
            >
                {resolvedLabel}
                {required && <span class="form-field__required">*</span>}
            </label>
        )
    }

    {
        isSelect ? (
            <div class="form-field__select-wrapper">
                <select
                    id={fieldId}
                    name={name}
                    class="form-field__select text-body-p3 is-placeholder"
                    value={value}
                    aria-label={ariaLabel || resolvedLabel}
                    data-select
                    {...(required && { required })}
                >
                    {options.map((option) => (
                        <option value={option.value}>
                            {option.labelKey
                                ? t(copy, option.labelKey, locale, option.label)
                                : option.label}
                        </option>
                    ))}
                </select>
            </div>
        ) : isTextarea ? (
            <textarea
                id={fieldId}
                name={name}
                rows={1}
                class:list={[
                    'form-field__input',
                    'form-field__textarea',
                    'text-body-p3',
                    className,
                ]}
                placeholder={resolvedPlaceholder}
                aria-label={ariaLabel || resolvedLabel || resolvedPlaceholder}
                {...(required && { required })}
            />
        ) : (
            <div class="form-field__input-wrapper">
                <input
                    id={fieldId}
                    type={type}
                    name={name}
                    class:list={[
                        'form-field__input',
                        'text-body-p3',
                        isPassword && 'form-field__input--with-toggle',
                        className,
                    ]}
                    placeholder={resolvedPlaceholder}
                    value={value}
                    aria-label={ariaLabel || resolvedLabel || resolvedPlaceholder}
                    aria-invalid="false"
                    aria-describedby={shouldRenderEmailError ? emailErrorId : undefined}
                    data-email-field={isEmail ? 'true' : undefined}
                    data-error-id={shouldRenderEmailError ? emailErrorId : undefined}
                    data-email-validation={isEmail ? emailValidation : undefined}
                    {...(required && { required })}
                />
                {isPassword && (
                    <button
                        type="button"
                        class="form-field__toggle"
                        data-password-toggle
                        data-label-show={passwordToggleLabels.show}
                        data-label-hide={passwordToggleLabels.hide}
                        aria-label={passwordToggleLabels.show}
                        aria-pressed="false"
                    >
                        <svg
                            class="form-field__toggle-icon form-field__toggle-icon--eye icon-s"
                            viewBox="0 0 24 24"
                            fill="none"
                            aria-hidden="true"
                        >
                            <path
                                d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8Z"
                                stroke="currentColor"
                                stroke-width="1.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            />
                            <circle
                                cx="12"
                                cy="12"
                                r="3"
                                stroke="currentColor"
                                stroke-width="1.5"
                            />
                        </svg>
                        <svg
                            class="form-field__toggle-icon form-field__toggle-icon--eye-off icon-s"
                            viewBox="0 0 24 24"
                            fill="none"
                            aria-hidden="true"
                        >
                            <path
                                d="M17.94 17.94A10.94 10.94 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A10.94 10.94 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"
                                stroke="currentColor"
                                stroke-width="1.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            />
                            <line
                                x1="1"
                                y1="1"
                                x2="23"
                                y2="23"
                                stroke="currentColor"
                                stroke-width="1.5"
                                stroke-linecap="round"
                            />
                        </svg>
                    </button>
                )}
            </div>
        )
    }

    {
        shouldRenderEmailError && (
            <p
                id={emailErrorId}
                class="form-field__error text-body-p3-small"
                aria-live="polite"
                aria-hidden="true"
            >
                {emailErrorMessage}
            </p>
        )
    }
</div>

<style>
    .form-field {
        display: flex;
        flex-direction: column;
        gap: var(--space-1);
        width: 100%;
    }

    .form-field--field-only {
        gap: 0;
    }

    .form-field__label {
        margin: 0;
        color: var(--neutral-grey-1);
        font-weight: 400;
    }

    .form-field__label--primary {
        color: var(--text-primary);
    }

    .form-field__required {
        color: #c00;
        margin-left: var(--space-1);
    }

    .form-field__input,
    .form-field__select {
        width: 100%;
        height: var(--space-8);
        padding: var(--space-2) var(--space-4);
        border: var(--stroke-1) solid var(--neutral-grey-2);
        border-radius: var(--radius-s);
        background-color: var(--surface-white);
        color: var(--text-primary);
        font-size: inherit;
        font-family: var(--font-body);
        cursor: pointer;
    }

    .form-field__input::placeholder {
        color: var(--neutral-grey-3);
    }

    .form-field__textarea {
        height: auto;
        min-height: var(--space-8);
        resize: vertical;
        cursor: text;
    }

    .form-field__error {
        margin: 0;
        color: var(--feedback-error);
        min-height: 1.4em;
        visibility: hidden;
        opacity: 0;
        transition: opacity 180ms ease;
    }

    .form-field__error.is-visible {
        visibility: visible;
        opacity: 1;
    }

    .form-field__input:focus {
        outline: none;
        border-color: var(--border-primary);
        box-shadow: 0 0 0 3px rgba(85, 61, 204, 0.1);
    }

    .form-field__input-wrapper {
        position: relative;
        width: 100%;
    }

    .form-field__input--with-toggle {
        padding-right: var(--space-9);
    }

    .form-field__toggle {
        position: absolute;
        top: 50%;
        right: var(--space-3);
        transform: translateY(-50%);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        border: none;
        background: transparent;
        color: var(--neutral-grey-1);
        cursor: pointer;
    }

    .form-field__toggle:focus-visible {
        outline: var(--stroke-2) solid var(--border-primary);
        outline-offset: var(--stroke-2);
        border-radius: var(--radius-xs);
    }

    .form-field__toggle-icon--eye-off {
        display: none;
    }

    .form-field__toggle.is-visible .form-field__toggle-icon--eye {
        display: none;
    }

    .form-field__toggle.is-visible .form-field__toggle-icon--eye-off {
        display: block;
    }

    .form-field__select {
        -webkit-appearance: none;
        -moz-appearance: none;
        appearance: none;
        color-scheme: light;
        background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23707070' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right var(--space-2) center;
        background-size: 1.25rem;
        padding-right: var(--space-6);
    }

    .form-field__select-wrapper {
        position: relative;
        width: 100%;
    }

    .form-field__select {
        width: 100%;
    }

    .form-field__select option {
        color: var(--text-primary);
        background-color: var(--surface-white);
        padding: var(--space-3);
        border: none;
    }

    .form-field__select option:disabled {
        color: var(--neutral-grey-3);
    }

    .form-field__select option[value=''] {
        color: var(--neutral-grey-3);
    }

    .form-field__select.is-placeholder {
        color: var(--neutral-grey-3);
    }

    .form-field__select:focus {
        outline: none;
        border-color: var(--border-primary);
        box-shadow: 0 0 0 3px rgba(85, 61, 204, 0.1);
    }

    @media (max-width: 1023px) {
        .form-field__input,
        .form-field__select {
            height: auto;
            min-height: 2.75rem;
            padding: var(--space-3) var(--space-4);
        }
    }
</style>

<script>
    document.querySelectorAll<HTMLSelectElement>('[data-select]').forEach((select) => {
        select.addEventListener('change', () => {
            select.classList.toggle('is-placeholder', select.value === '');
        });
    });

    function syncEmailErrorState(input: HTMLInputElement) {
        const errorId = input.dataset.errorId;
        if (!errorId) return;

        const errorNode = document.getElementById(errorId);
        if (!errorNode) return;

        const shouldShow = input.value.trim().length > 0 && !input.checkValidity();
        input.setAttribute('aria-invalid', shouldShow ? 'true' : 'false');
        errorNode.classList.toggle('is-visible', shouldShow);
        errorNode.setAttribute('aria-hidden', shouldShow ? 'false' : 'true');
    }

    document.querySelectorAll<HTMLInputElement>('[data-email-field="true"]').forEach((input) => {
        const mode = input.dataset.emailValidation;

        if (mode === 'none') {
            return;
        }

        if (mode === 'live') {
            input.addEventListener('input', () => syncEmailErrorState(input));
            input.addEventListener('blur', () => syncEmailErrorState(input));
        }

        input.addEventListener('invalid', (event) => {
            event.preventDefault();

            const errorId = input.dataset.errorId;
            if (!errorId) return;

            const errorNode = document.getElementById(errorId);
            if (!errorNode) return;

            input.setAttribute('aria-invalid', 'true');
            errorNode.classList.add('is-visible');
            errorNode.setAttribute('aria-hidden', 'false');
        });
    });

    document.querySelectorAll<HTMLButtonElement>('[data-password-toggle]').forEach((button) => {
        const input = button
            .closest('.form-field__input-wrapper')
            ?.querySelector<HTMLInputElement>('.form-field__input');
        if (!input) return;

        button.addEventListener('click', () => {
            const willReveal = input.type === 'password';
            input.type = willReveal ? 'text' : 'password';
            button.classList.toggle('is-visible', willReveal);
            button.setAttribute('aria-pressed', String(willReveal));
            button.setAttribute(
                'aria-label',
                willReveal ? button.dataset.labelHide || '' : button.dataset.labelShow || ''
            );
        });
    });
</script>
