---
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { t } from '../../lib/i18n/t';

export interface FaqAccordionItem {
    id: string;
    questionKey: string;
    questionFallback: string;
    answerKey: string;
    answerFallback: string;
    color?: string;
}

interface Props {
    locale: Locale;
    copy: CMSDictionary;
    titleKey: string;
    titleFallback: string;
    items: FaqAccordionItem[];
}

const { locale, copy, titleKey, titleFallback, items } = Astro.props as Props;
const hasFooter = Astro.slots.has('footer');
---

<section class="faq-accordion" aria-label={t(copy, titleKey, locale, titleFallback)}>
    <div class="faq-accordion__heading">
        <h2 class="faq-accordion__title faq-fly-in" data-copy-key={titleKey}>
            {t(copy, titleKey, locale, titleFallback)}
        </h2>
    </div>

    <div class="faq-accordion__list">
        {
            items.map((faq, idx) => (
                <div
                    class={`faq-accordion__item faq-fly-in${idx === 0 ? ' is-open' : ''}`}
                    data-faq-id={faq.id}
                    style={faq.color ? `--faq-color: ${faq.color}` : undefined}
                >
                    <button
                        type="button"
                        class={`faq-accordion__trigger${idx === 0 ? ' is-open' : ''}`}
                        data-faq-trigger={faq.id}
                        aria-expanded={idx === 0 ? 'true' : 'false'}
                        aria-controls={`faq-accordion-content-${faq.id}`}
                    >
                        <span
                            class="faq-accordion__question text-body-p1-bold"
                            data-copy-key={faq.questionKey}
                        >
                            {t(copy, faq.questionKey, locale, faq.questionFallback)}
                        </span>
                        <span class="faq-accordion__chevron icon-m" aria-hidden="true">
                            <svg
                                width="100%"
                                height="100%"
                                viewBox="0 0 20 20"
                                fill="none"
                                xmlns="http://www.w3.org/2000/svg"
                            >
                                <path
                                    d="M5 7.5L10 12.5L15 7.5"
                                    stroke="currentColor"
                                    stroke-width="1.5"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                />
                            </svg>
                        </span>
                    </button>

                    <div class={`faq-accordion__content-clip${idx === 0 ? ' is-open' : ''}`}>
                        <div
                            class="faq-accordion__content"
                            id={`faq-accordion-content-${faq.id}`}
                            role="region"
                            aria-labelledby={`faq-accordion-trigger-${faq.id}`}
                        >
                            <p
                                class="faq-accordion__answer text-body-p1"
                                data-copy-key={faq.answerKey}
                            >
                                {t(copy, faq.answerKey, locale, faq.answerFallback)}
                            </p>
                        </div>
                    </div>
                </div>
            ))
        }
    </div>

    {
        hasFooter && (
            <div class="faq-accordion__footer">
                <slot name="footer" />
            </div>
        )
    }
</section>

<style>
    .faq-accordion {
        width: 100%;
        background: var(--surface-white);
        padding: var(--section-pad-block) var(--content-margin-inline);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--space-9);
    }

    .faq-accordion__heading {
        width: min(100%, 90rem);
        text-align: center;
    }

    .faq-accordion__title {
        margin: 0;
        color: var(--text-primary);
    }

    .faq-fly-in {
        opacity: 0;
        transform: translateY(1.625rem);
        transition:
            opacity var(--motion-duration-heading) ease,
            transform var(--motion-duration-heading) var(--motion-ease-standard);
    }

    .faq-fly-in.is-visible {
        opacity: 1;
        transform: translateY(0);
    }

    /* Pause after heading before FAQ items appear */
    .faq-accordion__item.faq-fly-in {
        transition:
            opacity var(--motion-duration-card) ease 0.9s,
            transform var(--motion-duration-card) var(--motion-ease-standard) 0.9s;
    }

    .faq-accordion__list {
        width: min(100%, 90rem);
        display: flex;
        flex-direction: column;
        gap: var(--space-5);
    }

    .faq-accordion__item {
        border-radius: var(--layout-card-radius);
        background: var(--surface-white);
        box-shadow: var(--shadow-card);
    }

    .faq-accordion__item.is-open {
        box-shadow: var(--shadow-card);
    }

    .faq-accordion__trigger {
        appearance: none;
        background: transparent;
        border: 0;
        color: var(--neutral-black);
        padding: var(--space-8);
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-4);
        cursor: pointer;
        text-align: left;
        transition: all 220ms ease;
    }

    .faq-accordion__trigger:focus-visible {
        outline: var(--stroke-2) solid var(--brand-blue-main);
        outline-offset: var(--space-1);
    }

    .faq-accordion__question {
        margin: 0;
        color: var(--text-primary);
        flex: 1;
    }

    .faq-accordion__chevron {
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        transform: rotate(0deg);
        transition: transform 240ms cubic-bezier(0.4, 0, 0.2, 1);
    }

    .faq-accordion__trigger.is-open .faq-accordion__chevron {
        transform: rotate(180deg);
    }

    .faq-accordion__content-clip {
        overflow: hidden;
        height: 0;
        transition: height 450ms cubic-bezier(0.4, 0, 0.2, 1);
    }

    .faq-accordion__content {
        padding: 0 var(--space-8) var(--space-8) var(--space-8);
    }

    .faq-accordion__answer {
        margin: 0;
        color: var(--text-primary);
    }

    .faq-accordion__footer {
        width: min(100%, 90rem);
    }

    @media (max-width: 767px) {
        .faq-accordion {
            padding-top: var(--space-9);
            padding-bottom: var(--space-9);
            gap: var(--space-8);
        }

        .faq-accordion__heading {
            text-align: left;
        }

        .faq-accordion__trigger {
            padding: var(--space-6);
        }

        .faq-accordion__content {
            padding: 0 var(--space-6) var(--space-6) var(--space-6);
        }
    }
</style>

<script>
    document.querySelectorAll<HTMLElement>('.faq-accordion').forEach((faqsFlySection) => {
        const faqFlyEls = faqsFlySection.querySelectorAll<HTMLElement>('.faq-fly-in');
        const faqFlyObserver = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        faqFlyObserver.unobserve(entry.target);
                        faqFlyEls.forEach((el, i) => {
                            setTimeout(() => el.classList.add('is-visible'), i * 80);
                        });
                    }
                });
            },
            { threshold: 0.15 }
        );
        faqFlyObserver.observe(faqsFlySection);

        const triggers = faqsFlySection.querySelectorAll('.faq-accordion__trigger');

        const firstOpenClip = faqsFlySection.querySelector(
            '.faq-accordion__content-clip.is-open'
        ) as HTMLElement | null;
        if (firstOpenClip) {
            const inner = firstOpenClip.querySelector('.faq-accordion__content') as HTMLElement;
            firstOpenClip.style.height = inner.scrollHeight + 'px';
        }

        triggers.forEach((trigger) => {
            trigger.addEventListener('click', () => {
                const item = trigger.closest('.faq-accordion__item');
                const contentClip = item?.querySelector('.faq-accordion__content-clip');
                const isOpen = trigger.classList.contains('is-open');

                triggers.forEach((t) => {
                    t.classList.remove('is-open');
                    t.setAttribute('aria-expanded', 'false');
                    t.closest('.faq-accordion__item')?.classList.remove('is-open');
                });
                faqsFlySection.querySelectorAll('.faq-accordion__content-clip').forEach((c) => {
                    (c as HTMLElement).style.height = '0';
                });

                if (!isOpen && contentClip) {
                    trigger.classList.add('is-open');
                    trigger.setAttribute('aria-expanded', 'true');
                    item?.classList.add('is-open');
                    const inner = contentClip.querySelector(
                        '.faq-accordion__content'
                    ) as HTMLElement;
                    (contentClip as HTMLElement).style.height = inner.scrollHeight + 'px';
                }
            });
        });
    });
</script>
