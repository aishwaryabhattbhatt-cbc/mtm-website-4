---
// src/components/request-demo/RequestDemoHeroSection.astro
// Figma node: 82:57895 — "Request a Demo hero"
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { t } from '../../lib/i18n/t';
import Button from '../shared/Button.astro';
import Eyebrow from '../shared/Eyebrow.astro';
import FormField from '../shared/FormField.astro';

interface Props {
    locale: Locale;
    copy: CMSDictionary;
}

const { locale, copy } = Astro.props as Props;
const base = import.meta.env.BASE_URL;

// From the HubSpot form embed snippet. Public values (they ship in the client
// bundle), so the literals are safe fallbacks when .env isn't present — e.g. a
// fresh clone or a CI job that hasn't had the build variables set.
const hubspotPortalId = import.meta.env.PUBLIC_HUBSPOT_PORTAL_ID || '343607035';
const hubspotFormGuid =
    import.meta.env.PUBLIC_HUBSPOT_FORM_GUID || 'db1da805-3985-4e72-b94a-3857b546af69';
const hubspotRegion = import.meta.env.PUBLIC_HUBSPOT_REGION || 'na3';

const expectItems = [
    {
        key: 'request_demo_hero_expect_item_1',
        fallback: 'Personalized walk-through of the tools, reports and services',
    },
    {
        key: 'request_demo_hero_expect_item_2',
        fallback: 'Q & A to understand how the MTM can support you',
    },
    {
        key: 'request_demo_hero_expect_item_3',
        fallback: 'Expert advice on how MTM can fit in your workflow',
    },
];

const industryOptions = [
    { value: '', label: 'Select your industry', labelKey: 'newsletter_industry_placeholder' },
    { value: 'media', label: 'Media', labelKey: 'solutions_item_2' },
    { value: 'advertising', label: 'Advertising', labelKey: 'solutions_item_3' },
    { value: 'govngo', label: 'Gov & NGOs', labelKey: 'solutions_item_5' },
    { value: 'education', label: 'Education', labelKey: 'solutions_item_4' },
    { value: 'industry', label: 'Industry', labelKey: 'solutions_item_1' },
    { value: 'other', label: 'Other', labelKey: 'newsletter_industry_other' },
];

const interestOptions = [
    { key: 'request_demo_hero_form_interest_mtm18', fallback: 'MTM 18+', value: 'mtm18' },
    { key: 'request_demo_hero_form_interest_junior', fallback: 'Junior', value: 'junior' },
    { key: 'request_demo_hero_form_interest_newcomer', fallback: 'Newcomers', value: 'newcomer' },
    { key: 'request_demo_hero_form_interest_census', fallback: 'Census', value: 'census' },
];
---

<section class="request-demo-hero">
    <div class="request-demo-hero__pattern" aria-hidden="true">
        <img
            src={`${base}images/request-demo/request-demo-hero-pattern.png`}
            alt=""
            class="request-demo-hero__pattern-img"
        />
    </div>

    <div class="request-demo-hero__content">
        <div class="request-demo-hero__text hero-fade-in" style="animation-delay: 0.1s">
            <h1 data-copy-key="request_demo_hero_title">
                {t(copy, 'request_demo_hero_title', locale, 'Book A Demo Today!')}
            </h1>

            <p
                class="text-body-p1 request-demo-hero__description"
                data-copy-key="request_demo_hero_description"
            >
                {
                    t(
                        copy,
                        'request_demo_hero_description',
                        locale,
                        'Interested to see what the MTM can do for you? Book a demo with one of our experts to walk you though the products and tools in more detail.'
                    )
                }
            </p>

            <div class="request-demo-hero__expect">
                <Eyebrow
                    >{
                        t(copy, 'request_demo_hero_expect_eyebrow', locale, 'What You Can Expect')
                    }</Eyebrow
                >

                <ul class="request-demo-hero__expect-list">
                    {
                        expectItems.map((item) => (
                            <li class="request-demo-hero__expect-item text-body-p1">
                                <span
                                    class="request-demo-hero__bullet icon-xs"
                                    aria-hidden="true"
                                />
                                {t(copy, item.key, locale, item.fallback)}
                            </li>
                        ))
                    }
                </ul>
            </div>
        </div>

        <div class="request-demo-hero__card hero-fade-in" style="animation-delay: 0.2s">
            <form
                class="request-demo-hero__form"
                aria-label={t(copy, 'request_demo_hero_form_aria_label', locale, 'Request a demo')}
                data-submit-href={`${base}${locale}/request-demo-success/`}
                data-error-href={`${base}${locale}/submission-error/`}
                data-hs-portal={hubspotPortalId}
                data-hs-form={hubspotFormGuid}
                data-hs-region={hubspotRegion}
            >
                {/* Honeypot: bots fill it, humans never see it. Hidden from AT too. */}
                <div class="request-demo-hero__hp" aria-hidden="true">
                    <label for="request-demo-company-website">Company website</label>
                    <input
                        id="request-demo-company-website"
                        type="text"
                        name="companyWebsite"
                        tabindex="-1"
                        autocomplete="off"
                    />
                </div>
                <div class="request-demo-hero__row">
                    <FormField
                        locale={locale}
                        copy={copy}
                        variant="field-with-label"
                        type="text"
                        name="firstName"
                        labelKey="request_demo_hero_form_first_name_label"
                        label="First Name"
                        placeholderKey="request_demo_hero_form_first_name_placeholder"
                        placeholder="John"
                        labelColor="primary"
                        required
                    />
                    <FormField
                        locale={locale}
                        copy={copy}
                        variant="field-with-label"
                        type="text"
                        name="lastName"
                        labelKey="request_demo_hero_form_last_name_label"
                        label="Last Name"
                        placeholderKey="request_demo_hero_form_last_name_placeholder"
                        placeholder="Doe"
                        labelColor="primary"
                        required
                    />
                </div>

                <div class="request-demo-hero__row">
                    <FormField
                        locale={locale}
                        copy={copy}
                        variant="field-with-label"
                        type="email"
                        name="email"
                        labelKey="request_demo_hero_form_email_label"
                        label="Work Email"
                        placeholderKey="request_demo_hero_form_email_placeholder"
                        placeholder="john@workmail.com"
                        emailValidation="none"
                        labelColor="primary"
                        required
                    />
                    <FormField
                        locale={locale}
                        copy={copy}
                        variant="field-with-label"
                        type="text"
                        name="organisation"
                        labelKey="request_demo_hero_form_org_label"
                        label="Organisation"
                        placeholderKey="request_demo_hero_form_org_placeholder"
                        placeholder="Organisation Name"
                        labelColor="primary"
                        required
                    />
                </div>

                <FormField
                    locale={locale}
                    copy={copy}
                    variant="field-with-label"
                    type="select"
                    name="industry"
                    labelKey="request_demo_hero_form_industry_label"
                    label="Industry"
                    placeholderKey="newsletter_industry_placeholder"
                    placeholder="Select your industry"
                    labelColor="primary"
                    options={industryOptions}
                    required
                />

                <div class="request-demo-hero__group">
                    <p
                        class="text-body-p3 request-demo-hero__group-label"
                        id="request-demo-language-label"
                        data-copy-key="request_demo_hero_form_language_label"
                    >
                        {
                            t(
                                copy,
                                'request_demo_hero_form_language_label',
                                locale,
                                'Language Preference'
                            )
                        }
                    </p>
                    <div
                        class="request-demo-hero__choice-grid"
                        role="radiogroup"
                        aria-labelledby="request-demo-language-label"
                    >
                        <label class="request-demo-hero__choice text-body-p3">
                            <input type="radio" name="language" value="en" checked />
                            {t(copy, 'request_demo_hero_form_language_en', locale, 'English')}
                        </label>
                        <label class="request-demo-hero__choice text-body-p3">
                            <input type="radio" name="language" value="fr" />
                            {t(copy, 'request_demo_hero_form_language_fr', locale, 'French')}
                        </label>
                    </div>
                </div>

                <div class="request-demo-hero__group">
                    <p
                        class="text-body-p3 request-demo-hero__group-label"
                        id="request-demo-interest-label"
                        data-copy-key="request_demo_hero_form_interest_label"
                    >
                        {
                            t(
                                copy,
                                'request_demo_hero_form_interest_label',
                                locale,
                                'What are you interested in?'
                            )
                        }
                    </p>
                    <div
                        class="request-demo-hero__choice-grid"
                        role="group"
                        aria-labelledby="request-demo-interest-label"
                    >
                        {
                            interestOptions.map((option) => (
                                <label class="request-demo-hero__choice text-body-p3">
                                    <input type="checkbox" name="interests" value={option.value} />
                                    {t(copy, option.key, locale, option.fallback)}
                                </label>
                            ))
                        }
                    </div>

                    <div class="request-demo-hero__message">
                        <p
                            class="text-body-p3 request-demo-hero__message-label"
                            data-copy-key="request_demo_hero_form_message_label"
                        >
                            {
                                t(
                                    copy,
                                    'request_demo_hero_form_message_label',
                                    locale,
                                    'Something else? Please enter below.'
                                )
                            }
                        </p>
                        <FormField
                            locale={locale}
                            copy={copy}
                            variant="field-only"
                            type="textarea"
                            name="message"
                            placeholderKey="request_demo_hero_form_message_placeholder"
                            placeholder="Write your message here..."
                        />
                    </div>
                </div>

                <label class="request-demo-hero__choice request-demo-hero__newsletter text-body-p3">
                    <input type="checkbox" name="newsletter" checked />
                    {
                        t(
                            copy,
                            'request_demo_hero_form_newsletter_label',
                            locale,
                            'Subscribe to our newsletter'
                        )
                    }
                </label>

                <Button variant="primary" type="submit" class="request-demo-hero__submit">
                    {t(copy, 'request_demo_hero_form_submit', locale, 'Submit')}
                </Button>
            </form>
        </div>
    </div>
</section>

<style>
    .request-demo-hero {
        position: relative;
        width: 100%;
        overflow: clip;
        background: var(--surface-white);
        margin-top: var(--navbar-height);
        padding: var(--section-pad-block) var(--content-margin-inline);
    }

    /* Honeypot. display:none is skipped by some bots, so move it out of view instead. */
    .request-demo-hero__hp {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
        pointer-events: none;
    }

    .hero-fade-in {
        opacity: 0;
        animation: hero-fade-in-up var(--motion-duration-heading) var(--motion-ease-standard)
            forwards;
    }

    @keyframes hero-fade-in-up {
        from {
            opacity: 0;
            transform: translateY(1.625rem);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .hero-fade-in {
            animation: none;
            opacity: 1;
        }
    }

    .request-demo-hero__pattern {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        pointer-events: none;
        z-index: 0;
    }

    .request-demo-hero__pattern-img {
        width: 100%;
        height: auto;
        display: block;
    }

    .request-demo-hero__content {
        position: relative;
        z-index: 1;
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        align-items: start;
        gap: var(--space-11);
        max-width: 90rem;
        margin: 0 auto;
    }

    .request-demo-hero__text {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: var(--space-4);
        max-width: 34rem;
    }

    .request-demo-hero__text h1 {
        margin: 0;
        color: var(--text-primary);
    }

    .request-demo-hero__description {
        margin: 0;
        color: var(--text-primary);
    }

    .request-demo-hero__expect {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: var(--space-7);
        margin-top: var(--space-6);
    }

    .request-demo-hero__expect-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
    }

    .request-demo-hero__expect-item {
        display: flex;
        align-items: flex-start;
        gap: var(--space-4);
        color: var(--text-primary);
    }

    .request-demo-hero__bullet {
        flex-shrink: 0;
        margin-top: var(--space-1);
        border-radius: var(--radius-full);
        background: var(--badge-mtm-18);
    }

    .request-demo-hero__card {
        display: flex;
        flex-direction: column;
        gap: var(--space-6);
        width: 100%;
        max-width: 37.5rem;
        margin-left: auto;
        padding: var(--space-9);
        border-radius: var(--radius-m);
        background: var(--surface-blue);
        box-shadow: var(--shadow-card);
    }

    .request-demo-hero__form {
        display: flex;
        flex-direction: column;
        gap: var(--space-5);
    }

    .request-demo-hero__row {
        display: flex;
        gap: var(--space-5);
    }

    .request-demo-hero__row > :global(.form-field) {
        flex: 1;
        min-width: 0;
    }

    .request-demo-hero__group {
        display: flex;
        flex-direction: column;
        gap: var(--space-1);
    }

    .request-demo-hero__group-label {
        margin: 0;
        color: var(--text-primary);
    }

    .request-demo-hero__choice-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        column-gap: var(--space-6);
        row-gap: var(--space-1);
        align-items: center;
    }

    .request-demo-hero__choice {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        min-height: var(--space-7);
        color: var(--text-primary);
        cursor: pointer;
    }

    .request-demo-hero__choice input {
        width: var(--icon-s);
        height: var(--icon-s);
        flex-shrink: 0;
        accent-color: var(--neutral-black);
        cursor: pointer;
    }

    .request-demo-hero__message {
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
        margin-top: var(--space-5);
    }

    .request-demo-hero__message-label {
        margin: 0;
        color: var(--text-primary);
    }

    .request-demo-hero__newsletter {
        color: var(--text-primary);
    }

    .request-demo-hero__submit {
        width: 100%;
        text-align: center;
    }

    @media (max-width: 1023px) {
        .request-demo-hero {
            margin-top: 0;
        }

        .request-demo-hero__content {
            grid-template-columns: minmax(0, 1fr);
            gap: var(--space-9);
        }

        .request-demo-hero__text {
            max-width: 100%;
        }

        .request-demo-hero__card {
            max-width: 100%;
            margin-left: 0;
        }
    }

    @media (max-width: 767px) {
        .request-demo-hero {
            padding: var(--space-9) var(--content-margin-inline);
        }

        .request-demo-hero__content {
            gap: var(--space-7);
        }

        .request-demo-hero__row {
            flex-direction: column;
            gap: var(--space-5);
        }

        .request-demo-hero__card {
            padding: var(--space-6);
        }

        .request-demo-hero__choice-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }
</style>

<script>
    const form = document.querySelector<HTMLFormElement>('.request-demo-hero__form');
    const emailInput = form?.querySelector<HTMLInputElement>('input[name="email"]');

    const prefillEmail = new URLSearchParams(window.location.search).get('email');
    if (emailInput && prefillEmail) {
        emailInput.value = prefillEmail;
    }

    const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

    // Our input names -> HubSpot fields. `objectTypeId` is required for properties
    // that live on the Company object (0-2) rather than the Contact (0-1); the form
    // rejects those two as missing if they're sent unqualified.
    const FIELD_MAP: Array<{
        formName: string;
        name: string;
        objectTypeId?: string;
        values?: Record<string, string>;
    }> = [
        { formName: 'firstName', name: 'firstname' },
        { formName: 'lastName', name: 'lastname' },
        { formName: 'email', name: 'email' },
        { formName: 'organisation', name: 'name', objectTypeId: '0-2' },
        {
            formName: 'industry',
            name: 'select_industry',
            // HubSpot's internal names for this property are the full labels, so our
            // short slugs have to be translated. A value outside this list is dropped
            // silently by HubSpot, so these must stay in step with the property options.
            values: {
                media: 'Media and Broadcasting',
                advertising: 'Advertising and Marketing',
                govngo: 'Government and NGOs',
                education: 'Education and Research',
                industry: 'Industry',
                other: 'Other',
            },
        },
        { formName: 'language', name: 'language', values: { en: 'English', fr: 'French' } },
        { formName: 'message', name: 'description' },
    ];

    form?.addEventListener('submit', async (event) => {
        event.preventDefault();

        if (!form.checkValidity()) {
            form.reportValidity();
            return;
        }

        const { submitHref, errorHref, hsPortal, hsForm, hsRegion } = form.dataset;
        const data = new FormData(form);

        // Honeypot tripped: pretend it worked, send nothing.
        if (String(data.get('companyWebsite') ?? '').trim() !== '') {
            if (submitHref) window.location.href = submitHref;
            return;
        }

        const fields = FIELD_MAP.map(({ formName, name, objectTypeId, values }) => {
            const raw = String(data.get(formName) ?? '').trim();
            return {
                ...(objectTypeId ? { objectTypeId } : {}),
                name,
                value: values ? (values[raw] ?? '') : raw,
            };
        }).filter((field) => field.value !== '');

        // HubSpot expects multi-checkbox values as one semicolon-delimited string,
        // using the property's internal names (which here are the full labels).
        const INTEREST_VALUES: Record<string, string> = {
            mtm18: 'MTM 18+',
            junior: 'MTM Junior',
            newcomer: 'MTM Newcomers',
            census: 'MTM Census',
        };
        const interests = data
            .getAll('interests')
            .map((value) => INTEREST_VALUES[String(value)])
            .filter(Boolean);
        if (interests.length > 0) {
            fields.push({ name: 'what_are_you_interested_in_', value: interests.join(';') });
        }

        // Set by the HubSpot tracking script; ties the submission to the visitor's
        // session. Absent on a first visit with cookies blocked, which is fine.
        const hutk = document.cookie.match(/(?:^|;\s*)hubspotutk=([^;]*)/)?.[1];

        submitButton?.setAttribute('disabled', '');
        submitButton?.setAttribute('aria-busy', 'true');

        try {
            const response = await fetch(
                `https://api-${hsRegion}.hsforms.com/submissions/v3/integration/submit/${hsPortal}/${hsForm}`,
                {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        fields,
                        context: {
                            pageUri: window.location.href,
                            pageName: document.title,
                            ...(hutk ? { hutk } : {}),
                        },
                    }),
                }
            );

            if (!response.ok) {
                // The body names the offending field, which is the only practical
                // way to debug a rejection. Surface it before redirecting away.
                throw new Error(`HubSpot responded ${response.status}: ${await response.text()}`);
            }

            if (submitHref) window.location.href = submitHref;
        } catch (error) {
            console.error('Request demo submission failed', error);
            submitButton?.removeAttribute('disabled');
            submitButton?.removeAttribute('aria-busy');
            if (errorHref) window.location.href = errorHref;
        }
    });
</script>
