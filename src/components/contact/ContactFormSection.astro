---
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { t } from '../../lib/i18n/t';
import Button from '../shared/Button.astro';
import FormField from '../shared/FormField.astro';

interface Props {
    locale: Locale;
    copy: CMSDictionary;
}

const { locale, copy } = Astro.props as Props;
const base = import.meta.env.BASE_URL;
---

<section class="contact-form-section" data-contact-form-section>
    <div class="contact-form-section__edge contact-form-section__edge--left" aria-hidden="true">
        <img
            src={`${base}images/contact-us/left-edge.png`}
            alt=""
            class="contact-form-section__edge-img"
        />
    </div>
    <div class="contact-form-section__edge contact-form-section__edge--right" aria-hidden="true">
        <img
            src={`${base}images/contact-us/right-edge.png`}
            alt=""
            class="contact-form-section__edge-img"
        />
    </div>

    <div class="contact-form-section__inner">
        <div class="contact-form-section__heading hero-fade-in" style="animation-delay: 0.1s">
            <h2 class="contact-form-section__title" data-copy-key="contact_page_title">
                {t(copy, 'contact_page_title', locale, 'Contact Us')}
            </h2>
            <p
                class="text-body-p2 contact-form-section__description"
                data-copy-key="contact_page_description"
            >
                {
                    t(
                        copy,
                        'contact_page_description',
                        locale,
                        'Fill out the form below and our team will get back to you.'
                    )
                }
            </p>
        </div>

        <div class="contact-form-section__card hero-fade-in" style="animation-delay: 0.2s">
            <form class="contact-form-section__form" data-contact-form novalidate>
                <div class="contact-form-section__row">
                    <FormField
                        locale={locale}
                        copy={copy}
                        variant="field-with-label"
                        type="text"
                        name="firstName"
                        labelKey="contact_first_name_label"
                        label="First Name"
                        placeholderKey="contact_first_name_placeholder"
                        placeholder="John"
                        labelColor="primary"
                        required
                    />
                    <FormField
                        locale={locale}
                        copy={copy}
                        variant="field-with-label"
                        type="text"
                        name="lastName"
                        labelKey="contact_last_name_label"
                        label="Last Name"
                        placeholderKey="contact_last_name_placeholder"
                        placeholder="Doe"
                        labelColor="primary"
                        required
                    />
                </div>

                <FormField
                    locale={locale}
                    copy={copy}
                    variant="field-with-label"
                    type="email"
                    name="email"
                    labelKey="contact_email_label"
                    label="Email"
                    placeholderKey="contact_email_placeholder"
                    placeholder="john@workmail.com"
                    emailValidation="none"
                    labelColor="primary"
                    required
                />

                <FormField
                    locale={locale}
                    copy={copy}
                    variant="field-with-label"
                    type="textarea"
                    name="message"
                    labelKey="contact_message_label"
                    label="Message"
                    placeholderKey="contact_message_placeholder"
                    placeholder="How can we help?"
                    labelColor="primary"
                    required
                />

                <Button
                    variant="primary"
                    type="submit"
                    class="contact-form-section__submit"
                    data-copy-key="contact_submit_cta"
                >
                    {t(copy, 'contact_submit_cta', locale, 'Submit')}
                </Button>
            </form>

            <div
                class="contact-form-section__success"
                data-contact-form-success
                role="status"
                aria-live="polite"
                aria-atomic="true"
                tabindex="-1"
            >
                <span class="contact-form-section__success-icon" aria-hidden="true">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="icon-s"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                </span>
                <div class="contact-form-section__success-copy">
                    <p class="text-body-p1-bold" data-copy-key="contact_success_title">
                        {t(copy, 'contact_success_title', locale, 'Success!')}
                    </p>
                    <p class="text-body-p3" data-copy-key="contact_success_message">
                        {
                            t(
                                copy,
                                'contact_success_message',
                                locale,
                                "Thanks for reaching out. We'll be in touch shortly."
                            )
                        }
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .contact-form-section {
        position: relative;
        width: 100%;
        overflow: clip;
        margin-top: var(--navbar-height);
        padding: var(--space-10) var(--content-margin-inline) var(--space-12);
        background: var(--surface-white);
        display: flex;
        align-items: center;
    }

    .contact-form-section__edge {
        position: absolute;
        top: 0;
        bottom: 0;
        pointer-events: none;
        z-index: 0;
    }

    .contact-form-section__edge--left {
        left: 0;
    }

    .contact-form-section__edge--right {
        right: 0;
    }

    .contact-form-section__edge-img {
        height: 100%;
        width: auto;
        display: block;
    }

    .contact-form-section__inner {
        position: relative;
        z-index: 1;
        width: 100%;
        max-width: 37.5rem;
        display: flex;
        flex-direction: column;
        gap: var(--space-6);
    }

    .contact-form-section__heading {
        display: flex;
        flex-direction: column;
        gap: var(--title-desc-gap);
        width: 100%;
        text-align: left;
    }

    .contact-form-section__title {
        margin: 0;
        font-family: var(--font-heading);
        font-size: var(--fs-subsection-h2);
        font-weight: var(--fw-semibold);
        line-height: var(--lh-tight);
        letter-spacing: var(--ls-heading-lg);
        color: var(--text-primary);
    }

    .contact-form-section__description {
        margin: 0;
        color: var(--text-secondary);
    }

    .contact-form-section__card {
        display: flex;
        flex-direction: column;
        gap: var(--space-6);
        width: 100%;
        padding: var(--space-9);
        border-radius: var(--radius-m);
        background: var(--surface-blue);
        box-shadow: var(--shadow-card);
    }

    .contact-form-section__form {
        display: flex;
        flex-direction: column;
        gap: var(--space-5);
    }

    .contact-form-section__row {
        display: flex;
        gap: var(--space-5);
    }

    .contact-form-section__row > :global(.form-field) {
        flex: 1;
        min-width: 0;
    }

    .contact-form-section__submit {
        align-self: stretch;
        width: 100%;
        margin-top: var(--space-4);
    }

    .contact-form-section__success {
        display: none;
        align-items: flex-start;
        gap: var(--space-3);
        border: var(--stroke-1) solid var(--badge-newcomers);
        border-radius: var(--radius-s);
        background: var(--surface-white);
        padding: var(--space-4);
    }

    .contact-form-section__success-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: var(--space-6);
        height: var(--space-6);
        border-radius: var(--radius-full);
        background: var(--badge-newcomers);
        color: var(--text-white);
        flex-shrink: 0;
    }

    .contact-form-section__success-copy {
        display: flex;
        flex-direction: column;
        gap: var(--space-1);
    }

    .contact-form-section__success-copy p {
        margin: 0;
    }

    .contact-form-section.is-success .contact-form-section__form {
        display: none;
    }

    .contact-form-section.is-success .contact-form-section__success {
        display: flex;
    }

    @media (max-width: 1023px) {
        .contact-form-section {
            margin-top: 0;
        }

        /* Edge images are desktop-only for now — tablet/mobile treatment TBD. */
        .contact-form-section__edge {
            display: none;
        }
    }

    @media (max-width: 767px) {
        .contact-form-section__row {
            flex-direction: column;
            gap: var(--space-5);
        }

        .contact-form-section__card {
            padding: var(--space-6);
        }
    }

    /* Page-load cascade — heading, then form card fly in in sequence. */
    .hero-fade-in {
        opacity: 0;
        animation: hero-fade-in-up var(--motion-duration-heading) var(--motion-ease-standard)
            forwards;
    }

    @keyframes hero-fade-in-up {
        from {
            opacity: 0;
            transform: translateY(1.625rem);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .hero-fade-in {
            animation: none;
            opacity: 1;
        }
    }
</style>

<script>
    document.querySelectorAll<HTMLElement>('[data-contact-form-section]').forEach((section) => {
        const form = section.querySelector<HTMLFormElement>('[data-contact-form]');
        const success = section.querySelector<HTMLElement>('[data-contact-form-success]');
        if (!form) return;

        form.addEventListener('submit', (event) => {
            event.preventDefault();
            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }
            section.classList.add('is-success');
            success?.focus();
        });
    });
</script>
