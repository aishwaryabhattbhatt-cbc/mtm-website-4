---
// src/components/contact/ContactSuccessSection.astro
// Mirrors RequestDemoSuccessSection.astro's glass-card success layout.
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { t } from '../../lib/i18n/t';

interface Props {
    locale: Locale;
    copy: CMSDictionary;
}

const { locale, copy } = Astro.props as Props;
const base = import.meta.env.BASE_URL;
---

<section class="contact-success">
    <div class="contact-success__pattern" aria-hidden="true">
        <img
            src={`${base}images/request-demo/hero-pattern.png`}
            alt=""
            class="contact-success__pattern-img"
        />
    </div>

    <div class="contact-success__card">
        <div class="contact-success__content">
            <span class="contact-success__icon" aria-hidden="true">
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="icon-m"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
            </span>

            <h2 data-copy-key="contact_success_title">
                {t(copy, 'contact_success_title', locale, 'Form Submitted!')}
            </h2>

            <p
                class="text-body-p1 contact-success__description"
                data-copy-key="contact_success_description"
            >
                {
                    t(
                        copy,
                        'contact_success_description',
                        locale,
                        'Thank you for reaching out. One of our experts will be in touch with you shortly.'
                    )
                }
            </p>
        </div>
    </div>
</section>

<style>
    .contact-success {
        position: relative;
        width: 100%;
        overflow: clip;
        padding: var(--section-pad-block-lg) var(--content-margin-inline);
        margin-top: var(--navbar-height);
        background: var(--surface-white);
    }

    .contact-success__pattern {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        pointer-events: none;
        z-index: 0;
    }

    .contact-success__pattern-img {
        width: 100%;
        height: auto;
        display: block;
    }

    .contact-success__card {
        position: relative;
        z-index: 1;
        width: min(100%, 90rem);
        margin: 0 auto;
        padding: var(--space-12) var(--space-12);
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: var(--layout-card-radius);
        background: rgba(255, 255, 255, 0.39);
        border: var(--stroke-1) solid rgba(255, 255, 255, 0.37);
        backdrop-filter: blur(10px);
        box-shadow: var(--shadow-beautiful);
    }

    .contact-success__content {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: var(--space-4);
        max-width: 32rem;
    }

    .contact-success__icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: var(--space-9);
        height: var(--space-9);
        border-radius: var(--radius-full);
        background: var(--badge-newcomers);
        color: var(--text-white);
        flex-shrink: 0;
    }

    .contact-success__content h2 {
        margin: 0;
        color: var(--text-primary);
    }

    .contact-success__description {
        margin: 0;
        color: var(--text-primary);
    }

    @media (max-width: 1023px) {
        .contact-success {
            margin-top: 0;
        }
    }

    @media (max-width: 767px) {
        .contact-success__card {
            padding: var(--space-8) var(--space-5);
        }
    }
</style>
