---
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { t } from '../../lib/i18n/t';
import CarouselNavArrows from '../shared/CarouselNavArrows.astro';
import Eyebrow from '../shared/Eyebrow.astro';
import InsightsFreeReportCard from './InsightsFreeReportCard.astro';

interface Props {
    locale: Locale;
    copy: CMSDictionary;
}

const { locale, copy } = Astro.props as Props;
const base = import.meta.env.BASE_URL;

const freeReports = [
    {
        tagKey: 'free_report_1_tag',
        dateKey: 'free_report_1_date',
        titleKey: 'free_report_1_title',
        descriptionKey: 'free_report_1_description',
        imageSrc: `${base}images/insights/free-reports/Picture.png`,
    },
    {
        tagKey: 'free_report_2_tag',
        dateKey: 'free_report_2_date',
        titleKey: 'free_report_2_title',
        descriptionKey: 'free_report_2_description',
        imageSrc: `${base}images/insights/free-reports/Picture-1.png`,
    },
    {
        tagKey: 'free_report_3_tag',
        dateKey: 'free_report_3_date',
        titleKey: 'free_report_3_title',
        descriptionKey: 'free_report_3_description',
        imageSrc: `${base}images/insights/free-reports/Picture-2.png`,
    },
];
---

<section class="free-reports-section">
    <div class="free-reports-section__header heading-fly-in">
        <div class="free-reports-section__eyebrow-wrap">
            <Eyebrow>
                <span data-copy-key="Free Reports"
                    >{t(copy, 'Free Reports', locale, 'Free Reports')}</span
                >
            </Eyebrow>
        </div>

        <div class="free-reports-section__content-wrap">
            <h2 data-copy-key="section_3_title">
                {t(copy, 'section_3_title', locale, 'Insights Across Key Canadian Audiences')}
            </h2>

            <p
                class="text-body-p1 free-reports-section__description"
                data-copy-key="section_3_description"
            >
                {
                    t(
                        copy,
                        'section_3_description',
                        locale,
                        'MTM reporting helps organizations better understand the behaviours, attitudes, and technology adoption patterns of Canadians across distinct demographic and cultural segments.'
                    )
                }
            </p>
        </div>

        <div class="free-reports-section__controls-wrap">
            <CarouselNavArrows
                scrollTargetSelector="#freeReportsCarousel"
                ariaLabel="Reports navigation"
                class="free-reports-section__arrows"
            />
        </div>
    </div>

    <div class="free-reports-section__grid" id="freeReportsCarousel">
        {
            freeReports.map((report) => (
                <div class="free-reports-section__card-wrap card-fly-in">
                    <InsightsFreeReportCard
                        locale={locale}
                        copy={copy}
                        ctaHref={`${base}${locale}/insights/report-download/`}
                        imageSrc={report.imageSrc}
                        tagKey={report.tagKey}
                        dateKey={report.dateKey}
                        titleKey={report.titleKey}
                        descriptionKey={report.descriptionKey}
                    />
                </div>
            ))
        }
    </div>
</section>

<style>
    .free-reports-section {
        width: 100%;
        background: var(--surface-blue);
        /* bottom matches this section's own top padding, so the gap before
           the infographic section below (which has no top padding of its
           own) reads the same as the gap above this section. */
        padding: var(--section-pad-block) var(--content-margin-inline) var(--section-pad-block);
        display: flex;
        flex-direction: column;
        gap: 0;
    }

    .free-reports-section__header {
        display: flex;
        flex-direction: column;
        gap: var(--header-stack-gap);
    }

    .free-reports-section__eyebrow-wrap {
        display: flex;
    }

    .free-reports-section__content-wrap {
        display: flex;
        flex-direction: column;
        gap: var(--title-desc-gap);
        max-width: 56rem;
    }

    .free-reports-section__content-wrap h2 {
        margin: 0;
    }

    .free-reports-section__controls-wrap {
        display: flex;
        flex-direction: row;
        flex-wrap: wrap;
        align-items: center;
        justify-content: flex-end;
        width: 100%;
        gap: var(--space-3);
    }

    .free-reports-section__description-with-arrows {
        display: flex;
        flex-direction: column;
        gap: var(--space-5);
        align-items: flex-start;
    }

    .free-reports-section__arrows {
        display: none;
    }

    .free-reports-section__description {
        color: var(--text-secondary);
        margin: 0;
    }

    .free-reports-section__grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: var(--layout-card-gap);
    }

    .free-reports-section__card-wrap {
        min-width: 0;
    }

    @media (max-width: 1023px) {
        .free-reports-section {
            padding: var(--space-9) var(--content-margin-inline) var(--space-9);
            gap: 0;
        }

        .free-reports-section__header {
            max-width: 100%;
        }

        .free-reports-section__controls-wrap {
            display: flex;
            justify-content: flex-start;
        }

        .free-reports-section__arrows {
            display: flex;
        }

        .free-reports-section__grid {
            display: flex;
            gap: var(--layout-card-gap);
            overflow-x: auto;
            scroll-snap-type: x mandatory;
            scrollbar-width: none;
            margin-inline: calc(-1 * var(--content-margin-inline));
            padding: var(--section-header-gap) var(--content-margin-inline)
                var(--section-pad-block-lg);
            scroll-padding-inline-start: var(--content-margin-inline);
            grid-template-columns: unset;
        }

        .free-reports-section__grid::-webkit-scrollbar {
            display: none;
        }

        .free-reports-section__card-wrap {
            flex-shrink: 0;
            width: 24rem;
            scroll-snap-align: start;
            min-width: unset;
        }
    }

    @media (max-width: 767px) {
        .free-reports-section__header {
            gap: var(--space-7);
        }

        .free-reports-section__content-wrap {
            gap: var(--space-4);
        }

        .free-reports-section__card-wrap {
            width: calc(100vw - 2 * var(--content-margin-inline) - var(--space-5));
        }
    }

    .heading-fly-in {
        opacity: 0;
        transform: translateY(1.625rem);
        transition:
            opacity var(--motion-duration-heading) ease,
            transform var(--motion-duration-heading) var(--motion-ease-standard);
    }

    .heading-fly-in.is-visible {
        opacity: 1;
        transform: translateY(0);
    }

    .card-fly-in {
        opacity: 0;
        transform: translateY(1.625rem);
        transition:
            opacity var(--motion-duration-card) cubic-bezier(0.22, 1, 0.36, 1),
            transform var(--motion-duration-card) cubic-bezier(0.22, 1, 0.36, 1);
    }

    .card-fly-in.is-visible {
        opacity: 1;
        transform: translateY(0);
    }
</style>

<script>
    document.querySelectorAll<HTMLElement>('.free-reports-section').forEach((section) => {
        const heading = section.querySelector<HTMLElement>('.heading-fly-in');
        if (heading) {
            const headingObserver = new IntersectionObserver(
                ([entry]) => {
                    if (entry.isIntersecting) {
                        heading.classList.add('is-visible');
                        headingObserver.disconnect();
                    }
                },
                { threshold: 0.15 }
            );
            headingObserver.observe(heading);
        }

        // Cards sit at the same vertical scroll position (a grid row on
        // desktop, a single carousel row on mobile), so trigger off the
        // row itself and keep the stagger rather than per-card observers.
        // Raised from the 0.2 default — the row was firing while barely
        // scrolled into view, before it was actually being looked at.
        const cardsRow = section.querySelector<HTMLElement>('.free-reports-section__grid');
        const cards = section.querySelectorAll<HTMLElement>('.card-fly-in');
        if (cardsRow && cards.length) {
            const cardObserver = new IntersectionObserver(
                ([entry]) => {
                    if (entry.isIntersecting) {
                        cards.forEach((card, i) => {
                            setTimeout(() => card.classList.add('is-visible'), i * 140);
                        });
                        cardObserver.disconnect();
                    }
                },
                { threshold: 0.4 }
            );
            cardObserver.observe(cardsRow);
        }
    });
</script>
