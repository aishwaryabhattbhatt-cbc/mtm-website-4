---
// Figma node: 2074:13960 — Checkbox + compact report card row
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { t } from '../../lib/i18n/t';
import ProductPill from '../shared/ProductPill.astro';
import type { ProductVariant } from '../shared/ProductPill.astro';
import DatePill from '../shared/DatePill.astro';

interface Props {
    locale: Locale;
    copy: CMSDictionary;
    imageSrc?: string;
    tagKey: string;
    dateKey: string;
    titleKey: string;
    name: string;
    value: string;
    checked?: boolean;
    formId?: string;
}

const {
    locale,
    copy,
    imageSrc,
    tagKey,
    dateKey,
    titleKey,
    name,
    value,
    checked = true,
    formId,
} = Astro.props as Props;

function tagToVariant(tag: string): ProductVariant | null {
    const n = tag.toLowerCase().replace(/\s+/g, '');
    if (n.includes('18+') || n.includes('18plus')) return 'mtm18plus';
    if (n.includes('junior')) return 'junior';
    if (n.includes('newcomer')) return 'newcomers';
    if (n.includes('census')) return 'census';
    return null;
}

const tagText = tagKey in copy ? t(copy, tagKey, locale, '') : '';
const tagVariant = tagText ? tagToVariant(tagText) : null;
const dateText = dateKey in copy ? t(copy, dateKey, locale, '') : '';
const titleText = t(copy, titleKey, locale, '');
---

<label class="report-select-row">
    <input
        type="checkbox"
        class="report-select-row__input"
        name={name}
        value={value}
        checked={checked}
        form={formId}
    />
    <span class="report-select-row__box" aria-hidden="true">
        <svg
            class="report-select-row__check icon-xs"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"
        >
            <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
    </span>

    <span class="report-select-row__card">
        <span class="report-select-row__image-wrap">
            {
                imageSrc && (
                    <img
                        class="report-select-row__image"
                        src={imageSrc}
                        alt=""
                        loading="lazy"
                        decoding="async"
                    />
                )
            }
        </span>
        <span class="report-select-row__text">
            <span class="report-select-row__meta">
                {
                    tagVariant ? (
                        <ProductPill
                            variant={tagVariant}
                            size="small"
                            copy={copy}
                            locale={locale}
                        />
                    ) : null
                }
                {dateText && <DatePill date={dateText} />}
            </span>
            <span class="text-body-p1-bold report-select-row__title" data-copy-key={titleKey}>
                {titleText}
            </span>
        </span>
    </span>
</label>

<style>
    .report-select-row {
        display: flex;
        align-items: center;
        gap: var(--space-4);
        width: 100%;
        cursor: pointer;
    }

    .report-select-row__input {
        position: absolute;
        width: var(--stroke-1);
        height: var(--stroke-1);
        padding: 0;
        margin: calc(-1 * var(--stroke-1));
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }

    .report-select-row__box {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: var(--space-4);
        height: var(--space-4);
        flex-shrink: 0;
        border-radius: var(--radius-xs);
        border: var(--stroke-1) solid var(--border-tertiary);
        background: var(--surface-white);
        color: var(--text-white);
        transition:
            background var(--motion-duration-card),
            border-color var(--motion-duration-card);
    }

    .report-select-row__check {
        opacity: 0;
        transition: opacity var(--motion-duration-card);
    }

    .report-select-row__input:checked ~ .report-select-row__box {
        background: var(--neutral-black);
        border-color: var(--neutral-black);
    }

    .report-select-row__input:checked ~ .report-select-row__box .report-select-row__check {
        opacity: 1;
    }

    .report-select-row__input:focus-visible ~ .report-select-row__box {
        box-shadow: 0 0 0 var(--stroke-2) var(--border-primary);
    }

    .report-select-row__card {
        display: flex;
        align-items: center;
        gap: var(--space-4);
        flex: 1;
        min-width: 0;
        padding: var(--space-2) var(--space-3);
        border: var(--stroke-1) solid transparent;
        border-radius: var(--radius-s);
        background: var(--surface-white);
        box-shadow: var(--shadow-card);
        transition: border-color var(--motion-duration-card);
    }

    .report-select-row__input:checked ~ .report-select-row__card {
        border-color: var(--neutral-grey-2);
    }

    .report-select-row__image-wrap {
        width: 8.375rem;
        aspect-ratio: 134 / 64;
        flex-shrink: 0;
        overflow: hidden;
        border-radius: var(--radius-xs);
        background: var(--surface-blue);
    }

    .report-select-row__image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .report-select-row__text {
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
        flex: 1;
        min-width: 0;
    }

    .report-select-row__meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-3);
        width: 100%;
    }

    .report-select-row__title {
        display: block;
        width: 100%;
        margin: 0;
        color: var(--text-primary);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    @media (max-width: 767px) {
        .report-select-row__image-wrap {
            width: 6rem;
        }
    }
</style>
