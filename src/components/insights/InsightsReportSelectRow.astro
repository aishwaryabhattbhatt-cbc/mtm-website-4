---
// Figma node: 2074:13960 — Checkbox + compact report card row
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { t } from '../../lib/i18n/t';
import ProductPill from '../shared/ProductPill.astro';
import type { ProductVariant } from '../shared/ProductPill.astro';
import DatePill from '../shared/DatePill.astro';

interface Props {
    locale: Locale;
    copy: CMSDictionary;
    imageSrc?: string;
    tagKey: string;
    dateKey: string;
    titleKey: string;
    name: string;
    value: string;
    checked?: boolean;
    formId?: string;
    /* Literal values win over the *Key CMS lookups — that's how a caller feeds
       this row a real report (from a backend) instead of placeholder copy. */
    title?: string;
    date?: string;
    pillVariant?: ProductVariant;
}

const {
    locale,
    copy,
    imageSrc,
    tagKey,
    dateKey,
    titleKey,
    name,
    value,
    checked = true,
    formId,
    title,
    date,
    pillVariant,
} = Astro.props as Props;

function tagToVariant(tag: string): ProductVariant | null {
    const n = tag.toLowerCase().replace(/\s+/g, '');
    if (n.includes('18+') || n.includes('18plus')) return 'mtm18plus';
    if (n.includes('junior')) return 'junior';
    if (n.includes('newcomer')) return 'newcomers';
    if (n.includes('census')) return 'census';
    return null;
}

const tagText = tagKey in copy ? t(copy, tagKey, locale, '') : '';
const tagVariant = pillVariant ?? (tagText ? tagToVariant(tagText) : null);
const dateText = date ?? (dateKey in copy ? t(copy, dateKey, locale, '') : '');
const titleText = title ?? t(copy, titleKey, locale, '');

// Only CMS-sourced text gets a data-copy-key — otherwise the dev live-reload in
// runtime/script.js would overwrite a caller's real report values with copy.
const titleCopyKey = title === undefined ? titleKey : undefined;
---

<label class="report-select-row">
    <input
        type="checkbox"
        class="report-select-row__input"
        name={name}
        value={value}
        checked={checked}
        form={formId}
    />
    <span class="report-select-row__box" aria-hidden="true">
        <svg
            class="report-select-row__check icon-xs"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"
        >
            <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
    </span>

    <span class="report-select-row__card">
        <span class="report-select-row__image-wrap">
            {
                imageSrc && (
                    <img
                        class="report-select-row__image"
                        src={imageSrc}
                        alt=""
                        loading="lazy"
                        decoding="async"
                    />
                )
            }
        </span>
        <span class="report-select-row__text">
            <span class="report-select-row__meta">
                <span class="report-select-row__pills">
                    {
                        tagVariant ? (
                            <ProductPill
                                variant={tagVariant}
                                size="small"
                                copy={copy}
                                locale={locale}
                            />
                        ) : null
                    }
                </span>
                {dateText && <DatePill date={dateText} />}
            </span>
            <span class="text-body-p1-bold report-select-row__title" data-copy-key={titleCopyKey}>
                {titleText}
            </span>
        </span>
    </span>
</label>

<style>
    .report-select-row {
        position: relative;
        display: flex;
        align-items: center;
        width: 100%;
        cursor: pointer;
    }

    .report-select-row__input {
        position: absolute;
        width: var(--stroke-1);
        height: var(--stroke-1);
        padding: 0;
        margin: calc(-1 * var(--stroke-1));
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }

    /* Sits on the thumbnail rather than in its own column: the card then gets
       the full row width. Offsets clear the card's padding plus a --space-2
       inset, so the box reads as inset from the image's corner. The shadow
       keeps a white box legible over a busy photo. */
    .report-select-row__box {
        position: absolute;
        top: calc(var(--space-2) + var(--space-2));
        left: calc(var(--space-3) + var(--space-2));
        z-index: 1;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: var(--space-6);
        height: var(--space-6);
        flex-shrink: 0;
        border-radius: var(--radius-xs);
        border: var(--stroke-2) solid var(--neutral-black);
        background: var(--surface-white);
        color: var(--text-white);
        box-shadow: var(--shadow-card);
        transition:
            background var(--motion-duration-card),
            border-color var(--motion-duration-card);
    }

    /* Heavier tick to match the larger box — a size class can't change per
       breakpoint, so the weight carries the extra prominence. */
    .report-select-row__check {
        stroke-width: 4;
    }

    .report-select-row__check {
        opacity: 0;
        transition: opacity var(--motion-duration-card);
    }

    .report-select-row__input:checked ~ .report-select-row__box {
        background: var(--neutral-black);
        border-color: var(--neutral-black);
    }

    .report-select-row__input:checked ~ .report-select-row__box .report-select-row__check {
        opacity: 1;
    }

    .report-select-row__input:focus-visible ~ .report-select-row__box {
        box-shadow: 0 0 0 var(--stroke-2) var(--border-primary);
    }

    .report-select-row__card {
        display: flex;
        align-items: center;
        gap: var(--space-4);
        flex: 1;
        min-width: 0;
        padding: var(--space-2) var(--space-3);
        border: var(--stroke-1) solid transparent;
        border-radius: var(--radius-s);
        background: var(--surface-white);
        box-shadow: var(--shadow-card);
        transition: border-color var(--motion-duration-card);
    }

    .report-select-row__input:checked ~ .report-select-row__card {
        border-color: var(--neutral-grey-2);
    }

    .report-select-row__image-wrap {
        width: 8.375rem;
        aspect-ratio: 134 / 64;
        flex-shrink: 0;
        overflow: hidden;
        border-radius: var(--radius-xs);
        background: var(--surface-blue);
    }

    .report-select-row__image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .report-select-row__text {
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
        flex: 1;
        min-width: 0;
    }

    .report-select-row__meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-3);
        width: 100%;
    }

    /* The pills are grouped so space-between above pushes the date away from
       the group as a whole. Without this wrapper the runtime's extra pills are
       each their own flex item and get stretched across the row. */
    .report-select-row__pills {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        min-width: 0;
    }

    .report-select-row__title {
        display: block;
        width: 100%;
        margin: 0;
        color: var(--text-primary);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    /* Still two columns here, so the list is narrow. The row layout stays, but
       the thumbnail gives some width back to the title and takes the card's
       full height instead of holding its own 134:64 ratio. */
    @media (min-width: 1024px) and (max-width: 1200px) {
        .report-select-row__image-wrap {
            width: 7.5rem;
            aspect-ratio: auto;
            align-self: stretch;
        }
    }

    @media (max-width: 767px) {
        /* Only the offsets change — the card's padding is even at this width. */
        .report-select-row__box {
            top: calc(var(--space-3) + var(--space-2));
            left: calc(var(--space-3) + var(--space-2));
        }

        /* Image leads, text underneath: beside the text at phone widths the
           thumbnail left the title almost no room. */
        .report-select-row__card {
            flex-direction: column;
            align-items: stretch;
            /* Even inset once the image is the top edge — the tighter vertical
               padding only read right when the image sat beside the text. */
            padding: var(--space-3);
        }

        /* Full width, height following the same 134:64 ratio as the desktop
           thumbnail, so every card in the list is the same height. */
        .report-select-row__image-wrap {
            width: 100%;
        }
    }
</style>
