---
import type { CMSDictionary, Locale } from '../../lib/cms/types';

import ProductPill from '../shared/ProductPill.astro';
import type { ProductVariant } from '../shared/ProductPill.astro';
import DatePill from '../shared/DatePill.astro';
import Button from '../shared/Button.astro';

interface Props {
    locale: Locale;
    copy: CMSDictionary;
    ctaHref: string;
    imageSrc?: string;
    imageAlt?: string;
    dateKey?: string;
    titleKey?: string;
    descriptionKey?: string;
    variable1Key?: string;
    variable2Key?: string;
    ctaKey?: string;
    /* Literal values win over the *Key CMS lookups — that's how a caller feeds
       this card a real report (from a backend) instead of placeholder copy. */
    date?: string;
    title?: string;
    description?: string;
    tags?: string[];
    ctaLabel?: string;
    /* Library cards render all three pills and filter them with CSS. A card
       used outside that filter (e.g. report-download-2) passes the one it wants. */
    pillVariant?: ProductVariant;
    showDescription?: boolean;
    showCta?: boolean;
}

const {
    locale,
    copy,
    ctaHref,
    imageSrc,
    imageAlt,
    dateKey = 'report_card_date',
    titleKey = 'report_card_title',
    descriptionKey = 'report_card_description',
    variable1Key = 'report_card_variable_1',
    variable2Key = 'report_card_variable_2',
    ctaKey = 'report_card_cta',
    date,
    title,
    description,
    tags,
    ctaLabel,
    pillVariant,
    showDescription = true,
    showCta = true,
} = Astro.props as Props;

const getVal = (key: string): string => {
    const row = copy[key];
    if (!row) return '';
    return (locale === 'fr' ? row.fr : row.en) || row.en || '';
};

const dateText = date ?? getVal(dateKey);
const titleText = title ?? getVal(titleKey);
const descText = description ?? getVal(descriptionKey);
const ctaText = ctaLabel ?? getVal(ctaKey);
const variables = tags ?? [getVal(variable1Key), getVal(variable2Key)].filter(Boolean);

// Only CMS-sourced text gets a data-copy-key — otherwise the dev live-reload in
// runtime/script.js would overwrite a caller's real report values with copy.
const titleCopyKey = title === undefined ? titleKey : undefined;
const descCopyKey = description === undefined ? descriptionKey : undefined;
---

<div class="report-card">
    <div class="report-card__image-wrap">
        {
            imageSrc ? (
                <img
                    class="report-card__image"
                    src={imageSrc}
                    alt={imageAlt ?? ''}
                    loading="lazy"
                    decoding="async"
                />
            ) : (
                <div class="report-card__image-placeholder" />
            )
        }
    </div>

    <div class="report-card__body">
        <div class="report-card__top">
            <div class="report-card__meta">
                {
                    pillVariant ? (
                        <span data-pill-variant={pillVariant}>
                            <ProductPill
                                variant={pillVariant}
                                size="big"
                                copy={copy}
                                locale={locale}
                            />
                        </span>
                    ) : (
                        <Fragment>
                            <span data-pill-variant="junior">
                                <ProductPill
                                    variant="junior"
                                    size="big"
                                    copy={copy}
                                    locale={locale}
                                />
                            </span>
                            <span data-pill-variant="mtm18plus">
                                <ProductPill
                                    variant="mtm18plus"
                                    size="big"
                                    copy={copy}
                                    locale={locale}
                                />
                            </span>
                            <span data-pill-variant="newcomers">
                                <ProductPill
                                    variant="newcomers"
                                    size="big"
                                    copy={copy}
                                    locale={locale}
                                />
                            </span>
                        </Fragment>
                    )
                }
                {dateText && <DatePill date={dateText} />}
            </div>

            {
                (titleText || (showDescription && descText)) && (
                    <div class="report-card__text">
                        {titleText && (
                            <p
                                class="text-body-p1-bold report-card__title"
                                data-copy-key={titleCopyKey}
                            >
                                {titleText}
                            </p>
                        )}
                        {showDescription && descText && (
                            <p
                                class="text-body-p2 report-card__description"
                                data-copy-key={descCopyKey}
                            >
                                {descText}
                            </p>
                        )}
                    </div>
                )
            }

            {
                variables.length > 0 && (
                    <div class="report-card__tags">
                        {variables.map((v) => (
                            <span class="report-card__var-pill text-body-p3">{v}</span>
                        ))}
                    </div>
                )
            }
        </div>

        {
            showCta && (
                <Button variant="tertiary" size="md" href={ctaHref}>
                    {ctaText || 'View Press Release'}
                </Button>
            )
        }
    </div>
</div>

<style>
    .report-card {
        display: flex;
        flex-direction: column;
        gap: var(--space-5);
        background: var(--surface-white);
        border-radius: var(--layout-card-radius);
        box-shadow: var(--shadow-card);
        padding: var(--card-pad-thin);
        overflow: hidden;
    }

    .report-card__image-wrap {
        width: 100%;
        aspect-ratio: 400 / 217;
        border-radius: var(--radius-s);
        overflow: hidden;
        flex-shrink: 0;
    }

    .report-card__image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .report-card__image-placeholder {
        width: 100%;
        height: 100%;
        background: var(--surface-blue);
    }

    .report-card__body {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: space-between;
        flex: 1;
        padding: var(--card-pad-thin);
        gap: var(--space-8);
    }

    .report-card__top {
        display: flex;
        flex-direction: column;
        gap: var(--card-stack-gap);
        width: 100%;
    }

    .report-card__meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .report-card__tag {
        background: var(--surface-blue);
        border-radius: var(--radius-full);
        padding: var(--space-2) var(--space-4);
        color: var(--text-primary);
        white-space: nowrap;
    }

    .report-card__text {
        display: flex;
        flex-direction: column;
        gap: var(--title-desc-gap);
    }

    .report-card__title {
        color: var(--text-primary);
        margin: 0;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
    }

    .report-card__description {
        color: var(--text-secondary);
        margin: 0;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
    }

    .report-card__tags {
        display: flex;
        gap: var(--space-2);
        flex-wrap: wrap;
        overflow: hidden;
    }

    .report-card__var-pill {
        background: var(--surface-blue);
        border-radius: var(--radius-full);
        padding: var(--space-1) var(--space-4);
        color: var(--text-primary);
        white-space: nowrap;
    }
</style>
