---
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { t } from '../../lib/i18n/t';
import ProductPill from '../shared/ProductPill.astro';
import DatePill from '../shared/DatePill.astro';
import Button from '../shared/Button.astro';

interface Props {
    locale: Locale;
    copy: CMSDictionary;
    ctaHref: string;
    imageSrc?: string;
    imageAlt?: string;
    dateKey?: string;
    titleKey?: string;
    descriptionKey?: string;
    variable1Key?: string;
    variable2Key?: string;
    ctaKey?: string;
}

const {
    locale,
    copy,
    ctaHref,
    imageSrc,
    imageAlt,
    dateKey = 'report_card_date',
    titleKey = 'report_card_title',
    descriptionKey = 'report_card_description',
    variable1Key = 'report_card_variable_1',
    variable2Key = 'report_card_variable_2',
    ctaKey = 'report_card_cta',
} = Astro.props as Props;

const dateText = dateKey in copy ? t(copy, dateKey, locale, '') : '';
const variable1 = variable1Key in copy ? t(copy, variable1Key, locale, '') : '';
const variable2 = variable2Key in copy ? t(copy, variable2Key, locale, '') : '';
const variables = [variable1, variable2].filter(Boolean);
---

<div class="report-card">
    <div class="report-card__image-wrap">
        {
            imageSrc ? (
                <img
                    class="report-card__image"
                    src={imageSrc}
                    alt={imageAlt ?? ''}
                    loading="lazy"
                    decoding="async"
                />
            ) : (
                <div class="report-card__image-placeholder" />
            )
        }
    </div>

    <div class="report-card__body">
        <div class="report-card__top">
            <div class="report-card__meta">
                <span data-pill-variant="junior"><ProductPill variant="junior" size="big" /></span>
                <span data-pill-variant="mtm18plus"
                    ><ProductPill variant="mtm18plus" size="big" /></span
                >
                <span data-pill-variant="newcomers"
                    ><ProductPill variant="newcomers" size="big" /></span
                >
                {dateText && <DatePill date={dateText} />}
            </div>

            <div class="report-card__text">
                <p class="text-body-p1-bold report-card__title" data-copy-key={titleKey}>
                    {t(copy, titleKey, locale, '')}
                </p>
                <p class="text-body-p2 report-card__description" data-copy-key={descriptionKey}>
                    {t(copy, descriptionKey, locale, '')}
                </p>
            </div>

            {
                variables.length > 0 && (
                    <div class="report-card__tags">
                        {variables.map((v) => (
                            <span class="report-card__var-pill text-body-p3">{v}</span>
                        ))}
                    </div>
                )
            }
        </div>

        <Button variant="tertiary" size="md" href={ctaHref}>
            {t(copy, ctaKey, locale, 'View Press Release')}
        </Button>
    </div>
</div>

<style>
    .report-card {
        display: flex;
        flex-direction: column;
        gap: var(--space-5);
        background: var(--surface-white);
        border-radius: var(--layout-card-radius);
        box-shadow: var(--shadow-card);
        padding: var(--space-3);
        overflow: hidden;
    }

    .report-card__image-wrap {
        width: 100%;
        aspect-ratio: 400 / 217;
        border-radius: var(--radius-s);
        overflow: hidden;
        flex-shrink: 0;
    }

    .report-card__image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .report-card__image-placeholder {
        width: 100%;
        height: 100%;
        background: var(--surface-blue);
    }

    .report-card__body {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: space-between;
        flex: 1;
        padding: var(--space-3);
        gap: var(--space-8);
    }

    .report-card__top {
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
        width: 100%;
    }

    .report-card__meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .report-card__tag {
        background: var(--surface-blue);
        border-radius: var(--radius-full);
        padding: var(--space-2) var(--space-4);
        color: var(--text-primary);
        white-space: nowrap;
    }

    .report-card__text {
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
    }

    .report-card__title {
        color: var(--text-primary);
        margin: 0;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
    }

    .report-card__description {
        color: var(--text-secondary);
        margin: 0;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
    }

    .report-card__tags {
        display: flex;
        gap: var(--space-2);
        flex-wrap: wrap;
        overflow: hidden;
    }

    .report-card__var-pill {
        background: var(--surface-blue);
        border-radius: var(--radius-full);
        padding: var(--space-1) var(--space-4);
        color: var(--text-primary);
        white-space: nowrap;
    }
</style>
