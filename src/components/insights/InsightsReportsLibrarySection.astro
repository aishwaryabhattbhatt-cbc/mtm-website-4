---
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { t } from '../../lib/i18n/t';
import CarouselNavArrows from '../shared/CarouselNavArrows.astro';
import Eyebrow from '../shared/Eyebrow.astro';
import Tabs from '../shared/Tabs.astro';
import RuntimeReportTemplate from './RuntimeReportTemplate.astro';
import InsightsRuntime from './InsightsRuntime.astro';

interface Props {
    locale: Locale;
    copy: CMSDictionary;
    instanceId?: string;
}

const { locale, copy, instanceId = 'insights' } = Astro.props as Props;
const carouselId = `reportsLibraryCarousel-${instanceId}`;
const filterTabs = [
    { label: t(copy, 'filter_all', locale, 'All'), value: 'all' },
    {
        label: t(copy, 'filter_mtm18plus', locale, 'MTM 18+'),
        value: 'mtm18plus',
    },
    { label: t(copy, 'filter_junior', locale, 'Junior'), value: 'junior' },
    {
        label: t(copy, 'filter_newcomers', locale, 'Newcomers'),
        value: 'newcomers',
    },
];
---

<section class="reports-library-section" data-filter="all" data-insights-kind="library">
    <div class="reports-library-section__header heading-fly-in">
        <div class="reports-library-section__eyebrow-wrap">
            <Eyebrow>{t(copy, 'section_2_eyebrow', locale, 'Reports Library')}</Eyebrow>
        </div>

        <div class="reports-library-section__content-wrap">
            <h2 data-copy-key="section_2_title">
                {
                    t(
                        copy,
                        'section_2_title',
                        locale,
                        'Research Across Every Corner of Canadian Media Behaviour'
                    )
                }
            </h2>
            <p
                class="text-body-p1 reports-library-section__description"
                data-copy-key="section_2_description"
            >
                {
                    t(
                        copy,
                        'section_2_description',
                        locale,
                        'From streaming and social platforms to news consumption, gaming, AI, and connected devices, MTM reports uncover how Canadians engage with media and technology across generations and demographic groups.'
                    )
                }
            </p>
        </div>

        <div class="reports-library-section__controls-wrap">
            <Tabs
                tabs={filterTabs}
                showArrows={false}
                id={`reports-filter-${instanceId}`}
                copy={copy}
                locale={locale}
            />
            <CarouselNavArrows
                scrollTargetSelector={`#${carouselId}`}
                ariaLabel={t(
                    copy,
                    'reports_library_carousel_aria_label',
                    locale,
                    'Reports navigation'
                )}
                class="reports-library-section__arrows"
                copy={copy}
                locale={locale}
            />
        </div>
    </div>

    <InsightsRuntime locale={locale} />
    <div class="reports-library-section__carousel" id={carouselId} data-insights-list></div>
    <RuntimeReportTemplate
        locale={locale}
        copy={copy}
        kind="library"
        wrapClass="reports-library-section__card-wrap card-fly-in"
    />
</section>

<style>
    .reports-library-section {
        width: 100%;
        /* Bottom is --space-8, not --section-pad-block: the carousel below
           already carries 80px of its own padding to clear the card shadow,
           so 40px here totals the 120px (--section-pad-block-lg) that the
           In the News section uses above its content. */
        padding: var(--section-pad-block-lg) var(--content-margin-inline) var(--space-8);
    }

    .reports-library-section__header {
        display: flex;
        flex-direction: column;
        gap: var(--header-stack-gap);
    }

    .reports-library-section__eyebrow-wrap {
        display: flex;
    }

    .reports-library-section__content-wrap {
        display: flex;
        flex-direction: column;
        gap: var(--title-desc-gap);
    }

    .reports-library-section__content-wrap h2 {
        margin: 0;
    }

    .reports-library-section__controls-wrap {
        display: flex;
        flex-direction: row;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-3);
    }

    .reports-library-section__controls-wrap :global(.tabs-bar) {
        width: fit-content;
        max-width: 100%;
        margin-right: auto;
    }

    .reports-library-section__description {
        color: var(--text-secondary);
        margin: 0;
        max-width: 52rem;
    }

    .reports-library-section__carousel {
        display: flex;
        gap: var(--layout-card-gap);
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        scrollbar-width: none;
        margin-inline: calc(-1 * var(--content-margin-inline));
        /* `overflow-x: auto` forces overflow-y to auto, so this container
           clips vertically, and the bottom padding is what keeps --shadow-card
           from being cut off: its lower layer reaches 47px + 47px/2 = 70.5px
           below the card. The shadow is defined in fixed px but --space-12 is
           rem-based, and at the ≤480px root of 14px it shrinks to 70px and
           starts clipping — hence the px floor. */
        padding: var(--space-6) var(--content-margin-inline) max(var(--space-12), 72px);
        scroll-padding-inline-start: var(--content-margin-inline);
        transition:
            opacity 180ms ease,
            transform 180ms ease;
    }

    .reports-library-section__carousel::-webkit-scrollbar {
        display: none;
    }

    :global(.reports-library-section__card-wrap) {
        flex-shrink: 0;
        /* One fixed card width at every breakpoint — no per-breakpoint
           overrides. Capped at the available width so the card can never be
           wider than the carousel on a narrow phone. */
        width: min(24rem, 100%);
        scroll-snap-align: start;
        transition:
            opacity 180ms ease,
            transform 180ms ease;
    }

    .reports-library-section.is-filter-transitioning .reports-library-section__carousel,
    .reports-library-section.is-filter-transitioning :global(.reports-library-section__card-wrap) {
        opacity: 0.9;
        transform: translateY(0.125rem);
    }

    @media (max-width: 1023px) {
        .reports-library-section {
            gap: var(--space-4);
            padding-top: var(--section-pad-block-lg);
            padding-bottom: 0;
        }

        .reports-library-section__controls-wrap {
            display: flex;
        }

        .reports-library-section__description {
            max-width: 100%;
        }
    }

    @media (max-width: 767px) {
        .reports-library-section {
            padding-top: var(--space-12);
            padding-bottom: 0;
        }

        .reports-library-section__header {
            gap: var(--space-7);
        }

        .reports-library-section__content-wrap {
            gap: var(--space-4);
        }

        .reports-library-section__controls-wrap {
            row-gap: var(--space-5);
        }

        .reports-library-section__controls-wrap :global(.tabs-bar) {
            width: 100%;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .reports-library-section__carousel,
        :global(.reports-library-section__card-wrap) {
            transition: none;
        }
    }
</style>
