---
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { t } from '../../lib/i18n/t';
import CarouselNavArrows from '../shared/CarouselNavArrows.astro';
import Eyebrow from '../shared/Eyebrow.astro';
import Tabs from '../shared/Tabs.astro';
import InsightsReportCard from './InsightsReportCard.astro';

interface Props {
    locale: Locale;
    copy: CMSDictionary;
}

const { locale, copy } = Astro.props as Props;
const base = import.meta.env.BASE_URL;

const libraryImages = [
    `${base}images/insights/report-library/Picture.png`,
    `${base}images/insights/report-library/Picture-1.png`,
    `${base}images/insights/report-library/Picture-2.png`,
    `${base}images/insights/report-library/Picture-3.png`,
];

const filterTabs = [
    { label: t(copy, 'filter_all', locale, 'All'), value: 'all' },
    { label: t(copy, 'filter_mtm18plus', locale, 'MTM 18+'), value: 'mtm18plus' },
    { label: t(copy, 'filter_junior', locale, 'Junior'), value: 'junior' },
    { label: t(copy, 'filter_newcomers', locale, 'Newcomers'), value: 'newcomers' },
];
---

<section class="reports-library-section" data-filter="all">
    <div class="reports-library-section__header heading-fly-in">
        <div class="reports-library-section__eyebrow-wrap">
            <Eyebrow>{t(copy, 'section_2_eyebrow', locale, 'Reports Library')}</Eyebrow>
        </div>

        <div class="reports-library-section__content-wrap">
            <h2 data-copy-key="section_2_title">
                {
                    t(
                        copy,
                        'section_2_title',
                        locale,
                        'Research Across Every Corner of Canadian Media Behaviour'
                    )
                }
            </h2>
            <p
                class="text-body-p1 reports-library-section__description"
                data-copy-key="section_2_description"
            >
                {
                    t(
                        copy,
                        'section_2_description',
                        locale,
                        'From streaming and social platforms to news consumption, gaming, AI, and connected devices, MTM reports uncover how Canadians engage with media and technology across generations and demographic groups.'
                    )
                }
            </p>
        </div>

        <div class="reports-library-section__controls-wrap">
            <Tabs
                tabs={filterTabs}
                showArrows={false}
                id="reports-filter"
                copy={copy}
                locale={locale}
            />
            <CarouselNavArrows
                scrollTargetSelector="#reportsLibraryCarousel"
                ariaLabel={t(
                    copy,
                    'reports_library_carousel_aria_label',
                    locale,
                    'Reports navigation'
                )}
                class="reports-library-section__arrows"
                copy={copy}
                locale={locale}
            />
        </div>
    </div>

    <div class="reports-library-section__carousel" id="reportsLibraryCarousel">
        {
            (['junior', 'mtm18plus', 'newcomers', 'junior', 'mtm18plus', 'newcomers'] as const).map(
                (variant, i) => (
                    <div
                        class="reports-library-section__card-wrap card-fly-in"
                        data-card-variant={variant}
                    >
                        <InsightsReportCard
                            locale={locale}
                            copy={copy}
                            ctaHref="#"
                            imageSrc={libraryImages[i % libraryImages.length]}
                        />
                    </div>
                )
            )
        }
    </div>
</section>

<style>
    .reports-library-section {
        width: 100%;
        padding: var(--section-pad-block-lg) var(--content-margin-inline) var(--section-pad-block);
    }

    .reports-library-section__header {
        display: flex;
        flex-direction: column;
        gap: var(--header-stack-gap);
    }

    .reports-library-section__eyebrow-wrap {
        display: flex;
    }

    .reports-library-section__content-wrap {
        display: flex;
        flex-direction: column;
        gap: var(--title-desc-gap);
    }

    .reports-library-section__content-wrap h2 {
        margin: 0;
    }

    .reports-library-section__controls-wrap {
        display: flex;
        flex-direction: row;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-3);
    }

    .reports-library-section__controls-wrap :global(.tabs-bar) {
        width: fit-content;
        max-width: 100%;
        margin-right: auto;
    }

    .reports-library-section__description {
        color: var(--text-secondary);
        margin: 0;
        max-width: 52rem;
    }

    .reports-library-section__carousel {
        display: flex;
        gap: var(--layout-card-gap);
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        scrollbar-width: none;
        margin-inline: calc(-1 * var(--content-margin-inline));
        padding: var(--space-6) var(--content-margin-inline) var(--section-pad-block-lg);
        scroll-padding-inline-start: var(--content-margin-inline);
        transition:
            opacity 180ms ease,
            transform 180ms ease;
    }

    .reports-library-section__carousel::-webkit-scrollbar {
        display: none;
    }

    .reports-library-section__card-wrap {
        flex-shrink: 0;
        width: 24rem;
        scroll-snap-align: start;
        transition:
            opacity 180ms ease,
            transform 180ms ease;
    }

    .reports-library-section.is-filter-transitioning .reports-library-section__carousel,
    .reports-library-section.is-filter-transitioning .reports-library-section__card-wrap {
        opacity: 0.9;
        transform: translateY(0.125rem);
    }

    @media (min-width: 1024px) {
        .reports-library-section__card-wrap {
            width: calc(
                (100vw - (2 * var(--content-margin-inline)) - (2 * var(--layout-card-gap))) / 3
            );
        }
    }

    @media (max-width: 1023px) {
        .reports-library-section {
            gap: var(--space-4);
            padding-top: var(--section-pad-block-lg);
            padding-bottom: 0;
        }

        .reports-library-section__controls-wrap {
            display: flex;
        }

        .reports-library-section__description {
            max-width: 100%;
        }
    }

    @media (max-width: 767px) {
        .reports-library-section {
            padding-top: var(--space-12);
            padding-bottom: 0;
        }

        .reports-library-section__header {
            gap: var(--space-7);
        }

        .reports-library-section__card-wrap {
            width: calc(100vw - 2 * var(--content-margin-inline) - var(--space-5));
        }

        .reports-library-section__content-wrap {
            gap: var(--space-4);
        }

        .reports-library-section__controls-wrap {
            row-gap: var(--space-5);
        }

        .reports-library-section__controls-wrap :global(.tabs-bar) {
            width: 100%;
        }
    }

    /* Hide all pills inside report cards by default */
    .reports-library-section :global([data-pill-variant]) {
        display: none;
    }

    /* All: show each card's assigned pill */
    .reports-library-section[data-filter='all']
        [data-card-variant='junior']
        :global([data-pill-variant='junior']),
    .reports-library-section[data-filter='all']
        [data-card-variant='mtm18plus']
        :global([data-pill-variant='mtm18plus']),
    .reports-library-section[data-filter='all']
        [data-card-variant='newcomers']
        :global([data-pill-variant='newcomers']) {
        display: inline-flex;
    }

    /* MTM 18+: show mtm18plus pill on all cards */
    .reports-library-section[data-filter='mtm18plus'] :global([data-pill-variant='mtm18plus']) {
        display: inline-flex;
    }

    /* Junior: show junior pill on all cards */
    .reports-library-section[data-filter='junior'] :global([data-pill-variant='junior']) {
        display: inline-flex;
    }

    /* Newcomers: show newcomers pill on all cards */
    .reports-library-section[data-filter='newcomers'] :global([data-pill-variant='newcomers']) {
        display: inline-flex;
    }

    @media (prefers-reduced-motion: reduce) {
        .reports-library-section__carousel,
        .reports-library-section__card-wrap {
            transition: none;
        }
    }
</style>

<script>
    document.querySelectorAll<HTMLElement>('.reports-library-section').forEach((section) => {
        let filterAnimTimer: number | null = null;

        section.addEventListener('tabs:change', ((e: CustomEvent) => {
            section.classList.add('is-filter-transitioning');
            section.dataset.filter = e.detail.value;

            if (filterAnimTimer !== null) {
                window.clearTimeout(filterAnimTimer);
            }
            filterAnimTimer = window.setTimeout(() => {
                section.classList.remove('is-filter-transitioning');
                filterAnimTimer = null;
            }, 180);
        }) as EventListener);

        const heading = section.querySelector<HTMLElement>('.heading-fly-in');
        if (heading) {
            const headingObserver = new IntersectionObserver(
                ([entry]) => {
                    if (entry.isIntersecting) {
                        heading.classList.add('is-visible');
                        headingObserver.disconnect();
                    }
                },
                { threshold: 0.15 }
            );
            headingObserver.observe(heading);
        }

        // Carousel cards sit at the same vertical scroll position, so a
        // per-card observer would fire them all at once — trigger off the
        // row itself instead, and keep the stagger.
        const cardsRow = section.querySelector<HTMLElement>('.reports-library-section__carousel');
        const cards = section.querySelectorAll<HTMLElement>('.card-fly-in');
        if (cardsRow && cards.length) {
            const cardObserver = new IntersectionObserver(
                ([entry]) => {
                    if (entry.isIntersecting) {
                        cards.forEach((card, i) => {
                            setTimeout(() => card.classList.add('is-visible'), i * 140);
                        });
                        cardObserver.disconnect();
                    }
                },
                { threshold: 0.2 }
            );
            cardObserver.observe(cardsRow);
        }
    });
</script>
