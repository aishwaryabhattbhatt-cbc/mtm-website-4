---
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { t } from '../../lib/i18n/t';
import ProductPill from '../shared/ProductPill.astro';
import type { ProductVariant } from '../shared/ProductPill.astro';
import DatePill from '../shared/DatePill.astro';
import Button from '../shared/Button.astro';

interface Props {
    locale: Locale;
    copy: CMSDictionary;
    ctaHref?: string;
    imageSrc?: string;
    imageAlt?: string;
    tagKey: string;
    dateKey: string;
    titleKey: string;
    descriptionKey: string;
    ctaKey?: string;
    showCta?: boolean;
}

const {
    locale,
    copy,
    ctaHref,
    imageSrc,
    imageAlt,
    tagKey,
    dateKey,
    titleKey,
    descriptionKey,
    ctaKey = 'free_report_cta',
    showCta = true,
} = Astro.props as Props;

function tagToVariant(tag: string): ProductVariant | null {
    const n = tag.toLowerCase().replace(/\s+/g, '');
    if (n.includes('18+') || n.includes('18plus')) return 'mtm18plus';
    if (n.includes('junior')) return 'junior';
    if (n.includes('newcomer')) return 'newcomers';
    if (n.includes('census')) return 'census';
    return null;
}

const tagText = tagKey in copy ? t(copy, tagKey, locale, '') : '';
const tagVariant = tagText ? tagToVariant(tagText) : null;
const dateText = dateKey in copy ? t(copy, dateKey, locale, '') : '';
---

<article class="free-report-card">
    <div class="free-report-card__image-wrap">
        {
            imageSrc ? (
                <img
                    class="free-report-card__image"
                    src={imageSrc}
                    alt={imageAlt ?? ''}
                    loading="lazy"
                    decoding="async"
                />
            ) : (
                <div class="free-report-card__image-placeholder" aria-hidden="true" />
            )
        }
    </div>

    <div class="free-report-card__body">
        <div class="free-report-card__meta">
            {
                tagVariant ? (
                    <ProductPill variant={tagVariant} size="small" copy={copy} locale={locale} />
                ) : tagText ? (
                    <span class="free-report-card__tag text-label-small">{tagText}</span>
                ) : null
            }
            {dateText && <DatePill date={dateText} />}
        </div>

        <div class="free-report-card__text">
            <p class="text-body-p1-bold free-report-card__title" data-copy-key={titleKey}>
                {t(copy, titleKey, locale, '')}
            </p>
            <p class="text-body-p2 free-report-card__description" data-copy-key={descriptionKey}>
                {t(copy, descriptionKey, locale, '')}
            </p>
        </div>

        {
            showCta && (
                <div class="free-report-card__cta">
                    <Button variant="primary" size="md" href={ctaHref}>
                        <span class="free-report-card__download-btn">
                            <span>{t(copy, ctaKey, locale, 'Download')}</span>
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="icon-s"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true"
                            >
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                                <polyline points="7 10 12 15 17 10" />
                                <line x1="12" y1="15" x2="12" y2="3" />
                            </svg>
                        </span>
                    </Button>
                </div>
            )
        }
    </div>
</article>

<style>
    .free-report-card {
        display: flex;
        flex-direction: column;
        gap: var(--space-6);
    }

    .free-report-card__image-wrap {
        width: 100%;
        aspect-ratio: 400 / 217;
        overflow: hidden;
        border-radius: var(--radius-s);
    }

    .free-report-card__image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .free-report-card__image-placeholder {
        width: 100%;
        height: 100%;
        background: var(--surface-blue);
    }

    .free-report-card__body {
        display: flex;
        flex-direction: column;
        gap: var(--space-6);
        padding: 0;
    }

    .free-report-card__meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-3);
    }

    .free-report-card__tag {
        background: var(--badge-juniors);
        border-radius: var(--radius-full);
        padding: var(--space-2) var(--space-4);
        color: var(--text-white);
        white-space: nowrap;
    }

    .free-report-card__text {
        display: flex;
        flex-direction: column;
        gap: var(--title-desc-gap);
    }

    .free-report-card__title {
        margin: 0;
        color: var(--text-primary);
    }

    .free-report-card__description {
        margin: 0;
        color: var(--neutral-grey-1);
        min-height: calc(1.4em * 4);
        max-height: calc(1.4em * 4);
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 4;
        -webkit-box-orient: vertical;
    }

    .free-report-card__cta {
        display: block;
        width: 100%;
    }

    .free-report-card :global(.btn) {
        width: fit-content;
        align-self: flex-start;
    }

    .free-report-card__download-btn {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
    }
</style>
