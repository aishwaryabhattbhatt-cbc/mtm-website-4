---
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { t } from '../../lib/i18n/t';
import CarouselNavArrows from '../shared/CarouselNavArrows.astro';
import InsightsNewsCard from './InsightsNewsCard.astro';
import { getNewsItemsForLocale } from '../../lib/cms/getNewsItems';

interface Props {
    locale: Locale;
    copy: CMSDictionary;
}

const { locale, copy } = Astro.props as Props;

// Sheet dates are either "YYYY-MM-DD" or a bare "YYYY" — sort by a normalized
// timestamp (year-only entries anchor to Jan 1) so newest articles lead the carousel.
function toSortableTime(raw: string): number {
    if (/^\d{4}-\d{2}-\d{2}$/.test(raw)) return new Date(`${raw}T00:00:00`).getTime();
    if (/^\d{4}$/.test(raw)) return new Date(`${raw}-01-01T00:00:00`).getTime();
    return 0;
}

function parseNewsDate(raw: string): Date | string {
    return /^\d{4}-\d{2}-\d{2}$/.test(raw) ? new Date(`${raw}T00:00:00`) : raw;
}

const newsItems = getNewsItemsForLocale(locale)
    .filter((item) => item.link)
    .sort((a, b) => toSortableTime(b.date) - toSortableTime(a.date))
    .map((item) => ({
        tags: item.products,
        date: parseNewsDate(item.date),
        title: item.title,
        platform: item.platform,
        href: item.link,
    }));
---

<section class="news-section">
    <div class="news-section__header heading-fly-in">
        <div class="news-section__content-wrap">
            <h2 data-copy-key="section_5_title">
                {t(copy, 'section_5_title', locale, 'News')}
            </h2>

            <p class="text-body-p1 news-section__description" data-copy-key="section_5_description">
                {
                    t(
                        copy,
                        'section_5_description',
                        locale,
                        'Stay up to date with the latest MTM findings, product updates, and timely analysis on media and technology trends across Canada.'
                    )
                }
            </p>
        </div>

        <div class="news-section__controls-wrap">
            <CarouselNavArrows
                scrollTargetSelector="#newsSectionCarousel"
                ariaLabel={t(copy, 'news_carousel_aria_label', locale, 'News navigation')}
                class="news-section__arrows"
                copy={copy}
                locale={locale}
            />
        </div>
    </div>

    <div class="news-section__grid" id="newsSectionCarousel">
        {
            newsItems.map((item) => (
                <div class="news-section__card-wrap card-fly-in">
                    <InsightsNewsCard
                        locale={locale}
                        copy={copy}
                        tags={item.tags}
                        date={item.date}
                        title={item.title}
                        platform={item.platform}
                        href={item.href}
                    />
                </div>
            ))
        }
    </div>
</section>

<style>
    .news-section {
        width: 100%;
        padding: var(--section-pad-block-lg) var(--content-margin-inline) var(--section-pad-block);
        display: flex;
        flex-direction: column;
        gap: var(--space-6);
    }

    .news-section__header {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: start;
        gap: var(--header-stack-gap);
    }

    .news-section__content-wrap {
        display: flex;
        flex-direction: column;
        gap: var(--title-desc-gap);
        max-width: 56rem;
        min-width: 0;
    }

    .news-section__content-wrap h2 {
        margin: 0;
    }

    .news-section__description {
        color: var(--text-secondary);
        margin: 0;
        max-width: 56rem;
    }

    .news-section__controls-wrap {
        display: flex;
        flex-shrink: 0;
        justify-self: end;
        align-self: end;
    }

    .news-section__grid {
        display: flex;
        gap: var(--layout-card-gap);
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        scrollbar-width: none;
        margin-inline: calc(-1 * var(--content-margin-inline));
        padding: var(--space-2) var(--content-margin-inline) var(--space-8);
        scroll-padding-inline-start: var(--content-margin-inline);
    }

    .news-section__grid::-webkit-scrollbar {
        display: none;
    }

    .news-section__card-wrap {
        flex-shrink: 0;
        width: 24rem;
        scroll-snap-align: start;
    }

    @media (min-width: 1024px) {
        .news-section__card-wrap {
            width: calc(
                (100vw - (2 * var(--content-margin-inline)) - (2 * var(--layout-card-gap))) / 3
            );
        }
    }

    @media (max-width: 1023px) {
        .news-section {
            /* bottom kept tighter than --section-pad-block — footer below carries its own top padding */
            padding: var(--section-pad-block) var(--content-margin-inline) var(--space-9);
        }

        .news-section__header {
            grid-template-columns: 1fr;
        }

        .news-section__controls-wrap {
            justify-self: start;
            align-self: start;
        }

        .news-section__card-wrap {
            width: 24rem;
        }
    }

    @media (max-width: 767px) {
        .news-section {
            padding: var(--space-9) var(--content-margin-inline) var(--space-9);
        }

        .news-section__content-wrap {
            gap: var(--space-4);
            max-width: 100%;
        }

        .news-section__card-wrap {
            width: calc(100vw - 2 * var(--content-margin-inline) - var(--space-5));
        }
    }
</style>

<script>
    document.querySelectorAll<HTMLElement>('.news-section').forEach((section) => {
        const heading = section.querySelector<HTMLElement>('.heading-fly-in');
        if (heading) {
            const headingObserver = new IntersectionObserver(
                ([entry]) => {
                    if (entry.isIntersecting) {
                        heading.classList.add('is-visible');
                        headingObserver.disconnect();
                    }
                },
                { threshold: 0.15 }
            );
            headingObserver.observe(heading);
        }

        // Carousel cards sit at the same vertical scroll position, so
        // trigger off the row itself and keep the stagger rather than
        // per-card observers. Raised from the 0.2 default — the row was
        // firing while barely scrolled into view, before it was actually
        // being looked at.
        const cardsRow = section.querySelector<HTMLElement>('.news-section__grid');
        const cards = section.querySelectorAll<HTMLElement>('.card-fly-in');
        if (cardsRow && cards.length) {
            const cardObserver = new IntersectionObserver(
                ([entry]) => {
                    if (entry.isIntersecting) {
                        cards.forEach((card, i) => {
                            setTimeout(() => card.classList.add('is-visible'), i * 140);
                        });
                        cardObserver.disconnect();
                    }
                },
                { threshold: 0.4 }
            );
            cardObserver.observe(cardsRow);
        }
    });
</script>
