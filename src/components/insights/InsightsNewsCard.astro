---
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { t } from '../../lib/i18n/t';
import ProductPill from '../shared/ProductPill.astro';
import type { ProductVariant } from '../shared/ProductPill.astro';
import DatePill from '../shared/DatePill.astro';
import Button from '../shared/Button.astro';

interface Props {
    locale: Locale;
    copy: CMSDictionary;
    tag: string;
    date: string;
    title: string;
    description: string;
    href: string;
}

const { locale, copy, tag, date, title, description, href } = Astro.props as Props;

function tagToVariant(tag: string): ProductVariant | null {
    const n = tag.toLowerCase().replace(/\s+/g, '');
    if (n.includes('18+') || n.includes('18plus')) return 'mtm18plus';
    if (n.includes('junior')) return 'junior';
    if (n.includes('newcomer')) return 'newcomers';
    if (n.includes('census')) return 'census';
    return null;
}

const tagVariant = tagToVariant(tag);
---

<article class="news-card">
    <div class="news-card__top">
        <div class="news-card__meta">
            {
                tagVariant ? (
                    <ProductPill variant={tagVariant} size="small" />
                ) : tag ? (
                    <span class="news-card__tag text-label-small">{tag}</span>
                ) : null
            }
            {date && <DatePill date={date} />}
        </div>

        <div class="news-card__text">
            <p class="text-body-p1-bold news-card__title">{title}</p>
            <p class="text-body-p2 news-card__description">{description}</p>
        </div>
    </div>

    <div class="news-card__footer">
        <Button variant="tertiary" size="md" href={href}>
            <span data-copy-key="news_cta">{t(copy, 'news_cta', locale, 'Read')}</span>
        </Button>
    </div>
</article>

<style>
    .news-card {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        background: var(--surface-blue);
        border-radius: var(--radius-s);
        padding: var(--card-pad);
        gap: var(--space-6);
        height: 100%;
    }

    .news-card__top {
        display: flex;
        flex-direction: column;
        gap: var(--card-stack-gap);
    }

    .news-card__meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-3);
    }

    .news-card__tag {
        background: var(--badge-juniors);
        border-radius: var(--radius-full);
        padding: var(--space-2) var(--space-4);
        color: var(--text-white);
        white-space: nowrap;
    }

    .news-card__text {
        display: flex;
        flex-direction: column;
        gap: var(--title-desc-gap);
    }

    .news-card__title {
        margin: 0;
        color: var(--text-primary);
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .news-card__description {
        margin: 0;
        color: var(--text-secondary);
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .news-card__footer {
        display: flex;
    }
</style>
