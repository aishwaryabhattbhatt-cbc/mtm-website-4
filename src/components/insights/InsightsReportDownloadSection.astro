---
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { t } from '../../lib/i18n/t';
import Button from '../shared/Button.astro';
import FormField from '../shared/FormField.astro';
import InsightsReportSelectRow from './InsightsReportSelectRow.astro';

interface ReportItem {
    imageSrc?: string;
    tagKey: string;
    dateKey: string;
    titleKey: string;
    value: string;
}

interface Props {
    locale: Locale;
    copy: CMSDictionary;
    reports: ReportItem[];
}

const { locale, copy, reports } = Astro.props as Props;
const base = import.meta.env.BASE_URL;
const formId = 'report-download-form';
---

<section class="report-download-section" data-report-download-section>
    <div class="report-download-section__pattern" aria-hidden="true">
        <img
            src={`${base}images/request-demo/hero-pattern.png`}
            alt=""
            class="report-download-section__pattern-img"
        />
    </div>

    <div class="report-download-section__inner">
        <div class="report-download-section__content">
            <div
                class="report-download-section__heading hero-fade-in"
                style="animation-delay: 0.1s"
            >
                <h2
                    class="report-download-section__title"
                    data-copy-key="report_download_page_title"
                >
                    {t(copy, 'report_download_page_title', locale, 'Download Report')}
                </h2>
                <p
                    class="text-body-p2 report-download-section__description"
                    data-copy-key="report_download_page_description"
                >
                    {
                        t(
                            copy,
                            'report_download_page_description',
                            locale,
                            'Thank you for your interest in this content. Please fill out the form below, and we will provide you with an email containing a download link.'
                        )
                    }
                </p>
            </div>

            <div class="report-download-section__panel hero-fade-in" style="animation-delay: 0.2s">
                <div class="report-download-section__columns">
                    <div class="report-download-section__form-block">
                        <form
                            id={formId}
                            class="report-download-section__form"
                            data-report-download-form
                            data-submit-href={`${base}${locale}/insights/download-success/`}
                            novalidate
                        >
                            <div class="report-download-section__row">
                                <FormField
                                    locale={locale}
                                    copy={copy}
                                    variant="field-with-label"
                                    type="text"
                                    name="firstName"
                                    labelKey="report_download_first_name_label"
                                    label="First Name"
                                    placeholderKey="report_download_first_name_placeholder"
                                    placeholder="John"
                                    labelColor="primary"
                                    required
                                />
                                <FormField
                                    locale={locale}
                                    copy={copy}
                                    variant="field-with-label"
                                    type="text"
                                    name="lastName"
                                    labelKey="report_download_last_name_label"
                                    label="Last Name"
                                    placeholderKey="report_download_last_name_placeholder"
                                    placeholder="Doe"
                                    labelColor="primary"
                                    required
                                />
                            </div>

                            <FormField
                                locale={locale}
                                copy={copy}
                                variant="field-with-label"
                                type="email"
                                name="email"
                                labelKey="report_download_email_label"
                                label="Work Email"
                                placeholderKey="report_download_email_placeholder"
                                placeholder="john@workmail.com"
                                emailValidation="none"
                                labelColor="primary"
                                required
                            />

                            <FormField
                                locale={locale}
                                copy={copy}
                                variant="field-with-label"
                                type="text"
                                name="organisation"
                                labelKey="report_download_organisation_label"
                                label="Organisation"
                                placeholderKey="report_download_organisation_placeholder"
                                placeholder="Organisation Name"
                                labelColor="primary"
                                required
                            />

                            <FormField
                                locale={locale}
                                copy={copy}
                                variant="field-with-label"
                                type="text"
                                name="position"
                                labelKey="report_download_position_label"
                                label="Position"
                                placeholderKey="report_download_position_placeholder"
                                placeholder="Marketing Director"
                                labelColor="primary"
                                required
                            />
                        </form>
                    </div>

                    <div class="report-download-section__reports">
                        <p
                            class="text-body-p3 report-download-section__reports-subtitle"
                            data-copy-key="report_download_select_subtitle"
                        >
                            {
                                t(
                                    copy,
                                    'report_download_select_subtitle',
                                    locale,
                                    'Select Free Report'
                                )
                            }
                            <span class="report-download-section__reports-required">*</span>
                        </p>
                        <div class="report-download-section__reports-list">
                            {
                                reports.map((report) => (
                                    <InsightsReportSelectRow
                                        locale={locale}
                                        copy={copy}
                                        imageSrc={report.imageSrc}
                                        tagKey={report.tagKey}
                                        dateKey={report.dateKey}
                                        titleKey={report.titleKey}
                                        name="reports"
                                        value={report.value}
                                        formId={formId}
                                    />
                                ))
                            }
                        </div>
                    </div>
                </div>

                <Button
                    variant="primary"
                    type="submit"
                    form={formId}
                    class="report-download-section__submit"
                    data-copy-key="free_report_submit_cta"
                >
                    {t(copy, 'free_report_submit_cta', locale, 'Submit')}
                </Button>
            </div>
        </div>
    </div>
</section>

<style>
    .report-download-section {
        position: relative;
        width: 100%;
        overflow: clip;
        margin-top: var(--navbar-height);
        padding: var(--section-pad-block) var(--content-margin-inline);
        background: var(--surface-white);
        display: flex;
        align-items: center;
        /* Desktop/tablet only — see the 767px override below for mobile. */
        min-height: var(--section-height-100);
    }

    .hero-fade-in {
        opacity: 0;
        animation: hero-fade-in-up var(--motion-duration-heading) var(--motion-ease-standard)
            forwards;
    }

    @keyframes hero-fade-in-up {
        from {
            opacity: 0;
            transform: translateY(1.625rem);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .hero-fade-in {
            animation: none;
            opacity: 1;
        }
    }

    .report-download-section__pattern {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        pointer-events: none;
        z-index: 0;
    }

    .report-download-section__pattern-img {
        width: 100%;
        height: auto;
        display: block;
    }

    .report-download-section__inner {
        position: relative;
        z-index: 1;
        width: 100%;
    }

    .report-download-section__heading {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        text-align: left;
        gap: var(--title-desc-gap);
        width: 100%;
    }

    .report-download-section__title {
        margin: 0;
        font-family: var(--font-heading);
        font-size: var(--fs-subsection-h2);
        font-weight: var(--fw-semibold);
        line-height: var(--lh-tight);
        letter-spacing: var(--ls-heading-lg);
        color: var(--text-primary);
    }

    .report-download-section__description {
        margin: 0;
        max-width: 37.5rem;
        color: var(--text-secondary);
    }

    .report-download-section__content {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: var(--space-9);
        max-width: 90rem;
        margin: 0 auto;
    }

    .report-download-section__panel {
        display: flex;
        flex-direction: column;
        gap: var(--space-8);
        width: 100%;
        padding: var(--space-9);
        border-radius: var(--radius-m);
        background: var(--surface-blue);
        box-shadow: var(--shadow-card);
    }

    .report-download-section__columns {
        display: flex;
        align-items: stretch;
        gap: var(--space-11);
        width: 100%;
    }

    .report-download-section__form-block {
        display: flex;
        flex-direction: column;
        gap: var(--space-6);
        flex: 1;
        min-width: 0;
    }

    .report-download-section__reports {
        display: flex;
        flex-direction: column;
        gap: var(--space-1);
        flex: 1;
        min-width: 0;
    }

    .report-download-section__reports-subtitle {
        margin: 0;
        color: var(--text-primary);
    }

    .report-download-section__reports-required {
        color: #c00;
        margin-left: var(--space-1);
    }

    .report-download-section__reports-list {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: stretch;
        gap: var(--space-4);
        flex: 1;
        min-width: 0;
    }

    .report-download-section__form {
        display: flex;
        flex-direction: column;
        gap: var(--space-5);
    }

    .report-download-section__row {
        display: flex;
        gap: var(--space-5);
    }

    .report-download-section__row > :global(.form-field) {
        flex: 1;
        min-width: 0;
    }

    .report-download-section__submit {
        align-self: flex-start;
    }

    @media (max-width: 1023px) {
        .report-download-section {
            margin-top: 0;
        }

        .report-download-section__columns {
            flex-direction: column;
            /* Match the form's own row gap — was inheriting the desktop
               column-to-column gap, which read much larger once stacked. */
            gap: var(--space-5);
        }

        .report-download-section__reports-list {
            justify-content: flex-start;
            gap: var(--layout-card-gap);
        }
    }

    @media (max-width: 767px) {
        .report-download-section {
            min-height: auto;
            padding: var(--space-9) var(--content-margin-inline);
        }

        .report-download-section__row {
            flex-direction: column;
            gap: var(--space-5);
        }

        .report-download-section__panel {
            padding: var(--space-6);
        }

        .report-download-section__columns {
            /* Reports lead on mobile, ahead of the form — matches the section's
               prior mobile priority order. */
            flex-direction: column-reverse;
        }
    }
</style>

<script>
    document.querySelectorAll<HTMLElement>('[data-report-download-section]').forEach((section) => {
        const form = section.querySelector<HTMLFormElement>('[data-report-download-form]');
        if (!form) return;

        form.addEventListener('submit', (event) => {
            event.preventDefault();
            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }
            const submitHref = form.dataset.submitHref;
            if (!submitHref) return;

            // Forward the "from" param (the page/section the visitor started
            // from) on to the success page, so its "Go Back to Exploring"
            // CTA can return them to the right place instead of a fixed page.
            const fromParam = new URLSearchParams(window.location.search).get('from');
            window.location.href = fromParam
                ? `${submitHref}?from=${encodeURIComponent(fromParam)}`
                : submitHref;
        });
    });
</script>
