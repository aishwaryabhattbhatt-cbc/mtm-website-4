---
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { t } from '../../lib/i18n/t';
import Eyebrow from '../shared/Eyebrow.astro';
import SneakPeekReportCard from './SneakPeekReportCard.astro';
import { icons } from '../../lib/icons/registry';

interface Props {
    locale: Locale;
    copy: CMSDictionary;
}

const { locale, copy } = Astro.props as Props;
const base = import.meta.env.BASE_URL;
---

<section class="sneak-peek-reports-section">
    <div class="sneak-peek-reports-section__header heading-fly-in">
        <div class="sneak-peek-reports-section__eyebrow-wrap">
            <Eyebrow>
                <span>Free infographic</span>
            </Eyebrow>
        </div>

        <div class="sneak-peek-reports-section__content-wrap">
            <h2 data-copy-key="section_4_title">
                {
                    t(
                        copy,
                        'section_4_title',
                        locale,
                        locale === 'fr' ? 'Infographie gratuite' : 'Free infographic'
                    )
                }
            </h2>

            <p
                class="text-body-p1 sneak-peek-reports-section__description"
                data-copy-key="section_4_description"
            >
                {
                    t(
                        copy,
                        'section_4_description',
                        locale,
                        locale === 'fr'
                            ? 'Découvrez un aperçu rapide des rapports MTM les plus récents.'
                            : 'Take a quick look at the latest MTM reports.'
                    )
                }
            </p>
        </div>
    </div>

    <div class="content-fly-in">
        <SneakPeekReportCard
            locale={locale}
            copy={copy}
            imageSrc={`${base}images/products/mtm-18-plus/report-image.webp`}
            imageAlt=""
            graphIconSrc={`${base}${icons['service-video-svod'].gaming}`}
            graphIconAlt=""
            chartSrc={`${base}images/products/mtm-18-plus/report-graph.svg`}
            chartAlt=""
            downloadHref={`${base}${locale}/insights/report-download/`}
        />
    </div>
</section>

<style>
    .sneak-peek-reports-section {
        width: 100%;
        background: var(--surface-blue);
        padding-top: 0;
        padding-right: var(--content-margin-inline);
        padding-bottom: var(--section-pad-block-lg);
        padding-left: var(--content-margin-inline);
        display: flex;
        flex-direction: column;
        gap: var(--section-header-gap);
    }

    .sneak-peek-reports-section__header {
        display: flex;
        flex-direction: column;
        gap: var(--header-stack-gap);
        max-width: 56rem;
    }

    .sneak-peek-reports-section__content-wrap {
        display: flex;
        flex-direction: column;
        gap: var(--title-desc-gap);
    }

    .sneak-peek-reports-section__eyebrow-wrap {
        display: flex;
    }

    .sneak-peek-reports-section__content-wrap h2 {
        margin: 0;
    }

    .sneak-peek-reports-section__description {
        color: var(--text-secondary);
        margin: 0;
    }

    @media (max-width: 767px) {
        .sneak-peek-reports-section {
            padding-top: 0;
            padding-right: var(--content-margin-inline);
            padding-bottom: var(--space-9);
            padding-left: var(--content-margin-inline);
            gap: var(--section-header-gap);
        }

        .sneak-peek-reports-section__header {
            gap: var(--space-7);
        }

        .sneak-peek-reports-section__content-wrap {
            gap: var(--space-4);
        }
    }

    .heading-fly-in {
        opacity: 0;
        transform: translateY(1.625rem);
        transition:
            opacity var(--motion-duration-heading) ease,
            transform var(--motion-duration-heading) var(--motion-ease-standard);
    }

    .heading-fly-in.is-visible {
        opacity: 1;
        transform: translateY(0);
    }

    .content-fly-in {
        opacity: 0;
        transform: translateY(1.625rem);
        transition:
            opacity var(--motion-duration-heading) ease,
            transform var(--motion-duration-heading) var(--motion-ease-standard);
    }

    .content-fly-in.is-visible {
        opacity: 1;
        transform: translateY(0);
    }
</style>

<script>
    document.querySelectorAll<HTMLElement>('.sneak-peek-reports-section').forEach((section) => {
        const heading = section.querySelector<HTMLElement>('.heading-fly-in');
        if (heading) {
            const headingObserver = new IntersectionObserver(
                ([entry]) => {
                    if (entry.isIntersecting) {
                        heading.classList.add('is-visible');
                        headingObserver.disconnect();
                    }
                },
                { threshold: 0.15 }
            );
            headingObserver.observe(heading);
        }

        const contentObserver = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('is-visible');
                        contentObserver.unobserve(entry.target);
                    }
                });
            },
            { threshold: 0.15 }
        );
        section.querySelectorAll<HTMLElement>('.content-fly-in').forEach((el) => {
            contentObserver.observe(el);
        });
    });
</script>
