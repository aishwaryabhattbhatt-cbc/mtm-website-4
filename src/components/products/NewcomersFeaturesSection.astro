---
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { icons } from '../../lib/icons/registry';
import ProductFeaturesSection from './ProductFeaturesSection.astro';

interface Props {
    locale: Locale;
    copy: CMSDictionary;
}

const { locale, copy } = Astro.props as Props;
const base = import.meta.env.BASE_URL;

const features = [
    {
        icon: `${base}${icons['product-newcomers'].yearsData5}`,
        titleKey: 'feature_1_title',
        descKey: 'feature_1_description',
        titleFallback: '5+ Years Of Data',
        descFallback:
            'The only annual study tracking media and technology habits of newcomers to Canada.',
    },
    {
        icon: `${base}${icons['demographics-group'].newcomers}`,
        titleKey: 'feature_2_title',
        descKey: 'feature_2_description',
        titleFallback: 'Newcomers, New Audiences',
        descFallback:
            'Data spanning newcomers across all provinces, demographics, and years since arrival.',
    },
    {
        icon: `${base}${icons.gen.largeSamples}`,
        titleKey: 'feature_3_title',
        descKey: 'feature_3_description',
        titleFallback: 'A Large, Diverse Sample',
        descFallback:
            'Nationally representative sampling ensures findings reflect the true newcomer population.',
    },
    {
        icon: `${base}${icons['product-newcomers'].survey12Languages}`,
        titleKey: 'feature_4_title',
        descKey: 'feature_4_description',
        titleFallback: 'A Survey Conducted In 12 Languages',
        descFallback:
            'Thousands of respondents annually, giving you the statistical confidence to act on the data.',
    },
    {
        icon: `${base}${icons['product-newcomers'].interviewInternet}`,
        titleKey: 'feature_5_title',
        descKey: 'feature_5_description',
        titleFallback: 'Interviewing Online And In-Person Across Canada',
        descFallback:
            'Insights into household-level media consumption habits among newcomer families.',
    },
];
---

<ProductFeaturesSection locale={locale} copy={copy} features={features} />
