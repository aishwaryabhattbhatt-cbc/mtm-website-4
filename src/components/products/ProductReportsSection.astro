---
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { t } from '../../lib/i18n/t';
import Reports from '../shared/Reports.astro';
import InsightsRuntime from '../insights/InsightsRuntime.astro';

interface StatItem {
    iconSrc: string;
    metric: string;
    description: string;
}

interface Props {
    locale: Locale;
    copy: CMSDictionary;
    productId: string;
    imageSrc: string;
    imageAlt?: string;
    insightsHref: string;
    sampleReportHref: string;
    stats: StatItem[];
}

const {
    locale,
    copy,
    productId,
    imageSrc,
    imageAlt = '',
    insightsHref,
    sampleReportHref,
    stats,
} = Astro.props as Props;
---

<section
    class="product-reports-section"
    id="reports"
    data-flyin
    data-insights-kind="product"
    data-product-id={productId}
>
    <InsightsRuntime locale={locale} />
    <div data-insights-product-content hidden style="display: contents">
        <div class="product-reports-headline heading-fly-in">
            <h2 data-copy-key="report_title">
                {t(copy, 'report_title', locale, 'Reports')}
            </h2>
            <p class="text-body-p1 product-reports-description" data-copy-key="report_description">
                {t(copy, 'report_description', locale, '')}
            </p>
        </div>

        <Reports
            locale={locale}
            copy={copy}
            imageSrc={imageSrc}
            imageAlt={imageAlt}
            graphIconSrc=""
            graphTitle=""
            graphDetail=""
            chartSrc=""
            chartAlt=""
            insightsHref={insightsHref}
            sampleReportHref={sampleReportHref}
            stats={stats}
        />
    </div>
</section>

<style>
    .product-reports-section {
        width: 100%;
        padding: var(--section-pad-block-lg) var(--content-margin-inline);
        background-color: var(--surface-blue);
        scroll-margin-top: var(--navbar-height);
    }

    .product-reports-headline {
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
        margin-bottom: var(--space-9);
    }

    .product-reports-description {
        color: var(--text-primary);
        margin: 0;
    }
</style>
