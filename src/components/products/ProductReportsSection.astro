---
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { t } from '../../lib/i18n/t';
import Reports from '../shared/Reports.astro';

interface StatItem {
    iconSrc: string;
    metric: string;
    description: string;
}

interface Props {
    locale: Locale;
    copy: CMSDictionary;
    imageSrc: string;
    imageAlt?: string;
    graphIconSrc: string;
    graphTitle: string;
    graphDetail: string;
    chartSrc: string;
    chartAlt?: string;
    insightsHref: string;
    sampleReportHref: string;
    stats: StatItem[];
}

const {
    locale,
    copy,
    imageSrc,
    imageAlt = '',
    graphIconSrc,
    graphTitle,
    graphDetail,
    chartSrc,
    chartAlt = '',
    insightsHref,
    sampleReportHref,
    stats,
} = Astro.props as Props;
---

<section class="product-reports-section">
    <div class="product-reports-headline heading-fly-in">
        <h2 data-copy-key="report_title">
            {t(copy, 'report_title', locale, 'Reports')}
        </h2>
        <p class="text-body-p1 product-reports-description" data-copy-key="report_description">
            {t(copy, 'report_description', locale, '')}
        </p>
    </div>

    <Reports
        imageSrc={imageSrc}
        imageAlt={imageAlt}
        graphIconSrc={graphIconSrc}
        graphTitle={graphTitle}
        graphDetail={graphDetail}
        chartSrc={chartSrc}
        chartAlt={chartAlt}
        insightsHref={insightsHref}
        sampleReportHref={sampleReportHref}
        stats={stats}
    />
</section>

<style>
    .product-reports-section {
        width: 100%;
        padding: var(--section-pad-block-lg) var(--content-margin-inline);
        background-color: var(--surface-blue);
    }

    .product-reports-headline {
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
        margin-bottom: var(--space-9);
    }

    .product-reports-description {
        color: var(--text-primary);
        margin: 0;
    }

    .heading-fly-in {
        opacity: 0;
        transform: translateY(1.625rem);
        transition:
            opacity var(--motion-duration-heading) ease,
            transform var(--motion-duration-heading) var(--motion-ease-standard);
    }

    .heading-fly-in.is-visible {
        opacity: 1;
        transform: translateY(0);
    }
</style>

<script>
    // Heading observes itself, not the outer section — a threshold is a
    // fraction of the target's own area, so watching the whole section
    // skews the trigger point once it's taller than the heading inside it.
    // The Reports block below (report card / stat cards / action card) now
    // stages its own per-row reveals in Reports.astro instead of fading in
    // as one block here.
    document.querySelectorAll<HTMLElement>('.product-reports-section').forEach((section) => {
        const heading = section.querySelector<HTMLElement>('.heading-fly-in');
        if (heading) {
            const headingObserver = new IntersectionObserver(
                ([entry]) => {
                    if (entry.isIntersecting) {
                        heading.classList.add('is-visible');
                        headingObserver.disconnect();
                    }
                },
                { threshold: 0.15 }
            );
            headingObserver.observe(heading);
        }
    });
</script>
