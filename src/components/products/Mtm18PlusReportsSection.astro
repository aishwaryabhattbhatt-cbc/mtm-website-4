---
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { t } from '../../lib/i18n/t';
import { icons } from '../../lib/icons/registry';
import ProductReportsSection from './ProductReportsSection.astro';

interface Props {
    locale: Locale;
    copy: CMSDictionary;
}

const { locale, copy } = Astro.props as Props;
const base = import.meta.env.BASE_URL;
// Lets the download-success page's "Go Back to Exploring" CTA return here
// instead of a hardcoded destination.
const reportDownloadHref = `${base}${locale}/insights/report-download/?from=${encodeURIComponent(`${base}${locale}/products/mtm-18-plus/#reports`)}`;
---

<ProductReportsSection
    locale={locale}
    copy={copy}
    imageSrc={`${base}images/products/mtm-18-plus/report-image.webp`}
    imageAlt=""
    graphIconSrc={`${base}${icons['service-video-svod'].gaming}`}
    graphTitle={t(copy, 'graph_name', locale, 'Name of Graph')}
    graphDetail={t(copy, 'graph_detail', locale, '')}
    chartSrc={`${base}images/products/mtm-18-plus/report-graph.svg`}
    chartAlt=""
    insightsHref={`${base}${locale}/insights/`}
    sampleReportHref={reportDownloadHref}
    stats={[
        {
            iconSrc: `${base}${icons['service-video-svod'].premium}`,
            metric: t(copy, 'stat_1_value', locale, ''),
            description: t(copy, 'stat_1_description', locale, ''),
        },
        {
            iconSrc: `${base}${icons['service-video-svod'].time}`,
            metric: t(copy, 'stat_2_value', locale, ''),
            description: t(copy, 'stat_2_description', locale, ''),
        },
    ]}
/>
