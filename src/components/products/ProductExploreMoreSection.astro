---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import CarouselNavArrows from '../shared/CarouselNavArrows.astro';

interface Product {
    id: string;
    name: string;
    desc: string;
    href: string;
    bg: ImageMetadata;
    people: ImageMetadata;
    chartSrc: string;
    chevronFill: string;
}

interface Props {
    heading: string;
    products: Product[];
}

const { heading, products } = Astro.props as Props;
---

<section class="explore-more-section">
    <div class="explore-header heading-fly-in">
        <h2>{heading}</h2>
        <CarouselNavArrows
            scrollTargetSelector="#exploreMobileScroll"
            ariaLabel="Product navigation"
            prevLabel="Previous product"
            nextLabel="Next product"
            class="explore-nav"
        />
    </div>

    <!-- Desktop: 3-column grid -->
    <div class="explore-cards-desktop">
        {
            products.map((product) => (
                <a class="explore-card card-fly-in" href={product.href}>
                    <div class="explore-card-image">
                        <Image class="explore-card-bg" src={product.bg} alt="" loading="lazy" />
                        <img
                            class="explore-card-chart"
                            src={product.chartSrc}
                            alt=""
                            aria-hidden="true"
                            loading="lazy"
                            decoding="async"
                        />
                        <Image
                            class="explore-card-people"
                            src={product.people}
                            alt={product.name}
                            loading="lazy"
                        />
                    </div>
                    <div class="explore-card-info">
                        <div class="explore-card-text">
                            <p class="explore-card-name text-body-p1-bold">{product.name}</p>
                            <p class="explore-card-desc text-body-p3">{product.desc}</p>
                        </div>
                        <span class="explore-card-chevron" aria-hidden="true">
                            <svg
                                width="100%"
                                height="100%"
                                viewBox="0 0 15 22"
                                fill="none"
                                xmlns="http://www.w3.org/2000/svg"
                            >
                                <g clip-path={`url(#clip-dt-${product.id})`}>
                                    <path
                                        d="M3.86782 5.53252C4.79584 5.53252 5.54815 4.78021 5.54815 3.8522C5.54815 2.92418 4.79584 2.17188 3.86782 2.17188C2.93981 2.17188 2.1875 2.92418 2.1875 3.8522C2.1875 4.78021 2.93981 5.53252 3.86782 5.53252Z"
                                        fill={product.chevronFill}
                                    />
                                    <path
                                        d="M7.64712 9.31231C8.57514 9.31231 9.32744 8.56 9.32744 7.63198C9.32744 6.70397 8.57514 5.95166 7.64712 5.95166C6.7191 5.95166 5.9668 6.70397 5.9668 7.63198C5.9668 8.56 6.7191 9.31231 7.64712 9.31231Z"
                                        fill={product.chevronFill}
                                    />
                                    <path
                                        d="M3.86782 20.6502C4.79584 20.6502 5.54815 19.8979 5.54815 18.9699C5.54815 18.0419 4.79584 17.2896 3.86782 17.2896C2.93981 17.2896 2.1875 18.0419 2.1875 18.9699C2.1875 19.8979 2.93981 20.6502 3.86782 20.6502Z"
                                        fill={product.chevronFill}
                                    />
                                    <path
                                        d="M7.64712 16.8714C8.57514 16.8714 9.32744 16.1191 9.32744 15.1911C9.32744 14.263 8.57514 13.5107 7.64712 13.5107C6.7191 13.5107 5.9668 14.263 5.9668 15.1911C5.9668 16.1191 6.7191 16.8714 7.64712 16.8714Z"
                                        fill={product.chevronFill}
                                    />
                                    <path
                                        d="M11.4284 13.0921C12.3564 13.0921 13.1087 12.3398 13.1087 11.4118C13.1087 10.4838 12.3564 9.73145 11.4284 9.73145C10.5004 9.73145 9.74805 10.4838 9.74805 11.4118C9.74805 12.3398 10.5004 13.0921 11.4284 13.0921Z"
                                        fill={product.chevronFill}
                                    />
                                </g>
                                <defs>
                                    <clipPath id={`clip-dt-${product.id}`}>
                                        <rect width="14.2353" height="22" fill="white" />
                                    </clipPath>
                                </defs>
                            </svg>
                        </span>
                    </div>
                </a>
            ))
        }
    </div>

    <!-- Mobile: horizontal scroll -->
    <div class="explore-cards-mobile" id="exploreMobileScroll">
        {
            products.map((product) => (
                <a class="explore-mobile-card card-fly-in" href={product.href}>
                    <div class="explore-mobile-image">
                        <Image class="explore-mobile-bg" src={product.bg} alt="" loading="lazy" />
                        <img
                            class="explore-mobile-chart"
                            src={product.chartSrc}
                            alt=""
                            aria-hidden="true"
                            loading="lazy"
                            decoding="async"
                        />
                        <Image
                            class="explore-mobile-people"
                            src={product.people}
                            alt={product.name}
                            loading="lazy"
                        />
                    </div>
                    <div class="explore-mobile-info">
                        <div class="explore-mobile-text">
                            <span class="explore-mobile-name text-body-p1-bold">
                                {product.name}
                            </span>
                            <span class="explore-mobile-desc text-body-p3">{product.desc}</span>
                        </div>
                        <span class="explore-mobile-chevron" aria-hidden="true">
                            <svg
                                width="100%"
                                height="100%"
                                viewBox="0 0 15 22"
                                fill="none"
                                xmlns="http://www.w3.org/2000/svg"
                            >
                                <g clip-path={`url(#clip-em-${product.id})`}>
                                    <path
                                        d="M3.86782 5.53252C4.79584 5.53252 5.54815 4.78021 5.54815 3.8522C5.54815 2.92418 4.79584 2.17188 3.86782 2.17188C2.93981 2.17188 2.1875 2.92418 2.1875 3.8522C2.1875 4.78021 2.93981 5.53252 3.86782 5.53252Z"
                                        fill={product.chevronFill}
                                    />
                                    <path
                                        d="M7.64712 9.31231C8.57514 9.31231 9.32744 8.56 9.32744 7.63198C9.32744 6.70397 8.57514 5.95166 7.64712 5.95166C6.7191 5.95166 5.9668 6.70397 5.9668 7.63198C5.9668 8.56 6.7191 9.31231 7.64712 9.31231Z"
                                        fill={product.chevronFill}
                                    />
                                    <path
                                        d="M3.86782 20.6502C4.79584 20.6502 5.54815 19.8979 5.54815 18.9699C5.54815 18.0419 4.79584 17.2896 3.86782 17.2896C2.93981 17.2896 2.1875 18.0419 2.1875 18.9699C2.1875 19.8979 2.93981 20.6502 3.86782 20.6502Z"
                                        fill={product.chevronFill}
                                    />
                                    <path
                                        d="M7.64712 16.8714C8.57514 16.8714 9.32744 16.1191 9.32744 15.1911C9.32744 14.263 8.57514 13.5107 7.64712 13.5107C6.7191 13.5107 5.9668 14.263 5.9668 15.1911C5.9668 16.1191 6.7191 16.8714 7.64712 16.8714Z"
                                        fill={product.chevronFill}
                                    />
                                    <path
                                        d="M11.4284 13.0921C12.3564 13.0921 13.1087 12.3398 13.1087 11.4118C13.1087 10.4838 12.3564 9.73145 11.4284 9.73145C10.5004 9.73145 9.74805 10.4838 9.74805 11.4118C9.74805 12.3398 10.5004 13.0921 11.4284 13.0921Z"
                                        fill={product.chevronFill}
                                    />
                                </g>
                                <defs>
                                    <clipPath id={`clip-em-${product.id}`}>
                                        <rect width="14.2353" height="22" fill="white" />
                                    </clipPath>
                                </defs>
                            </svg>
                        </span>
                    </div>
                </a>
            ))
        }
    </div>
</section>

<style>
    .explore-more-section {
        width: 100%;
        padding: var(--section-pad-block) var(--content-margin-inline);
        background: var(--surface-white);
        display: flex;
        flex-direction: column;
        gap: var(--section-header-gap);
    }

    .explore-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .explore-header h2 {
        margin: 0;
    }

    .explore-nav {
        display: none;
    }

    .explore-cards-desktop {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: var(--layout-card-gap);
    }

    .explore-card {
        display: flex;
        flex-direction: column;
        gap: var(--card-stack-gap);
        text-decoration: none;
        color: inherit;
        border-radius: var(--radius-s);
    }

    .explore-card-image {
        position: relative;
        width: 100%;
        aspect-ratio: 5 / 3;
        border-radius: var(--radius-s);
        overflow: hidden;
    }

    .explore-card-image .explore-card-bg,
    .explore-card-image .explore-card-people {
        transition: transform 0.4s ease;
    }

    .explore-card:hover .explore-card-image .explore-card-bg,
    .explore-card:hover .explore-card-image .explore-card-people {
        transform: scale(1.05);
    }

    .explore-card-bg {
        position: absolute;
        inset: 0;
        width: 110%;
        height: 100%;
        object-fit: cover;
        left: -1.125rem;
    }

    .explore-card-chart {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: auto;
        pointer-events: none;
        z-index: 1;
    }

    .explore-card-people {
        position: absolute;
        inset: 0;
        width: 110%;
        height: 100%;
        object-fit: cover;
        left: -1.125rem;
        z-index: 3;
    }

    .explore-card-info {
        display: flex;
        align-items: flex-start;
        gap: var(--space-6);
    }

    .explore-card-text {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: var(--space-1);
        min-width: 0;
    }

    .explore-card-name {
        color: var(--text-primary);
        margin: 0;
    }

    .explore-card-desc {
        color: var(--text-secondary);
        margin: 0;
        opacity: 0;
        transition: opacity 0.2s ease;
    }

    .explore-card-chevron {
        flex-shrink: 0;
        width: 0.875rem;
        height: 1.375rem;
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: opacity 0.2s ease;
    }

    .explore-card:hover .explore-card-desc,
    .explore-card:hover .explore-card-chevron {
        opacity: 1;
    }

    .explore-cards-mobile {
        display: none;
        gap: var(--layout-card-gap);
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
        margin-right: calc(-1 * var(--content-margin-inline));
        padding-right: var(--content-margin-inline);
        padding-bottom: var(--space-1);
    }

    .explore-cards-mobile::-webkit-scrollbar {
        display: none;
    }

    .explore-mobile-card {
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
        width: 17.1875rem;
        flex-shrink: 0;
        scroll-snap-align: start;
        text-decoration: none;
        color: inherit;
    }

    .explore-mobile-image {
        position: relative;
        width: 100%;
        aspect-ratio: 5 / 3;
        border-radius: var(--radius-s);
        overflow: hidden;
    }

    .explore-mobile-bg {
        position: absolute;
        inset: 0;
        width: 110%;
        height: 100%;
        object-fit: cover;
        left: -1.125rem;
    }

    .explore-mobile-chart {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: auto;
        pointer-events: none;
        z-index: 1;
    }

    .explore-mobile-people {
        position: absolute;
        inset: 0;
        width: 110%;
        height: 100%;
        object-fit: cover;
        left: -1.125rem;
        z-index: 3;
    }

    .explore-mobile-info {
        display: flex;
        align-items: flex-start;
        gap: var(--space-6);
    }

    .explore-mobile-text {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: var(--space-1);
        min-width: 0;
    }

    .explore-mobile-name {
        color: var(--text-primary);
    }

    .explore-mobile-desc {
        color: var(--text-secondary);
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .explore-mobile-chevron {
        flex-shrink: 0;
        width: 0.875rem;
        height: 1.375rem;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    @media (max-width: 1023px) {
        .explore-cards-desktop {
            display: none;
        }

        .explore-cards-mobile {
            display: flex;
        }

        .explore-nav {
            display: flex;
        }

        .explore-more-section {
            padding-top: var(--space-8);
            padding-bottom: var(--space-8);
        }
    }

    .heading-fly-in {
        opacity: 0;
        transform: translateY(1.625rem);
        transition:
            opacity var(--motion-duration-heading) ease,
            transform var(--motion-duration-heading) var(--motion-ease-standard);
    }

    .heading-fly-in.is-visible {
        opacity: 1;
        transform: translateY(0);
    }

    /* Per-card entrance, staggered — same spring/duration/delay as the
       homepage Solutions cards (.solutions-card-fly-in). */
    .card-fly-in {
        opacity: 0;
        transform: translateY(1.625rem);
        transition:
            opacity var(--motion-duration-card) cubic-bezier(0.22, 1, 0.36, 1),
            transform var(--motion-duration-card) cubic-bezier(0.22, 1, 0.36, 1);
    }

    .card-fly-in.is-visible {
        opacity: 1;
        transform: translateY(0);
    }
</style>

<script>
    // Heading and each cards row observe themselves, not the outer section —
    // a threshold is a fraction of the target's own area, so watching the
    // whole section skews the trigger point once it's taller than any one
    // piece inside it.
    document.querySelectorAll<HTMLElement>('.explore-more-section').forEach((section) => {
        const heading = section.querySelector<HTMLElement>('.heading-fly-in');
        if (heading) {
            const headingObserver = new IntersectionObserver(
                ([entry]) => {
                    if (entry.isIntersecting) {
                        heading.classList.add('is-visible');
                        headingObserver.disconnect();
                    }
                },
                { threshold: 0.15 }
            );
            headingObserver.observe(heading);
        }

        // Staggered independently per layout (desktop vs. mobile) since only
        // one is ever visible at a time; each row triggers off its own
        // container so the cards aren't gated by the whole section's size.
        function staggerCardsIn(containerSelector: string, cardClass: string) {
            const container = section.querySelector<HTMLElement>(containerSelector);
            const cards = section.querySelectorAll<HTMLElement>(cardClass);
            if (!container || !cards.length) return;
            const rowObserver = new IntersectionObserver(
                ([entry]) => {
                    if (entry.isIntersecting) {
                        cards.forEach((card, i) => {
                            setTimeout(() => card.classList.add('is-visible'), i * 140);
                        });
                        rowObserver.disconnect();
                    }
                },
                { threshold: 0.15 }
            );
            rowObserver.observe(container);
        }

        staggerCardsIn('.explore-cards-desktop', '.explore-card.card-fly-in');
        staggerCardsIn('.explore-cards-mobile', '.explore-mobile-card.card-fly-in');
    });
</script>
