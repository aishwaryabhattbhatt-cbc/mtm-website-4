---
import EyebrowIcon from '../shared/EyebrowIcon.astro';

interface StatItem {
    value?: string;
    label: string;
    logoSrc?: string;
    description: string;
}

interface Props {
    pillLabel: string;
    iconSrc: string;
    stats: StatItem[];
    statLayout?: 'column' | 'row';
}

const { pillLabel, iconSrc, stats, statLayout = 'column' } = Astro.props as Props;
---

<div class="methodology-card">
    <EyebrowIcon iconSrc={iconSrc} label={pillLabel} />

    <ul class="methodology-card-stats" role="list">
        {
            stats.map((stat) => (
                <li
                    class={`methodology-card-stat${statLayout === 'row' ? ' methodology-card-stat--row' : ''}`}
                >
                    {stat.value && (
                        <span class="text-body-p0-bold methodology-card-stat-value">
                            {stat.value}
                        </span>
                    )}
                    {stat.logoSrc ? (
                        <img
                            src={stat.logoSrc}
                            alt={stat.label}
                            class="methodology-card-stat-logo"
                            loading="lazy"
                            decoding="async"
                        />
                    ) : (
                        <span class="text-body-p2-bold methodology-card-stat-label">
                            {stat.label}
                        </span>
                    )}
                    <p class="text-body-p3 methodology-card-stat-desc">{stat.description}</p>
                </li>
            ))
        }
    </ul>
</div>

<style>
    .methodology-card {
        background-color: var(--surface-white);
        border-radius: var(--layout-card-radius);
        box-shadow: var(--shadow-card);
        padding: var(--card-pad);
        display: flex;
        flex-direction: column;
        gap: var(--space-6);
        min-width: 0;
    }

    .methodology-card-stats {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: var(--space-7);
    }

    .methodology-card-stat {
        display: flex;
        flex-direction: column;
        gap: var(--space-1);
    }

    .methodology-card-stat-value {
        color: var(--brand-blue-main);
        white-space: nowrap;
    }

    .methodology-card-stat-label {
        color: var(--text-primary);
    }

    .methodology-card-stat-logo {
        max-height: var(--space-13);
        width: auto;
        display: block;
        align-self: flex-start;
    }

    .methodology-card-stat--row {
        display: grid;
        grid-template-columns: 1fr 2fr;
        align-items: start;
        gap: var(--space-6);
    }

    .methodology-card-stat-desc {
        color: var(--text-secondary);
        margin: 0;
        white-space: pre-line;
    }

    @media (max-width: 1023px) {
        .methodology-card-stat--row {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 767px) {
        .methodology-card-stat-logo {
            width: 70%;
            max-height: none;
        }
    }
</style>
