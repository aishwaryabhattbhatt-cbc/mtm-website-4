---
import EyebrowIcon from '../shared/EyebrowIcon.astro';

interface StatItem {
    value?: string;
    label: string;
    logoSrc?: string;
    description: string;
}

interface Props {
    pillLabel: string;
    iconSrc: string;
    stats: StatItem[];
    statLayout?: 'column' | 'row';
    /** Extra delay (ms) before this card's own stat stagger starts —
        lets one card's data points wait until sibling cards in the same
        row have visibly appeared, instead of every card's stats revealing
        the moment they scroll into view. */
    revealDelayMs?: number;
    /** Per-stat offsets (ms, relative to the stagger's own start) —
        overrides the default uniform 300ms-apart spacing when a card
        needs a custom rhythm (e.g. the last stat catching up faster). */
    staggerOffsetsMs?: number[];
}

const {
    pillLabel,
    iconSrc,
    stats,
    statLayout = 'column',
    revealDelayMs = 0,
    staggerOffsetsMs,
} = Astro.props as Props;
---

<div class="methodology-card">
    <EyebrowIcon iconSrc={iconSrc} label={pillLabel} />

    <ul
        class="methodology-card-stats"
        role="list"
        data-reveal-delay={revealDelayMs}
        data-stagger-offsets={staggerOffsetsMs ? JSON.stringify(staggerOffsetsMs) : undefined}
    >
        {
            stats.map((stat) => (
                <li
                    class={`methodology-card-stat methodology-stat-fly-in${statLayout === 'row' ? ' methodology-card-stat--row' : ''}`}
                >
                    {stat.value && (
                        <span class="text-body-p0-bold methodology-card-stat-value">
                            {stat.value}
                        </span>
                    )}
                    {stat.logoSrc ? (
                        <img
                            src={stat.logoSrc}
                            alt={stat.label}
                            class="methodology-card-stat-logo"
                            loading="lazy"
                            decoding="async"
                        />
                    ) : (
                        <span class="text-body-p2-bold methodology-card-stat-label">
                            {stat.label}
                        </span>
                    )}
                    <p class="text-body-p3 methodology-card-stat-desc">{stat.description}</p>
                </li>
            ))
        }
    </ul>
</div>

<style>
    .methodology-card {
        background-color: var(--surface-white);
        border-radius: var(--layout-card-radius);
        box-shadow: var(--shadow-card);
        padding: var(--card-pad);
        display: flex;
        flex-direction: column;
        gap: var(--space-6);
        min-width: 0;
    }

    .methodology-card-stats {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: var(--space-7);
    }

    .methodology-card-stat {
        display: flex;
        flex-direction: column;
        gap: var(--space-1);
    }

    .methodology-card-stat-value {
        color: var(--brand-blue-main);
        white-space: nowrap;
    }

    .methodology-card-stat-label {
        color: var(--text-primary);
    }

    .methodology-card-stat-logo {
        max-height: var(--space-13);
        width: auto;
        display: block;
        align-self: flex-start;
    }

    .methodology-card-stat--row {
        display: grid;
        grid-template-columns: 1fr 2fr;
        align-items: start;
        gap: var(--space-6);
    }

    .methodology-card-stat-desc {
        color: var(--text-secondary);
        margin: 0;
        white-space: pre-line;
    }

    @media (max-width: 1023px) {
        .methodology-card-stat--row {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 767px) {
        .methodology-card-stat-logo {
            width: 70%;
            max-height: none;
        }
    }

    .methodology-stat-fly-in {
        opacity: 0;
        transform: translateY(1.625rem);
        transition:
            opacity var(--motion-duration-card) cubic-bezier(0.22, 1, 0.36, 1),
            transform var(--motion-duration-card) cubic-bezier(0.22, 1, 0.36, 1);
    }

    .methodology-stat-fly-in.is-visible {
        opacity: 1;
        transform: translateY(0);
    }
</style>

<script>
    // The stat list's own geometry says nothing about whether it's actually
    // visible: the card wrapping it (.card-fly-in, from the parent section)
    // starts at opacity:0 and fades in on its own row-based delay. If this
    // stagger fired on the list's own intersection, a card sitting later in
    // that row would finish its whole stagger while still hidden behind the
    // parent's fade-in — so by the time the card appears, every stat is
    // already resolved to "visible" and the reveal reads as one instant pop
    // instead of a stagger. Wait for the ancestor card to actually become
    // visible before starting the stagger; fall back to this element's own
    // intersection if it isn't wrapped in one.
    //
    // MutationObserver fires right as the card's is-visible class gets
    // added — i.e. right as its 650ms (--motion-duration-card) fade-in
    // *starts*, not once it's finished. Starting the stat stagger at that
    // same instant makes stat 1 fade in on top of the still-fading card, so
    // the two blend together and the stagger disappears visually. CARD_FADE_MS
    // holds the stagger off until the card's own entrance has settled;
    // revealDelayMs (data-reveal-delay) adds on top of that for cross-card
    // sequencing (see Survey Design's usage in ProductMethodologySection).
    const CARD_FADE_MS = 650;
    const STAT_COUNT_MS = 1400;
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Same leading-number roll-up as CountUpValue, but matches every number
    // in the string (not just the first) — sample_stat_3 is literally two
    // stats in one value ("6,000+/6,000+"), and animating only the first
    // half would read as broken rather than intentional. Values with no
    // digits at all (e.g. "Two-Part") are left untouched.
    function animateStatValue(el: HTMLElement) {
        const raw = el.textContent?.trim() ?? '';
        const matches = [...raw.matchAll(/-?[\d,]+(\.\d+)?/g)];
        if (!matches.length) return;

        const segments: { text: string; target?: number; decimals?: number; commas?: boolean }[] =
            [];
        let cursor = 0;
        matches.forEach((m) => {
            const start = m.index ?? 0;
            if (start > cursor) segments.push({ text: raw.slice(cursor, start) });
            const numStr = m[0];
            segments.push({
                text: numStr,
                target: parseFloat(numStr.replace(/,/g, '')),
                decimals: numStr.includes('.') ? numStr.split('.')[1].length : 0,
                commas: numStr.includes(','),
            });
            cursor = start + numStr.length;
        });
        if (cursor < raw.length) segments.push({ text: raw.slice(cursor) });

        const startTime = performance.now();
        function frame(now: number) {
            const progress = Math.min((now - startTime) / STAT_COUNT_MS, 1);
            const eased = 1 - Math.pow(1 - progress, 3);
            el.textContent = segments
                .map((s) => {
                    if (s.target === undefined) return s.text;
                    const current = s.target * eased;
                    return s.commas
                        ? current.toLocaleString('en-US', {
                              minimumFractionDigits: s.decimals,
                              maximumFractionDigits: s.decimals,
                          })
                        : current.toFixed(s.decimals);
                })
                .join('');
            if (progress < 1) {
                requestAnimationFrame(frame);
            } else {
                el.textContent = raw;
            }
        }
        requestAnimationFrame(frame);
    }

    function runStagger(list: HTMLElement) {
        const baseDelay = CARD_FADE_MS + (Number(list.dataset.revealDelay) || 0);
        let offsets: number[] = [];
        try {
            offsets = list.dataset.staggerOffsets ? JSON.parse(list.dataset.staggerOffsets) : [];
        } catch {
            offsets = [];
        }
        const stats = list.querySelectorAll<HTMLElement>('.methodology-stat-fly-in');
        stats.forEach((stat, i) => {
            const offset = offsets[i] ?? i * 300;
            setTimeout(() => {
                stat.classList.add('is-visible');
                if (prefersReducedMotion) return;
                const value = stat.querySelector<HTMLElement>('.methodology-card-stat-value');
                if (value) animateStatValue(value);
            }, baseDelay + offset);
        });
    }

    document.querySelectorAll<HTMLElement>('.methodology-card-stats').forEach((list) => {
        const card = list.closest<HTMLElement>('.card-fly-in');
        if (!card) {
            const observer = new IntersectionObserver(
                (entries) => {
                    entries.forEach((entry) => {
                        if (!entry.isIntersecting) return;
                        runStagger(list);
                        observer.unobserve(entry.target);
                    });
                },
                { threshold: 0.2 }
            );
            observer.observe(list);
            return;
        }

        if (card.classList.contains('is-visible')) {
            runStagger(list);
            return;
        }

        const cardObserver = new MutationObserver(() => {
            if (card.classList.contains('is-visible')) {
                cardObserver.disconnect();
                runStagger(list);
            }
        });
        cardObserver.observe(card, { attributes: true, attributeFilter: ['class'] });
    });
</script>
