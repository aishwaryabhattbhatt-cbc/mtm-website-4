---
interface Props {
    percentage: string;
    size?: string;
}

const { percentage, size = '12rem' } = Astro.props as Props;

const RADIUS = 52;
const CIRCUMFERENCE = 2 * Math.PI * RADIUS;

function arcLength(percentStr: string): number {
    const pct = parseFloat(percentStr.replace('%', ''));
    return isNaN(pct) ? 0 : (pct / 100) * CIRCUMFERENCE;
}

const donutOffset = CIRCUMFERENCE - arcLength(percentage);
---

<div
    class="donut-chart"
    style={`--donut-size: ${size}; --donut-circumference: ${CIRCUMFERENCE}px; --donut-offset: ${donutOffset}px`}
    aria-hidden="true"
>
    <svg viewBox="0 0 140 140">
        <circle
            cx="70"
            cy="70"
            r={RADIUS}
            fill="none"
            stroke="var(--neutral-grey-4)"
            stroke-width="12"></circle>
        <circle
            class="donut-progress"
            cx="70"
            cy="70"
            r={RADIUS}
            fill="none"
            stroke="var(--brand-blue-main)"
            stroke-width="12"
            stroke-linecap="round"
            transform="rotate(-90 70 70)"></circle>
    </svg>
    <span class="donut-value text-h4">{percentage}</span>
</div>

<style>
    .donut-chart {
        position: relative;
        width: 100%;
        max-width: var(--donut-size);
        aspect-ratio: 1;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .donut-chart svg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
    }

    .donut-progress {
        /* Explicit two-value dash/gap (both = full circumference), not a
           single value left to the "odd-length lists repeat" rule — that
           auto-doubling isn't reliably applied when the value comes from a
           custom property, and without it the dash becomes one unbroken
           segment covering the whole path (no gap), so the ring renders
           fully solid no matter what stroke-dashoffset is. */
        stroke-dasharray: var(--donut-circumference) var(--donut-circumference);
        /* Starts fully wound back (offset = full circumference, so none of
           the ring shows) and eases forward to --donut-offset once the
           chart scrolls into view (self-observed, see script below). Kept
           slower than the usual entrance tokens — a data reveal reads
           better unhurried than a snappy UI transition. */
        stroke-dashoffset: var(--donut-circumference);
        transition: stroke-dashoffset 1.6s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .donut-chart.is-visible .donut-progress {
        stroke-dashoffset: var(--donut-offset);
    }

    @media (prefers-reduced-motion: reduce) {
        .donut-progress {
            transition: none;
            stroke-dashoffset: var(--donut-offset);
        }
    }

    .donut-value {
        position: relative;
        z-index: 1;
        color: var(--brand-blue-main);
    }
</style>

<script>
    const donutObserver = new IntersectionObserver(
        (entries) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('is-visible');
                    donutObserver.unobserve(entry.target);
                }
            });
        },
        { threshold: 0.2 }
    );
    document.querySelectorAll<HTMLElement>('.donut-chart').forEach((chart) => {
        donutObserver.observe(chart);
    });
</script>
