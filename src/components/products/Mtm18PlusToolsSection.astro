---
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { t } from '../../lib/i18n/t';
import { icons } from '../../lib/icons/registry';
import Button from '../shared/Button.astro';

interface Props {
    locale: Locale;
    copy: CMSDictionary;
}

const { locale, copy } = Astro.props as Props;
const base = import.meta.env.BASE_URL;

function splitCallout(text: string): [string, string] {
    const idx = text.indexOf('?');
    if (idx === -1) return [text, ''];
    return [
        text.slice(0, idx + 1),
        text
            .slice(idx + 1)
            .replace(/^\n/, '')
            .trim(),
    ];
}

const [datCalloutQ, datCalloutA] = splitCallout(t(copy, 'dat_callout', locale, ''));
const [trendingCalloutQ, trendingCalloutA] = splitCallout(t(copy, 'trending_callout', locale, ''));
const [forecastCalloutQ, forecastCalloutA] = splitCallout(
    t(copy, 'forecasting_callout', locale, '')
);
---

<section class="mtm18-tools-section">
    <div class="mtm18-tools-headline">
        <h2 data-copy-key="tools_title">
            {t(copy, 'tools_title', locale, 'Tools')}
        </h2>
        <p class="text-body-p1 mtm18-tools-description" data-copy-key="tools_description">
            {
                t(
                    copy,
                    'tools_description',
                    locale,
                    'Explore our suite of analytics, forecasting, and trending tools. Leverage data insights for confident decision-making.'
                )
            }
        </p>
    </div>

    <div class="row mtm18-tools-grid">
        <div class="col col-12 col-lg-7 mtm18-tools-left">
            <img
                src={`${base}images/products/mtm-18-plus/data-analysis-tool.png`}
                alt="Data analysis tool screenshot"
                class="mtm18-tools-image"
                loading="lazy"
                decoding="async"
            />
        </div>
        <div class="col col-12 col-lg-5 mtm18-tools-right">
            <div class="mtm18-tools-card">
                <div class="mtm18-tools-card-header">
                    <img
                        src={`${base}${icons.tool.dat}`}
                        alt=""
                        aria-hidden="true"
                        class="icon-2xl mtm18-tools-card-icon"
                        loading="lazy"
                        decoding="async"
                    />
                    <h3 data-copy-key="dat_title">
                        {t(copy, 'dat_title', locale, 'Data Analysis Tool')}
                    </h3>
                </div>
                <p class="text-body-p2 mtm18-tools-card-desc" data-copy-key="dat_description">
                    {t(copy, 'dat_description', locale, '')}
                </p>
                <Button variant="tertiary" size="lg" href={`${base}${locale}/request-demo/`}>
                    {t(copy, 'dat_cta', locale, 'LEARN MORE')}
                </Button>

                <div class="mtm18-float-card" aria-hidden="true">
                    <svg
                        class="mtm18-float-card-arrow"
                        viewBox="0 0 10 14"
                        fill="none"
                        aria-hidden="true"
                    >
                        <path d="M10 0L0 7L10 14V0Z" fill="currentColor"></path>
                    </svg>
                    <div class="mtm18-float-card-text">
                        <p class="text-body-p2-bold">{datCalloutQ}</p>
                        <p class="text-body-p2">{datCalloutA}</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mtm18-tools-grid mtm18-tools-grid--reversed">
        <div class="col col-12 col-lg-7 mtm18-tools-left">
            <img
                src={`${base}images/products/mtm-18-plus/trending-tool.png`}
                alt="Trending tool screenshot"
                class="mtm18-tools-image"
                loading="lazy"
                decoding="async"
            />
        </div>
        <div class="col col-12 col-lg-5 mtm18-tools-right">
            <div class="mtm18-tools-card">
                <div class="mtm18-tools-card-header">
                    <img
                        src={`${base}${icons.tool.trending}`}
                        alt=""
                        aria-hidden="true"
                        class="icon-2xl mtm18-tools-card-icon"
                        loading="lazy"
                        decoding="async"
                    />
                    <h3 data-copy-key="trending_title">
                        {t(copy, 'trending_title', locale, 'Trending Tool')}
                    </h3>
                </div>
                <p class="text-body-p2 mtm18-tools-card-desc" data-copy-key="trending_description">
                    {t(copy, 'trending_description', locale, '')}
                </p>
                <Button variant="tertiary" size="lg" href={`${base}${locale}/request-demo/`}>
                    {t(copy, 'trending_cta', locale, 'LEARN MORE')}
                </Button>

                <div class="mtm18-float-card mtm18-float-card--reversed" aria-hidden="true">
                    <div class="mtm18-float-card-text">
                        <p class="text-body-p2-bold">{trendingCalloutQ}</p>
                        <p class="text-body-p2">{trendingCalloutA}</p>
                    </div>
                    <svg
                        class="mtm18-float-card-arrow"
                        viewBox="0 0 10 14"
                        fill="none"
                        aria-hidden="true"
                    >
                        <path d="M10 0L0 7L10 14V0Z" fill="currentColor"></path>
                    </svg>
                </div>
            </div>
        </div>
    </div>

    <div class="row mtm18-tools-grid">
        <div class="col col-12 col-lg-7 mtm18-tools-left">
            <img
                src={`${base}images/products/mtm-18-plus/forecasting-tool.png`}
                alt="Forecasting tool screenshot"
                class="mtm18-tools-image"
                loading="lazy"
                decoding="async"
            />
        </div>
        <div class="col col-12 col-lg-5 mtm18-tools-right">
            <div class="mtm18-tools-card">
                <div class="mtm18-tools-card-header">
                    <img
                        src={`${base}${icons.tool.forecast}`}
                        alt=""
                        aria-hidden="true"
                        class="icon-2xl mtm18-tools-card-icon"
                        loading="lazy"
                        decoding="async"
                    />
                    <h3 data-copy-key="forecasting_title">
                        {t(copy, 'forecasting_title', locale, 'Forecasting Tool')}
                    </h3>
                </div>
                <p
                    class="text-body-p2 mtm18-tools-card-desc"
                    data-copy-key="forecasting_description"
                >
                    {t(copy, 'forecasting_description', locale, '')}
                </p>
                <Button variant="tertiary" size="lg" href={`${base}${locale}/request-demo/`}>
                    {t(copy, 'forecasting_cta', locale, 'LEARN MORE')}
                </Button>

                <div class="mtm18-float-card" aria-hidden="true">
                    <svg
                        class="mtm18-float-card-arrow"
                        viewBox="0 0 10 14"
                        fill="none"
                        aria-hidden="true"
                    >
                        <path d="M10 0L0 7L10 14V0Z" fill="currentColor"></path>
                    </svg>
                    <div class="mtm18-float-card-text">
                        <p class="text-body-p2-bold">{forecastCalloutQ}</p>
                        <p class="text-body-p2">{forecastCalloutA}</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .mtm18-tools-section {
        width: 100%;
        padding: var(--space-13) var(--content-margin-inline);
    }

    .mtm18-tools-headline {
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
        max-width: 51.25rem;
    }

    .mtm18-tools-description {
        color: var(--text-primary);
        margin: 0;
    }

    .mtm18-tools-grid {
        margin-top: var(--space-12);
    }

    .mtm18-tools-image {
        width: 100%;
        height: auto;
        display: block;
    }

    .mtm18-tools-card-icon {
        flex-shrink: 0;
    }

    .mtm18-tools-right {
        padding-bottom: var(--space-6);
    }

    .mtm18-tools-card {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: var(--space-4);
        height: 100%;
    }

    .mtm18-tools-card-header {
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
    }

    .mtm18-tools-card-desc {
        color: var(--text-primary);
        margin: 0;
    }

    .mtm18-float-card {
        margin-top: auto;
        margin-left: calc(-1 * var(--space-9));
        background-color: var(--surface-white);
        border-radius: var(--radius-m);
        box-shadow: var(--shadow-beautiful);
        padding: var(--space-5);
        display: flex;
        gap: var(--space-3);
        align-items: flex-start;
        position: relative;
        z-index: 1;
    }

    .mtm18-float-card-arrow {
        color: var(--brand-blue-main);
        flex-shrink: 0;
        width: auto;
        height: 0.875rem;
        margin-top: var(--space-1);
    }

    .mtm18-float-card-text {
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
    }

    .mtm18-float-card-text p {
        margin: 0;
    }

    .mtm18-tools-grid--reversed .mtm18-tools-left {
        order: 2;
    }

    .mtm18-tools-grid--reversed .mtm18-tools-right {
        order: 1;
    }

    .mtm18-float-card--reversed {
        margin-left: 0;
        margin-right: calc(-1 * var(--space-9));
        align-self: flex-end;
    }

    .mtm18-float-card--reversed .mtm18-float-card-arrow {
        transform: scaleX(-1);
    }

    @media (max-width: 1023px) {
        .mtm18-tools-right {
            order: 1;
            padding-bottom: 0;
        }

        .mtm18-tools-left {
            order: 2;
            margin-top: calc(-1 * var(--space-8));
            position: relative;
            z-index: 0;
        }

        .mtm18-tools-card {
            height: auto;
        }

        .mtm18-tools-card-header {
            flex-direction: row;
            align-items: center;
        }

        .mtm18-tools-image {
            border-radius: var(--radius-s);
        }

        .mtm18-float-card {
            margin-top: 0;
            margin-left: 0;
            align-self: center;
            border-radius: var(--radius-s);
            padding: var(--space-3);
            position: relative;
            z-index: 1;
        }

        .mtm18-float-card-arrow {
            transform: rotate(-90deg);
        }

        .mtm18-float-card--reversed {
            margin-right: 0;
            align-self: center;
            flex-direction: row-reverse;
        }

        .mtm18-float-card--reversed .mtm18-float-card-arrow {
            transform: rotate(-90deg);
        }
    }
</style>
