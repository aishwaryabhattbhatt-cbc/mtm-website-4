---
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { t } from '../../lib/i18n/t';
import { icons } from '../../lib/icons/registry';
import ProductToolsSection from './ProductToolsSection.astro';

interface Props {
    locale: Locale;
    copy: CMSDictionary;
}

const { locale, copy } = Astro.props as Props;
const base = import.meta.env.BASE_URL;

const tools = [
    {
        imageSrc: `${base}images/products/mtm-junior/data-analysis-tool.webp`,
        imageAlt: 'Data analysis tool screenshot',
        iconSrc: `${base}${icons.tool.dat}`,
        title: t(copy, 'dat_title', locale, 'Data Analysis Tool'),
        description: t(copy, 'dat_description', locale, ''),
        calloutText: t(copy, 'dat_callout', locale, ''),
        ctaLabel: t(copy, 'dat_cta', locale, 'LEARN MORE'),
        ctaHref: `${base}${locale}/request-demo/`,
    },
    {
        imageSrc: `${base}images/products/mtm-junior/trending-tool.webp`,
        imageAlt: 'Trending tool screenshot',
        iconSrc: `${base}${icons.tool.trending}`,
        title: t(copy, 'trending_title', locale, 'Trending Tool'),
        description: t(copy, 'trending_description', locale, ''),
        calloutText: t(copy, 'trending_callout', locale, ''),
        ctaLabel: t(copy, 'trending_cta', locale, 'LEARN MORE'),
        ctaHref: `${base}${locale}/request-demo/`,
    },
];
---

<ProductToolsSection locale={locale} copy={copy} tools={tools} />
