---
import ProductDonutChart from './ProductDonutChart.astro';

interface DonutItem {
    label: string;
    percentage: string;
}

interface Props {
    pillLabel: string;
    iconSrc: string;
    items: DonutItem[];
}

const { pillLabel, iconSrc, items } = Astro.props as Props;
---

<div class="composition-card">
    <div class="composition-card-pill">
        <img
            src={iconSrc}
            alt=""
            aria-hidden="true"
            class="icon-l composition-card-icon"
            loading="lazy"
            decoding="async"
        />
        <span class="text-label-small composition-card-pill-label">{pillLabel}</span>
    </div>

    <div class="composition-card-donuts">
        {
            items.map((item) => (
                <>
                    <p class="text-body-p2-bold composition-donut-label">{item.label}</p>
                    <ProductDonutChart percentage={item.percentage} size="9rem" />
                </>
            ))
        }
    </div>

    <p class="text-body-p3 composition-card-description">
        Sample composition is weighted to reflect the national distribution of Canadian households.
    </p>
</div>

<style>
    .composition-card {
        background-color: var(--surface-white);
        border-radius: var(--layout-card-radius);
        box-shadow: var(--shadow-card);
        padding: var(--space-6);
        display: flex;
        flex-direction: column;
        gap: var(--space-6);
        min-width: 0;
    }

    .composition-card-pill {
        display: inline-flex;
        align-items: center;
        gap: var(--space-3);
        background-color: var(--surface-blue);
        border-radius: var(--radius-s);
        padding: var(--space-2) var(--space-4) var(--space-2) var(--space-2);
        align-self: flex-start;
    }

    .composition-card-icon {
        flex-shrink: 0;
    }

    .composition-card-pill-label {
        color: var(--text-secondary);
        white-space: nowrap;
    }

    .composition-card-donuts {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--space-4) var(--space-8);
        align-items: center;
    }

    .composition-donut-label {
        color: var(--text-primary);
        margin: 0;
    }

    .composition-card-description {
        color: var(--text-secondary);
        margin: 0;
    }
</style>
