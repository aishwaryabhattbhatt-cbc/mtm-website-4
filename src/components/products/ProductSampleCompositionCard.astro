---
import EyebrowIcon from '../shared/EyebrowIcon.astro';
import ProductDonutChart from './ProductDonutChart.astro';

interface DonutItem {
    label: string;
    percentage: string;
}

interface Props {
    pillLabel: string;
    iconSrc: string;
    items: DonutItem[];
}

const { pillLabel, iconSrc, items } = Astro.props as Props;
---

<div class="composition-card">
    <EyebrowIcon iconSrc={iconSrc} label={pillLabel} />

    <div class="composition-card-donuts">
        {
            items.map((item) => (
                <>
                    <p class="text-body-p2-bold composition-donut-label">{item.label}</p>
                    <ProductDonutChart percentage={item.percentage} size="9rem" />
                </>
            ))
        }
    </div>

    <p class="text-body-p3 composition-card-description">
        Sample composition is weighted to reflect the national distribution of Canadian households.
    </p>
</div>

<style>
    .composition-card {
        background-color: var(--surface-white);
        border-radius: var(--layout-card-radius);
        box-shadow: var(--shadow-card);
        padding: var(--card-pad);
        display: flex;
        flex-direction: column;
        gap: var(--space-6);
        min-width: 0;
    }

    .composition-card-donuts {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--space-4) var(--space-8);
        align-items: center;
    }

    .composition-donut-label {
        color: var(--text-primary);
        margin: 0;
    }

    .composition-card-description {
        color: var(--text-secondary);
        margin: 0;
    }

    @media (max-width: 767px) {
        .composition-card-donuts {
            grid-template-columns: 1fr;
            justify-items: center;
            text-align: center;
        }

        .composition-card-donuts :global(.donut-chart) {
            max-width: 6.5rem;
        }
    }
</style>
