---
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { icons } from '../../lib/icons/registry';
import ProductFeaturesSection from './ProductFeaturesSection.astro';

interface Props {
    locale: Locale;
    copy: CMSDictionary;
}

const { locale, copy } = Astro.props as Props;
const base = import.meta.env.BASE_URL;

const features = [
    {
        icon: `${base}${icons['product-juniors'].yearsData8}`,
        titleKey: 'feature_1_title',
        descKey: 'feature_1_description',
        titleFallback: '8 Years Of Data',
        descFallback:
            'The only annual study tracking media and technology habits of Canadian children and teens.',
    },
    {
        icon: `${base}${icons.gen.largeSamples}`,
        titleKey: 'feature_2_title',
        descKey: 'feature_2_description',
        titleFallback: 'A Large Sample You Can Rely On',
        descFallback:
            'Data spanning children and teens aged 2–17 across all provinces and demographics.',
    },
    {
        icon: `${base}${icons['product-juniors'].focusedOnKids}`,
        titleKey: 'feature_3_title',
        descKey: 'feature_3_description',
        titleFallback: 'Focused on Kids',
        descFallback:
            'Nationally representative sampling ensures findings reflect the true Canadian youth population.',
    },
    {
        icon: `${base}${icons.gen.bilingual}`,
        titleKey: 'feature_4_title',
        descKey: 'feature_4_description',
        titleFallback: 'A Fully Bilingual Product',
        descFallback:
            'Thousands of respondents annually, giving you the statistical confidence to act on the data.',
    },
    {
        icon: `${base}${icons['product-juniors'].surveyingKids}`,
        titleKey: 'feature_5_title',
        descKey: 'feature_5_description',
        titleFallback: 'Surveying Teens Directly',
        descFallback:
            'Insights into household-level media consumption habits among younger Canadians.',
    },
];
---

<ProductFeaturesSection locale={locale} copy={copy} features={features} />
