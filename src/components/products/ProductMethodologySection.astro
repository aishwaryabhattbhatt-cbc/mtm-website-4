---
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { t } from '../../lib/i18n/t';
import { icons } from '../../lib/icons/registry';
import CarouselNavArrows from '../shared/CarouselNavArrows.astro';
import ProductMethodologyCard from './ProductMethodologyCard.astro';
import ProductSampleCompositionCard from './ProductSampleCompositionCard.astro';

interface Props {
    locale: Locale;
    copy: CMSDictionary;
    showComposition?: boolean;
    providerLogoSrc?: string;
}

const { locale, copy, showComposition = true, providerLogoSrc } = Astro.props as Props;
const base = import.meta.env.BASE_URL;

const surveyStats = [
    {
        value: t(copy, 'survey_stat_1', locale, '25+'),
        label: t(copy, 'survey_stat_1_label', locale, 'Years of data collection'),
        description: t(
            copy,
            'survey_stat_1_description',
            locale,
            'Industry standard level tracking'
        ),
    },
    {
        value: t(copy, 'survey_stat_2', locale, '22%'),
        label: t(copy, 'survey_stat_2_label', locale, 'Response rate'),
        description: t(copy, 'survey_stat_2_description', locale, 'Exceeds industry standards'),
    },
    {
        value: t(copy, 'survey_stat_3', locale, 'Two-Part'),
        label: t(copy, 'survey_stat_3_label', locale, 'Survey structure'),
        description: t(
            copy,
            'survey_stat_3_description',
            locale,
            'Respondents complete a phone survey and an additional follow up online survey, with questions optimized for each medium.'
        ),
    },
];

const compositionItems = [
    {
        label: t(copy, 'method_1', locale, 'Landline Proportion'),
        percentage: t(copy, 'method_1_percentage', locale, '57%'),
    },
    {
        label: t(copy, 'method_2', locale, 'Cellphone Only Household (CPO) Proportion'),
        percentage: t(copy, 'method_2_percentage', locale, '43%'),
    },
];

const providerStats = [
    {
        label: t(copy, 'provider_label', locale, 'Forum Research'),
        logoSrc: providerLogoSrc ?? `${base}images/products/mtm-18-plus/forum_research_logo.png`,
        description: t(copy, 'provider_description', locale, ''),
    },
];

const sampleStats = [
    {
        value: t(copy, 'sample_stat_1', locale, '12,000+'),
        label: t(copy, 'sample_stat_1_label', locale, 'Canadian adults surveyed annually'),
        description: t(
            copy,
            'sample_stat_1_description',
            locale,
            'The largest on-going survey of its kind.'
        ),
    },
    {
        value: t(copy, 'sample_stat_2', locale, '300,000+'),
        label: t(copy, 'sample_stat_2_label', locale, 'Canadian adults surveyed to date'),
        description: t(copy, 'sample_stat_2_description', locale, 'Decades of results available.'),
    },
    {
        value: t(copy, 'sample_stat_3', locale, '6,000+/6,000+'),
        label: t(copy, 'sample_stat_3_label', locale, 'Anglophone/Francophone respondents'),
        description: t(
            copy,
            'sample_stat_3_description',
            locale,
            'Large, viable samples for either Official Canadian language market.'
        ),
    },
];
---

<section class="product-methodology-section">
    <div class="product-methodology-headline heading-fly-in">
        <h2 data-copy-key="methodology_title">
            {t(copy, 'methodology_title', locale, 'Research Methodology')}
        </h2>
        <p
            class="text-body-p1 product-methodology-description"
            data-copy-key="methodology_description"
        >
            {t(copy, 'methodology_description', locale, '')}
        </p>
    </div>

    <div class="product-methodology-cards">
        <CarouselNavArrows
            scrollTargetSelector="#productMethodologyCardsScroll"
            ariaLabel="Cards navigation"
            prevLabel="Previous card"
            nextLabel="Next card"
            class="product-cards-nav"
        />

        <div
            class={`product-top-row${showComposition ? '' : ' product-top-row--two-col'}`}
            id="productMethodologyCardsScroll"
        >
            <div class="card-fly-in">
                <ProductMethodologyCard
                    pillLabel={t(copy, 'sample_title', locale, 'Sample Coverage')}
                    iconSrc={`${base}${icons.gen.sampleCoverage}`}
                    stats={sampleStats}
                />
            </div>
            <div class="card-fly-in">
                <ProductMethodologyCard
                    pillLabel={t(copy, 'survey_title', locale, 'Survey Design')}
                    iconSrc={`${base}${icons.gen.surveyDesign}`}
                    stats={surveyStats}
                    revealDelayMs={560}
                    staggerOffsetsMs={[0, 300, 400]}
                />
            </div>
            {
                showComposition && (
                    <div class="card-fly-in">
                        <ProductSampleCompositionCard
                            pillLabel={t(
                                copy,
                                'data_collected_title',
                                locale,
                                'Sample Composition'
                            )}
                            iconSrc={`${base}${icons.gen.sampleComposition}`}
                            items={compositionItems}
                            revealDelayMs={1120}
                            descriptionRevealDelayMs={1720}
                        />
                    </div>
                )
            }
        </div>

        <div class="product-methodology-provider-row">
            <div class="card-fly-in">
                <ProductMethodologyCard
                    pillLabel={t(copy, 'provider_title', locale, 'Research Provider')}
                    iconSrc={`${base}${icons.gen.researchProvider}`}
                    stats={providerStats}
                    statLayout="row"
                    revealDelayMs={showComposition ? 2150 : 250}
                />
            </div>
        </div>
    </div>
</section>

<style>
    .product-methodology-section {
        width: 100%;
        padding: var(--section-pad-block-lg) var(--content-margin-inline);
        display: flex;
        flex-direction: column;
        gap: var(--section-header-gap);
    }

    .product-methodology-headline {
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
        max-width: 51.25rem;
    }

    .product-methodology-description {
        color: var(--text-primary);
        margin: 0;
    }

    .product-methodology-cards {
        display: flex;
        flex-direction: column;
        gap: var(--layout-card-gap);
    }

    .product-cards-nav {
        display: none;
    }

    .product-top-row {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: var(--layout-card-gap);
        position: relative;
        z-index: 0;
    }

    .product-top-row--two-col {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .product-methodology-provider-row {
        width: 100%;
        position: relative;
        z-index: 1;
    }

    @media (max-width: 1439px) {
        .product-cards-nav {
            display: flex;
            justify-content: flex-start;
        }

        .product-top-row {
            display: flex;
            overflow-x: auto;
            scroll-snap-type: x mandatory;
            scroll-padding-inline-start: var(--content-margin-inline);
            -webkit-overflow-scrolling: touch;
            scrollbar-width: none;
            gap: var(--layout-card-gap);
            margin-right: calc(-1 * var(--content-margin-inline));
            padding-right: var(--content-margin-inline);
            margin-left: calc(-1 * var(--content-margin-inline));
            padding-left: var(--content-margin-inline);
            padding-top: var(--space-4);
            padding-bottom: var(--space-12);
            margin-top: calc(-1 * var(--space-4));
            margin-bottom: calc(-1 * var(--space-12));
        }

        .product-top-row::-webkit-scrollbar {
            display: none;
        }

        .product-top-row > :global(*) {
            width: clamp(17.1875rem, calc(50% - var(--space-3)), 26rem);
            flex-shrink: 0;
            scroll-snap-align: start;
        }
    }

    .heading-fly-in {
        opacity: 0;
        transform: translateY(1.625rem);
        transition:
            opacity var(--motion-duration-heading) ease,
            transform var(--motion-duration-heading) var(--motion-ease-standard);
    }

    .heading-fly-in.is-visible {
        opacity: 1;
        transform: translateY(0);
    }

    /* Per-card entrance, staggered — same spring/duration/delay as the
       homepage Solutions cards (.solutions-card-fly-in). display:flex so this
       wrapper (the actual grid item) passes the grid's row-height stretch down
       to the card component inside it — otherwise each card shrink-wraps to
       its own content and the top row's heights stop matching. */
    .card-fly-in {
        display: flex;
        opacity: 0;
        transform: translateY(1.625rem);
        transition:
            opacity var(--motion-duration-card) cubic-bezier(0.22, 1, 0.36, 1),
            transform var(--motion-duration-card) cubic-bezier(0.22, 1, 0.36, 1);
    }

    .card-fly-in > :global(*) {
        flex: 1;
    }

    .card-fly-in.is-visible {
        opacity: 1;
        transform: translateY(0);
    }
</style>

<script>
    // Heading and each card row observe themselves, not the outer section —
    // a threshold is a fraction of the target's own area, so watching the
    // whole section skews the trigger point once it's taller than any one
    // piece inside it (the provider row sits well below the top row).
    document.querySelectorAll<HTMLElement>('.product-methodology-section').forEach((section) => {
        const heading = section.querySelector<HTMLElement>('.heading-fly-in');
        if (heading) {
            const headingObserver = new IntersectionObserver(
                ([entry]) => {
                    if (entry.isIntersecting) {
                        heading.classList.add('is-visible');
                        headingObserver.disconnect();
                    }
                },
                { threshold: 0.15 }
            );
            headingObserver.observe(heading);
        }

        function staggerCardsInRow(row: HTMLElement | null) {
            if (!row) return;
            const cards = row.querySelectorAll<HTMLElement>('.card-fly-in');
            if (!cards.length) return;
            const rowObserver = new IntersectionObserver(
                ([entry]) => {
                    if (entry.isIntersecting) {
                        cards.forEach((card, i) => {
                            setTimeout(() => card.classList.add('is-visible'), i * 140);
                        });
                        rowObserver.disconnect();
                    }
                },
                { threshold: 0.2 }
            );
            rowObserver.observe(row);
        }

        staggerCardsInRow(section.querySelector<HTMLElement>('.product-top-row'));
        staggerCardsInRow(section.querySelector<HTMLElement>('.product-methodology-provider-row'));
    });
</script>
