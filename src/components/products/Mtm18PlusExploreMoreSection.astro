---
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { t } from '../../lib/i18n/t';
import bgJr from '../../assets/images/home/mtm-suite/home-products-bg-jr.webp';
import peopleJr from '../../assets/images/home/mtm-suite/home-products-people-jr.webp';
import bgNc from '../../assets/images/home/mtm-suite/home-products-bg-nc.webp';
import peopleNc from '../../assets/images/home/mtm-suite/home-products-people-nc.webp';
import bgCs from '../../assets/images/home/mtm-suite/home-products-bg-cs.webp';
import peopleCs from '../../assets/images/home/mtm-suite/home-products-people-cs.webp';
import chartJr from '../../assets/svg/home/data-products/junior.svg?url';
import chartNc from '../../assets/svg/home/data-products/newcomers.svg?url';
import chartCs from '../../assets/svg/home/data-products/census.svg?url';
import ProductExploreMoreSection from './ProductExploreMoreSection.astro';

interface Props {
    locale: Locale;
    copy: CMSDictionary;
}

const { locale, copy } = Astro.props as Props;
const base = import.meta.env.BASE_URL;

const products = [
    {
        id: 'junior',
        name: t(copy, 'product_2_title', locale, 'MTM Junior'),
        desc: t(
            copy,
            'product_2_description',
            locale,
            'Insights into the media and technology habits of Canadians aged 2–17'
        ),
        href: `${base}${locale}/products/juniors/`,
        bg: bgJr,
        people: peopleJr,
        chartSrc: chartJr,
        chevronFill: 'var(--badge-juniors)',
    },
    {
        id: 'newcomer',
        name: t(copy, 'product_3_title', locale, 'MTM Newcomers'),
        desc: t(
            copy,
            'product_3_description',
            locale,
            'Research focused on Canadians who have arrived within the past five years'
        ),
        href: `${base}${locale}/products/newcomers/`,
        bg: bgNc,
        people: peopleNc,
        chartSrc: chartNc,
        chevronFill: 'var(--badge-newcomers)',
    },
    {
        id: 'census',
        name: t(copy, 'product_4_title', locale, 'MTM Census Tool'),
        desc: t(
            copy,
            'product_4_description',
            locale,
            'Comprehensive demographic and population data for enhanced analysis and targeting'
        ),
        href: `${base}${locale}/tools/census-tool/`,
        bg: bgCs,
        people: peopleCs,
        chartSrc: chartCs,
        chevronFill: 'var(--badge-census)',
    },
];
---

<ProductExploreMoreSection
    heading={t(copy, 'explore_title', locale, 'Explore More Data')}
    products={products}
/>
