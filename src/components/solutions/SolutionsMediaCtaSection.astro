---
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { t } from '../../lib/i18n/t';
import Button from '../shared/Button.astro';

interface Props {
    locale: Locale;
    copy: CMSDictionary;
    ctaHref: string;
}

const { locale, copy, ctaHref } = Astro.props as Props;
---

<section class="solutions-media-cta-section">
    <div class="solutions-media-cta-section__card">
        <div class="solutions-media-cta-section__content">
            <h2 data-copy-key="media_cta_title">
                {t(copy, 'media_cta_title', locale, 'Bring MTM Insights Into Your Media Strategy')}
            </h2>
            <p class="text-body-p1" data-copy-key="media_cta_description">
                {
                    t(
                        copy,
                        'media_cta_description',
                        locale,
                        'Talk with our team to explore data access, report subscriptions, and the best setup for your organization.'
                    )
                }
            </p>
        </div>

        <Button href={ctaHref} size="lg">
            {t(copy, 'media_cta_button', locale, 'Request a demo')}
        </Button>
    </div>
</section>

<style>
    .solutions-media-cta-section {
        width: 100%;
        padding: var(--section-pad-block) var(--content-margin-inline);
    }

    .solutions-media-cta-section__card {
        border: var(--stroke-1) solid var(--border-secondary);
        border-radius: var(--radius-m);
        background: var(--surface-white);
        box-shadow: var(--shadow-card);
        padding: var(--space-8);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-7);
    }

    .solutions-media-cta-section__content {
        display: flex;
        flex-direction: column;
        gap: var(--card-stack-gap);
        max-width: 46rem;
    }

    .solutions-media-cta-section__content h2,
    .solutions-media-cta-section__content p {
        margin: 0;
    }

    .solutions-media-cta-section__content p {
        color: var(--text-secondary);
    }

    @media (max-width: 1023px) {
        .solutions-media-cta-section {
            padding-top: var(--space-10);
            padding-bottom: var(--space-10);
        }

        .solutions-media-cta-section__card {
            flex-direction: column;
            align-items: flex-start;
        }
    }

    @media (max-width: 767px) {
        .solutions-media-cta-section__card {
            padding: var(--space-7);
        }

        .solutions-media-cta-section__card :global(.btn) {
            width: 100%;
            text-align: center;
        }
    }
</style>
