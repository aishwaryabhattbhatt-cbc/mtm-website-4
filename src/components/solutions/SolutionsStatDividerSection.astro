---
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { t } from '../../lib/i18n/t';
import CountUpValue from '../shared/CountUpValue.astro';

interface Props {
    locale: Locale;
    copy: CMSDictionary;
    imageSrc: string;
    mobileImageSrc?: string;
    imageAlt?: string;
    align?: 'left' | 'right';
    fallbackValue?: string;
    fallbackDescription?: string;
}

const {
    locale,
    copy,
    imageSrc,
    mobileImageSrc,
    imageAlt = '',
    align = 'right',
    fallbackValue = '',
    fallbackDescription = '',
} = Astro.props as Props;
---

<div class="solutions-stat-divider content-fly-in">
    <picture>
        {mobileImageSrc && <source media="(max-width: 767px)" srcset={mobileImageSrc} />}
        <img src={imageSrc} alt={imageAlt} loading="lazy" decoding="async" />
    </picture>
    <div class={`solutions-stat-divider__callout solutions-stat-divider__callout--${align}`}>
        <CountUpValue
            value={t(copy, 'stat_value', locale, fallbackValue)}
            class="text-hero solutions-stat-divider__value solutions-stat-divider__value--lg"
        />
        <CountUpValue
            value={t(copy, 'stat_value', locale, fallbackValue)}
            class="text-metrics solutions-stat-divider__value solutions-stat-divider__value--sm"
        />
        <span class="text-body-p1 solutions-stat-divider__desc">
            {t(copy, 'stat_description', locale, fallbackDescription)}
        </span>
    </div>
</div>

<style>
    .solutions-stat-divider {
        position: relative;
        display: grid;
        width: 100%;
        overflow: hidden;
    }

    /* Transparent wrapper — lets .solutions-stat-divider img's grid-area
       placement reach through <picture> as if img were the direct grid
       child. */
    .solutions-stat-divider picture {
        display: contents;
    }

    .solutions-stat-divider img {
        grid-area: 1 / 1;
        width: 100%;
        height: auto;
        display: block;
        /* Reserves the image's box immediately instead of collapsing to 0
           height until the (loading="lazy") asset actually loads — without
           this the callout below it visually overlaps/crops the image on
           slower connections. Desktop asset is 2880x1000; the mobile source
           swapped in below is a different ratio (1280x710). */
        aspect-ratio: 2880 / 1000;
    }

    /* solution-split-unlimited-seats.webp has a transparent/gradient zone
       covering the top 23% of the asset, with the photo band filling the
       bottom 77%. Center within that band (23% + 77%/2 = 61.5%), not the
       full image height — same math as CensusToolFeaturesSection's
       split-frame-callout, since this asset uses the same template. */
    .solutions-stat-divider__callout {
        position: absolute;
        top: 61.5%;
        transform: translateY(-50%);
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
        max-width: 40%;
    }

    .solutions-stat-divider__callout--right {
        right: var(--content-margin-inline);
        align-items: flex-end;
        text-align: right;
    }

    .solutions-stat-divider__callout--left {
        left: var(--content-margin-inline);
        align-items: flex-start;
        text-align: left;
    }

    /* :global — these target CountUpValue's own <span>, which doesn't carry
       this component's scope attribute. */
    :global(.solutions-stat-divider__value) {
        color: var(--text-primary);
    }

    :global(.solutions-stat-divider__value--sm) {
        display: none;
    }

    .solutions-stat-divider__desc {
        color: var(--text-secondary);
    }

    @media (max-width: 1023px) {
        :global(.solutions-stat-divider__value--lg) {
            display: none;
        }

        :global(.solutions-stat-divider__value--sm) {
            display: block;
        }
    }

    @media (max-width: 767px) {
        /* Below the image instead of overlaid on it — the callout drops out
           of the grid stack into normal flow, centered under the photo. */
        .solutions-stat-divider {
            display: flex;
            flex-direction: column;
            gap: 0;
        }

        .solutions-stat-divider img {
            /* No scale/zoom here (unlike the census split-frame) — this
               mobile crop has the subject's hair touching the very top
               edge with no headroom, so any upward-anchored zoom clips
               straight into her hair against .solutions-stat-divider's
               overflow: hidden. The image now displays uncropped at its
               full aspect ratio, so no zoom is needed anyway. */
            aspect-ratio: 1280 / 710;
        }

        .solutions-stat-divider__callout {
            position: static;
            transform: none;
            max-width: none;
            align-items: center;
            text-align: center;
            background: var(--surface-blue);
            padding-block: var(--card-pad);
            padding-inline: var(--content-margin-inline);
        }

        .solutions-stat-divider__callout--right,
        .solutions-stat-divider__callout--left {
            right: auto;
            left: auto;
        }
    }

    .content-fly-in {
        opacity: 0;
        transform: translateY(1.625rem);
        transition:
            opacity var(--motion-duration-heading) ease,
            transform var(--motion-duration-heading) var(--motion-ease-standard);
    }

    .content-fly-in.is-visible {
        opacity: 1;
        transform: translateY(0);
    }
</style>

<script>
    // The stat value (CountUpValue) triggers its own count-up independently,
    // on its own scroll-in observer — this only handles the block's fade/slide.
    document.querySelectorAll<HTMLElement>('.solutions-stat-divider').forEach((el) => {
        const observer = new IntersectionObserver(
            ([entry]) => {
                if (entry.isIntersecting) {
                    el.classList.add('is-visible');
                    observer.disconnect();
                }
            },
            { threshold: 0.15 }
        );
        observer.observe(el);
    });
</script>
