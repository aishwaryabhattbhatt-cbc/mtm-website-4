---
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { t } from '../../lib/i18n/t';
import Eyebrow from '../shared/Eyebrow.astro';

interface Props {
    locale: Locale;
    copy: CMSDictionary;
}

const { locale, copy } = Astro.props as Props;
const base = import.meta.env.BASE_URL;

const logos = [
    { src: `${base}images/home/solutions/logos/media/rogers.svg`, alt: 'Rogers' },
    { src: `${base}images/home/solutions/logos/media/quebecor.svg`, alt: 'Quebecor' },
    { src: `${base}images/home/solutions/logos/media/telus.svg`, alt: 'TELUS' },
    { src: `${base}images/home/solutions/logos/media/tva.svg`, alt: 'TVA' },
    { src: `${base}images/home/solutions/logos/media/tvo.svg`, alt: 'TVO' },
    { src: `${base}images/home/solutions/logos/media/tv5.svg`, alt: 'TV5' },
    { src: `${base}images/home/solutions/logos/media/abc.svg`, alt: 'ABC' },
    { src: `${base}images/home/solutions/logos/media/bell.svg`, alt: 'Bell' },
];
---

<section class="solutions-media-partners-section">
    <div class="solutions-media-partners-section__header">
        <Eyebrow>{t(copy, 'media_partners_eyebrow', locale, 'Trusted by media leaders')}</Eyebrow>
        <h2 data-copy-key="media_partners_title">
            {t(copy, 'media_partners_title', locale, 'Organizations Using MTM Intelligence')}
        </h2>
        <p class="text-body-p2" data-copy-key="media_partners_description">
            {
                t(
                    copy,
                    'media_partners_description',
                    locale,
                    'From broadcasters to digital publishers and telecom players, teams rely on MTM to validate strategy and monitor market change.'
                )
            }
        </p>
    </div>

    <ul
        class="solutions-media-partners-section__logos"
        aria-label={t(copy, 'media_partners_aria', locale, 'Media organization logos')}
    >
        {
            logos.map((logo) => (
                <li class="solutions-media-partners-section__logo-item">
                    <img src={logo.src} alt={logo.alt} loading="lazy" decoding="async" />
                </li>
            ))
        }
    </ul>
</section>

<style>
    .solutions-media-partners-section {
        width: 100%;
        padding: var(--space-10) var(--content-margin-inline) var(--space-12);
        display: flex;
        flex-direction: column;
        gap: var(--space-8);
        background: var(--surface-blue);
    }

    .solutions-media-partners-section__header {
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
        max-width: 56rem;
    }

    .solutions-media-partners-section__header h2,
    .solutions-media-partners-section__header p {
        margin: 0;
    }

    .solutions-media-partners-section__header p {
        color: var(--text-secondary);
    }

    .solutions-media-partners-section__logos {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: var(--layout-card-gap);
    }

    .solutions-media-partners-section__logo-item {
        border: var(--stroke-1) solid var(--border-tertiary);
        border-radius: var(--radius-m);
        background: var(--surface-white);
        min-height: 7rem;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: var(--space-5);
    }

    .solutions-media-partners-section__logo-item img {
        width: auto;
        max-width: 100%;
        max-height: 2.75rem;
        display: block;
    }

    @media (max-width: 1023px) {
        .solutions-media-partners-section__logos {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    @media (max-width: 767px) {
        .solutions-media-partners-section {
            padding-bottom: var(--space-10);
        }

        .solutions-media-partners-section__logos {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .solutions-media-partners-section__logo-item {
            min-height: 6rem;
        }
    }
</style>
