---
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { t } from '../../lib/i18n/t';
import Button from '../shared/Button.astro';
import { icons } from '../../lib/icons/registry';

interface Props {
    locale: Locale;
    copy: CMSDictionary;
    cards?: ('analytic' | 'analytic-slim' | 'census' | 'census-slim')[];
    /** Each page reads from its own CMS tab, so this shared component takes the
        description keys as props — every page gets page-specific copy instead
        of all pages sharing one generic key name. */
    analyticDescriptionKey?: string;
    censusDescriptionKey?: string;
}

const {
    locale,
    copy,
    cards = ['analytic', 'census'],
    analyticDescriptionKey = 'tools_analytic_description',
    censusDescriptionKey = 'tools_census_description',
} = Astro.props as Props;
const base = import.meta.env.BASE_URL;
const showAnalytic = cards.includes('analytic');
const showAnalyticSlim = cards.includes('analytic-slim');
const showCensus = cards.includes('census');
const showCensusSlim = cards.includes('census-slim');

const analyticDescriptionFallback =
    "Access media usage and behaviour data across MTM's three datasets — MTM 18+, Juniors, and Newcomers. Query platform adoption, content consumption, device ownership, and service usage across hundreds of variables and filters to find exactly what your research needs.";
const censusDescriptionFallback =
    'Map audience distribution at the postal code level. Identify underserved communities, size local markets, and benchmark your reach against the national population — sourced directly from Statistics Canada.';
---

<section class="solutions-tools-section">
    <h2 class="solutions-tools-section__headline heading-fly-in">
        {t(copy, 'tools_title', locale, 'Tools that empower you to track those shifts')}
    </h2>

    <div class="solutions-tools-cards">
        {
            showAnalytic && (
                <article class="solutions-tools-card card-fly-in">
                    <div class="solutions-tools-card__content">
                        <div class="solutions-tools-card__text">
                            <div class="solutions-tools-card__title-row">
                                <img
                                    class="icon-2xl"
                                    src={`${base}${icons.tool.dashboard}`}
                                    alt=""
                                    aria-hidden="true"
                                    loading="lazy"
                                    decoding="async"
                                />
                                <h3>
                                    {t(copy, 'tools_analytic_eyebrow', locale, 'Analytic Tools')}
                                </h3>
                            </div>
                            <p class="text-body-p2 solutions-tools-card__description">
                                {t(
                                    copy,
                                    analyticDescriptionKey,
                                    locale,
                                    analyticDescriptionFallback
                                )}
                            </p>
                        </div>
                        <div class="solutions-tools-card__features">
                            <div class="solutions-tools-card__feature">
                                <img
                                    class="icon-2xl"
                                    src={`${base}${icons.tool.dat}`}
                                    alt=""
                                    aria-hidden="true"
                                    loading="lazy"
                                    decoding="async"
                                />
                                <span class="text-body-p2-bold">
                                    {t(copy, 'tools_analytic_feature_1', locale, 'Data Analysis')}
                                </span>
                            </div>
                            <div class="solutions-tools-card__feature">
                                <img
                                    class="icon-2xl"
                                    src={`${base}${icons.tool.trending}`}
                                    alt=""
                                    aria-hidden="true"
                                    loading="lazy"
                                    decoding="async"
                                />
                                <span class="text-body-p2-bold">
                                    {t(copy, 'tools_analytic_feature_2', locale, 'Trending')}
                                </span>
                            </div>
                            <div class="solutions-tools-card__feature">
                                <img
                                    class="icon-2xl"
                                    src={`${base}${icons.tool.forecast}`}
                                    alt=""
                                    aria-hidden="true"
                                    loading="lazy"
                                    decoding="async"
                                />
                                <span class="text-body-p2-bold">
                                    {t(copy, 'tools_analytic_feature_3', locale, 'Forecasting')}
                                </span>
                            </div>
                        </div>
                        <Button
                            variant="tertiary"
                            size="md"
                            href={`${base}${locale}/tools/analytic-tools/`}
                        >
                            {t(copy, 'tools_learn_more', locale, 'Learn more')}
                        </Button>
                    </div>
                    <div class="solutions-tools-card__preview">
                        <img
                            src={`${base}images/tools/analytic-tools/Analytic-tool.png`}
                            alt=""
                            class="solutions-tools-card__preview-img"
                            loading="lazy"
                            decoding="async"
                        />
                    </div>
                </article>
            )
        }

        {
            showCensus && (
                <article class="solutions-tools-card card-fly-in">
                    <div class="solutions-tools-card__preview">
                        <img
                            src={`${base}images/tools/census-tool/Census-tool.png`}
                            alt=""
                            class="solutions-tools-card__preview-img"
                            loading="lazy"
                            decoding="async"
                        />
                    </div>
                    <div class="solutions-tools-card__content solutions-tools-card__content--flipped">
                        <div class="solutions-tools-card__text">
                            <div class="solutions-tools-card__title-row">
                                <img
                                    class="icon-2xl"
                                    src={`${base}${icons.tool.census}`}
                                    alt=""
                                    aria-hidden="true"
                                    loading="lazy"
                                    decoding="async"
                                />
                                <h3>{t(copy, 'tools_census_eyebrow', locale, 'Census Tools')}</h3>
                            </div>
                            <p class="text-body-p2 solutions-tools-card__description">
                                {t(copy, censusDescriptionKey, locale, censusDescriptionFallback)}
                            </p>
                        </div>
                        <div class="solutions-tools-card__features">
                            <div class="solutions-tools-card__feature">
                                <img
                                    class="icon-2xl"
                                    src={`${base}${icons['census-tool'].snapshot}`}
                                    alt=""
                                    aria-hidden="true"
                                    loading="lazy"
                                    decoding="async"
                                />
                                <span class="text-body-p2-bold">
                                    {t(copy, 'tools_census_feature_1', locale, 'Snapshot')}
                                </span>
                            </div>
                            <div class="solutions-tools-card__feature">
                                <img
                                    class="icon-2xl"
                                    src={`${base}${icons['census-tool'].demographicExplorer}`}
                                    alt=""
                                    aria-hidden="true"
                                    loading="lazy"
                                    decoding="async"
                                />
                                <span class="text-body-p2-bold">
                                    {t(copy, 'tools_census_feature_2', locale, 'Explorer')}
                                </span>
                            </div>
                            <div class="solutions-tools-card__feature">
                                <img
                                    class="icon-2xl"
                                    src={`${base}${icons['census-tool'].compare}`}
                                    alt=""
                                    aria-hidden="true"
                                    loading="lazy"
                                    decoding="async"
                                />
                                <span class="text-body-p2-bold">
                                    {t(copy, 'tools_census_feature_3', locale, 'Compare')}
                                </span>
                            </div>
                            <div class="solutions-tools-card__feature solutions-tools-card__feature--more">
                                <span class="text-body-p2-bold">
                                    {t(copy, 'tools_census_more', locale, '+3 more')}
                                </span>
                            </div>
                        </div>
                        <Button
                            variant="tertiary"
                            size="md"
                            href={`${base}${locale}/tools/census-tool/`}
                        >
                            {t(copy, 'tools_learn_more', locale, 'Learn more')}
                        </Button>
                    </div>
                </article>
            )
        }

        {
            showAnalyticSlim && (
                <details class="solutions-tools-accordion card-fly-in">
                    <summary class="solutions-tools-card-slim solutions-tools-card-slim--summary">
                        <div class="solutions-tools-card-slim__left">
                            <img
                                class="icon-2xl"
                                src={`${base}${icons.tool.dashboard}`}
                                alt=""
                                aria-hidden="true"
                                loading="lazy"
                                decoding="async"
                            />
                            <h3 class="solutions-tools-card-slim__title">
                                {t(copy, 'tools_analytic_eyebrow', locale, 'Analytic Tools')}
                            </h3>
                        </div>
                        <span class="solutions-tools-card-slim__chevron icon-m" aria-hidden="true">
                            <svg
                                width="100%"
                                height="100%"
                                viewBox="0 0 20 20"
                                fill="none"
                                xmlns="http://www.w3.org/2000/svg"
                            >
                                <path
                                    d="M5 7.5L10 12.5L15 7.5"
                                    stroke="currentColor"
                                    stroke-width="1.5"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                />
                            </svg>
                        </span>
                    </summary>

                    <div class="solutions-tools-accordion__content-clip">
                        <article class="solutions-tools-card solutions-tools-card--accordion">
                            <div class="solutions-tools-card__content">
                                <div class="solutions-tools-card__text">
                                    <div class="solutions-tools-card__title-row">
                                        <img
                                            class="icon-2xl"
                                            src={`${base}${icons.tool.dashboard}`}
                                            alt=""
                                            aria-hidden="true"
                                            loading="lazy"
                                            decoding="async"
                                        />
                                        <h3>
                                            {t(
                                                copy,
                                                'tools_analytic_eyebrow',
                                                locale,
                                                'Analytic Tools'
                                            )}
                                        </h3>
                                    </div>
                                    <p class="text-body-p2 solutions-tools-card__description">
                                        {t(
                                            copy,
                                            analyticDescriptionKey,
                                            locale,
                                            analyticDescriptionFallback
                                        )}
                                    </p>
                                </div>
                                <div class="solutions-tools-card__features">
                                    <div class="solutions-tools-card__feature">
                                        <img
                                            class="icon-2xl"
                                            src={`${base}${icons.tool.dat}`}
                                            alt=""
                                            aria-hidden="true"
                                            loading="lazy"
                                            decoding="async"
                                        />
                                        <span class="text-body-p2-bold">
                                            {t(
                                                copy,
                                                'tools_analytic_feature_1',
                                                locale,
                                                'Data Analysis'
                                            )}
                                        </span>
                                    </div>
                                    <div class="solutions-tools-card__feature">
                                        <img
                                            class="icon-2xl"
                                            src={`${base}${icons.tool.trending}`}
                                            alt=""
                                            aria-hidden="true"
                                            loading="lazy"
                                            decoding="async"
                                        />
                                        <span class="text-body-p2-bold">
                                            {t(
                                                copy,
                                                'tools_analytic_feature_2',
                                                locale,
                                                'Trending'
                                            )}
                                        </span>
                                    </div>
                                    <div class="solutions-tools-card__feature">
                                        <img
                                            class="icon-2xl"
                                            src={`${base}${icons.tool.forecast}`}
                                            alt=""
                                            aria-hidden="true"
                                            loading="lazy"
                                            decoding="async"
                                        />
                                        <span class="text-body-p2-bold">
                                            {t(
                                                copy,
                                                'tools_analytic_feature_3',
                                                locale,
                                                'Forecasting'
                                            )}
                                        </span>
                                    </div>
                                </div>
                                <Button
                                    variant="tertiary"
                                    size="md"
                                    href={`${base}${locale}/tools/analytic-tools/`}
                                >
                                    {t(copy, 'tools_learn_more', locale, 'Learn more')}
                                </Button>
                            </div>
                            <div class="solutions-tools-card__preview">
                                <img
                                    src={`${base}images/tools/analytic-tools/Analytic-tool.png`}
                                    alt=""
                                    class="solutions-tools-card__preview-img"
                                    loading="lazy"
                                    decoding="async"
                                />
                            </div>
                        </article>
                    </div>
                </details>
            )
        }

        {
            showCensusSlim && (
                <details class="solutions-tools-accordion card-fly-in">
                    <summary class="solutions-tools-card-slim solutions-tools-card-slim--summary">
                        <div class="solutions-tools-card-slim__left">
                            <img
                                class="icon-2xl"
                                src={`${base}${icons.tool.census}`}
                                alt=""
                                aria-hidden="true"
                                loading="lazy"
                                decoding="async"
                            />
                            <h3 class="solutions-tools-card-slim__title">
                                {t(copy, 'tools_census_eyebrow', locale, 'Census Tools')}
                            </h3>
                        </div>
                        <span class="solutions-tools-card-slim__chevron icon-m" aria-hidden="true">
                            <svg
                                width="100%"
                                height="100%"
                                viewBox="0 0 20 20"
                                fill="none"
                                xmlns="http://www.w3.org/2000/svg"
                            >
                                <path
                                    d="M5 7.5L10 12.5L15 7.5"
                                    stroke="currentColor"
                                    stroke-width="1.5"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                />
                            </svg>
                        </span>
                    </summary>

                    <div class="solutions-tools-accordion__content-clip">
                        <article class="solutions-tools-card solutions-tools-card--accordion">
                            <div class="solutions-tools-card__preview">
                                <img
                                    src={`${base}images/tools/census-tool/Census-tool.png`}
                                    alt=""
                                    class="solutions-tools-card__preview-img"
                                    loading="lazy"
                                    decoding="async"
                                />
                            </div>
                            <div class="solutions-tools-card__content solutions-tools-card__content--flipped">
                                <div class="solutions-tools-card__text">
                                    <div class="solutions-tools-card__title-row">
                                        <img
                                            class="icon-2xl"
                                            src={`${base}${icons.tool.census}`}
                                            alt=""
                                            aria-hidden="true"
                                            loading="lazy"
                                            decoding="async"
                                        />
                                        <h3>
                                            {t(
                                                copy,
                                                'tools_census_eyebrow',
                                                locale,
                                                'Census Tools'
                                            )}
                                        </h3>
                                    </div>
                                    <p class="text-body-p2 solutions-tools-card__description">
                                        {t(
                                            copy,
                                            censusDescriptionKey,
                                            locale,
                                            censusDescriptionFallback
                                        )}
                                    </p>
                                </div>
                                <div class="solutions-tools-card__features">
                                    <div class="solutions-tools-card__feature">
                                        <img
                                            class="icon-2xl"
                                            src={`${base}${icons['census-tool'].snapshot}`}
                                            alt=""
                                            aria-hidden="true"
                                            loading="lazy"
                                            decoding="async"
                                        />
                                        <span class="text-body-p2-bold">
                                            {t(copy, 'tools_census_feature_1', locale, 'Snapshot')}
                                        </span>
                                    </div>
                                    <div class="solutions-tools-card__feature">
                                        <img
                                            class="icon-2xl"
                                            src={`${base}${icons['census-tool'].demographicExplorer}`}
                                            alt=""
                                            aria-hidden="true"
                                            loading="lazy"
                                            decoding="async"
                                        />
                                        <span class="text-body-p2-bold">
                                            {t(copy, 'tools_census_feature_2', locale, 'Explorer')}
                                        </span>
                                    </div>
                                    <div class="solutions-tools-card__feature">
                                        <img
                                            class="icon-2xl"
                                            src={`${base}${icons['census-tool'].compare}`}
                                            alt=""
                                            aria-hidden="true"
                                            loading="lazy"
                                            decoding="async"
                                        />
                                        <span class="text-body-p2-bold">
                                            {t(copy, 'tools_census_feature_3', locale, 'Compare')}
                                        </span>
                                    </div>
                                    <div class="solutions-tools-card__feature solutions-tools-card__feature--more">
                                        <span class="text-body-p2-bold">
                                            {t(copy, 'tools_census_more', locale, '+3 more')}
                                        </span>
                                    </div>
                                </div>
                                <Button
                                    variant="tertiary"
                                    size="md"
                                    href={`${base}${locale}/tools/census-tool/`}
                                >
                                    {t(copy, 'tools_learn_more', locale, 'Learn more')}
                                </Button>
                            </div>
                        </article>
                    </div>
                </details>
            )
        }
    </div>
</section>

<style>
    .solutions-tools-section {
        width: 100%;
        background: var(--surface-white);
        padding: var(--section-pad-block-lg) var(--content-margin-inline) var(--section-pad-block);
        display: flex;
        flex-direction: column;
        gap: var(--section-header-gap);
    }

    /* Headline */
    .solutions-tools-section__headline {
        margin: 0;
        max-width: 52rem;
    }

    /* Cards grid */
    .solutions-tools-cards {
        display: flex;
        flex-direction: column;
        gap: var(--layout-card-gap);
    }

    /* Card */
    .solutions-tools-card {
        background: var(--surface-white);
        border-radius: var(--radius-m);
        box-shadow: var(--shadow-card);
        padding: var(--card-pad-thin);
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--space-8);
        align-items: stretch;
    }

    /* Left: content column */
    .solutions-tools-card__content {
        display: flex;
        flex-direction: column;
        gap: var(--card-stack-gap);
        /* right 0 — flush against the preview image column */
        padding: var(--card-pad) 0 var(--card-pad) var(--card-pad);
    }

    .solutions-tools-card__text {
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
    }

    .solutions-tools-card__content--flipped {
        /* left 0 — flush against the preview image column */
        padding: var(--card-pad) var(--card-pad) var(--card-pad) 0;
    }

    .solutions-tools-card__text h3 {
        margin: 0;
    }

    .solutions-tools-card__title-row {
        display: flex;
        align-items: center;
        gap: var(--space-3);
    }

    .solutions-tools-card__content :global(.btn) {
        align-self: flex-start;
    }

    /* Description */
    .solutions-tools-card__description {
        margin: 0;
        color: var(--text-secondary);
    }

    /* Features row */
    .solutions-tools-card__features {
        display: flex;
        align-items: center;
        gap: var(--space-4);
        flex-wrap: wrap;
        margin-top: auto;
    }

    .solutions-tools-card__feature {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        flex-shrink: 0;
    }

    .solutions-tools-card__feature span {
        color: var(--text-primary);
        white-space: nowrap;
    }

    /* Right: preview placeholder */
    .solutions-tools-card__preview {
        background: var(--surface-blue);
        border-radius: var(--radius-s);
        min-height: 24rem;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: var(--card-pad);
        overflow: hidden;
    }

    .solutions-tools-card__preview-img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        display: block;
    }

    /* Slim secondary card */
    .solutions-tools-card-slim {
        background: var(--surface-white);
        border-radius: var(--radius-m);
        box-shadow: var(--shadow-card);
        /* top/bottom space-5 — slim variant, deliberately shorter than --card-pad */
        padding: var(--space-5) var(--card-pad);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--card-stack-gap);
    }

    .solutions-tools-accordion {
        position: relative;
        --accordion-chevron-image-offset: calc(var(--card-pad-thin) + var(--space-3));
    }

    .solutions-tools-accordion > summary {
        list-style: none;
    }

    .solutions-tools-accordion > summary::-webkit-details-marker {
        display: none;
    }

    .solutions-tools-accordion__content-clip {
        overflow: hidden;
        height: 0;
        border-radius: var(--radius-m);
        box-shadow: var(--shadow-card);
        transition: height 450ms cubic-bezier(0.4, 0, 0.2, 1);
    }

    .solutions-tools-card--accordion {
        box-shadow: none;
    }

    .solutions-tools-card-slim--summary {
        cursor: pointer;
        margin: 0;
        opacity: 1;
        transition: opacity 200ms cubic-bezier(0.4, 0, 0.2, 1);
    }

    .solutions-tools-card-slim__chevron {
        color: var(--brand-blue-main);
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        transform: rotate(0deg);
        transition: transform 450ms cubic-bezier(0.4, 0, 0.2, 1);
    }

    .solutions-tools-accordion.is-expanded > .solutions-tools-card-slim--summary {
        position: absolute;
        top: var(--accordion-chevron-image-offset);
        right: var(--accordion-chevron-image-offset);
        z-index: 2;
        width: var(--space-8);
        height: var(--space-8);
        min-width: var(--space-8);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0;
        padding: 0;
        margin: 0;
        border-radius: var(--radius-full);
        box-shadow: var(--shadow-card);
        background: color-mix(in srgb, var(--surface-white) 92%, transparent);
    }

    .solutions-tools-card-slim__left {
        transition: opacity 450ms cubic-bezier(0.4, 0, 0.2, 1);
    }

    .solutions-tools-accordion.is-expanded .solutions-tools-card-slim__left {
        position: absolute;
        opacity: 0;
        visibility: hidden;
    }

    .solutions-tools-accordion.is-expanded .solutions-tools-card-slim__chevron {
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .solutions-tools-accordion.is-expanded .solutions-tools-card-slim__chevron {
        transform: rotate(180deg);
    }

    .solutions-tools-card-slim__left {
        display: flex;
        align-items: center;
        gap: var(--space-3);
        min-width: 0;
    }

    .solutions-tools-card-slim__title {
        margin: 0;
        color: var(--text-primary);
    }

    /* Tablet */
    @media (max-width: 1023px) {
        .solutions-tools-section {
            padding-top: var(--space-11);
            padding-bottom: var(--space-11);
        }

        .solutions-tools-card {
            grid-template-columns: 1fr;
            gap: var(--space-6);
        }

        .solutions-tools-card__preview {
            min-height: 16rem;
            order: 0;
        }

        .solutions-tools-card__content {
            padding: var(--space-4);
            order: 1;
        }
    }

    /* Mobile */
    @media (max-width: 767px) {
        .solutions-tools-section {
            padding-top: var(--section-pad-block);
            padding-bottom: var(--section-pad-block);
            gap: var(--section-header-gap);
        }

        .solutions-tools-card__preview {
            min-height: 12rem;
        }

        .solutions-tools-accordion.is-expanded > .solutions-tools-card-slim--summary {
            width: var(--space-8);
            height: var(--space-8);
            min-width: var(--space-8);
        }
    }

    .heading-fly-in {
        opacity: 0;
        transform: translateY(1.625rem);
        transition:
            opacity var(--motion-duration-heading) ease,
            transform var(--motion-duration-heading) var(--motion-ease-standard);
    }

    .heading-fly-in.is-visible {
        opacity: 1;
        transform: translateY(0);
    }

    .card-fly-in {
        opacity: 0;
        transform: translateY(1.625rem);
        transition:
            opacity var(--motion-duration-card) cubic-bezier(0.22, 1, 0.36, 1),
            transform var(--motion-duration-card) cubic-bezier(0.22, 1, 0.36, 1);
    }

    .card-fly-in.is-visible {
        opacity: 1;
        transform: translateY(0);
    }
</style>

<script>
    // Cards (and the collapsed accordion bars) stack vertically at
    // different scroll positions, so each observes itself. They're also
    // unusually tall (preview image + full feature row), so the threshold
    // is raised past the 0.2 default — same fix as the Census tool cards,
    // which fired on just a sliver of a tall card poking into view.
    document.querySelectorAll<HTMLElement>('.solutions-tools-section').forEach((section) => {
        const heading = section.querySelector<HTMLElement>('.heading-fly-in');
        if (heading) {
            const headingObserver = new IntersectionObserver(
                ([entry]) => {
                    if (entry.isIntersecting) {
                        heading.classList.add('is-visible');
                        headingObserver.disconnect();
                    }
                },
                { threshold: 0.15 }
            );
            headingObserver.observe(heading);
        }

        const cardObserver = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('is-visible');
                        cardObserver.unobserve(entry.target);
                    }
                });
            },
            { threshold: 0.35 }
        );
        section.querySelectorAll<HTMLElement>('.card-fly-in').forEach((card) => {
            cardObserver.observe(card);
        });
    });
</script>

<script>
    const toolsAccordions = document.querySelectorAll<HTMLDetailsElement>(
        '.solutions-tools-accordion'
    );

    toolsAccordions.forEach((accordion) => {
        const summary = accordion.querySelector<HTMLElement>('.solutions-tools-card-slim--summary');
        const contentClip = accordion.querySelector<HTMLElement>(
            '.solutions-tools-accordion__content-clip'
        );
        const contentCard = contentClip?.firstElementChild as HTMLElement | null;
        if (!summary || !contentClip || !contentCard) return;

        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        let isAnimating = false;

        const getOpenHeight = () => contentCard.scrollHeight;

        if (accordion.open) {
            accordion.classList.add('is-expanded');
            contentClip.style.height = `${getOpenHeight()}px`;
        }

        summary.addEventListener('click', (event: MouseEvent) => {
            event.preventDefault();
            if (isAnimating) return;

            const isOpen = accordion.open;

            if (prefersReducedMotion.matches) {
                if (isOpen) {
                    accordion.classList.remove('is-expanded');
                    contentClip.style.height = '0px';
                    accordion.open = false;
                } else {
                    accordion.open = true;
                    accordion.classList.add('is-expanded');
                    contentClip.style.height = `${getOpenHeight()}px`;
                }
                return;
            }

            isAnimating = true;

            // The summary swaps between two very different shapes (full-width row
            // vs. a small floating circle) via position/width/height/padding, none
            // of which can transition smoothly. So it's faded out first, the shape
            // swap happens while invisible, then it's faded back in — the swap
            // itself is never seen, only the fade.
            summary.style.opacity = '0';

            const onFadeOutEnd = (e: TransitionEvent) => {
                if (e.propertyName !== 'opacity') return;
                summary.removeEventListener('transitionend', onFadeOutEnd);

                if (!isOpen) {
                    accordion.open = true;
                    accordion.classList.add('is-expanded');
                    void summary.offsetHeight;
                    summary.style.opacity = '1';

                    contentClip.style.height = '0px';
                    void contentClip.offsetHeight;
                    contentClip.style.height = `${getOpenHeight()}px`;

                    const onExpandEnd = (ev: TransitionEvent) => {
                        if (ev.propertyName !== 'height') return;
                        contentClip.removeEventListener('transitionend', onExpandEnd);
                        contentClip.style.height = 'auto';
                        isAnimating = false;
                    };
                    contentClip.addEventListener('transitionend', onExpandEnd);
                    return;
                }

                contentClip.style.height = `${contentClip.getBoundingClientRect().height}px`;
                void contentClip.offsetHeight;
                contentClip.style.height = '0px';

                const onCollapseEnd = (ev: TransitionEvent) => {
                    if (ev.propertyName !== 'height') return;
                    contentClip.removeEventListener('transitionend', onCollapseEnd);
                    accordion.classList.remove('is-expanded');
                    accordion.open = false;
                    void summary.offsetHeight;
                    summary.style.opacity = '1';
                    isAnimating = false;
                };
                contentClip.addEventListener('transitionend', onCollapseEnd);
            };
            summary.addEventListener('transitionend', onFadeOutEnd);
        });

        window.addEventListener('resize', () => {
            if (!accordion.open || isAnimating) return;
            contentClip.style.height = `${getOpenHeight()}px`;
        });
    });
</script>
