---
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { t } from '../../lib/i18n/t';

interface Props {
    locale: Locale;
    copy: CMSDictionary;
    base: string;
}

const { locale, copy, base } = Astro.props as Props;
---

<section class="media-testimonials-section">
    <div class="media-testimonials-inner">
        <h2 class="media-testimonials-heading">
            {t(copy, 'testimonial_title', locale, 'What media companies are saying about us')}
        </h2>

        <div class="media-testimonials-card">
            <img
                src={`${base}images/solutions/testimonials/left-top.png`}
                alt=""
                class="dots-left"
                aria-hidden="true"
            />
            <img
                src={`${base}images/solutions/testimonials/right-bottom.png`}
                alt=""
                class="dots-right"
                aria-hidden="true"
            />

            <img
                src={`${base}images/solutions/testimonials/left.svg`}
                alt=""
                class="icon-xl quote-mark"
                aria-hidden="true"
            />

            <div class="media-testimonials-content">
                <div class="media-testimonials-logo-wrap">
                    <img
                        src={`${base}images/home/solutions/logos/media/tvo.svg`}
                        alt="TVO"
                        class="media-testimonials-logo"
                    />
                </div>
                <p class="text-h4 media-testimonials-quote">
                    {
                        t(
                            copy,
                            'testimonial_quote',
                            locale,
                            "Our decisions have to stand up to scrutiny — from where funding goes to how impact is measured. MTM's data gives us that credibility. It connects audience behaviour to real outcomes, helping us plan investments and policies that actually reflect how Canadians consume media today."
                        )
                    }
                </p>
                <p class="text-body-p2 media-testimonials-attribution">
                    {t(copy, 'testimonial_attribution', locale, '— Director of Audience Strategy')}
                </p>
            </div>

            <img
                src={`${base}images/solutions/testimonials/right.svg`}
                alt=""
                class="icon-xl quote-mark"
                aria-hidden="true"
            />
        </div>
    </div>
</section>

<style>
    .media-testimonials-section {
        width: 100%;
        background: var(--surface-blue);
        padding: var(--space-13) var(--content-margin-inline);
    }

    .media-testimonials-inner {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--space-10);
        width: 100%;
    }

    .media-testimonials-heading {
        margin: 0;
        color: var(--text-primary);
        text-align: center;
        max-width: 52rem;
    }

    /* Card */
    .media-testimonials-card {
        position: relative;
        width: 100%;
        background: var(--surface-white);
        border-radius: var(--radius-m);
        box-shadow: var(--shadow-card);
        overflow: hidden;
        padding: var(--space-12);
        display: flex;
        align-items: center;
        gap: var(--space-8);
        min-height: 18rem;
    }

    /* Background dot pattern images */
    .dots-left {
        position: absolute;
        left: 0;
        top: 0;
        height: 100%;
        width: auto;
        pointer-events: none;
        user-select: none;
    }

    .dots-right {
        position: absolute;
        right: 0;
        bottom: 0;
        height: 100%;
        width: auto;
        pointer-events: none;
        user-select: none;
    }

    /* Quote marks */
    .quote-mark {
        flex-shrink: 0;
        position: relative;
        z-index: 1;
    }

    /* Center content */
    .media-testimonials-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--space-8);
        text-align: center;
        position: relative;
        z-index: 1;
        min-width: 0;
    }

    .media-testimonials-logo-wrap {
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .media-testimonials-logo {
        height: var(--space-9);
        width: auto;
        max-width: 12rem;
    }

    .media-testimonials-quote {
        margin: 0;
        color: var(--text-primary);
        max-width: 52rem;
    }

    .media-testimonials-attribution {
        margin: 0;
        color: var(--text-secondary);
    }

    /* Tablet */
    @media (max-width: 1023px) {
        .media-testimonials-section {
            padding: var(--space-12) var(--content-margin-inline);
        }

        .media-testimonials-card {
            padding: var(--space-10) var(--space-9);
            gap: var(--space-6);
        }
    }

    /* Mobile */
    @media (max-width: 767px) {
        .media-testimonials-section {
            padding: var(--space-10) var(--content-margin-inline);
        }

        .media-testimonials-inner {
            gap: var(--space-8);
        }

        .media-testimonials-card {
            flex-direction: column;
            align-items: center;
            padding: var(--space-9) var(--space-7);
            gap: var(--space-6);
            min-height: 0;
        }

        .dots-left {
            height: 50%;
            top: 0;
            bottom: auto;
        }

        .dots-right {
            height: 50%;
            bottom: 0;
            top: auto;
        }
    }
</style>
