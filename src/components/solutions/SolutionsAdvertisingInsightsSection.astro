---
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { t } from '../../lib/i18n/t';
import { icons } from '../../lib/icons/registry';
import SolutionsInsightCard from './SolutionsInsightCard.astro';

interface Props {
    locale: Locale;
    copy: CMSDictionary;
    base: string;
}

const { locale, copy, base } = Astro.props as Props;
---

<section class="solutions-advertising-insights-section">
    <div class="solutions-advertising-insights-header heading-fly-in">
        <h2 data-copy-key="problem_title">
            {t(copy, 'problem_title', locale, 'Why trusted data changes everything')}
        </h2>
        <p
            class="text-body-p1 solutions-advertising-insights-subtitle"
            data-copy-key="problem_description"
        >
            {
                t(
                    copy,
                    'problem_description',
                    locale,
                    'MTM gives your agency the competitive edge, transforming campaigns from speculation into pitches that guarantee client confidence.'
                )
            }
        </p>
    </div>

    <div class="solutions-advertising-insights-cards">
        <div class="card-fly-in">
            <SolutionsInsightCard
                iconSrc={`${base}${icons.gen.reliableData}`}
                eyebrow={t(copy, 'insight_1_eyebrow', locale, 'Trustworthy Data')}
                eyebrowKey="insight_1_eyebrow"
                title={t(
                    copy,
                    'insight_1_title',
                    locale,
                    'With 20 years of data, and more than 300,000 Canadians surveyed to date, the MTM gives you a source you can measure against with confidence.'
                )}
                titleKey="insight_1_title"
                description={t(
                    copy,
                    'insight_1_description',
                    locale,
                    'Our independent, nationally representative samples allow for detailed comparisons against your internal data and other sources. With the MTM, know where and how Canadians are engaged with an exhaustive array of media platforms and leave nothing up to chance.'
                )}
                descriptionKey="insight_1_description"
                imageSrc={`${base}images/solutions/advertising/insight-1.svg`}
                imageAlt={t(copy, 'insight_1_chart_title', locale, '300,000+ Canadians surveyed')}
                imageTitle={t(copy, 'insight_1_chart_title', locale, '300,000+ Canadians surveyed')}
                imageTitleKey="insight_1_chart_title"
                imageTitleColor="blue"
            />
        </div>
        <div class="card-fly-in">
            <SolutionsInsightCard
                iconSrc={`${base}${icons.gen.focus}`}
                eyebrow={t(copy, 'insight_2_eyebrow', locale, 'Precision Targeting')}
                eyebrowKey="insight_2_eyebrow"
                title={t(
                    copy,
                    'insight_2_title',
                    locale,
                    "Stop marketing to the 'average' Canadian."
                )}
                titleKey="insight_2_title"
                description={t(
                    copy,
                    'insight_2_description',
                    locale,
                    'The MTM allows you to see Canada in high definition. Let your clients benefit from the surgical precision of being able to filter data by specific racialized groups, families, age groups, income brackets and more!'
                )}
                descriptionKey="insight_2_description"
                imageSrc={`${base}images/solutions/advertising/insight-2.svg`}
                imageAlt={t(copy, 'insight_2_chart_title', locale, 'Audience breakdown by segment')}
                imageTitle={t(
                    copy,
                    'insight_2_chart_title',
                    locale,
                    'Audience breakdown by segment'
                )}
                imageTitleKey="insight_2_chart_title"
                imageTitleColor="purple"
            />
        </div>
    </div>
</section>

<style>
    .solutions-advertising-insights-section {
        width: 100%;
        background: var(--surface-blue);
        padding: var(--section-pad-block-lg) var(--content-margin-inline);
        display: flex;
        flex-direction: column;
        gap: var(--section-header-gap);
    }

    /* Header */
    .solutions-advertising-insights-header {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--title-desc-gap);
        text-align: center;
    }

    .solutions-advertising-insights-header h2 {
        margin: 0;
        color: var(--text-primary);
        max-width: 44rem;
    }

    .solutions-advertising-insights-subtitle {
        margin: 0;
        color: var(--text-secondary);
        max-width: 44rem;
    }

    /* Cards grid — stretch keeps both cards at equal height */
    /* Cards grid — stretch keeps both cards at equal height. The explicit
       row pair (body, visual) lets each card subgrid into it, so the two
       cards' body/visual split lines up even when one card's copy is
       longer — see SolutionsInsightCard's own comment for the full chain. */
    .solutions-advertising-insights-cards {
        display: grid;
        grid-template-columns: 1fr 1fr;
        grid-template-rows: auto 1fr;
        gap: var(--layout-card-gap);
        align-items: stretch;
    }

    @media (max-width: 1023px) {
        .solutions-advertising-insights-cards {
            grid-template-columns: 1fr;
            grid-template-rows: none;
            row-gap: var(--space-9);
        }
    }

    /* Pass-through wrapper for the subgrid rows defined above — must also
       be a subgridded grid item itself, or the row tracks don't reach
       SolutionsInsightCard's own subgrid two levels down. */
    .card-fly-in {
        display: grid;
        grid-template-rows: subgrid;
        grid-row: span 2;
        opacity: 0;
        transform: translateY(1.625rem);
        transition:
            opacity var(--motion-duration-card) cubic-bezier(0.22, 1, 0.36, 1),
            transform var(--motion-duration-card) cubic-bezier(0.22, 1, 0.36, 1);
    }

    /* Restated locally: the global .is-visible in design-system.css has the same
       specificity as this component's scoped base rule above, so on a tie the
       component's `opacity: 0` wins on source order and the element never
       reveals. */
    .card-fly-in.is-visible {
        opacity: 1;
        transform: translateY(0);
    }

    @media (max-width: 1023px) {
        .card-fly-in {
            display: block;
        }
    }
</style>

<script>
    // Cards are a wrapping grid — a single row at desktop, so they all cross
    // the viewport edge together at that breakpoint. A per-card observer
    // would fire them all at once there, losing the stagger; trigger off
    // the grid itself instead and stagger the children.
    document
        .querySelectorAll<HTMLElement>('.solutions-advertising-insights-section')
        .forEach((section) => {
            const heading = section.querySelector<HTMLElement>('.heading-fly-in');
            if (heading) {
                const headingObserver = new IntersectionObserver(
                    ([entry]) => {
                        if (entry.isIntersecting) {
                            heading.classList.add('is-visible');
                            headingObserver.disconnect();
                        }
                    },
                    { threshold: 0.15 }
                );
                headingObserver.observe(heading);
            }

            const cardsRow = section.querySelector<HTMLElement>(
                '.solutions-advertising-insights-cards'
            );
            const cards = section.querySelectorAll<HTMLElement>('.card-fly-in');
            if (cardsRow && cards.length) {
                const cardObserver = new IntersectionObserver(
                    ([entry]) => {
                        if (entry.isIntersecting) {
                            cards.forEach((card, i) => {
                                setTimeout(() => card.classList.add('is-visible'), i * 140);
                            });
                            cardObserver.disconnect();
                        }
                    },
                    { threshold: 0.4 }
                );
                cardObserver.observe(cardsRow);
            }
        });
</script>
