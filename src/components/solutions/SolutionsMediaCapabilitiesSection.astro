---
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { t } from '../../lib/i18n/t';
import Eyebrow from '../shared/Eyebrow.astro';
import { icons } from '../../lib/icons/registry';

interface Props {
    locale: Locale;
    copy: CMSDictionary;
}

const { locale, copy } = Astro.props as Props;
const base = import.meta.env.BASE_URL;

const cards = [
    {
        icon: icons.gen.trends,
        title: t(copy, 'media_capability_1_title', locale, 'Track platform and content trends'),
        description: t(
            copy,
            'media_capability_1_description',
            locale,
            'Understand where audience attention is moving across video, audio, social, and digital ecosystems.'
        ),
    },
    {
        icon: icons.gen.uniqueSegments,
        title: t(copy, 'media_capability_2_title', locale, 'Build smarter audience segments'),
        description: t(
            copy,
            'media_capability_2_description',
            locale,
            'Use demographic, behavioral, and usage signals to define high-value segments for planning and distribution.'
        ),
    },
    {
        icon: icons.gen.summaryExecutive,
        title: t(
            copy,
            'media_capability_3_title',
            locale,
            'Align teams with executive-ready outputs'
        ),
        description: t(
            copy,
            'media_capability_3_description',
            locale,
            'Share clear summaries and practical insights to support faster decisions across strategy, research, and partnerships.'
        ),
    },
];
---

<section class="solutions-media-capabilities-section">
    <div class="solutions-media-capabilities-section__header">
        <Eyebrow>{t(copy, 'media_capabilities_eyebrow', locale, 'What you can do')}</Eyebrow>
        <h2 data-copy-key="media_capabilities_title">
            {t(copy, 'media_capabilities_title', locale, 'Core Media Use Cases')}
        </h2>
    </div>

    <div class="solutions-media-capabilities-section__grid">
        {
            cards.map((card, index) => (
                <article class="solutions-media-capabilities-section__card">
                    <img
                        class="solutions-media-capabilities-section__icon icon-xl"
                        src={`${base}${card.icon}`}
                        alt=""
                        aria-hidden="true"
                        loading="lazy"
                        decoding="async"
                    />
                    <h4 class="text-body-p0" data-copy-key={`media_capability_${index + 1}_title`}>
                        {card.title}
                    </h4>
                    <p
                        class="text-body-p2"
                        data-copy-key={`media_capability_${index + 1}_description`}
                    >
                        {card.description}
                    </p>
                </article>
            ))
        }
    </div>
</section>

<style>
    .solutions-media-capabilities-section {
        width: 100%;
        padding: var(--section-pad-block) var(--content-margin-inline);
        display: flex;
        flex-direction: column;
        gap: var(--section-header-gap);
    }

    .solutions-media-capabilities-section__header {
        display: flex;
        flex-direction: column;
        gap: var(--header-stack-gap);
        max-width: 56rem;
    }

    .solutions-media-capabilities-section__header h2 {
        margin: 0;
    }

    .solutions-media-capabilities-section__grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: var(--layout-card-gap);
    }

    .solutions-media-capabilities-section__card {
        padding: var(--space-7);
        border: var(--stroke-1) solid var(--border-tertiary);
        border-radius: var(--radius-m);
        background: var(--surface-white);
        display: flex;
        flex-direction: column;
        gap: var(--card-stack-gap);
    }

    .solutions-media-capabilities-section__icon {
        flex-shrink: 0;
    }

    .solutions-media-capabilities-section__card h4,
    .solutions-media-capabilities-section__card p {
        margin: 0;
    }

    .solutions-media-capabilities-section__card p {
        color: var(--text-secondary);
    }

    @media (max-width: 1023px) {
        .solutions-media-capabilities-section {
            padding-top: var(--space-9);
            padding-bottom: var(--space-9);
        }

        .solutions-media-capabilities-section__grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .solutions-media-capabilities-section__card:last-child {
            grid-column: 1 / -1;
        }
    }

    @media (max-width: 767px) {
        .solutions-media-capabilities-section__grid {
            grid-template-columns: 1fr;
        }

        .solutions-media-capabilities-section__card:last-child {
            grid-column: auto;
        }
    }
</style>
