---
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { t } from '../../lib/i18n/t';
import Button from '../shared/Button.astro';
import Eyebrow from '../shared/Eyebrow.astro';
import { icons } from '../../lib/icons/registry';

export type SolutionsHeroLayoutId = 'advertising' | 'media' | 'education' | 'gov-ngos' | 'industry';

interface Props {
    locale: Locale;
    copy: CMSDictionary;
    ctaHref: string;
    heroImageSrc: string;
    /** Black-on-white silhouette of heroImageSrc; cuts a person-shaped
        hole in the effects layer so animations appear behind the subject. */
    maskImageSrc?: string;
    /** Which fixed panel-grid arrangement (hidden/scaled/icon cells) to use. */
    layoutId?: SolutionsHeroLayoutId;
    /** Six icon registry paths placed on the grid's icon cells, in order.
        Swap entries here (per page) to change which icons appear. */
    heroIcons?: string[];
    fallbackEyebrow: string;
    fallbackTitle: string;
    fallbackDescription: string;
    fallbackCta?: string;
}

const {
    locale,
    copy,
    ctaHref,
    heroImageSrc,
    maskImageSrc,
    layoutId = 'advertising',
    heroIcons = [
        icons.gen.marketing,
        icons.gen.trends,
        icons.gen.strategicGrowth,
        icons.gen.quickInsights,
        icons.gen.uniqueSegments,
        icons.gen.credibility,
    ],
    fallbackEyebrow,
    fallbackTitle,
    fallbackDescription,
    fallbackCta = 'REQUEST A DEMO',
} = Astro.props as Props;

const maskUrl = maskImageSrc ? `url("${maskImageSrc}")` : 'none';
/* SVG replica of images/solutions/rounded-square-panel.webp (91px webp was
   too small for the rendered cell size and upscaled blurry; vector stays sharp). */
const panelSvg = `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 91 91'><defs><radialGradient id='g' cx='50%' cy='42%' r='78%'><stop offset='0%' stop-color='#ffffff'/><stop offset='60%' stop-color='#fdfeff'/><stop offset='100%' stop-color='#f5f8fc'/></radialGradient></defs><rect x='4' y='4' width='83' height='83' rx='10' fill='url(#g)' stroke='#eef2f8' stroke-width='1'/></svg>`;
const panelUrl = `url("data:image/svg+xml,${encodeURIComponent(panelSvg)}")`;

const GRID_COLS = 14;
const GRID_ROWS = 4;
const gridCells = Array.from({ length: GRID_COLS * GRID_ROWS }, (_, i) => i);

// Fixed hand-picked layouts (cell index = row*14+col) — central columns 4-9
// (6 wide) stay reserved (fully visible, behind the subject), leaving a
// 4-column block on each flank. Per layout, each set is split 3/3 across the
// left/right flanks with no row/column adjacency within a set (diagonal is
// fine within a type), and hidden cells sit at least two cells (row, column,
// AND diagonal) from every scaled cell. Static rather than randomized per
// build: a shuffled pick could clump or clash by chance; these are verified
// balanced/separated and don't change between loads.
// 'advertising' is the hand-verified original; 'education' is its horizontal
// mirror (col -> 13-col), 'gov-ngos' its vertical mirror (row -> 3-row),
// 'industry' its 180° rotation (i -> 55-i) — mirroring preserves every
// adjacency relation, so the constraints hold by construction — and 'media'
// is a second hand-verified design.
const PANEL_LAYOUTS: Record<
    SolutionsHeroLayoutId,
    { hidden: number[]; scaled: [number, number][]; iconCells: number[] }
> = {
    advertising: {
        hidden: [0, 2, 15, 10, 12, 25],
        scaled: [
            [31, 0.75],
            [42, 0.5],
            [44, 0.75],
            [41, 0.5],
            [52, 0.75],
            [54, 0.5],
        ],
        iconCells: [1, 17, 43, 11, 27, 53],
    },
    media: {
        hidden: [28, 43, 45, 38, 53, 55],
        scaled: [
            [1, 0.75],
            [3, 0.5],
            [16, 0.75],
            [10, 0.5],
            [12, 0.75],
            [27, 0.5],
        ],
        iconCells: [0, 17, 30, 11, 39, 54],
    },
    education: {
        hidden: [13, 11, 26, 3, 1, 16],
        scaled: [
            [38, 0.75],
            [55, 0.5],
            [53, 0.75],
            [28, 0.5],
            [45, 0.75],
            [43, 0.5],
        ],
        iconCells: [12, 24, 54, 2, 14, 44],
    },
    'gov-ngos': {
        hidden: [42, 44, 29, 52, 54, 39],
        scaled: [
            [17, 0.75],
            [0, 0.5],
            [2, 0.75],
            [27, 0.5],
            [10, 0.75],
            [12, 0.5],
        ],
        iconCells: [43, 31, 1, 53, 41, 11],
    },
    industry: {
        hidden: [55, 53, 40, 45, 43, 30],
        scaled: [
            [24, 0.75],
            [13, 0.5],
            [11, 0.75],
            [14, 0.5],
            [3, 0.75],
            [1, 0.5],
        ],
        iconCells: [54, 38, 12, 44, 28, 2],
    },
};

const layout = PANEL_LAYOUTS[layoutId];
const hiddenCells = new Set(layout.hidden);
const cellScale = new Map<number, number>(layout.scaled);
const cellIcon = new Map(layout.iconCells.map((i, idx) => [i, heroIcons[idx]]));
const base = import.meta.env.BASE_URL;

// The media block flies in first (home-section pattern: 1.1s fly-in, content
// follows after a 0.9s pause), then the grid staggers in: each cell at a
// random point within the next ~2s (delay capped at 1.5s + 0.5s fade).
const MEDIA_IN_SECONDS = 0.9;
const cellDelays = gridCells.map(() => (MEDIA_IN_SECONDS + Math.random() * 1.5).toFixed(2));
---

<section class="solutions-hero-section">
    <div class="solutions-hero-media" aria-hidden="true">
        <img
            src={heroImageSrc}
            alt=""
            class="solutions-hero-image"
            loading="eager"
            decoding="async"
        />
        {
            maskImageSrc && (
                <div class="solutions-hero-effects">
                    <div class="solutions-hero-panel-grid">
                        {gridCells.map((i) => (
                            <span
                                class:list={[
                                    'panel-cell',
                                    hiddenCells.has(i) && 'is-hidden',
                                    cellScale.has(i) && 'is-scaled',
                                ]}
                                style={`--cell-delay: ${cellDelays[i]}s${
                                    cellScale.has(i)
                                        ? `; --panel-cell-scale: ${cellScale.get(i)}`
                                        : ''
                                }`}
                            >
                                {cellIcon.has(i) && (
                                    <img
                                        src={`${base}${cellIcon.get(i)}`}
                                        alt=""
                                        class="panel-cell-icon icon-2xl"
                                    />
                                )}
                            </span>
                        ))}
                    </div>
                    <slot name="effects" />
                </div>
            )
        }
        <div class="solutions-hero-fade"></div>
    </div>

    <div class="solutions-hero-content">
        <Eyebrow>{t(copy, 'hero_eyebrow', locale, fallbackEyebrow)}</Eyebrow>

        <h1 data-copy-key="hero_title">
            {t(copy, 'hero_title', locale, fallbackTitle)}
        </h1>

        <p class="text-body-p1 solutions-hero-description" data-copy-key="hero_description">
            {t(copy, 'hero_description', locale, fallbackDescription)}
        </p>

        <Button variant="primary" size="lg" href={ctaHref} data-copy-key="hero_cta">
            {t(copy, 'hero_cta', locale, fallbackCta)}
        </Button>
    </div>
</section>

<style define:vars={{ 'mask-url': maskUrl, 'panel-url': panelUrl }}>
    .solutions-hero-panel-grid {
        position: absolute;
        inset-inline: var(--content-margin-inline);
        top: 50%;
        /* Slightly above dead-center, not exact vertical middle. */
        transform: translateY(calc(-50% - var(--space-4)));
        /* 14 columns x 4 rows of square cells; height follows from width,
           so the tile's uniform built-in margin gives equal gaps both ways */
        aspect-ratio: 14 / 4;
        display: grid;
        grid-template-columns: repeat(14, 1fr);
        grid-template-rows: repeat(4, 1fr);
    }

    .panel-cell {
        position: relative;
        background-image: var(--panel-url);
        background-repeat: no-repeat;
        background-size: 100% 100%;
        opacity: 0;
        /* Back-out bezier overshoots the end scale slightly = subtle bounce. */
        animation: panel-cell-in 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
        animation-delay: var(--cell-delay, 0s);
    }

    @keyframes panel-cell-in {
        from {
            opacity: 0;
            /* Multiply by the cell's own scale so 0.75x/0.5x cells bounce
               to their reduced size, not to full size. */
            transform: scale(calc(var(--panel-cell-scale, 1) * 0.8));
        }
        to {
            opacity: 1;
            transform: scale(var(--panel-cell-scale, 1));
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .panel-cell {
            animation: none;
            opacity: 1;
        }
    }

    .panel-cell-icon {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
    }

    /* Cell size is the grid's own width / 14, which shrinks much faster than
       the icon-2xl token as --content-margin-inline steps down — by mobile
       the cell is ~20-30px while icon-2xl stays 2.5rem (40px), badly
       overflowing the badge square. Step the icon down with the cell. */
    @media (max-width: 1023px) {
        .panel-cell .panel-cell-icon {
            width: var(--icon-xl);
            height: var(--icon-xl);
        }
    }

    @media (max-width: 767px) {
        .panel-cell .panel-cell-icon {
            width: var(--icon-m);
            height: var(--icon-m);
        }
    }

    .panel-cell.is-hidden {
        opacity: 0;
        /* No entrance animation: its forwards-fill opacity would override this. */
        animation: none;
    }

    .panel-cell.is-scaled {
        transform: scale(var(--panel-cell-scale));
    }

    .solutions-hero-effects {
        position: absolute;
        inset: 0;
        pointer-events: none;
        /* Luminance mask: white = show, black silhouette = hole, so
           anything in this layer renders behind the photo's subject.
           Must stay registered with .solutions-hero-image: same cover
           sizing and center-top anchor. */
        mask-image: var(--mask-url);
        mask-mode: luminance;
        mask-repeat: no-repeat;
        mask-position: center top;
        mask-size: cover;
    }

    .solutions-hero-section {
        position: relative;
        background-color: var(--surface-blue);
        overflow: hidden;
        margin-top: var(--navbar-height);
    }

    .solutions-hero-media {
        position: relative;
        width: 100%;
        aspect-ratio: 1920 / 770;
        opacity: 0;
        /* Home-section fly-in: image + mask + grid move as one unit, so the
           silhouette cut-out stays registered while it settles. Duration
           pairs with MEDIA_IN_SECONDS (0.9s pause) in the frontmatter. */
        animation: hero-media-in var(--motion-duration-heading) var(--motion-ease-standard) forwards;
    }

    @keyframes hero-media-in {
        from {
            opacity: 0;
            transform: translateY(1.625rem);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .solutions-hero-media {
            animation: none;
            opacity: 1;
        }
    }

    .solutions-hero-image {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center top;
        display: block;
    }

    .solutions-hero-fade {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            to bottom,
            transparent 48%,
            color-mix(in srgb, var(--surface-blue) 47%, transparent) 74%,
            var(--surface-blue) 100%
        );
    }

    .solutions-hero-content {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding: 0 var(--content-margin-inline) var(--section-pad-block-lg);
        margin-top: calc(-1 * var(--space-11));
        gap: var(--hero-stack-gap);
    }

    /* Same fly-in as the media block, cascading down the content stack:
       eyebrow -> title -> description -> CTA. */
    .solutions-hero-content > :global(*) {
        opacity: 0;
        animation: hero-media-in 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
    }

    .solutions-hero-content > :global(:nth-child(1)) {
        animation-delay: 0.1s;
    }

    .solutions-hero-content > :global(:nth-child(2)) {
        animation-delay: 0.2s;
    }

    .solutions-hero-content > :global(:nth-child(3)) {
        animation-delay: 0.3s;
    }

    .solutions-hero-content > :global(:nth-child(4)) {
        animation-delay: 0.4s;
    }

    @media (prefers-reduced-motion: reduce) {
        .solutions-hero-content > :global(*) {
            animation: none;
            opacity: 1;
        }
    }

    .solutions-hero-content :global(.eyebrow) {
        align-self: center;
    }

    .solutions-hero-content h1 {
        margin: 0;
    }

    .solutions-hero-description {
        max-width: 61.25rem;
        color: var(--text-primary);
        margin: 0;
    }

    @media (max-width: 1023px) {
        .solutions-hero-section {
            margin-top: 0;
        }
    }

    @media (max-width: 767px) {
        .solutions-hero-content {
            /* Mobile media is 1540/1920 ratio, so 35% upward shift = 28.0729vw
               — same scaling as ProductsHeroSection's mobile treatment */
            margin-top: -28.0729vw;
            gap: var(--space-5);
        }

        .solutions-hero-media {
            /* 2x taller than the desktop ratio so object-fit: cover zooms in
               by scaling to fill the extra height, cropping only the sides */
            aspect-ratio: 1920 / 1540;
        }

        /* The panel-grid centers on .solutions-hero-media's own height, which
           is 2x taller here — so the same 50% mark sits much lower in the
           now-zoomed photo than it did on desktop. Pull it further up to
           compensate, on top of the shared -space-4 offset. */
        .solutions-hero-panel-grid {
            transform: translateY(calc(-50% - var(--space-9)));
        }
    }
</style>
