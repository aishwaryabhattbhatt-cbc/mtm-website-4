---
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { t } from '../../lib/i18n/t';
import Button from '../shared/Button.astro';
import Eyebrow from '../shared/Eyebrow.astro';
import { icons } from '../../lib/icons/registry';

interface Props {
    locale: Locale;
    copy: CMSDictionary;
    ctaHref: string;
    heroImageSrc: string;
    /** Black-on-white silhouette of heroImageSrc; cuts a person-shaped
        hole in the effects layer so animations appear behind the subject. */
    maskImageSrc?: string;
    /** Nine icon registry paths placed on the grid's icon cells, in order.
        Swap entries here (per page) to change which icons appear. */
    heroIcons?: string[];
    fallbackEyebrow: string;
    fallbackTitle: string;
    fallbackDescription: string;
    fallbackCta?: string;
}

const {
    locale,
    copy,
    ctaHref,
    heroImageSrc,
    maskImageSrc,
    heroIcons = [
        icons.gen.marketing,
        icons.gen.trends,
        icons.gen.strategicGrowth,
        icons.gen.quickInsights,
        icons.gen.uniqueSegments,
        icons.gen.credibility,
        icons.gen.shapeStrategies,
        icons.gen.quickAccess,
        icons.gen.exportCharts,
    ],
    fallbackEyebrow,
    fallbackTitle,
    fallbackDescription,
    fallbackCta = 'REQUEST A DEMO',
} = Astro.props as Props;

const maskUrl = maskImageSrc ? `url("${maskImageSrc}")` : 'none';
/* SVG replica of images/solutions/rounded-square-panel.webp (91px webp was
   too small for the rendered cell size and upscaled blurry; vector stays sharp). */
const panelSvg = `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 91 91'><defs><radialGradient id='g' cx='50%' cy='42%' r='78%'><stop offset='0%' stop-color='#ffffff'/><stop offset='60%' stop-color='#fdfeff'/><stop offset='100%' stop-color='#f5f8fc'/></radialGradient></defs><rect x='4' y='4' width='83' height='83' rx='10' fill='url(#g)' stroke='#eef2f8' stroke-width='1'/></svg>`;
const panelUrl = `url("data:image/svg+xml,${encodeURIComponent(panelSvg)}")`;

const GRID_COLS = 14;
const GRID_ROWS = 4;
const gridCells = Array.from({ length: GRID_COLS * GRID_ROWS }, (_, i) => i);

// Panel grid: central columns 5-8 (4 wide) stay reserved (fully visible,
// behind the subject), leaving a 5-column block on each flank. Per flank,
// `count` cells become hidden, `count` become scaled, `count` get an icon —
// randomized fresh each build rather than hand-picked, but under the same
// rules that kept the old hand-picked layouts readable: no two cells of the
// same type (hidden/hidden, scaled/scaled, icon/icon) sit orthogonally
// adjacent (diagonal is fine), and the bottom-row outer corner of each flank
// is always an icon cell, never hidden/scaled. Which flank gets 4 vs 5 of
// each is also randomized per build.
type FlankCellType = 'hidden' | 'scaled' | 'icon';
const FLANK_COLS = 5;
const FLANK_ROWS = 4;

function shuffle<T>(arr: T[]): T[] {
    const a = arr.slice();
    for (let i = a.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
}

function orthogonallyAdjacent(a: [number, number], b: [number, number]): boolean {
    return Math.abs(a[0] - b[0]) + Math.abs(a[1] - b[1]) === 1;
}

/** Randomly places `count` hidden + `count` scaled + `count` icon cells in a
    5x4 flank (rest stay plain), forcing the bottom-row outer corner to be an
    icon. Backtracks with a step budget per attempt, retrying with a fresh
    random order on failure — cheap since the grid is small. */
function generateFlank(
    count: number,
    forcedCornerCol: number
): Record<FlankCellType, [number, number][]> {
    // 0-based index of row 4 (bottom row in a 4-row flank).
    const forcedCornerRow = FLANK_ROWS - 1;
    const forcedCorner: [number, number] = [forcedCornerRow, forcedCornerCol];

    for (let attempt = 0; attempt < 200; attempt++) {
        const rest = shuffle(
            Array.from({ length: FLANK_ROWS * FLANK_COLS }, (_, i): [number, number] => [
                Math.floor(i / FLANK_COLS),
                i % FLANK_COLS,
            ]).filter(([r, c]) => !(r === forcedCorner[0] && c === forcedCorner[1]))
        );
        const order = [forcedCorner, ...rest];
        const target = { hidden: count, scaled: count, icon: count };
        const counts = { hidden: 0, scaled: 0, icon: 0 };
        const assign = new Map<string, FlankCellType>();
        let steps = 0;

        const fits = (cell: [number, number], type: FlankCellType) => {
            for (const [key, t] of assign) {
                if (t !== type) continue;
                const [r, c] = key.split(',').map(Number);
                if (orthogonallyAdjacent(cell, [r, c])) return false;
            }
            return true;
        };

        const dfs = (i: number): boolean => {
            if (++steps > 4000) return false;
            if (i === order.length) {
                return (
                    counts.hidden === target.hidden &&
                    counts.scaled === target.scaled &&
                    counts.icon === target.icon
                );
            }
            const cell = order[i];
            const key = `${cell[0]},${cell[1]}`;
            const candidates: (FlankCellType | null)[] =
                i === 0 ? ['icon'] : shuffle(['hidden', 'scaled', 'icon', null]);
            for (const type of candidates) {
                if (type === null) {
                    if (dfs(i + 1)) return true;
                    continue;
                }
                if (counts[type] >= target[type] || !fits(cell, type)) continue;
                assign.set(key, type);
                counts[type]++;
                if (dfs(i + 1)) return true;
                counts[type]--;
                assign.delete(key);
            }
            return false;
        };

        if (dfs(0)) {
            const result: Record<FlankCellType, [number, number][]> = {
                hidden: [],
                scaled: [],
                icon: [],
            };
            for (const [key, type] of assign) {
                const [r, c] = key.split(',').map(Number);
                result[type].push([r, c]);
            }
            return result;
        }
    }
    // Constraints are loose enough that this shouldn't happen at these
    // counts; fall back to an all-plain flank rather than failing the build.
    return { hidden: [], scaled: [], icon: [forcedCorner] };
}

function toGridIndex(cell: [number, number], side: 'left' | 'right'): number {
    const col = side === 'left' ? cell[1] : GRID_COLS - FLANK_COLS + cell[1];
    return cell[0] * GRID_COLS + col;
}

const SCALES = [0.35, 0.5, 0.65, 0.8];
const leftCount = Math.random() < 0.5 ? 4 : 5;
const rightCount = 9 - leftCount;
const leftFlank = generateFlank(leftCount, 0);
const rightFlank = generateFlank(rightCount, FLANK_COLS - 1);

const hiddenCells = new Set([
    ...leftFlank.hidden.map((c) => toGridIndex(c, 'left')),
    ...rightFlank.hidden.map((c) => toGridIndex(c, 'right')),
]);
const scaledIndices = [
    ...leftFlank.scaled.map((c) => toGridIndex(c, 'left')),
    ...rightFlank.scaled.map((c) => toGridIndex(c, 'right')),
];
const cellScale = new Map<number, number>(
    scaledIndices.map((i, idx) => [i, SCALES[idx % SCALES.length]])
);
const iconIndices = [
    ...leftFlank.icon.map((c) => toGridIndex(c, 'left')),
    ...rightFlank.icon.map((c) => toGridIndex(c, 'right')),
];
const cellIcon = new Map(iconIndices.map((i, idx) => [i, heroIcons[idx]]));
const base = import.meta.env.BASE_URL;

// The media block flies in first (home-section pattern: 1.1s fly-in, content
// follows after a 0.9s pause), then the grid staggers in: each cell at a
// random point within the next ~2s (delay capped at 1.5s + 0.5s fade).
const MEDIA_IN_SECONDS = 0.9;
const cellDelays = gridCells.map(() => (MEDIA_IN_SECONDS + Math.random() * 1.5).toFixed(2));
---

<section class="solutions-hero-section">
    <div class="solutions-hero-media" aria-hidden="true">
        <img
            src={heroImageSrc}
            alt=""
            class="solutions-hero-image"
            loading="eager"
            decoding="async"
        />
        {
            maskImageSrc && (
                <>
                    <div class="solutions-hero-effects">
                        <div class="solutions-hero-panel-grid">
                            {gridCells.map((i) => (
                                <span
                                    class:list={[
                                        'panel-cell',
                                        hiddenCells.has(i) && 'is-hidden',
                                        cellScale.has(i) && 'is-scaled',
                                    ]}
                                    style={`--cell-delay: ${cellDelays[i]}s${
                                        cellScale.has(i)
                                            ? `; --panel-cell-scale: ${cellScale.get(i)}`
                                            : ''
                                    }`}
                                >
                                    {cellIcon.has(i) && (
                                        <img
                                            src={`${base}${cellIcon.get(i)}`}
                                            alt=""
                                            class="panel-cell-icon icon-2xl"
                                        />
                                    )}
                                </span>
                            ))}
                        </div>
                        <slot name="effects" />
                    </div>
                    {/* Desktop-only: dotted connector (CSS only) wired to the
                           two bottom-corner badges (always icon cells, see
                           generateFlank) and the eyebrow pill below — each
                           side drops straight down from its badge, turns
                           toward center, then a shared segment drops from
                           that turn down to the eyebrow. Not part of
                           .solutions-hero-effects so it stays unmasked
                           (drawn in front of the subject, like the source
                           photos). Positions mirror .solutions-hero-panel-grid
                           and .solutions-hero-content's own math exactly, so
                           it tracks them with no JS measurement needed. */}
                    <div class="solutions-hero-connector" aria-hidden="true">
                        <span class="connector-dot connector-dot--left" />
                        <span class="connector-dot connector-dot--right" />
                        <span class="connector-dot connector-dot--center" />
                        <span class="connector-elbow connector-elbow--left" />
                        <span class="connector-elbow connector-elbow--right" />
                        <span class="connector-corner-center connector-corner-center--left" />
                        <span class="connector-corner-center connector-corner-center--right" />
                    </div>
                </>
            )
        }
    </div>

    <div class="solutions-hero-content">
        <Eyebrow>{t(copy, 'hero_eyebrow', locale, fallbackEyebrow)}</Eyebrow>

        <h1 data-copy-key="hero_title">
            {t(copy, 'hero_title', locale, fallbackTitle)}
        </h1>

        <p class="text-body-p1 solutions-hero-description" data-copy-key="hero_description">
            {t(copy, 'hero_description', locale, fallbackDescription)}
        </p>

        <Button variant="primary" size="lg" href={ctaHref} data-copy-key="hero_cta">
            {t(copy, 'hero_cta', locale, fallbackCta)}
        </Button>
    </div>
</section>

<style define:vars={{ 'mask-url': maskUrl, 'panel-url': panelUrl }}>
    .solutions-hero-panel-grid {
        position: absolute;
        inset-inline: var(--content-margin-inline);
        top: 50%;
        /* Slightly above dead-center, not exact vertical middle. */
        transform: translateY(calc(-50% - var(--space-4)));
        /* 14 columns x 4 rows of square cells; height follows from width,
           so the tile's uniform built-in margin gives equal gaps both ways */
        aspect-ratio: 14 / 4;
        display: grid;
        grid-template-columns: repeat(14, 1fr);
        grid-template-rows: repeat(4, 1fr);
    }

    .panel-cell {
        position: relative;
        background-image: var(--panel-url);
        background-repeat: no-repeat;
        background-size: 100% 100%;
        opacity: 0;
        /* Back-out bezier overshoots the end scale slightly = subtle bounce. */
        animation: panel-cell-in 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
        animation-delay: var(--cell-delay, 0s);
    }

    @keyframes panel-cell-in {
        from {
            opacity: 0;
            /* Multiply by the cell's own scale so 0.75x/0.5x cells bounce
               to their reduced size, not to full size. */
            transform: scale(calc(var(--panel-cell-scale, 1) * 0.8));
        }
        to {
            opacity: 1;
            transform: scale(var(--panel-cell-scale, 1));
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .panel-cell {
            animation: none;
            opacity: 1;
        }
    }

    .panel-cell-icon {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
    }

    /* Cell size is the grid's own width / 14, which shrinks much faster than
       the icon-2xl token as --content-margin-inline steps down — by mobile
       the cell is ~20-30px while icon-2xl stays 2.5rem (40px), badly
       overflowing the badge square. Step the icon down with the cell. */
    @media (max-width: 1023px) {
        .panel-cell .panel-cell-icon {
            width: var(--icon-xl);
            height: var(--icon-xl);
        }
    }

    @media (max-width: 767px) {
        .panel-cell .panel-cell-icon {
            width: var(--icon-m);
            height: var(--icon-m);
        }
    }

    .panel-cell.is-hidden {
        opacity: 0;
        /* No entrance animation: its forwards-fill opacity would override this. */
        animation: none;
    }

    .panel-cell.is-scaled {
        transform: scale(var(--panel-cell-scale));
    }

    .solutions-hero-effects {
        position: absolute;
        inset: 0;
        pointer-events: none;
        /* Luminance mask: white = show, black silhouette = hole, so
           anything in this layer renders behind the photo's subject.
           Must stay registered with .solutions-hero-image: same cover
           sizing and center-top anchor. */
        mask-image: var(--mask-url);
        mask-mode: luminance;
        mask-repeat: no-repeat;
        mask-position: center top;
        mask-size: cover;
    }

    /* Desktop-only dotted connector — see the markup comment above for why
       this lives outside .solutions-hero-effects. Path per side: a dot just
       below the corner badge, straight down to a "bend" row, then in toward
       center; a shared segment then drops from that bend down to the
       eyebrow's top edge. Hidden below desktop, see max-width: 1023px. */
    .solutions-hero-connector {
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: 2;
        /* Shared anchor points. `left`/`right` resolve % against this box's
           WIDTH; `top`/`bottom` resolve % against its HEIGHT — since this
           box exactly matches .solutions-hero-media, any height-context
           formula that needs the panel-grid's WIDTH (to derive its height
           via the 14:4 aspect-ratio) has to reconstruct that width from
           height using the media's fixed desktop aspect-ratio (1920/770);
           only valid at desktop, which is fine since the whole connector is
           desktop-only. */
        --connector-x-left: calc(
            var(--content-margin-inline) + (100% - 2 * var(--content-margin-inline)) / 28
        );
        --connector-x-right: calc(100% - var(--connector-x-left));
        /* Bottom edge of the panel grid (row 4's own bottom, not its center). */
        --connector-y-grid-bottom: calc(
            50% - var(--space-4) + (100% * 1920 / 770 - 2 * var(--content-margin-inline)) / 7
        );
        /* Eyebrow's top edge = .solutions-hero-content's negative margin-top,
           nudged up by --space-1 so the dot sits fully above the pill
           instead of being half-covered by it. */
        --connector-y-eyebrow: calc(100% - var(--space-11) - var(--space-1));
        /* Bend sits exactly halfway between the two, so the badge->bend drop
           and the bend->eyebrow drop are always equal height. */
        --connector-y-bend: calc((var(--connector-y-grid-bottom) + var(--connector-y-eyebrow)) / 2);
        --connector-corner-r: 24px;
    }

    .connector-dot {
        position: absolute;
        width: var(--space-2);
        height: var(--space-2);
        border-radius: var(--radius-full);
        background: var(--brand-blue-main);
        transform: translate(-50%, -50%);
    }

    .connector-dot--left {
        left: var(--connector-x-left);
        top: var(--connector-y-grid-bottom);
    }

    .connector-dot--right {
        left: var(--connector-x-right);
        top: var(--connector-y-grid-bottom);
    }

    .connector-dot--center {
        left: 50%;
        top: var(--connector-y-eyebrow);
    }

    /* Each side is one S-curve made of two boxes: the elbow bends
       vertical-from-badge into horizontal-toward-center (rounded at the
       badge end); the center-corner then bends that same horizontal back
       into vertical-toward-eyebrow (rounded at the center end) — one box
       can only bend one way, so the S needs both pieces per side. */
    .connector-elbow {
        position: absolute;
        top: var(--connector-y-grid-bottom);
        bottom: calc(100% - var(--connector-y-bend));
        border-bottom: var(--stroke-2) dotted var(--brand-blue-main);
    }

    .connector-elbow--left {
        left: var(--connector-x-left);
        right: calc(50% + var(--connector-corner-r));
        border-left: var(--stroke-2) dotted var(--brand-blue-main);
        border-bottom-left-radius: var(--connector-corner-r);
    }

    .connector-elbow--right {
        left: calc(50% + var(--connector-corner-r));
        right: var(--connector-x-left);
        border-right: var(--stroke-2) dotted var(--brand-blue-main);
        border-bottom-right-radius: var(--connector-corner-r);
    }

    /* Spans all the way down to the eyebrow (not just the corner radius) —
       the curve fills whatever room it has near the top, and the box's own
       straight edge continues the rest of the way, so no separate vertical
       piece is needed below it. Top is nudged up 2px to overlap the
       elbow's bottom edge and close a hairline seam between the two boxes. */
    .connector-corner-center {
        position: absolute;
        top: calc(var(--connector-y-bend) - 2px);
        bottom: calc(100% - var(--connector-y-eyebrow));
        border-top: var(--stroke-2) dotted var(--brand-blue-main);
    }

    .connector-corner-center--left {
        left: calc(50% - var(--connector-corner-r));
        right: 50%;
        border-right: var(--stroke-2) dotted var(--brand-blue-main);
        border-top-right-radius: var(--connector-corner-r);
    }

    .connector-corner-center--right {
        left: 50%;
        right: calc(50% - var(--connector-corner-r));
        border-left: var(--stroke-2) dotted var(--brand-blue-main);
        border-top-left-radius: var(--connector-corner-r);
    }

    .solutions-hero-section {
        position: relative;
        background-color: var(--surface-blue);
        overflow: hidden;
        margin-top: var(--navbar-height);
    }

    .solutions-hero-media {
        position: relative;
        width: 100%;
        aspect-ratio: 1920 / 770;
        opacity: 0;
        /* Home-section fly-in: image + mask + grid move as one unit, so the
           silhouette cut-out stays registered while it settles. Duration
           pairs with MEDIA_IN_SECONDS (0.9s pause) in the frontmatter. */
        animation: hero-media-in var(--motion-duration-heading) var(--motion-ease-standard) forwards;
    }

    @keyframes hero-media-in {
        from {
            opacity: 0;
            transform: translateY(1.625rem);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .solutions-hero-media {
            animation: none;
            opacity: 1;
        }
    }

    .solutions-hero-image {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center top;
        display: block;
    }

    .solutions-hero-content {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding: 0 var(--content-margin-inline) var(--section-pad-block-lg);
        margin-top: calc(-1 * var(--space-11));
        gap: var(--hero-stack-gap);
    }

    /* Same fly-in as the media block, cascading down the content stack:
       eyebrow -> title -> description -> CTA. */
    .solutions-hero-content > :global(*) {
        opacity: 0;
        animation: hero-media-in 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
    }

    .solutions-hero-content > :global(:nth-child(1)) {
        animation-delay: 0.1s;
    }

    .solutions-hero-content > :global(:nth-child(2)) {
        animation-delay: 0.2s;
    }

    .solutions-hero-content > :global(:nth-child(3)) {
        animation-delay: 0.3s;
    }

    .solutions-hero-content > :global(:nth-child(4)) {
        animation-delay: 0.4s;
    }

    @media (prefers-reduced-motion: reduce) {
        .solutions-hero-content > :global(*) {
            animation: none;
            opacity: 1;
        }
    }

    .solutions-hero-content :global(.eyebrow) {
        align-self: center;
    }

    .solutions-hero-content h1 {
        margin: 0;
    }

    .solutions-hero-description {
        max-width: 61.25rem;
        color: var(--text-primary);
        margin: 0;
    }

    @media (max-width: 1023px) {
        .solutions-hero-section {
            margin-top: 0;
        }

        /* Desktop-only: the panel-grid geometry it's wired to shifts too
           much between breakpoints (translateY offset changes, mobile
           switches to a taller aspect-ratio) to keep tracking correctly. */
        .solutions-hero-connector {
            display: none;
        }
    }

    @media (max-width: 767px) {
        .solutions-hero-content {
            /* Mobile media is 1540/1920 ratio, so 35% upward shift = 28.0729vw
               — same scaling as ProductsHeroSection's mobile treatment */
            margin-top: -28.0729vw;
            gap: var(--space-5);
        }

        .solutions-hero-media {
            /* 2x taller than the desktop ratio so object-fit: cover zooms in
               by scaling to fill the extra height, cropping only the sides */
            aspect-ratio: 1920 / 1540;
        }

        /* The panel-grid centers on .solutions-hero-media's own height, which
           is 2x taller here — so the same 50% mark sits much lower in the
           now-zoomed photo than it did on desktop. Pull it further up to
           compensate, on top of the shared -space-4 offset. */
        .solutions-hero-panel-grid {
            transform: translateY(calc(-50% - var(--space-9)));
        }
    }
</style>
