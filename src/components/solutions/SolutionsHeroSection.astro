---
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { t } from '../../lib/i18n/t';
import Button from '../shared/Button.astro';
import Eyebrow from '../shared/Eyebrow.astro';
import { icons } from '../../lib/icons/registry';
import { getHeroIconPool } from '../../lib/icons/heroIconPool';

interface Props {
    locale: Locale;
    copy: CMSDictionary;
    ctaHref: string;
    heroImageSrc: string;
    /** Black-on-white silhouette of heroImageSrc; cuts a person-shaped
        hole in the effects layer so animations appear behind the subject. */
    maskImageSrc?: string;
    /** Nine icon registry paths placed on the grid's icon cells, in order.
        Swap entries here (per page) to change which icons appear. */
    heroIcons?: string[];
    fallbackEyebrow: string;
    fallbackTitle: string;
    fallbackDescription: string;
    fallbackCta?: string;
}

const {
    locale,
    copy,
    ctaHref,
    heroImageSrc,
    maskImageSrc,
    heroIcons = [
        icons.gen.marketing,
        icons.gen.trends,
        icons.gen.strategicGrowth,
        icons.gen.quickInsights,
        icons.gen.uniqueSegments,
        icons.gen.credibility,
        icons.gen.shapeStrategies,
        icons.gen.quickAccess,
        icons.gen.exportCharts,
    ],
    fallbackEyebrow,
    fallbackTitle,
    fallbackDescription,
    fallbackCta = 'REQUEST A DEMO',
} = Astro.props as Props;

const maskUrl = maskImageSrc ? `url("${maskImageSrc}")` : 'none';
/* SVG replica of images/solutions/rounded-square-panel.webp (91px webp was
   too small for the rendered cell size and upscaled blurry; vector stays sharp). */
const panelSvg = `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 91 91'><defs><radialGradient id='g' cx='50%' cy='42%' r='78%'><stop offset='0%' stop-color='#ffffff'/><stop offset='60%' stop-color='#fdfeff'/><stop offset='100%' stop-color='#f5f8fc'/></radialGradient></defs><rect x='4' y='4' width='83' height='83' rx='10' fill='url(#g)' stroke='#eef2f8' stroke-width='1'/></svg>`;
const panelUrl = `url("data:image/svg+xml,${encodeURIComponent(panelSvg)}")`;

const GRID_COLS = 14;
const GRID_ROWS = 4;
const gridCells = Array.from({ length: GRID_COLS * GRID_ROWS }, (_, i) => i);

// Panel grid: central columns 5-8 (4 wide) stay reserved (fully visible,
// behind the subject), leaving a 5-column block on each flank. Per flank,
// `count` cells become hidden, `count` become scaled, `count` get an icon —
// randomized fresh each build rather than hand-picked, but under the same
// rules that kept the old hand-picked layouts readable: no two cells of the
// same type (hidden/hidden, scaled/scaled, icon/icon) sit orthogonally
// adjacent (diagonal is fine), and the bottom-row outer corner of each flank
// is always an icon cell, never hidden/scaled. Which flank gets 4 vs 5 of
// each is also randomized per build.
type FlankCellType = 'hidden' | 'scaled' | 'icon';
const FLANK_COLS = 5;
const FLANK_ROWS = 4;
// Tablet gets a smaller grid: 2 columns off each flank, 1 row off the
// bottom — see the tablet-only media query in <style> for where this is
// actually swapped in.
const TABLET_FLANK_COLS = FLANK_COLS - 2;
const TABLET_FLANK_ROWS = FLANK_ROWS - 1;
const TABLET_GRID_COLS = GRID_COLS - 2 * 2;
const TABLET_GRID_ROWS = GRID_ROWS - 1;
// Mobile gets a smaller grid still: 8 columns x 4 rows total (2-col flanks,
// same 4-wide reserved center) — see the mobile media query in <style>.
const MOBILE_GRID_COLS = 8;
const MOBILE_GRID_ROWS = 4;
const MOBILE_FLANK_COLS = (MOBILE_GRID_COLS - 4) / 2;
const MOBILE_FLANK_ROWS = MOBILE_GRID_ROWS;

function shuffle<T>(arr: T[]): T[] {
    const a = arr.slice();
    for (let i = a.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
}

function orthogonallyAdjacent(a: [number, number], b: [number, number]): boolean {
    return Math.abs(a[0] - b[0]) + Math.abs(a[1] - b[1]) === 1;
}

/** Randomly places `target.hidden` hidden + `target.scaled` scaled +
    `target.icon` icon cells in a `rows`x`cols` flank (rest stay plain),
    forcing the bottom-row outer corner to be an icon. Backtracks with a
    step budget per attempt, retrying with a fresh random order on failure —
    cheap since the grid is small. */
function generateFlank(
    rows: number,
    cols: number,
    target: Record<FlankCellType, number>,
    forcedCornerCol: number
): Record<FlankCellType, [number, number][]> {
    // 0-based index of the bottom row.
    const forcedCornerRow = rows - 1;
    const forcedCorner: [number, number] = [forcedCornerRow, forcedCornerCol];

    for (let attempt = 0; attempt < 200; attempt++) {
        const rest = shuffle(
            Array.from({ length: rows * cols }, (_, i): [number, number] => [
                Math.floor(i / cols),
                i % cols,
            ]).filter(([r, c]) => !(r === forcedCorner[0] && c === forcedCorner[1]))
        );
        const order = [forcedCorner, ...rest];
        const counts = { hidden: 0, scaled: 0, icon: 0 };
        const assign = new Map<string, FlankCellType>();
        let steps = 0;

        const fits = (cell: [number, number], type: FlankCellType) => {
            for (const [key, t] of assign) {
                if (t !== type) continue;
                const [r, c] = key.split(',').map(Number);
                if (orthogonallyAdjacent(cell, [r, c])) return false;
            }
            return true;
        };

        const dfs = (i: number): boolean => {
            if (++steps > 4000) return false;
            if (i === order.length) {
                return (
                    counts.hidden === target.hidden &&
                    counts.scaled === target.scaled &&
                    counts.icon === target.icon
                );
            }
            const cell = order[i];
            const key = `${cell[0]},${cell[1]}`;
            const candidates: (FlankCellType | null)[] =
                i === 0 ? ['icon'] : shuffle(['hidden', 'scaled', 'icon', null]);
            for (const type of candidates) {
                if (type === null) {
                    if (dfs(i + 1)) return true;
                    continue;
                }
                if (counts[type] >= target[type] || !fits(cell, type)) continue;
                assign.set(key, type);
                counts[type]++;
                if (dfs(i + 1)) return true;
                counts[type]--;
                assign.delete(key);
            }
            return false;
        };

        if (dfs(0)) {
            const result: Record<FlankCellType, [number, number][]> = {
                hidden: [],
                scaled: [],
                icon: [],
            };
            for (const [key, type] of assign) {
                const [r, c] = key.split(',').map(Number);
                result[type].push([r, c]);
            }
            return result;
        }
    }
    // Constraints are loose enough that this shouldn't happen at these
    // counts; fall back to an all-plain flank rather than failing the build.
    return { hidden: [], scaled: [], icon: [forcedCorner] };
}

function toGridIndex(
    cell: [number, number],
    side: 'left' | 'right',
    gridCols: number,
    flankCols: number
): number {
    const col = side === 'left' ? cell[1] : gridCols - flankCols + cell[1];
    return cell[0] * gridCols + col;
}

// Tablet's 3x3 flank skews toward icons rather than splitting evenly:
// fewer hidden cells, more icon cells, so the smaller grid still reads as
// icon-forward rather than sparse. Sums to all 9 cells of the flank.
const TABLET_TARGET: Record<FlankCellType, number> = { hidden: 2, scaled: 3, icon: 4 };
// Mobile's 2x4 flank: 1 hidden, 1 scaled, 2 icon — same small badge count
// as before the flank grew taller, so the extra rows read as more open
// space around the badges rather than packing in more of them.
const MOBILE_TARGET: Record<FlankCellType, number> = { hidden: 1, scaled: 1, icon: 2 };

const SCALES = [0.35, 0.5, 0.65, 0.8];
const leftCount = Math.random() < 0.5 ? 4 : 5;
const rightCount = 9 - leftCount;
const leftFlank = generateFlank(
    FLANK_ROWS,
    FLANK_COLS,
    { hidden: leftCount, scaled: leftCount, icon: leftCount },
    0
);
const rightFlank = generateFlank(
    FLANK_ROWS,
    FLANK_COLS,
    { hidden: rightCount, scaled: rightCount, icon: rightCount },
    FLANK_COLS - 1
);

const hiddenCells = new Set([
    ...leftFlank.hidden.map((c) => toGridIndex(c, 'left', GRID_COLS, FLANK_COLS)),
    ...rightFlank.hidden.map((c) => toGridIndex(c, 'right', GRID_COLS, FLANK_COLS)),
]);
const scaledIndices = [
    ...leftFlank.scaled.map((c) => toGridIndex(c, 'left', GRID_COLS, FLANK_COLS)),
    ...rightFlank.scaled.map((c) => toGridIndex(c, 'right', GRID_COLS, FLANK_COLS)),
];
const cellScale = new Map<number, number>(
    scaledIndices.map((i, idx) => [i, SCALES[idx % SCALES.length]])
);
const iconIndices = [
    ...leftFlank.icon.map((c) => toGridIndex(c, 'left', GRID_COLS, FLANK_COLS)),
    ...rightFlank.icon.map((c) => toGridIndex(c, 'right', GRID_COLS, FLANK_COLS)),
];
const cellIcon = new Map(iconIndices.map((i, idx) => [i, heroIcons[idx]]));

// Tablet: smaller grid (see TABLET_* consts above), icon-skewed split.
const tabletLeftFlank = generateFlank(TABLET_FLANK_ROWS, TABLET_FLANK_COLS, TABLET_TARGET, 0);
const tabletRightFlank = generateFlank(
    TABLET_FLANK_ROWS,
    TABLET_FLANK_COLS,
    TABLET_TARGET,
    TABLET_FLANK_COLS - 1
);

const tabletHiddenCells = new Set([
    ...tabletLeftFlank.hidden.map((c) =>
        toGridIndex(c, 'left', TABLET_GRID_COLS, TABLET_FLANK_COLS)
    ),
    ...tabletRightFlank.hidden.map((c) =>
        toGridIndex(c, 'right', TABLET_GRID_COLS, TABLET_FLANK_COLS)
    ),
]);
const tabletScaledIndices = [
    ...tabletLeftFlank.scaled.map((c) =>
        toGridIndex(c, 'left', TABLET_GRID_COLS, TABLET_FLANK_COLS)
    ),
    ...tabletRightFlank.scaled.map((c) =>
        toGridIndex(c, 'right', TABLET_GRID_COLS, TABLET_FLANK_COLS)
    ),
];
const tabletCellScale = new Map<number, number>(
    tabletScaledIndices.map((i, idx) => [i, SCALES[idx % SCALES.length]])
);
const tabletIconIndices = [
    ...tabletLeftFlank.icon.map((c) => toGridIndex(c, 'left', TABLET_GRID_COLS, TABLET_FLANK_COLS)),
    ...tabletRightFlank.icon.map((c) =>
        toGridIndex(c, 'right', TABLET_GRID_COLS, TABLET_FLANK_COLS)
    ),
];
const tabletCellIcon = new Map(tabletIconIndices.map((i, idx) => [i, heroIcons[idx]]));
const tabletGridCells = Array.from({ length: TABLET_GRID_COLS * TABLET_GRID_ROWS }, (_, i) => i);

// Mobile: smaller grid still (see MOBILE_* consts above), same icon-skewed split.
const mobileLeftFlank = generateFlank(MOBILE_FLANK_ROWS, MOBILE_FLANK_COLS, MOBILE_TARGET, 0);
const mobileRightFlank = generateFlank(
    MOBILE_FLANK_ROWS,
    MOBILE_FLANK_COLS,
    MOBILE_TARGET,
    MOBILE_FLANK_COLS - 1
);

const mobileHiddenCells = new Set([
    ...mobileLeftFlank.hidden.map((c) =>
        toGridIndex(c, 'left', MOBILE_GRID_COLS, MOBILE_FLANK_COLS)
    ),
    ...mobileRightFlank.hidden.map((c) =>
        toGridIndex(c, 'right', MOBILE_GRID_COLS, MOBILE_FLANK_COLS)
    ),
]);
const mobileScaledIndices = [
    ...mobileLeftFlank.scaled.map((c) =>
        toGridIndex(c, 'left', MOBILE_GRID_COLS, MOBILE_FLANK_COLS)
    ),
    ...mobileRightFlank.scaled.map((c) =>
        toGridIndex(c, 'right', MOBILE_GRID_COLS, MOBILE_FLANK_COLS)
    ),
];
const mobileCellScale = new Map<number, number>(
    mobileScaledIndices.map((i, idx) => [i, SCALES[idx % SCALES.length]])
);
const mobileIconIndices = [
    ...mobileLeftFlank.icon.map((c) => toGridIndex(c, 'left', MOBILE_GRID_COLS, MOBILE_FLANK_COLS)),
    ...mobileRightFlank.icon.map((c) =>
        toGridIndex(c, 'right', MOBILE_GRID_COLS, MOBILE_FLANK_COLS)
    ),
];
const mobileCellIcon = new Map(mobileIconIndices.map((i, idx) => [i, heroIcons[idx]]));
const mobileGridCells = Array.from({ length: MOBILE_GRID_COLS * MOBILE_GRID_ROWS }, (_, i) => i);
const base = import.meta.env.BASE_URL;

// The media block flies in first (home-section pattern: 1.1s fly-in, content
// follows after a 0.9s pause), then the grid staggers in: each cell at a
// random point within the next ~2s (delay capped at 1.5s + 0.5s fade).
const MEDIA_IN_SECONDS = 0.9;
const cellDelays = gridCells.map(() => (MEDIA_IN_SECONDS + Math.random() * 1.5).toFixed(2));
const tabletCellDelays = tabletGridCells.map(() =>
    (MEDIA_IN_SECONDS + Math.random() * 1.5).toFixed(2)
);
const mobileCellDelays = mobileGridCells.map(() =>
    (MEDIA_IN_SECONDS + Math.random() * 1.5).toFixed(2)
);
---

<section class="solutions-hero-section">
    <div class="solutions-hero-media" aria-hidden="true">
        <img
            src={heroImageSrc}
            alt=""
            class="solutions-hero-image"
            loading="eager"
            decoding="async"
        />
        {
            maskImageSrc && (
                <>
                    <div class="solutions-hero-effects">
                        <div class="solutions-hero-panel-grid solutions-hero-panel-grid--desktop">
                            {gridCells.map((i) => (
                                <span
                                    class:list={[
                                        'panel-cell',
                                        hiddenCells.has(i) && 'is-hidden',
                                        cellScale.has(i) && 'is-scaled',
                                    ]}
                                    style={`--cell-delay: ${cellDelays[i]}s${
                                        cellScale.has(i)
                                            ? `; --panel-cell-scale: ${cellScale.get(i)}`
                                            : ''
                                    }`}
                                >
                                    {cellIcon.has(i) && (
                                        <img
                                            src={`${base}${cellIcon.get(i)}`}
                                            alt=""
                                            class="panel-cell-icon icon-2xl"
                                        />
                                    )}
                                </span>
                            ))}
                        </div>
                        {/* Tablet-only (768-1023px): a separately-generated
                               smaller grid — 2 fewer columns per flank, 1
                               fewer row, fewer badges per flank — swapped in
                               for the desktop grid above via the tablet-only
                               media query in <style>. */}
                        <div class="solutions-hero-panel-grid solutions-hero-panel-grid--tablet">
                            {tabletGridCells.map((i) => (
                                <span
                                    class:list={[
                                        'panel-cell',
                                        tabletHiddenCells.has(i) && 'is-hidden',
                                        tabletCellScale.has(i) && 'is-scaled',
                                    ]}
                                    style={`--cell-delay: ${tabletCellDelays[i]}s${
                                        tabletCellScale.has(i)
                                            ? `; --panel-cell-scale: ${tabletCellScale.get(i)}`
                                            : ''
                                    }`}
                                >
                                    {tabletCellIcon.has(i) && (
                                        <img
                                            src={`${base}${tabletCellIcon.get(i)}`}
                                            alt=""
                                            class="panel-cell-icon icon-2xl"
                                        />
                                    )}
                                </span>
                            ))}
                        </div>
                        {/* Mobile-only (<=767px): smaller again — 8 columns x
                               2 rows total, swapped in for both grids above
                               via the mobile media query in <style>. */}
                        <div class="solutions-hero-panel-grid solutions-hero-panel-grid--mobile">
                            {mobileGridCells.map((i) => (
                                <span
                                    class:list={[
                                        'panel-cell',
                                        mobileHiddenCells.has(i) && 'is-hidden',
                                        mobileCellScale.has(i) && 'is-scaled',
                                    ]}
                                    style={`--cell-delay: ${mobileCellDelays[i]}s${
                                        mobileCellScale.has(i)
                                            ? `; --panel-cell-scale: ${mobileCellScale.get(i)}`
                                            : ''
                                    }`}
                                >
                                    {mobileCellIcon.has(i) && (
                                        <img
                                            src={`${base}${mobileCellIcon.get(i)}`}
                                            alt=""
                                            class="panel-cell-icon icon-2xl"
                                        />
                                    )}
                                </span>
                            ))}
                        </div>
                        <slot name="effects" />
                    </div>
                    {/* Dotted connector (CSS only) wired to the two
                           bottom-corner badges (always icon cells, see
                           generateFlank) and the eyebrow pill below — each
                           side drops straight down from its badge, turns
                           toward center, then a shared segment drops from
                           that turn down to the eyebrow. Not part of
                           .solutions-hero-effects so it stays unmasked
                           (drawn in front of the subject, like the source
                           photos). Positions mirror whichever panel-grid
                           variant is visible at the current breakpoint and
                           .solutions-hero-content's own math exactly (see
                           the per-breakpoint --connector-* overrides in
                           <style>), so it tracks with no JS measurement
                           needed. */}
                    <div class="solutions-hero-connector" aria-hidden="true">
                        <span class="connector-dot connector-dot--left" />
                        <span class="connector-dot connector-dot--right" />
                        <span class="connector-dot connector-dot--center" />
                        <span class="connector-elbow connector-elbow--left" />
                        <span class="connector-elbow connector-elbow--right" />
                        <span class="connector-corner-center connector-corner-center--left" />
                        <span class="connector-corner-center connector-corner-center--right" />
                    </div>
                </>
            )
        }
    </div>

    <div class="solutions-hero-content">
        <Eyebrow>{t(copy, 'hero_eyebrow', locale, fallbackEyebrow)}</Eyebrow>

        <h1 data-copy-key="hero_title">
            {t(copy, 'hero_title', locale, fallbackTitle)}
        </h1>

        <p class="text-body-p1 solutions-hero-description" data-copy-key="hero_description">
            {t(copy, 'hero_description', locale, fallbackDescription)}
        </p>

        <Button variant="primary" size="lg" href={ctaHref} data-copy-key="hero_cta">
            {t(copy, 'hero_cta', locale, fallbackCta)}
        </Button>
    </div>
</section>

<script
    define:vars={{
        // Same curated pool as ProductsHeroSection, not just this page's
        // hand-picked 9 — real variety to draw from, and kept in sync in
        // one shared place.
        heroIconPaths: getHeroIconPool(base),
    }}
>
    // Cell layout (which cells are hidden/scaled/icon) stays exactly as
    // generated at build time — only which icon fills each icon-cell
    // re-rolls on every page load, drawn fresh from the shared pool each
    // time. Each grid variant (desktop/tablet/mobile) is shuffled
    // independently since they don't use the same number of icon cells.
    function shuffle(arr) {
        const a = arr.slice();
        for (let i = a.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [a[i], a[j]] = [a[j], a[i]];
        }
        return a;
    }

    document.querySelectorAll('.solutions-hero-panel-grid').forEach((grid) => {
        const cellIcons = grid.querySelectorAll('.panel-cell-icon');
        const picks = shuffle(heroIconPaths);
        cellIcons.forEach((img, i) => {
            if (picks[i]) img.src = picks[i];
        });
    });
</script>

<style define:vars={{ 'mask-url': maskUrl, 'panel-url': panelUrl }}>
    .solutions-hero-panel-grid {
        position: absolute;
        inset-inline: var(--content-margin-inline);
        top: 50%;
        /* Slightly above dead-center, not exact vertical middle. */
        transform: translateY(calc(-50% - var(--space-4)));
        /* Square cells; height follows from width, so the tile's uniform
           built-in margin gives equal gaps both ways. */
        display: grid;
    }

    /* 14 columns x 4 rows — shown at desktop widths only; tablet and mobile
       each swap in their own smaller grid below. */
    .solutions-hero-panel-grid--desktop {
        aspect-ratio: 14 / 4;
        grid-template-columns: repeat(14, 1fr);
        grid-template-rows: repeat(4, 1fr);
    }

    /* 10 columns x 3 rows, separately generated — fewer, bigger badges than
       the desktop grid — hidden except at tablet, see the tablet-only media
       query below. */
    .solutions-hero-panel-grid--tablet {
        display: none;
        aspect-ratio: 10 / 3;
        grid-template-columns: repeat(10, 1fr);
        grid-template-rows: repeat(3, 1fr);
    }

    /* 8 columns x 4 rows, separately generated — hidden except at mobile,
       see max-width: 767px below. */
    .solutions-hero-panel-grid--mobile {
        display: none;
        aspect-ratio: 8 / 4;
        grid-template-columns: repeat(8, 1fr);
        grid-template-rows: repeat(4, 1fr);
    }

    .panel-cell {
        position: relative;
        background-image: var(--panel-url);
        background-repeat: no-repeat;
        background-size: 100% 100%;
        opacity: 0;
        /* Back-out bezier overshoots the end scale slightly = subtle bounce. */
        animation: panel-cell-in 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
        animation-delay: var(--cell-delay, 0s);
    }

    @keyframes panel-cell-in {
        from {
            opacity: 0;
            /* Multiply by the cell's own scale so 0.75x/0.5x cells bounce
               to their reduced size, not to full size. */
            transform: scale(calc(var(--panel-cell-scale, 1) * 0.8));
        }
        to {
            opacity: 1;
            transform: scale(var(--panel-cell-scale, 1));
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .panel-cell {
            animation: none;
            opacity: 1;
        }
    }

    .panel-cell-icon {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
    }

    /* Desktop only — 20% over the shared icon-2xl token from the markup's
       `icon-2xl` class. Tablet and mobile already size correctly off their
       own overrides below and must stay untouched. */
    @media (min-width: 1024px) {
        .panel-cell-icon {
            width: calc(var(--icon-2xl) * 1.2);
            height: calc(var(--icon-2xl) * 1.2);
        }
    }

    /* Cell size is the grid's own width / 14, which shrinks much faster than
       the icon-2xl token as --content-margin-inline steps down — by mobile
       the cell is ~20-30px while icon-2xl stays 2.5rem (40px), badly
       overflowing the badge square. Step the icon down with the cell. */
    @media (max-width: 1023px) {
        .panel-cell .panel-cell-icon {
            width: var(--icon-xl);
            height: var(--icon-xl);
        }

        /* Tablet's own grid has fewer, bigger cells (10 cols vs desktop's
           14) than this rule assumes — size back up for it specifically. */
        .solutions-hero-panel-grid--tablet .panel-cell-icon {
            width: var(--icon-3xl);
            height: var(--icon-3xl);
        }
    }

    @media (max-width: 767px) {
        .panel-cell .panel-cell-icon {
            width: var(--icon-m);
            height: var(--icon-m);
        }

        /* Mobile's own grid has fewer, bigger columns (8 vs desktop's 14)
           than this rule assumes — size back up. */
        .solutions-hero-panel-grid--mobile .panel-cell-icon {
            width: var(--icon-2xl);
            height: var(--icon-2xl);
        }
    }

    .panel-cell.is-hidden {
        opacity: 0;
        /* No entrance animation: its forwards-fill opacity would override this. */
        animation: none;
    }

    .panel-cell.is-scaled {
        transform: scale(var(--panel-cell-scale));
    }

    .solutions-hero-effects {
        position: absolute;
        inset: 0;
        pointer-events: none;
        /* Alpha mask: opaque = show, transparent silhouette = hole, so
           anything in this layer renders behind the photo's subject.
           Must stay registered with .solutions-hero-image: same cover
           sizing and center-top anchor. The mask asset is a real alpha PNG
           baked from the original black/white luminance art (see
           scripts/ — regenerate via sharp if the source art changes) —
           `mask-mode: luminance` isn't reliably supported on real mobile
