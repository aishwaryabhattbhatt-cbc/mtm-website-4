---
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { t } from '../../lib/i18n/t';
import Button from '../shared/Button.astro';
import Eyebrow from '../shared/Eyebrow.astro';

interface Props {
    locale: Locale;
    copy: CMSDictionary;
    ctaHref: string;
    heroImageSrc: string;
    fallbackEyebrow: string;
    fallbackTitle: string;
    fallbackDescription: string;
    fallbackCta?: string;
}

const {
    locale,
    copy,
    ctaHref,
    heroImageSrc,
    fallbackEyebrow,
    fallbackTitle,
    fallbackDescription,
    fallbackCta = 'REQUEST A DEMO',
} = Astro.props as Props;
---

<section class="solutions-hero-section">
    <div class="solutions-hero-media" aria-hidden="true">
        <img
            src={heroImageSrc}
            alt=""
            class="solutions-hero-image"
            loading="eager"
            decoding="async"
        />
        <div class="solutions-hero-fade"></div>
    </div>

    <div class="solutions-hero-content">
        <Eyebrow>{fallbackEyebrow}</Eyebrow>

        <h1 data-copy-key="hero_title">
            {t(copy, 'hero_title', locale, fallbackTitle)}
        </h1>

        <p class="text-body-p1 solutions-hero-description" data-copy-key="hero_description">
            {t(copy, 'hero_description', locale, fallbackDescription)}
        </p>

        <Button variant="primary" size="lg" href={ctaHref} data-copy-key="hero_cta">
            {t(copy, 'hero_cta', locale, fallbackCta)}
        </Button>
    </div>
</section>

<style>
    .solutions-hero-section {
        position: relative;
        background-color: var(--surface-blue);
        overflow: hidden;
        margin-top: var(--navbar-height);
    }

    .solutions-hero-media {
        position: relative;
        width: 100%;
        aspect-ratio: 1920 / 770;
    }

    .solutions-hero-image {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center top;
        display: block;
    }

    .solutions-hero-fade {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            to bottom,
            transparent 48%,
            color-mix(in srgb, var(--surface-blue) 47%, transparent) 74%,
            var(--surface-blue) 100%
        );
    }

    .solutions-hero-content {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding: 0 var(--content-margin-inline) var(--space-13);
        margin-top: calc(-1 * var(--space-11));
        gap: var(--space-6);
    }

    .solutions-hero-content :global(.eyebrow) {
        align-self: center;
    }

    .solutions-hero-content h1 {
        margin: 0;
    }

    .solutions-hero-description {
        max-width: 61.25rem;
        color: var(--text-primary);
        margin: 0;
    }

    @media (max-width: 1023px) {
        .solutions-hero-section {
            margin-top: 0;
        }
    }

    @media (max-width: 767px) {
        .solutions-hero-content {
            margin-top: calc(-1 * var(--space-6));
            gap: var(--space-5);
        }
    }
</style>
