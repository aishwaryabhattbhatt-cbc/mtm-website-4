---
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { t } from '../../lib/i18n/t';
import { icons } from '../../lib/icons/registry';
import SolutionsInsightCard from './SolutionsInsightCard.astro';

interface Props {
    locale: Locale;
    copy: CMSDictionary;
    base: string;
}

const { locale, copy, base } = Astro.props as Props;
---

<section class="solutions-media-insights-section">
    <div class="solutions-media-insights-header heading-fly-in">
        <h2 data-copy-key="problem_title">
            {t(copy, 'problem_title', locale, "The shifts you don't see until it's too late.")}
        </h2>
        <p
            class="text-body-p1 solutions-media-insights-subtitle"
            data-copy-key="problem_description"
        >
            {
                t(
                    copy,
                    'problem_description',
                    locale,
                    'Attention fragmentation is real – know where your audience is now, where it will be next and who you may not be reaching yet.'
                )
            }
        </p>
    </div>

    <div class="solutions-media-insights-cards">
        <div class="card-fly-in">
            <SolutionsInsightCard
                iconSrc={`${base}${icons.gen.multitasking}`}
                eyebrow={t(copy, 'insight_1_eyebrow', locale, 'Platform Diversification')}
                eyebrowKey="insight_1_eyebrow"
                title={t(
                    copy,
                    'insight_1_title',
                    locale,
                    'Your audience is moving across platforms simultaneously.'
                )}
                titleKey="insight_1_title"
                description={t(
                    copy,
                    'insight_1_description',
                    locale,
                    "Canadians don't live on one platform. They stream on one device, podcast on another, and browse FAST channels in the evening. MTM tracks the full picture across every screen — so you know where attention is actually going."
                )}
                descriptionKey="insight_1_description"
                imageSrc={`${base}images/solutions/media/insight-1.svg`}
                imageAlt={t(copy, 'insight_1_chart_title', locale, 'Platform reach over time')}
                imageTitle={t(copy, 'insight_1_chart_title', locale, 'Platform reach over time')}
                imageTitleKey="insight_1_chart_title"
                imageTitleColor="blue"
            />
        </div>
        <div class="card-fly-in">
            <SolutionsInsightCard
                iconSrc={`${base}${icons.gen.uniqueSegments}`}
                eyebrow={t(copy, 'insight_2_eyebrow', locale, 'Market Intelligence')}
                eyebrowKey="insight_2_eyebrow"
                title={t(
                    copy,
                    'insight_2_title',
                    locale,
                    "Stop marketing to the 'average' Canadian."
                )}
                titleKey="insight_2_title"
                description={t(
                    copy,
                    'insight_2_description',
                    locale,
                    'The MTM allows you to see Canada in high definition. From streaming subscriptions to podcast habits to device ownership — not all Canadians have the same media behaviours.'
                )}
                descriptionKey="insight_2_description"
                imageSrc={`${base}images/solutions/media/insight-2.svg`}
                imageAlt={t(copy, 'insight_2_chart_title', locale, 'Audience breakdown by segment')}
                imageTitle={t(
                    copy,
                    'insight_2_chart_title',
                    locale,
                    'Audience breakdown by segment'
                )}
                imageTitleKey="insight_2_chart_title"
                imageTitleColor="indigo"
            />
        </div>
    </div>
</section>

<style>
    .solutions-media-insights-section {
        width: 100%;
        background: var(--surface-blue);
        padding: var(--section-pad-block-lg) var(--content-margin-inline);
        display: flex;
        flex-direction: column;
        gap: var(--section-header-gap);
    }

    /* Header */
    .solutions-media-insights-header {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--title-desc-gap);
        text-align: center;
    }

    .solutions-media-insights-header h2 {
        margin: 0;
        color: var(--text-primary);
        max-width: 44rem;
    }

    .solutions-media-insights-subtitle {
        margin: 0;
        color: var(--text-secondary);
        max-width: 44rem;
    }

    /* Cards grid — stretch keeps both cards at equal height. The explicit
       row pair (body, visual) lets each card subgrid into it, so the two
       cards' body/visual split lines up even when one card's copy is
       longer — see SolutionsInsightCard's own comment for the full chain. */
    .solutions-media-insights-cards {
        display: grid;
        grid-template-columns: 1fr 1fr;
        grid-template-rows: auto 1fr;
        gap: var(--layout-card-gap);
        align-items: stretch;
    }

    @media (max-width: 1023px) {
        .solutions-media-insights-cards {
            grid-template-columns: 1fr;
            grid-template-rows: none;
            row-gap: var(--space-9);
        }
    }

    /* Pass-through wrapper for the subgrid rows defined above — must also
       be a subgridded grid item itself, or the row tracks don't reach
       SolutionsInsightCard's own subgrid two levels down. */
    .card-fly-in {
        display: grid;
        grid-template-rows: subgrid;
        grid-row: span 2;
        opacity: 0;
        transform: translateY(1.625rem);
        transition:
            opacity var(--motion-duration-card) cubic-bezier(0.22, 1, 0.36, 1),
            transform var(--motion-duration-card) cubic-bezier(0.22, 1, 0.36, 1);
    }

    /* Restated locally: the global .is-visible in design-system.css has the same
       specificity as this component's scoped base rule above, so on a tie the
       component's `opacity: 0` wins on source order and the element never
       reveals. */
    .card-fly-in.is-visible {
        opacity: 1;
        transform: translateY(0);
    }

    @media (max-width: 1023px) {
        .card-fly-in {
            display: block;
        }
    }
</style>

<script>
    // Cards are a wrapping grid — a single row at desktop, so they all cross
    // the viewport edge together at that breakpoint. A per-card observer
    // would fire them all at once there, losing the stagger; trigger off
    // the grid itself instead and stagger the children.
    document
        .querySelectorAll<HTMLElement>('.solutions-media-insights-section')
        .forEach((section) => {
            const heading = section.querySelector<HTMLElement>('.heading-fly-in');
            if (heading) {
                const headingObserver = new IntersectionObserver(
                    ([entry]) => {
                        if (entry.isIntersecting) {
                            heading.classList.add('is-visible');
                            headingObserver.disconnect();
                        }
                    },
                    { threshold: 0.15 }
                );
                headingObserver.observe(heading);
            }

            const cardsRow = section.querySelector<HTMLElement>('.solutions-media-insights-cards');
            const cards = section.querySelectorAll<HTMLElement>('.card-fly-in');
            if (cardsRow && cards.length) {
                const cardObserver = new IntersectionObserver(
                    ([entry]) => {
                        if (entry.isIntersecting) {
                            cards.forEach((card, i) => {
                                setTimeout(() => card.classList.add('is-visible'), i * 140);
                            });
                            cardObserver.disconnect();
                        }
                    },
                    { threshold: 0.4 }
                );
                cardObserver.observe(cardsRow);
            }
        });
</script>
