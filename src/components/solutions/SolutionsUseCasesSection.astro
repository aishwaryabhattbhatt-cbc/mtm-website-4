---
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { t } from '../../lib/i18n/t';
import CarouselNavArrows from '../shared/CarouselNavArrows.astro';

interface Props {
    locale: Locale;
    copy: CMSDictionary;
}

const { locale, copy } = Astro.props as Props;
const base = import.meta.env.BASE_URL;

const vars1 = t(
    copy,
    'usecase_1_variables',
    locale,
    'Younger and Older Boomers,TV hours,Channel viewership,Income,Seeing ads on streaming services'
)
    .split(',')
    .map((v) => v.trim())
    .filter(Boolean);

const vars2 = t(
    copy,
    'usecase_2_variables',
    locale,
    'Podcast listenership,podcast hours,streaming audio platforms,social media usage'
)
    .split(',')
    .map((v) => v.trim())
    .filter(Boolean);
---

<section class="solutions-usecases-section">
    <div class="solutions-usecases-header heading-fly-in">
        <div class="solutions-usecases-headline">
            <h2>
                {t(copy, 'usecases_title', locale, 'What you can do with MTM')}
            </h2>
            <p class="text-body-p1 solutions-usecases-description">
                {
                    t(
                        copy,
                        'usecases_description',
                        locale,
                        'See how Canadian media organizations use MTM to get ahead of audience shifts and how you can apply the same data to your own strategy.'
                    )
                }
            </p>
        </div>
        <CarouselNavArrows
            scrollTargetSelector="#solutionsUsecasesCarousel"
            ariaLabel="Case study navigation"
            prevLabel="Previous case study"
            nextLabel="Next case study"
        />
    </div>

    <div
        class="solutions-usecases-carousel"
        id="solutionsUsecasesCarousel"
        role="region"
        aria-label="Case studies"
    >
        <!-- Card 1 -->
        <article class="solutions-usecase-card card-fly-in">
            <div class="solutions-usecase-card__left">
                <span class="text-body-p0 solutions-usecase-eyebrow">Use Case</span>
                <p class="text-body-p1 solutions-usecase-desc">
                    {
                        t(
                            copy,
                            'usecase_1_description',
                            locale,
                            'Understanding the most effective way to promote a new TV show to affluent Baby Boomers.'
                        )
                    }
                </p>
                <div class="solutions-usecase-variables">
                    <div class="solutions-usecase-pills">
                        {
                            vars1.map((v) => (
                                <span class="text-body-p2 solutions-usecase-pill">{v}</span>
                            ))
                        }
                    </div>
                </div>
                <div class="solutions-usecase-cta">
                    <p class="text-body-p0 solutions-usecase-cta-title">
                        {t(copy, 'usecase_1_cta_title', locale, 'How to leverage this')}
                    </p>
                    <p class="text-body-p1 solutions-usecase-cta-desc">
                        {
                            t(
                                copy,
                                'usecase_1_cta',
                                locale,
                                'Read our dedicated Baby Boomers report to learn where they are concentrating their current viewing, which are most exposed to advertising and whether traditional TV remains king for this audience.'
                            )
                        }
                    </p>
                </div>
            </div>
            <div class="solutions-usecase-card__right">
                <div class="solutions-usecase-image">
                    <img
                        src={`${base}images/solutions/media/use-case-1.png`}
                        alt=""
                        class="solutions-usecase-image-src"
                        loading="lazy"
                        decoding="async"
                    />
                </div>
            </div>
        </article>

        <!-- Card 2 -->
        <article class="solutions-usecase-card card-fly-in">
            <div class="solutions-usecase-card__left">
                <span class="text-body-p0 solutions-usecase-eyebrow">Use Case</span>
                <p class="text-body-p1 solutions-usecase-desc">
                    {
                        t(
                            copy,
                            'usecase_2_description',
                            locale,
                            'Gaining maximum exposure for a podcast aimed at men aged 18 to 35'
                        )
                    }
                </p>
                <div class="solutions-usecase-variables">
                    <div class="solutions-usecase-pills">
                        {
                            vars2.map((v) => (
                                <span class="text-body-p2 solutions-usecase-pill">{v}</span>
                            ))
                        }
                    </div>
                </div>
                <div class="solutions-usecase-cta">
                    <p class="text-body-p0 solutions-usecase-cta-title">
                        {t(copy, 'usecase_2_cta_title', locale, 'How to leverage this')}
                    </p>
                    <p class="text-body-p1 solutions-usecase-cta-desc">
                        {
                            t(
                                copy,
                                'usecase_2_cta',
                                locale,
                                'Use our tools to take a deep dive on the platforms, time spent and online communities where this group is most active.'
                            )
                        }
                    </p>
                </div>
            </div>
            <div class="solutions-usecase-card__right">
                <div class="solutions-usecase-image">
                    <img
                        src={`${base}images/solutions/media/use-case-2.png`}
                        alt=""
                        class="solutions-usecase-image-src"
                        loading="lazy"
                        decoding="async"
                    />
                </div>
            </div>
        </article>
    </div>
</section>

<style>
    .solutions-usecases-section {
        width: 100%;
        background: var(--surface-white);
        padding: var(--section-pad-block) var(--content-margin-inline) 0;
        display: flex;
        flex-direction: column;
        gap: var(--section-header-gap);
    }

    /* Header */
    .solutions-usecases-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: var(--space-8);
    }

    .solutions-usecases-headline {
        display: flex;
        flex-direction: column;
        gap: var(--title-desc-gap);
        max-width: 54rem;
    }

    .solutions-usecases-headline h2 {
        margin: 0;
    }

    .solutions-usecases-description {
        margin: 0;
        color: var(--text-secondary);
    }

    /* Carousel */
    .solutions-usecases-carousel {
        display: flex;
        gap: var(--layout-card-gap);
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        scroll-padding-inline-start: var(--content-margin-inline);
        scrollbar-width: none;
        margin-inline: calc(-1 * var(--content-margin-inline));
        /* top space-3 — scroll clearance for card hover shadow, not a header/section gap */
        padding: var(--space-3) var(--content-margin-inline) var(--section-pad-block);
    }

    .solutions-usecases-carousel::-webkit-scrollbar {
        display: none;
    }

    /* Card */
    .solutions-usecase-card {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: var(--space-3);
        padding: var(--card-pad-thin);
        background: var(--surface-white);
        border-radius: var(--radius-m);
        box-shadow: var(--shadow-card);
        scroll-snap-align: start;
        flex-shrink: 0;
        width: calc((100vw - 2 * var(--content-margin-inline)) * 0.833);
    }

    /* Left */
    .solutions-usecase-card__left {
        display: flex;
        flex-direction: column;
        gap: var(--space-6);
        padding: var(--space-5);
    }

    .solutions-usecase-eyebrow {
        color: var(--text-primary);
        margin: 0;
    }

    .solutions-usecase-desc {
        margin: 0;
        color: var(--text-secondary);
    }

    .solutions-usecase-variables {
        display: flex;
        flex-direction: column;
        gap: var(--card-stack-gap);
        margin-bottom: var(--space-8);
    }

    .solutions-usecase-card__left .solutions-usecase-cta {
        margin-top: auto;
    }

    .solutions-usecase-variables-label {
        color: var(--text-disabled);
    }

    .solutions-usecase-pills {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2);
    }

    .solutions-usecase-pill {
        background: var(--surface-blue);
        border-radius: var(--radius-full);
        padding: var(--space-1) var(--space-5);
        color: var(--text-primary);
    }

    /* Right */
    .solutions-usecase-card__right {
        display: flex;
        flex-direction: column;
        padding: var(--space-5);
    }

    .solutions-usecase-image {
        border-radius: calc(var(--radius-m) - var(--space-1));
        background: var(--surface-blue);
        flex: 1;
        overflow: hidden;
    }

    .solutions-usecase-image-src {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .solutions-usecase-cta {
        background: #e8f3fd;
        border-radius: calc(var(--radius-m) - var(--space-1));
        padding: var(--space-5);
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
    }

    .solutions-usecase-cta-title {
        margin: 0;
        color: var(--text-primary);
    }

    .solutions-usecase-cta-desc {
        margin: 0;
        color: var(--text-secondary);
    }

    /* Tablet */
    @media (max-width: 1023px) {
        .solutions-usecases-section {
            padding-block: var(--space-11);
        }

        .solutions-usecase-card {
            grid-template-columns: 2fr 1fr;
            width: calc(100vw - 2 * var(--content-margin-inline));
        }
    }

    /* Mobile */
    @media (max-width: 767px) {
        .solutions-usecases-section {
            padding-block: var(--section-pad-block);
        }

        .solutions-usecases-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .solutions-usecase-card {
            grid-template-columns: 1fr;
            width: calc(100vw - 2 * var(--content-margin-inline));
        }

        .solutions-usecase-card__right {
            order: -1;
        }

        .solutions-usecase-image {
            min-height: 14rem;
        }
    }

    .heading-fly-in {
        opacity: 0;
        transform: translateY(1.625rem);
        transition:
            opacity var(--motion-duration-heading) ease,
            transform var(--motion-duration-heading) var(--motion-ease-standard);
    }

    .heading-fly-in.is-visible {
        opacity: 1;
        transform: translateY(0);
    }

    .card-fly-in {
        opacity: 0;
        transform: translateY(1.625rem);
        transition:
            opacity var(--motion-duration-card) cubic-bezier(0.22, 1, 0.36, 1),
            transform var(--motion-duration-card) cubic-bezier(0.22, 1, 0.36, 1);
    }

    .card-fly-in.is-visible {
        opacity: 1;
        transform: translateY(0);
    }
</style>

<script>
    document.querySelectorAll<HTMLElement>('.solutions-usecases-section').forEach((section) => {
        const heading = section.querySelector<HTMLElement>('.heading-fly-in');
        if (heading) {
            const headingObserver = new IntersectionObserver(
                ([entry]) => {
                    if (entry.isIntersecting) {
                        heading.classList.add('is-visible');
                        headingObserver.disconnect();
                    }
                },
                { threshold: 0.15 }
            );
            headingObserver.observe(heading);
        }

        // Carousel cards sit at the same vertical scroll position, so
        // trigger off the row itself and keep the stagger. Threshold raised
        // above the 0.2 default — these cards are unusually wide (~83% of
        // viewport), so 0.2 of their own area was satisfied almost as soon
        // as the row appeared.
        const cardsRow = section.querySelector<HTMLElement>('.solutions-usecases-carousel');
        const cards = section.querySelectorAll<HTMLElement>('.card-fly-in');
        if (cardsRow && cards.length) {
            const cardObserver = new IntersectionObserver(
                ([entry]) => {
                    if (entry.isIntersecting) {
                        cards.forEach((card, i) => {
                            setTimeout(() => card.classList.add('is-visible'), i * 140);
                        });
                        cardObserver.disconnect();
                    }
                },
                { threshold: 0.4 }
            );
            cardObserver.observe(cardsRow);
        }
    });
</script>
