---
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { t } from '../../lib/i18n/t';

interface Props {
    locale: Locale;
    copy: CMSDictionary;
}

const { locale, copy } = Astro.props as Props;
const base = import.meta.env.BASE_URL;

const vars1 = t(
    copy,
    'usecase_1_variables',
    locale,
    'Younger and Older Boomers,TV hours,Channel viewership,Income,Seeing ads on streaming services'
)
    .split(',')
    .map((v) => v.trim())
    .filter(Boolean);

const vars2 = t(
    copy,
    'usecase_2_variables',
    locale,
    'Podcast listenership,podcast hours,streaming audio platforms,social media usage'
)
    .split(',')
    .map((v) => v.trim())
    .filter(Boolean);
---

<section class="solutions-usecases-section">
    <div class="solutions-usecases-header">
        <div class="solutions-usecases-headline">
            <h2>
                {t(copy, 'usecases_title', locale, 'What you can do with MTM')}
            </h2>
            <p class="text-body-p1 solutions-usecases-description">
                {
                    t(
                        copy,
                        'usecases_description',
                        locale,
                        'See how Canadian media organizations use MTM to get ahead of audience shifts and how you can apply the same data to your own strategy.'
                    )
                }
            </p>
        </div>
        <div class="solutions-usecases-nav" aria-label="Case study navigation">
            <button
                class="solutions-usecases-nav-btn"
                data-usecase-prev
                aria-label="Previous case study"
                disabled
            >
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                    <path
                        d="M11 13.5L6.5 9L11 4.5"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"></path>
                </svg>
            </button>
            <button
                class="solutions-usecases-nav-btn"
                data-usecase-next
                aria-label="Next case study"
            >
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                    <path
                        d="M7 4.5L11.5 9L7 13.5"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"></path>
                </svg>
            </button>
        </div>
    </div>

    <div class="solutions-usecases-carousel" role="region" aria-label="Case studies">
        <!-- Card 1 -->
        <article class="solutions-usecase-card">
            <div class="solutions-usecase-card__left">
                <span class="text-body-p0 solutions-usecase-eyebrow">Use Case</span>
                <p class="text-body-p1 solutions-usecase-desc">
                    {
                        t(
                            copy,
                            'usecase_1_description',
                            locale,
                            'Understanding the most effective way to promote a new TV show to affluent Baby Boomers.'
                        )
                    }
                </p>
                <div class="solutions-usecase-variables">
                    <div class="solutions-usecase-pills">
                        {
                            vars1.map((v) => (
                                <span class="text-body-p2 solutions-usecase-pill">{v}</span>
                            ))
                        }
                    </div>
                </div>
                <div class="solutions-usecase-cta">
                    <p class="text-body-p0 solutions-usecase-cta-title">
                        {t(copy, 'usecase_1_cta_title', locale, 'How to leverage this')}
                    </p>
                    <p class="text-body-p1 solutions-usecase-cta-desc">
                        {
                            t(
                                copy,
                                'usecase_1_cta',
                                locale,
                                'Read our dedicated Baby Boomers report to learn where they are concentrating their current viewing, which are most exposed to advertising and whether traditional TV remains king for this audience.'
                            )
                        }
                    </p>
                </div>
            </div>
            <div class="solutions-usecase-card__right">
                <div class="solutions-usecase-image">
                    <img
                        src={`${base}images/solutions/media/use-case-1.png`}
                        alt=""
                        class="solutions-usecase-image-src"
                        loading="lazy"
                        decoding="async"
                    />
                </div>
            </div>
        </article>

        <!-- Card 2 -->
        <article class="solutions-usecase-card">
            <div class="solutions-usecase-card__left">
                <span class="text-body-p0 solutions-usecase-eyebrow">Use Case</span>
                <p class="text-body-p1 solutions-usecase-desc">
                    {
                        t(
                            copy,
                            'usecase_2_description',
                            locale,
                            'Gaining maximum exposure for a podcast aimed at men aged 18 to 35'
                        )
                    }
                </p>
                <div class="solutions-usecase-variables">
                    <div class="solutions-usecase-pills">
                        {
                            vars2.map((v) => (
                                <span class="text-body-p2 solutions-usecase-pill">{v}</span>
                            ))
                        }
                    </div>
                </div>
                <div class="solutions-usecase-cta">
                    <p class="text-body-p0 solutions-usecase-cta-title">
                        {t(copy, 'usecase_2_cta_title', locale, 'How to leverage this')}
                    </p>
                    <p class="text-body-p1 solutions-usecase-cta-desc">
                        {
                            t(
                                copy,
                                'usecase_2_cta',
                                locale,
                                'Use our tools to take a deep dive on the platforms, time spent and online communities where this group is most active.'
                            )
                        }
                    </p>
                </div>
            </div>
            <div class="solutions-usecase-card__right">
                <div class="solutions-usecase-image">
                    <img
                        src={`${base}images/solutions/media/use-case-2.png`}
                        alt=""
                        class="solutions-usecase-image-src"
                        loading="lazy"
                        decoding="async"
                    />
                </div>
            </div>
        </article>
    </div>
</section>

<style>
    .solutions-usecases-section {
        width: 100%;
        background: var(--surface-white);
        padding: var(--space-12) var(--content-margin-inline) 0;
        display: flex;
        flex-direction: column;
        gap: var(--space-8);
    }

    /* Header */
    .solutions-usecases-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: var(--space-8);
    }

    .solutions-usecases-headline {
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
        max-width: 54rem;
    }

    .solutions-usecases-headline h2 {
        margin: 0;
    }

    .solutions-usecases-description {
        margin: 0;
        color: var(--text-secondary);
    }

    /* Nav buttons */
    .solutions-usecases-nav {
        display: flex;
        gap: var(--space-3);
        flex-shrink: 0;
    }

    .solutions-usecases-nav-btn {
        width: 2.75rem;
        height: 2.75rem;
        border-radius: var(--radius-full);
        border: var(--stroke-1) solid var(--border-primary);
        background: var(--surface-white);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        color: var(--text-primary);
        transition:
            background 0.15s,
            color 0.15s,
            border-color 0.15s,
            opacity 0.15s;
    }

    .solutions-usecases-nav-btn:disabled {
        opacity: 0.35;
        cursor: default;
    }

    .solutions-usecases-nav-btn--filled {
        background: var(--text-primary);
        color: var(--text-white);
        border-color: var(--text-primary);
    }

    .solutions-usecases-nav-btn--filled:disabled {
        background: var(--text-primary);
        color: var(--text-white);
    }

    /* Carousel */
    .solutions-usecases-carousel {
        display: flex;
        gap: var(--layout-card-gap);
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        scroll-padding-inline-start: var(--content-margin-inline);
        scrollbar-width: none;
        margin-inline: calc(-1 * var(--content-margin-inline));
        padding: var(--space-3) var(--content-margin-inline) var(--space-12);
    }

    .solutions-usecases-carousel::-webkit-scrollbar {
        display: none;
    }

    /* Card */
    .solutions-usecase-card {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: var(--space-3);
        padding: var(--space-3);
        background: var(--surface-white);
        border-radius: var(--radius-m);
        box-shadow: var(--shadow-card);
        scroll-snap-align: start;
        flex-shrink: 0;
        width: calc((100vw - 2 * var(--content-margin-inline)) * 0.833);
    }

    /* Left */
    .solutions-usecase-card__left {
        display: flex;
        flex-direction: column;
        gap: var(--space-6);
        padding: var(--space-5);
    }

    .solutions-usecase-eyebrow {
        color: var(--text-primary);
        margin: 0;
    }

    .solutions-usecase-desc {
        margin: 0;
        color: var(--text-secondary);
    }

    .solutions-usecase-variables {
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
        margin-bottom: var(--space-8);
    }

    .solutions-usecase-card__left .solutions-usecase-cta {
        margin-top: auto;
    }

    .solutions-usecase-variables-label {
        color: var(--text-disabled);
    }

    .solutions-usecase-pills {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2);
    }

    .solutions-usecase-pill {
        background: var(--surface-blue);
        border-radius: var(--radius-full);
        padding: var(--space-1) var(--space-5);
        color: var(--text-primary);
    }

    /* Right */
    .solutions-usecase-card__right {
        display: flex;
        flex-direction: column;
    }

    .solutions-usecase-image {
        border-radius: calc(var(--radius-m) - var(--space-1));
        background: var(--surface-blue);
        flex: 1;
        overflow: hidden;
    }

    .solutions-usecase-image-src {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .solutions-usecase-cta {
        background: #e8f3fd;
        border-radius: calc(var(--radius-m) - var(--space-1));
        padding: var(--space-5);
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
    }

    .solutions-usecase-cta-title {
        margin: 0;
        color: var(--text-primary);
    }

    .solutions-usecase-cta-desc {
        margin: 0;
        color: var(--text-secondary);
    }

    /* Tablet */
    @media (max-width: 1023px) {
        .solutions-usecases-section {
            padding-block: var(--space-11);
        }

        .solutions-usecase-card {
            grid-template-columns: 2fr 1fr;
            width: calc(100vw - 2 * var(--content-margin-inline));
        }
    }

    /* Mobile */
    @media (max-width: 767px) {
        .solutions-usecases-section {
            padding-block: var(--space-10);
        }

        .solutions-usecases-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .solutions-usecase-card {
            grid-template-columns: 1fr;
            width: calc(100vw - 2 * var(--content-margin-inline));
        }

        .solutions-usecase-card__right {
            order: -1;
        }

        .solutions-usecase-image {
            min-height: 14rem;
        }
    }
</style>

<script>
    document.querySelectorAll<HTMLElement>('.solutions-usecases-section').forEach((section) => {
        const carousel = section.querySelector<HTMLElement>('.solutions-usecases-carousel');
        const prevBtn = section.querySelector<HTMLButtonElement>('[data-usecase-prev]');
        const nextBtn = section.querySelector<HTMLButtonElement>('[data-usecase-next]');
        if (!carousel || !prevBtn || !nextBtn) return;

        function getCardWidth() {
            const card = carousel!.querySelector<HTMLElement>('.solutions-usecase-card');
            if (!card) return 0;
            const gap = parseFloat(getComputedStyle(carousel!).columnGap) || 0;
            return card.offsetWidth + gap;
        }

        function updateButtons() {
            const atStart = carousel!.scrollLeft <= 4;
            const atEnd = carousel!.scrollLeft >= carousel!.scrollWidth - carousel!.clientWidth - 4;
            prevBtn!.disabled = atStart;
            nextBtn!.disabled = atEnd;
        }

        function setFilled(btn: HTMLButtonElement) {
            prevBtn!.classList.remove('solutions-usecases-nav-btn--filled');
            nextBtn!.classList.remove('solutions-usecases-nav-btn--filled');
            btn.classList.add('solutions-usecases-nav-btn--filled');
        }

        prevBtn.addEventListener('click', () => {
            carousel.scrollBy({ left: -getCardWidth(), behavior: 'smooth' });
            setFilled(prevBtn!);
        });

        nextBtn.addEventListener('click', () => {
            carousel.scrollBy({ left: getCardWidth(), behavior: 'smooth' });
            setFilled(nextBtn!);
        });

        carousel.addEventListener('scroll', updateButtons, { passive: true });
        updateButtons();
    });
</script>
