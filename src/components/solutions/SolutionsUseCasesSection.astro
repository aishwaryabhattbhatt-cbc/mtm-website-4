---
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { t } from '../../lib/i18n/t';
import CarouselNavArrows from '../shared/CarouselNavArrows.astro';

const base = import.meta.env.BASE_URL;

interface Props {
    locale: Locale;
    copy: CMSDictionary;
    useCase1ImageSrc: string;
    useCase2ImageSrc: string;
    useCase1Icons?: string[];
    useCase2Icons?: string[];
}

const {
    locale,
    copy,
    useCase1ImageSrc,
    useCase2ImageSrc,
    useCase1Icons = [],
    useCase2Icons = [],
} = Astro.props as Props;

const vars1 = t(
    copy,
    'usecase_1_variables',
    locale,
    'Younger and Older Boomers,TV hours,Channel viewership,Income,Seeing ads on streaming services'
)
    .split(',')
    .map((v) => v.trim())
    .filter(Boolean);

const vars2 = t(
    copy,
    'usecase_2_variables',
    locale,
    'Podcast listenership,podcast hours,streaming audio platforms,social media usage'
)
    .split(',')
    .map((v) => v.trim())
    .filter(Boolean);

/* Same rounded-square icon panel as SolutionsHeroSection's badges. */
const panelSvg = `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 91 91'><defs><radialGradient id='g' cx='50%' cy='42%' r='78%'><stop offset='0%' stop-color='#ffffff'/><stop offset='60%' stop-color='#fdfeff'/><stop offset='100%' stop-color='#f5f8fc'/></radialGradient></defs><rect x='4' y='4' width='83' height='83' rx='10' fill='url(#g)' stroke='#eef2f8' stroke-width='1'/></svg>`;
const panelUrl = `url("data:image/svg+xml,${encodeURIComponent(panelSvg)}")`;
---

<section class="solutions-usecases-section">
    <div class="solutions-usecases-header heading-fly-in">
        <div class="solutions-usecases-headline">
            <h2>
                {t(copy, 'usecases_title', locale, 'What you can do with MTM')}
            </h2>
            <p class="text-body-p1 solutions-usecases-description">
                {
                    t(
                        copy,
                        'usecases_description',
                        locale,
                        'See how Canadian media organizations use MTM to get ahead of audience shifts and how you can apply the same data to your own strategy.'
                    )
                }
            </p>
        </div>
        <CarouselNavArrows
            scrollTargetSelector="#solutionsUsecasesCarousel"
            ariaLabel="Case study navigation"
            prevLabel="Previous case study"
            nextLabel="Next case study"
        />
    </div>

    <div
        class="solutions-usecases-carousel"
        id="solutionsUsecasesCarousel"
        role="region"
        aria-label="Case studies"
    >
        <!-- Card 1 -->
        <article class="solutions-usecase-card card-fly-in">
            <div class="solutions-usecase-card__left">
                <div class="solutions-usecase-heading">
                    <span
                        class="text-body-p0 solutions-usecase-eyebrow"
                        data-copy-key="usecases_card_title"
                    >
                        {t(copy, 'usecases_card_title', locale, 'Use Case')}
                    </span>
                    <p class="text-body-p1 solutions-usecase-desc">
                        {
                            t(
                                copy,
                                'usecase_1_description',
                                locale,
                                'Understanding the most effective way to promote a new TV show to affluent Baby Boomers.'
                            )
                        }
                    </p>
                </div>
                <div class="solutions-usecase-variables">
                    <div class="solutions-usecase-pills">
                        {
                            vars1.map((v) => (
                                <span class="text-body-p2 solutions-usecase-pill">{v}</span>
                            ))
                        }
                    </div>
                </div>
                <div class="solutions-usecase-cta">
                    <p
                        class="text-body-p0 solutions-usecase-cta-title"
                        data-copy-key="leverage_title"
                    >
                        {t(copy, 'leverage_title', locale, 'How to leverage this')}
                    </p>
                    <p class="text-body-p1 solutions-usecase-cta-desc">
                        {
                            t(
                                copy,
                                'usecase_1_cta',
                                locale,
                                'Read our dedicated Baby Boomers report to learn where they are concentrating their current viewing, which are most exposed to advertising and whether traditional TV remains king for this audience.'
                            )
                        }
                    </p>
                </div>
            </div>
            <div class="solutions-usecase-card__right">
                <div class="solutions-usecase-image">
                    <img
                        src={useCase1ImageSrc}
                        alt=""
                        class="solutions-usecase-image-src"
                        loading="lazy"
                        decoding="async"
                    />
                </div>
                <div class="solutions-usecase-badges" aria-hidden="true">
                    {
                        useCase1Icons.map((icon) => (
                            <span class="solutions-usecase-badge">
                                {icon && (
                                    <img
                                        src={`${base}${icon}`}
                                        alt=""
                                        class="solutions-usecase-badge-icon icon-xl"
                                    />
                                )}
                            </span>
                        ))
                    }
                </div>
            </div>
        </article>

        <!-- Card 2 -->
        <article class="solutions-usecase-card card-fly-in">
            <div class="solutions-usecase-card__left">
                <div class="solutions-usecase-heading">
                    <span
                        class="text-body-p0 solutions-usecase-eyebrow"
                        data-copy-key="usecases_card_title"
                    >
                        {t(copy, 'usecases_card_title', locale, 'Use Case')}
                    </span>
                    <p class="text-body-p1 solutions-usecase-desc">
                        {
                            t(
                                copy,
                                'usecase_2_description',
                                locale,
                                'Gaining maximum exposure for a podcast aimed at men aged 18 to 35'
                            )
                        }
                    </p>
                </div>
                <div class="solutions-usecase-variables">
                    <div class="solutions-usecase-pills">
                        {
                            vars2.map((v) => (
                                <span class="text-body-p2 solutions-usecase-pill">{v}</span>
                            ))
                        }
                    </div>
                </div>
                <div class="solutions-usecase-cta">
                    <p
                        class="text-body-p0 solutions-usecase-cta-title"
                        data-copy-key="leverage_title"
                    >
                        {t(copy, 'leverage_title', locale, 'How to leverage this')}
                    </p>
                    <p class="text-body-p1 solutions-usecase-cta-desc">
                        {
                            t(
                                copy,
                                'usecase_2_cta',
                                locale,
                                'Use our tools to take a deep dive on the platforms, time spent and online communities where this group is most active.'
                            )
                        }
                    </p>
                </div>
            </div>
            <div class="solutions-usecase-card__right">
                <div class="solutions-usecase-image">
                    <img
                        src={useCase2ImageSrc}
                        alt=""
                        class="solutions-usecase-image-src"
                        loading="lazy"
                        decoding="async"
                    />
                </div>
                <div class="solutions-usecase-badges" aria-hidden="true">
                    {
                        useCase2Icons.map((icon) => (
                            <span class="solutions-usecase-badge">
                                {icon && (
                                    <img
                                        src={`${base}${icon}`}
                                        alt=""
                                        class="solutions-usecase-badge-icon icon-xl"
                                    />
                                )}
                            </span>
                        ))
                    }
                </div>
            </div>
        </article>
    </div>
</section>

<style define:vars={{ 'panel-url': panelUrl }}>
    .solutions-usecases-section {
        width: 100%;
        background: var(--surface-white);
        padding: var(--section-pad-block) var(--content-margin-inline) 0;
        display: flex;
        flex-direction: column;
        gap: var(--section-header-gap);
    }

    /* Header */
    .solutions-usecases-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: var(--space-8);
    }

    .solutions-usecases-headline {
        display: flex;
        flex-direction: column;
        gap: var(--title-desc-gap);
        max-width: 54rem;
    }

    .solutions-usecases-headline h2 {
        margin: 0;
    }

    .solutions-usecases-description {
        margin: 0;
        color: var(--text-secondary);
    }

    /* Carousel */
    .solutions-usecases-carousel {
        display: flex;
        gap: var(--layout-card-gap);
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        scroll-padding-inline-start: var(--content-margin-inline);
        scrollbar-width: none;
        margin-inline: calc(-1 * var(--content-margin-inline));
        /* top space-3 — scroll clearance for card hover shadow, not a header/section gap */
        padding: var(--space-3) var(--content-margin-inline) var(--section-pad-block);
    }

    .solutions-usecases-carousel::-webkit-scrollbar {
        display: none;
    }

    /* Card */
    .solutions-usecase-card {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: var(--card-pad);
        padding: var(--card-pad);
        background: var(--surface-white);
        border-radius: var(--radius-m);
        box-shadow: var(--shadow-card);
        scroll-snap-align: start;
        flex-shrink: 0;
        width: calc((100vw - 2 * var(--content-margin-inline)) * 0.833);
    }

    /* Left */
    .solutions-usecase-card__left {
        display: flex;
        flex-direction: column;
        gap: var(--space-6);
    }

    .solutions-usecase-heading {
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
    }

    .solutions-usecase-eyebrow {
        color: var(--text-primary);
        margin: 0;
    }

    .solutions-usecase-desc {
        margin: 0;
        color: var(--text-secondary);
    }

    .solutions-usecase-variables {
        display: flex;
        flex-direction: column;
        gap: var(--card-stack-gap);
        margin-bottom: var(--space-8);
    }

    .solutions-usecase-card__left .solutions-usecase-cta {
        margin-top: auto;
    }

    .solutions-usecase-variables-label {
        color: var(--text-disabled);
    }

    .solutions-usecase-pills {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2);
    }

    .solutions-usecase-pill {
        background: var(--surface-blue);
        border-radius: var(--radius-full);
        padding: var(--space-1) var(--space-5);
        color: var(--text-primary);
    }

    /* Right */
    .solutions-usecase-card__right {
        position: relative;
        display: flex;
        flex-direction: column;
    }

    .solutions-usecase-image {
        border-radius: calc(var(--radius-m) - var(--space-1));
        background: var(--surface-blue);
        flex: 1;
        overflow: hidden;
    }

    .solutions-usecase-image-src {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    /* Icon badges — stacked vertically, inset into the image's
       bottom-right corner with equal padding on both sides. */
    .solutions-usecase-badges {
        position: absolute;
        right: var(--space-4);
        bottom: var(--space-4);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--space-3);
        z-index: 1;
    }

    .solutions-usecase-badge {
        width: var(--icon-2xl);
        height: var(--icon-2xl);
        border-radius: var(--radius-xs);
        background-image: var(--panel-url);
        background-repeat: no-repeat;
        background-size: 100% 100%;
        box-shadow: var(--shadow-e2);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .solutions-usecase-cta {
        background: #e8f3fd;
        border-radius: calc(var(--radius-m) - var(--space-1));
        padding: var(--space-5);
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
    }

    .solutions-usecase-cta-title {
        margin: 0;
        color: var(--text-primary);
    }

    .solutions-usecase-cta-desc {
        margin: 0;
        color: var(--text-secondary);
    }

    /* 1:1 columns between mobile and the widest desktop breakpoint — wider
       than that, the left copy gets the extra 2fr:1fr room back. */
    @media (max-width: 1440px) {
        .solutions-usecase-card {
            grid-template-columns: 1fr 1fr;
        }
    }

    /* Tablet */
    @media (max-width: 1023px) {
        .solutions-usecases-section {
            padding-block: var(--space-11);
        }

        .solutions-usecase-card {
            width: calc(100vw - 2 * var(--content-margin-inline));
        }
    }

    /* Mobile */
    @media (max-width: 767px) {
        .solutions-usecases-section {
            padding-block: var(--section-pad-block);
        }

        .solutions-usecases-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .solutions-usecase-card {
            grid-template-columns: 1fr;
            width: calc(100vw - 2 * var(--content-margin-inline));
        }

        .solutions-usecase-card__right {
            order: -1;
        }

        .solutions-usecase-image {
            min-height: 14rem;
        }

        /* Same bottom-right corner inset as desktop, but stacked
           horizontally instead of vertically. */
        .solutions-usecase-badges {
            flex-direction: row;
        }
    }

    .heading-fly-in {
        opacity: 0;
        transform: translateY(1.625rem);
        transition:
            opacity var(--motion-duration-heading) ease,
            transform var(--motion-duration-heading) var(--motion-ease-standard);
    }

    .heading-fly-in.is-visible {
        opacity: 1;
        transform: translateY(0);
    }

    .card-fly-in {
        opacity: 0;
        transform: translateY(1.625rem);
        transition:
            opacity var(--motion-duration-card) cubic-bezier(0.22, 1, 0.36, 1),
            transform var(--motion-duration-card) cubic-bezier(0.22, 1, 0.36, 1);
    }

    .card-fly-in.is-visible {
        opacity: 1;
        transform: translateY(0);
    }

    /* Badges pop in one after another once their card is visible — DOM order
       already reads top-to-bottom on desktop's column and left-to-right on
       mobile's row, so a single index-based stagger covers both layouts. */
    .solutions-usecase-badge {
        opacity: 0;
        transform: scale(0.8);
        transition:
            opacity var(--motion-duration-heading) cubic-bezier(0.22, 1, 0.36, 1),
            transform var(--motion-duration-heading) cubic-bezier(0.22, 1, 0.36, 1);
    }

    .solutions-usecase-badge.is-visible {
        opacity: 1;
        transform: scale(1);
    }
</style>

<script>
    document.querySelectorAll<HTMLElement>('.solutions-usecases-section').forEach((section) => {
        const heading = section.querySelector<HTMLElement>('.heading-fly-in');
        if (heading) {
            const headingObserver = new IntersectionObserver(
                ([entry]) => {
                    if (entry.isIntersecting) {
                        heading.classList.add('is-visible');
                        headingObserver.disconnect();
                    }
                },
                { threshold: 0.15 }
            );
            headingObserver.observe(heading);
        }

        // Carousel cards sit at the same vertical scroll position, so
        // trigger off the row itself and keep the stagger. Threshold raised
        // above the 0.2 default — these cards are unusually wide (~83% of
        // viewport), so 0.2 of their own area was satisfied almost as soon
        // as the row appeared.
        const cardsRow = section.querySelector<HTMLElement>('.solutions-usecases-carousel');
        const cards = section.querySelectorAll<HTMLElement>('.card-fly-in');
        if (cardsRow && cards.length) {
            const cardObserver = new IntersectionObserver(
                ([entry]) => {
                    if (entry.isIntersecting) {
                        cards.forEach((card, i) => {
                            setTimeout(() => {
                                card.classList.add('is-visible');
                                // Wait for the card's own entrance transition to
                                // finish (matches --motion-duration-card) before
                                // starting the badge stagger.
                                setTimeout(() => {
                                    const badges = card.querySelectorAll<HTMLElement>(
                                        '.solutions-usecase-badge'
                                    );
                                    badges.forEach((badge, j) => {
                                        setTimeout(
                                            () => badge.classList.add('is-visible'),
                                            j * 220
                                        );
                                    });
                                }, 650);
                            }, i * 140);
                        });
                        cardObserver.disconnect();
                    }
                },
                { threshold: 0.4 }
            );
            cardObserver.observe(cardsRow);
        }
    });
</script>
