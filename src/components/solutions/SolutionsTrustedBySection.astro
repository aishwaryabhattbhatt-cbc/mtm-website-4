---
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { t } from '../../lib/i18n/t';

interface LogoItem {
    src: string;
    alt: string;
}

interface Props {
    locale: Locale;
    copy: CMSDictionary;
    logos?: LogoItem[];
    logoSets?: LogoItem[][];
    rotationIntervalMs?: number;
    topPadding?: boolean;
    logoHeight?: string;
    desktopStatic?: boolean;
}

const {
    locale,
    copy,
    logos,
    logoSets,
    rotationIntervalMs = 7000,
    topPadding = false,
    logoHeight,
    desktopStatic = false,
} = Astro.props as Props;

const sets: LogoItem[][] = logoSets && logoSets.length > 0 ? logoSets : [logos ?? []];
const isMulti = sets.length > 1;
---

<section
    class:list={[
        'solutions-trusted-by-section',
        topPadding && 'solutions-trusted-by-section--top-padding',
    ]}
    style={logoHeight ? `--trusted-by-logo-height: ${logoHeight}` : undefined}
    aria-label={t(copy, 'trusted_by_label', locale, 'Trusted by')}
>
    <p class="text-label-regular solutions-trusted-by-label" data-copy-key="trusted_by_label">
        {t(copy, 'trusted_by_label', locale, 'Trusted by')}
    </p>

    <div
        class:list={[
            'solutions-trusted-by-strip',
            desktopStatic && 'solutions-trusted-by-strip--desktop-static',
        ]}
        data-trusted-by-rotator={isMulti ? 'true' : undefined}
        data-interval={isMulti ? rotationIntervalMs : undefined}
    >
        {
            sets.map((setLogos, i) => (
                <div
                    class="solutions-trusted-by-marquee"
                    data-active={i === 0 ? 'true' : 'false'}
                    aria-hidden={i === 0 ? 'false' : 'true'}
                >
                    <div class="solutions-trusted-by-track">
                        <div class="solutions-trusted-by-set">
                            {setLogos.map((logo) => (
                                <div class="solutions-trusted-by-logo-item">
                                    <img
                                        src={logo.src}
                                        alt={logo.alt}
                                        loading="lazy"
                                        decoding="async"
                                    />
                                </div>
                            ))}
                        </div>
                        <div class="solutions-trusted-by-set" aria-hidden="true">
                            {setLogos.map((logo) => (
                                <div class="solutions-trusted-by-logo-item" aria-hidden="true">
                                    <img src={logo.src} alt="" loading="lazy" decoding="async" />
                                </div>
                            ))}
                        </div>
                    </div>
                </div>
            ))
        }
    </div>
</section>

<style>
    .solutions-trusted-by-section {
        /* Logo-strip section — padding intentionally shallow, not --section-header-gap/--card-pad */
        width: 100%;
        background: var(--surface-blue);
        padding: 0 var(--content-margin-inline) var(--space-8);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--space-5);
    }

    .solutions-trusted-by-section--top-padding {
        padding-top: var(--section-pad-block);
    }

    .solutions-trusted-by-label {
        margin: 0;
        color: var(--text-secondary);
    }

    .solutions-trusted-by-strip {
        width: 100%;
        background: color-mix(in srgb, var(--surface-white) 60%, transparent);
        border-radius: var(--layout-card-radius);
        /* Logo-strip padding intentionally shallow, not --card-pad */
        padding: var(--space-6) 0;
        min-height: 12rem;
        overflow: hidden;
        display: grid;
        align-items: center;
    }

    .solutions-trusted-by-marquee {
        grid-area: 1 / 1;
        width: 100%;
        display: flex;
        align-items: center;
        opacity: 1;
    }

    [data-trusted-by-rotator] .solutions-trusted-by-marquee {
        opacity: 0;
        pointer-events: none;
        transition: opacity 600ms ease;
    }

    [data-trusted-by-rotator] .solutions-trusted-by-marquee[data-active='true'] {
        opacity: 1;
        pointer-events: auto;
    }

    [data-trusted-by-rotator]
        .solutions-trusted-by-marquee:not([data-active='true'])
        .solutions-trusted-by-track {
        animation-play-state: paused;
    }

    .solutions-trusted-by-track {
        display: flex;
        align-items: center;
        will-change: transform;
        animation: trusted-by-scroll 70s linear infinite;
    }

    .solutions-trusted-by-set {
        display: flex;
        align-items: center;
        /* Fluid between the mobile floor (--space-6, at a 375px viewport) and
           the desktop ceiling (--space-13, at a 1440px viewport) so the gap
           scales continuously on smaller screens instead of jumping at the
           767px breakpoint. */
        gap: clamp(var(--space-6), -0.613rem + 9.014vw, var(--space-13));
        flex-shrink: 0;
        /* padding-right creates the inter-set gap that matches the intra-set gap */
        padding-right: clamp(var(--space-6), -0.613rem + 9.014vw, var(--space-13));
    }

    .solutions-trusted-by-logo-item {
        min-height: var(--space-10);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .solutions-trusted-by-logo-item img {
        /* Fixed height (not max-height) so every logo renders at the same
           height regardless of aspect ratio — width is free to vary, and the
           item container is content-width so wide wordmarks aren't squished
           back down to fit a fixed box. */
        height: var(--trusted-by-logo-height, var(--space-8));
        width: auto;
        display: block;
        object-fit: contain;
    }

    .solutions-trusted-by-strip:hover .solutions-trusted-by-track {
        animation-play-state: paused;
    }

    @media (prefers-reduced-motion: reduce) {
        .solutions-trusted-by-track {
            animation-play-state: paused;
        }
    }

    @keyframes trusted-by-scroll {
        from {
            transform: translateX(0);
        }
        to {
            transform: translateX(var(--scroll-distance, -50%));
        }
    }

    /* Desktop-static variant (e.g. industry page): show one centered, still
       row instead of the auto-scrolling marquee. Below 1024px it reverts to
       the normal scrolling behavior — tablet/mobile keep the marquee since a
       row this wide won't fit those viewports. */
    @media (min-width: 1024px) {
        .solutions-trusted-by-strip--desktop-static .solutions-trusted-by-track {
            animation: none;
            justify-content: center;
            width: 100%;
        }

        .solutions-trusted-by-strip--desktop-static .solutions-trusted-by-set[aria-hidden='true'] {
            display: none;
        }
    }

    @media (max-width: 767px) {
        .solutions-trusted-by-section {
            gap: var(--space-4);
            padding-bottom: var(--space-6);
        }

        .solutions-trusted-by-strip {
            padding: var(--space-5) 0;
        }
    }
</style>

<script>
    // Same px/s on every page/breakpoint, regardless of how many logos or how
    // wide the set is — calibrated to match the media page's original
    // 70s/4667px pace so that reference speed didn't visibly change.
    const TRUSTED_BY_PX_PER_SECOND = 66.67;

    function initMarquee(strip: HTMLElement) {
        strip.querySelectorAll<HTMLElement>('.solutions-trusted-by-track').forEach((track) => {
            const set = track.querySelector<HTMLElement>('.solutions-trusted-by-set');
            if (!set) return;

            function measure() {
                const width = set!.offsetWidth;
                track.style.setProperty('--scroll-distance', `-${width}px`);
                track.style.animationDuration = `${width / TRUSTED_BY_PX_PER_SECOND}s`;
            }

            measure();

            // Re-measure if viewport size changes (affects rem-based spacing tokens)
            const ro = new ResizeObserver(measure);
            ro.observe(set);
        });
    }

    function initRotator(strip: HTMLElement) {
        const marquees = Array.from(
            strip.querySelectorAll<HTMLElement>('.solutions-trusted-by-marquee')
        );
        if (marquees.length <= 1) return;

        const interval = Number(strip.dataset.interval) || 7000;
        let index = Math.max(
            0,
            marquees.findIndex((marquee) => marquee.dataset.active === 'true')
        );
        let timer: ReturnType<typeof setInterval> | undefined;

        function show(next: number) {
            marquees[index].dataset.active = 'false';
            marquees[index].setAttribute('aria-hidden', 'true');
            index = next;
            marquees[index].dataset.active = 'true';
            marquees[index].setAttribute('aria-hidden', 'false');
        }

        function start() {
            timer = setInterval(() => show((index + 1) % marquees.length), interval);
        }

        function stop() {
            if (timer) clearInterval(timer);
        }

        start();

        strip.addEventListener('mouseenter', stop);
        strip.addEventListener('mouseleave', start);
    }

    function initAll() {
        document.querySelectorAll<HTMLElement>('.solutions-trusted-by-strip').forEach((strip) => {
            initMarquee(strip);
            initRotator(strip);
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initAll);
    } else {
        initAll();
    }
</script>
