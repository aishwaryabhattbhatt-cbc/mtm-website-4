---
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { t } from '../../lib/i18n/t';
import Eyebrow from '../shared/Eyebrow.astro';
import { icons } from '../../lib/icons/registry';

interface Props {
    locale: Locale;
    copy: CMSDictionary;
}

const { locale, copy } = Astro.props as Props;
const base = import.meta.env.BASE_URL;

const getTag = (key: string): string => {
    const row = copy[key];
    if (!row) return '';
    return (locale === 'fr' ? row.fr : row.en) || row.en || '';
};

const tagIconMap: Record<string, string> = {
    'Trending Tool': icons.tool.trending,
    'MTM Reports': icons.tool.reports,
    'Census Tool': icons.tool.census,
    'Data Analysis Tool': icons.tool.dat,
    YourData: icons.tool.yourData,
};

const tagLinkMap: Record<string, string> = {
    'Trending Tool': `${base}${locale}/tools/analytic-tools/#trending-tool`,
    'MTM Reports': `${base}${locale}/insights/`,
    'Census Tool': `${base}${locale}/tools/census-tool/`,
    'Data Analysis Tool': `${base}${locale}/tools/analytic-tools/#data-analysis-tool`,
    YourData: `${base}${locale}/tools/analytic-tools/#yourdata`,
};

const getTagIcon = (tag: string) => `${base}${tagIconMap[tag] ?? icons.tool.trending}`;
const getTagLink = (tag: string) => tagLinkMap[tag] ?? `${base}${locale}/tools/analytic-tools/`;

const step1Tags = [getTag('step1_tag1'), getTag('step1_tag2')].filter(Boolean);
const step2Tags = [getTag('step2_tag1'), getTag('step2_tag2')].filter(Boolean);
const step3Tags = [getTag('step3_tag1'), getTag('step3_tag2')].filter(Boolean);
---

<section class="solutions-workflow-section">
    <div class="solutions-workflow-header">
        <h2>{t(copy, 'workflow_title', locale, 'How MTM fits the way you already work')}</h2>
        <p class="text-body-p1 solutions-workflow-description">
            {
                t(
                    copy,
                    'workflow_description',
                    locale,
                    "You don't open a research tool and start clicking. You have a business question. MTM is built to answer it, at every stage of your workflow."
                )
            }
        </p>
    </div>

    <div class="solutions-workflow-cards">
        <div class="solutions-workflow-card solutions-workflow-card--blue">
            <Eyebrow>{t(copy, 'workflow_step_1_number', locale, '01 Query')}</Eyebrow>
            <div class="solutions-workflow-card-content">
                <p class="text-body-p1 solutions-workflow-step-title">
                    {t(copy, 'workflow_step_1_title', locale, 'Select your variables')}
                </p>
                <p class="text-body-p2 solutions-workflow-step-desc">
                    {
                        t(
                            copy,
                            'workflow_step_1_description',
                            locale,
                            'Start with a question — platform reach, time spent, device ownership, service provider. Pull exactly the variables you need and the MTM lets you build your view in minutes.'
                        )
                    }
                </p>
                {
                    step1Tags.length > 0 && (
                        <div class="solutions-workflow-tags">
                            {step1Tags.map((tag) => (
                                <a class="solutions-workflow-tag" href={getTagLink(tag)}>
                                    <img src={getTagIcon(tag)} class="icon-l" alt="" />
                                    <span class="text-body-p2 solutions-workflow-tag__text">
                                        {tag}
                                    </span>
                                    <svg
                                        class="solutions-workflow-tag__arrow icon-s"
                                        width="9"
                                        height="15"
                                        viewBox="0 0 9 15"
                                        fill="none"
                                        xmlns="http://www.w3.org/2000/svg"
                                        aria-hidden="true"
                                    >
                                        <path
                                            d="M1.5 1.5L7.5 7.5L1.5 13.5"
                                            stroke="currentColor"
                                            stroke-width="2"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                        />
                                    </svg>
                                </a>
                            ))}
                        </div>
                    )
                }
            </div>
        </div>

        <div class="solutions-workflow-card solutions-workflow-card--teal">
            <Eyebrow>{t(copy, 'workflow_step_2_number', locale, '02 Customize')}</Eyebrow>
            <div class="solutions-workflow-card-content">
                <p class="text-body-p1 solutions-workflow-step-title">
                    {t(copy, 'workflow_step_2_title', locale, 'Build your cross-tab or chart')}
                </p>
                <p class="text-body-p2 solutions-workflow-step-desc">
                    {
                        t(
                            copy,
                            'workflow_step_2_description',
                            locale,
                            'Drag variables into rows and columns. Filter by region, language, age or strategic target group. Every output is yours to configure — no fixed tables, no waiting.'
                        )
                    }
                </p>
                {
                    step2Tags.length > 0 && (
                        <div class="solutions-workflow-tags">
                            {step2Tags.map((tag) => (
                                <a class="solutions-workflow-tag" href={getTagLink(tag)}>
                                    <img src={getTagIcon(tag)} class="icon-l" alt="" />
                                    <span class="text-body-p2 solutions-workflow-tag__text">
                                        {tag}
                                    </span>
                                    <svg
                                        class="solutions-workflow-tag__arrow icon-s"
                                        width="9"
                                        height="15"
                                        viewBox="0 0 9 15"
                                        fill="none"
                                        xmlns="http://www.w3.org/2000/svg"
                                        aria-hidden="true"
                                    >
                                        <path
                                            d="M1.5 1.5L7.5 7.5L1.5 13.5"
                                            stroke="currentColor"
                                            stroke-width="2"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                        />
                                    </svg>
                                </a>
                            ))}
                        </div>
                    )
                }
            </div>
        </div>

        <div class="solutions-workflow-card solutions-workflow-card--purple">
            <Eyebrow>{t(copy, 'workflow_step_3_number', locale, '03 Export')}</Eyebrow>
            <div class="solutions-workflow-card-content">
                <p class="text-body-p1 solutions-workflow-step-title">
                    {t(copy, 'workflow_step_3_title', locale, 'Export for your client')}
                </p>
                <p class="text-body-p2 solutions-workflow-step-desc">
                    {
                        t(
                            copy,
                            'workflow_step_3_description',
                            locale,
                            'Download your analysis in presentation-ready formats. Drop it straight into a deck, a brief, or a regulatory submission — formatted and ready to go.'
                        )
                    }
                </p>
                {
                    step3Tags.length > 0 && (
                        <div class="solutions-workflow-tags">
                            {step3Tags.map((tag) => (
                                <a class="solutions-workflow-tag" href={getTagLink(tag)}>
                                    <img src={getTagIcon(tag)} class="icon-l" alt="" />
                                    <span class="text-body-p2 solutions-workflow-tag__text">
                                        {tag}
                                    </span>
                                    <svg
                                        class="solutions-workflow-tag__arrow icon-s"
                                        width="9"
                                        height="15"
                                        viewBox="0 0 9 15"
                                        fill="none"
                                        xmlns="http://www.w3.org/2000/svg"
                                        aria-hidden="true"
                                    >
                                        <path
                                            d="M1.5 1.5L7.5 7.5L1.5 13.5"
                                            stroke="currentColor"
                                            stroke-width="2"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                        />
                                    </svg>
                                </a>
                            ))}
                        </div>
                    )
                }
            </div>
        </div>
    </div>
</section>

<style>
    .solutions-workflow-section {
        width: 100%;
        background: var(--surface-white);
        padding: var(--section-pad-block) var(--content-margin-inline);
        display: flex;
        flex-direction: column;
        gap: var(--section-header-gap);
    }

    .solutions-workflow-header {
        display: flex;
        flex-direction: column;
        gap: var(--title-desc-gap);
        max-width: 54rem;
    }

    .solutions-workflow-header h2 {
        margin: 0;
    }

    .solutions-workflow-description {
        margin: 0;
        color: var(--text-secondary);
    }

    .solutions-workflow-cards {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: var(--layout-card-gap);
    }

    .solutions-workflow-card {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        /* proximity: within-card gap stays below --layout-card-gap */
        gap: var(--space-7);
        padding: var(--card-pad);
        border-radius: var(--radius-m);
        min-height: 18rem;
    }

    .solutions-workflow-card--blue {
        background: #e8f3fd;
    }
    .solutions-workflow-card--teal {
        background: #e8f7f5;
    }
    .solutions-workflow-card--purple {
        background: #f7f4ff;
    }

    .solutions-workflow-card-content {
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
    }

    .solutions-workflow-step-title {
        margin: 0;
        color: var(--text-primary);
    }

    .solutions-workflow-step-desc {
        margin: 0;
        color: var(--text-secondary);
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 4;
        -webkit-box-orient: vertical;
    }

    .solutions-workflow-tags {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2);
        margin-top: var(--space-3);
    }

    .solutions-workflow-tag {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        background: var(--surface-white);
        border-radius: var(--radius-s);
        padding: var(--space-2) var(--space-4) var(--space-2) var(--space-2);
        text-decoration: none;
    }

    .solutions-workflow-tag img {
        flex-shrink: 0;
        width: 2rem;
        height: 2rem;
    }

    .solutions-workflow-tag__text {
        color: var(--text-primary);
        white-space: nowrap;
    }

    .solutions-workflow-tag__arrow {
        color: var(--text-disabled);
        flex-shrink: 0;
    }

    @media (max-width: 1023px) {
        .solutions-workflow-section {
            padding-top: var(--space-11);
            padding-bottom: var(--space-11);
        }

        .solutions-workflow-cards {
            grid-template-columns: 1fr;
        }

        .solutions-workflow-card {
            min-height: auto;
            gap: var(--space-5);
        }
    }

    @media (max-width: 767px) {
        .solutions-workflow-section {
            padding-top: var(--section-pad-block);
            padding-bottom: var(--section-pad-block);
        }
    }
</style>
