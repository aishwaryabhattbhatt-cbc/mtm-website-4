---
// src/components/about-us/AboutUsBackgroundScripts.astro
// Drop inside the About Us page's <Fragment slot="scripts"> alongside <AboutUsBackground />.
// Loads Three.js + the WebGL liquid-gradient effect (public/js/backgrounds/about-us-background.js).
const base = import.meta.env.BASE_URL;
---

<script is:inline type="importmap">
    {
        "imports": {
            "three": "https://cdn.jsdelivr.net/npm/three@0.128.0/build/three.module.js"
        }
    }
</script>
<script is:inline type="module" src={`${base}js/backgrounds/about-us-background.js`}></script>
