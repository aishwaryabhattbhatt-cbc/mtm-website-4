---
// Mirrors AnalyticToolsYourDataSectionV2.astro's section design (light-blue
// background, card grid, heading/card fly-in mechanics) with team content
// in place of tool benefits. Cards use a monogram avatar, not a photo —
// there's no real headshot yet, and an initials avatar is an honest,
// intentional "photo pending" state rather than an empty placeholder box.
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import type { ProductVariant } from '../shared/ProductPill.astro';
import { t } from '../../lib/i18n/t';
import { aboutUsTeam as members } from '../../lib/content/aboutUsTeam';
import ProductPill from '../shared/ProductPill.astro';

interface Props {
    locale: Locale;
    copy: CMSDictionary;
}

const { locale, copy } = Astro.props as Props;
const base = import.meta.env.BASE_URL;

const researchPartners: {
    name: string;
    logoSrc: string;
    pillVariant: ProductVariant;
    zoomLogo?: boolean;
}[] = [
    {
        name: 'Forum Research',
        logoSrc: `${base}images/products/mtm-18-plus/forum_research_logo.png`,
        pillVariant: 'mtm18plus',
        // Source file has heavy letterboxing (arrow mark + a lot of empty
        // canvas) — zoom/crop in via CSS rather than shrinking the whole box.
        zoomLogo: true,
    },
    {
        name: 'Ad Hoc Research',
        logoSrc: `${base}images/products/mtm-junior/adhoc_research_logo.png`,
        pillVariant: 'junior',
    },
    {
        name: 'Léger',
        logoSrc: `${base}images/products/mtm-newcomers/leger_logo.png`,
        pillVariant: 'newcomers',
    },
];
---

<section class="about-us-team-section" id="about-us-team">
    <div class="about-us-team-section__header heading-fly-in">
        <h2 class="about-us-team-section__title" data-copy-key="about_team_title">
            {t(copy, 'about_team_title', locale, "Who's behind it")}
        </h2>
    </div>

    <p
        class="text-body-p2 about-us-team-section__note content-fly-in"
        data-copy-key="about_team_description"
    >
        {
            t(
                copy,
                'about_team_description',
                locale,
                "The people who design the surveys, validate the methodology, and build the tools MTM's data feeds into."
            )
        }
    </p>

    <div class="about-us-team-section__cards">
        {
            members.map((member) => (
                <div class="about-us-team-section__card card-fly-in">
                    <div class="about-us-team-section__card-avatar" aria-hidden="true" />
                    <div class="about-us-team-section__card-content">
                        <p
                            class="text-body-p1 about-us-team-section__card-name"
                            data-copy-key={member.nameKey}
                        >
                            {t(copy, member.nameKey, locale, member.nameFallback)}
                        </p>
                        <p
                            class="text-label-small about-us-team-section__card-role"
                            data-copy-key={member.titleKey}
                        >
                            {t(copy, member.titleKey, locale, member.titleFallback)}
                        </p>
                        <p
                            class="text-body-p3 about-us-team-section__card-desc"
                            data-copy-key={member.descKey}
                        >
                            {t(copy, member.descKey, locale, member.descFallback)}
                        </p>
                    </div>
                </div>
            ))
        }
    </div>

    <div class="about-us-team-section__divider" aria-hidden="true"></div>

    <p
        class="text-body-p2 about-us-team-section__note content-fly-in"
        data-copy-key="about_team_note"
    >
        {
            t(
                copy,
                'about_team_note',
                locale,
                'Fieldwork itself is run independently by established Canadian research firms — Forum Research, Ad Hoc Research, or Léger, depending on the product — so no single team touches every stage of a dataset.'
            )
        }
    </p>

    <div class="about-us-team-section__partners">
        {
            researchPartners.map((partner) => (
                <div class="about-us-team-section__card card-fly-in">
                    <div class="about-us-team-section__partner-logo-box" aria-hidden="true">
                        <img
                            src={partner.logoSrc}
                            alt=""
                            class={`about-us-team-section__partner-logo${partner.zoomLogo ? ' about-us-team-section__partner-logo--zoom' : ''}`}
                            loading="lazy"
                            decoding="async"
                        />
                    </div>
                    <div class="about-us-team-section__card-content">
                        <p class="text-body-p1 about-us-team-section__card-name">{partner.name}</p>
                        <ProductPill
                            variant={partner.pillVariant}
                            size="small"
                            copy={copy}
                            locale={locale}
                        />
                    </div>
                </div>
            ))
        }
    </div>
</section>

<style>
    .about-us-team-section {
        width: 100%;
        background: var(--surface-blue);
        padding: var(--section-pad-block) var(--content-margin-inline);
        display: flex;
        flex-direction: column;
        gap: var(--section-header-gap);
    }

    .about-us-team-section__header {
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
        text-align: center;
    }

    .about-us-team-section__title {
        margin: 0;
        color: var(--text-primary);
    }

    .about-us-team-section__cards {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: var(--layout-card-gap);
    }

    .about-us-team-section__card {
        background: var(--surface-white);
        border-radius: var(--radius-m);
        box-shadow: var(--shadow-card);
        padding: var(--card-pad-thin);
        display: flex;
        flex-direction: row;
        align-items: flex-start;
        gap: var(--space-4);
    }

    .about-us-team-section__card-avatar {
        flex-shrink: 0;
        width: calc(var(--space-11) * 2);
        height: calc(var(--space-11) * 2);
        border-radius: var(--radius-s);
        background: var(--surface-blue);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--text-primary);
    }

    .about-us-team-section__card-content {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: var(--space-3);
    }

    .about-us-team-section__card-name {
        margin: 0;
        color: var(--text-primary);
    }

    .about-us-team-section__card-role {
        margin: 0;
        color: var(--text-primary);
    }

    .about-us-team-section__card-desc {
        margin: 0;
        color: var(--text-secondary);
    }

    .about-us-team-section__divider {
        width: 100%;
        height: var(--stroke-1);
        background: var(--neutral-grey-4);
    }

    .about-us-team-section__partners {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: var(--layout-card-gap);
    }

    .about-us-team-section__partner-logo-box {
        flex-shrink: 0;
        align-self: stretch;
        width: calc(var(--space-11) * 2);
        border-radius: var(--radius-s);
        background: var(--surface-blue);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: var(--space-4);
        overflow: hidden;
    }

    .about-us-team-section__partner-logo {
        max-width: 100%;
        max-height: 100%;
        width: auto;
        height: auto;
        object-fit: contain;
        display: block;
    }

    /* Forum Research's source file has a lot of empty canvas on either side
       of the mark — scale up so the box crops that padding away instead of
       the logo rendering tiny inside it. */
    .about-us-team-section__partner-logo--zoom {
        transform: scale(1.3);
    }

    .about-us-team-section__note {
        max-width: 54rem;
        margin: 0 auto;
        text-align: center;
        color: var(--text-secondary);
    }

    @media (max-width: 1125px) {
        .about-us-team-section__cards,
        .about-us-team-section__partners {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (max-width: 767px) {
        .about-us-team-section {
            padding: var(--section-pad-block) var(--content-margin-inline);
            gap: var(--section-header-gap);
        }

        .about-us-team-section__header {
            gap: var(--space-3);
        }

        .about-us-team-section__cards,
        .about-us-team-section__partners {
            grid-template-columns: 1fr;
            gap: var(--layout-card-gap);
        }
    }
</style>

<script>
    // Heading and the cards row each observe themselves, not the outer
    // section — a threshold is a fraction of the target's own area, so
    // watching the whole section skews the trigger point once the section
    // is taller than any one piece inside it.
    document.querySelectorAll<HTMLElement>('.about-us-team-section').forEach((section) => {
        const heading = section.querySelector<HTMLElement>('.heading-fly-in');
        if (heading) {
            const headingObserver = new IntersectionObserver(
                ([entry]) => {
                    if (entry.isIntersecting) {
                        heading.classList.add('is-visible');
                        headingObserver.disconnect();
                    }
                },
                { threshold: 0.4 }
            );
            headingObserver.observe(heading);
        }

        // Two distinct card rows (team, then partners) — each gets its own
        // row-level observer so the second row doesn't inherit the first
        // row's trigger point and pop in early (per animation-conventions).
        const cardsRow = section.querySelector<HTMLElement>('.about-us-team-section__cards');
        const cards = cardsRow?.querySelectorAll<HTMLElement>('.card-fly-in');
        if (cardsRow && cards?.length) {
            const cardObserver = new IntersectionObserver(
                ([entry]) => {
                    if (entry.isIntersecting) {
                        cards.forEach((card, i) => {
                            setTimeout(() => card.classList.add('is-visible'), i * 140);
                        });
                        cardObserver.disconnect();
                    }
                },
                { threshold: 0.3 }
            );
            cardObserver.observe(cardsRow);
        }

        const partnersRow = section.querySelector<HTMLElement>('.about-us-team-section__partners');
        const partnerCards = partnersRow?.querySelectorAll<HTMLElement>('.card-fly-in');
        if (partnersRow && partnerCards?.length) {
            const partnerObserver = new IntersectionObserver(
                ([entry]) => {
                    if (entry.isIntersecting) {
                        partnerCards.forEach((card, i) => {
                            setTimeout(() => card.classList.add('is-visible'), i * 140);
                        });
                        partnerObserver.disconnect();
                    }
                },
                { threshold: 0.3 }
            );
            partnerObserver.observe(partnersRow);
        }

        // Two separate content blocks (team description, fieldwork note) —
        // each observes itself so both actually reveal (querySelector would
        // only ever find the first one).
        section.querySelectorAll<HTMLElement>('.content-fly-in').forEach((note) => {
            const noteObserver = new IntersectionObserver(
                ([entry]) => {
                    if (entry.isIntersecting) {
                        note.classList.add('is-visible');
                        noteObserver.disconnect();
                    }
                },
                { threshold: 0.15 }
            );
            noteObserver.observe(note);
        });
    });
</script>
