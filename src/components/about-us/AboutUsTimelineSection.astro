---
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { t } from '../../lib/i18n/t';
import Button from '../shared/Button.astro';

interface Props {
    locale: Locale;
    copy: CMSDictionary;
}

const { locale, copy } = Astro.props as Props;
const base = import.meta.env.BASE_URL;

const timelineFallbacks = [
    {
        year: '2005',
        title: 'MTM launches',
        body: 'An annual fall survey of 8,000 Canadians, gathering media and technology data by landline telephone.',
    },
    {
        year: '2010',
        title: 'Spring wave added',
        body: 'A spring wave is added alongside the fall wave, and the annual sample grows to 12,000 Canadians — the release cadence still used today.',
    },
    {
        year: '2011',
        title: 'MTM Portal launches',
        body: 'The MTM Portal launches, making data available online for the first time.',
    },
    {
        year: '2012',
        title: 'Cell-phone-only households added',
        body: 'Cell-phone-only households are added to the sample, keeping pace with how Canadians were actually reachable by phone.',
    },
    {
        year: '2015',
        title: '10th anniversary',
        body: "MTM's 10th anniversary. The interactive Trending Tool and Forecasting Tool launch, with 1,500+ data points now available.",
    },
    {
        year: '2019',
        title: 'MTM Jr. launches',
        body: 'MTM Jr. launches, extending coverage to Canadians aged 2–17; additional EDI questions are added to the survey.',
    },
    {
        year: '2021',
        title: 'MTM Newcomers launches',
        body: 'MTM Newcomers launches; the sample expands to include Northern Canada and a booster sample of Indigenous respondents.',
    },
    { year: '2022', title: 'MTM Jr. sample grows', body: "MTM Jr.'s sample size increases." },
    { year: '2023', title: '80+ reports released', body: '80+ reports and infographics released.' },
    {
        year: '2024',
        title: 'YourData tool launches',
        body: 'The YourData visualization tool launches on the Portal; over 4,000 data points are now available to users.',
    },
    { year: '2025', title: 'MTM Census Tool launches', body: 'MTM Census Tool launches.' },
    {
        year: '2026',
        title: 'Census Tool 2.0 & MTM Chatbot',
        body: 'MTM Census Tool 2.0 and the MTM Chatbot launch.',
    },
];

const items = timelineFallbacks.map((item, i) => ({
    yearKey: `about_timeline_item_${i + 1}_year`,
    yearFallback: item.year,
    titleKey: `about_timeline_item_${i + 1}_title`,
    titleFallback: item.title,
    bodyKey: `about_timeline_item_${i + 1}_body`,
    bodyFallback: item.body,
}));
---

<section class="about-us-timeline-section">
    <div class="about-us-timeline-header">
        <h2 class="about-us-timeline-title heading-fly-in" data-copy-key="about_timeline_title">
            {t(copy, 'about_timeline_title', locale, 'Timeline')}
        </h2>
        <p
            class="about-us-timeline-description text-body-p2 content-fly-in"
            data-copy-key="about_timeline_description"
        >
            {
                t(
                    copy,
                    'about_timeline_description',
                    locale,
                    'Every wave since 2005 uses the same core methodology, so a claim about how Canadian media habits shifted can be traced to an exact year.'
                )
            }
        </p>
    </div>

    <ol class="about-us-timeline-list">
        {
            items.map((item) => (
                <li class="about-us-timeline-item card-fly-in">
                    <span
                        class="about-us-timeline-number text-label-small"
                        data-copy-key={item.yearKey}
                    >
                        {t(copy, item.yearKey, locale, item.yearFallback)}
                    </span>
                    <div class="about-us-timeline-content">
                        <p
                            class="text-body-p1-bold about-us-timeline-item-title"
                            data-copy-key={item.titleKey}
                        >
                            {t(copy, item.titleKey, locale, item.titleFallback)}
                        </p>
                        <p class="about-us-timeline-body text-body-p2" data-copy-key={item.bodyKey}>
                            {t(copy, item.bodyKey, locale, item.bodyFallback)}
                        </p>
                    </div>
                </li>
            ))
        }

        <li class="about-us-timeline-item about-us-timeline-item--today card-fly-in">
            <span
                class="about-us-timeline-number text-label-small"
                data-copy-key="about_timeline_today_label"
            >
                {t(copy, 'about_timeline_today_label', locale, 'Today')}
            </span>
            <div class="about-us-timeline-content">
                <Button
                    variant="tertiary"
                    size="lg"
                    href={`${base}${locale}/request-demo/`}
                    data-copy-key="about_timeline_today_cta"
                >
                    {t(copy, 'about_timeline_today_cta', locale, 'Reach out to us today!')}
                </Button>
            </div>
        </li>
    </ol>
</section>

<style>
    .about-us-timeline-section {
        width: 100%;
        display: grid;
        grid-template-columns: 1fr 1fr;
        column-gap: var(--space-9);
        padding: var(--section-pad-block) var(--content-margin-inline);
        align-items: start;
    }

    /* Stays pinned in the left column while the steps scroll past on the right. */
    .about-us-timeline-header {
        position: sticky;
        top: calc(var(--navbar-height) + var(--space-8));
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
        padding-right: var(--space-11);
    }

    .about-us-timeline-title {
        margin: 0;
        color: var(--text-primary);
    }

    .about-us-timeline-description {
        margin: 0;
        color: var(--text-secondary);
    }

    .about-us-timeline-list {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: var(--space-12);
        margin: 0;
        /* With equal 1fr/1fr columns, this column's left edge sits half the
           column-gap to the right of the section's true center — and the
           circle sits another half-circle-width further right again. Pull
           the whole list left by both amounts so the circle lands exactly
           on center, without touching the (equal) column widths themselves. */
        margin-left: calc(-1 * (var(--space-9) + var(--space-10)) / 2);
        padding: 0;
        list-style: none;
    }

    /* Connecting line running through the center of each number, behind them. */
    .about-us-timeline-list::before {
        content: '';
        position: absolute;
        z-index: 0;
        top: calc(var(--space-10) / 2);
        bottom: calc(var(--space-10) / 2);
        left: calc(var(--space-10) / 2);
        width: var(--stroke-2);
        background: var(--neutral-grey-4);
        transform: translateX(-50%);
    }

    /* Colored fill drawn on top of the track line — height driven by
       --timeline-progress (0–1), set from scroll position in the script below. */
    .about-us-timeline-list::after {
        content: '';
        position: absolute;
        z-index: 0;
        top: calc(var(--space-10) / 2);
        left: calc(var(--space-10) / 2);
        width: var(--stroke-2);
        height: calc(100% - var(--space-10));
        background: var(--brand-blue-main);
        transform: translateX(-50%) scaleY(var(--timeline-progress, 0));
        transform-origin: top;
    }

    .about-us-timeline-item {
        position: relative;
        z-index: 1;
        display: grid;
        grid-template-columns: var(--space-10) 1fr;
        column-gap: var(--space-7);
        align-items: start;
    }

    /* Single button, no multi-line text to top-align with — center it on
       the circle instead of inheriting .about-us-timeline-item's align-items: start. */
    .about-us-timeline-item--today {
        align-items: center;
    }

    /* Button is a flex child of .about-us-timeline-content (default
       align-items: stretch, needed so the title/body text items fill the
       column) — override to flex-start here so the button hugs its own
       content width instead of stretching full width. */
    .about-us-timeline-item--today .about-us-timeline-content {
        align-items: flex-start;
    }

    .about-us-timeline-number {
        position: relative;
        z-index: 1;
        width: var(--space-10);
        height: var(--space-10);
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: var(--radius-full);
        background: var(--surface-white);
        box-shadow: var(--shadow-card);
        color: var(--text-primary);
        transition:
            background-color 0.3s ease,
            color 0.3s ease;
    }

    .about-us-timeline-item.is-reached .about-us-timeline-number {
        background: var(--surface-blue);
        color: var(--brand-blue-main);
    }

    .about-us-timeline-content {
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
    }

    .about-us-timeline-item-title {
        margin: 0;
        color: var(--text-secondary);
        transition: color 0.3s ease;
    }

    .about-us-timeline-body {
        margin: 0;
        color: var(--text-secondary);
        transition: color 0.3s ease;
    }

    .about-us-timeline-item.is-reached .about-us-timeline-item-title,
    .about-us-timeline-item.is-reached .about-us-timeline-body {
        color: var(--text-primary);
    }

    @media (max-width: 1023px) {
        .about-us-timeline-section {
            grid-template-columns: 1fr;
            row-gap: var(--space-8);
        }

        .about-us-timeline-header {
            position: static;
        }

        .about-us-timeline-list {
            margin-left: 0;
        }
    }
</style>

<script>
    document.querySelectorAll<HTMLElement>('.about-us-timeline-section').forEach((section) => {
        const heading = section.querySelector<HTMLElement>('.heading-fly-in');
        if (heading) {
            const headingObserver = new IntersectionObserver(
                ([entry]) => {
                    if (entry.isIntersecting) {
                        heading.classList.add('is-visible');
                        headingObserver.disconnect();
                    }
                },
                { threshold: 0.15 }
            );
            headingObserver.observe(heading);
        }

        const description = section.querySelector<HTMLElement>('.content-fly-in');
        if (description) {
            const descriptionObserver = new IntersectionObserver(
                ([entry]) => {
                    if (entry.isIntersecting) {
                        description.classList.add('is-visible');
                        descriptionObserver.disconnect();
                    }
                },
                { threshold: 0.15 }
            );
            descriptionObserver.observe(description);
        }

        // Timeline entries are stacked vertically at different scroll
        // positions, so each gets its own observer (per animation-conventions).
        const itemObserver = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('is-visible');
                        itemObserver.unobserve(entry.target);
                    }
                });
            },
            { threshold: 0.2 }
        );
        section.querySelectorAll<HTMLElement>('.about-us-timeline-item').forEach((item) => {
            itemObserver.observe(item);
        });
    });

    // Fills the connecting line as the list scrolls through the viewport's
    // vertical center, so the line reads as "how far through the timeline you are".
    // Each item (circle + title + body) also flips from muted to full-color
    // once the line reaches it.
    document.querySelectorAll<HTMLElement>('.about-us-timeline-list').forEach((list) => {
        const items = list.querySelectorAll<HTMLElement>('.about-us-timeline-item');

        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            list.style.setProperty('--timeline-progress', '1');
            items.forEach((item) => item.classList.add('is-reached'));
            return;
        }

        let ticking = false;
        const updateProgress = () => {
            const rect = list.getBoundingClientRect();
            const viewportCenter = window.innerHeight / 2;
            const progress = (viewportCenter - rect.top) / rect.height;
            list.style.setProperty(
                '--timeline-progress',
                String(Math.min(1, Math.max(0, progress)))
            );

            items.forEach((item) => {
                const circle = item.querySelector<HTMLElement>('.about-us-timeline-number');
                if (!circle) return;
                const circleRect = circle.getBoundingClientRect();
                const circleCenter = circleRect.top + circleRect.height / 2;
                item.classList.toggle('is-reached', circleCenter <= viewportCenter);
            });

            ticking = false;
        };

        updateProgress();
        window.addEventListener(
            'scroll',
            () => {
                if (!ticking) {
                    requestAnimationFrame(updateProgress);
                    ticking = true;
                }
            },
            { passive: true }
        );
        window.addEventListener('resize', updateProgress);
    });
</script>
