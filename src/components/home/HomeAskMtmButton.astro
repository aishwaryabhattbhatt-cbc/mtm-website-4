---
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { t } from '../../lib/i18n/t';
import Button from '../shared/Button.astro';

interface Props {
    locale: Locale;
    copy: CMSDictionary;
}

const { locale, copy } = Astro.props as Props;
const base = import.meta.env.BASE_URL;
// White-fill reversed icon, paired with this button's black background.
const askMtmIconPath = `${base}icons/products/AskMTM-REV.svg`;
---

<div class="ask-mtm-sticky-button">
    <Button
        variant="secondary-icon"
        class="ask-mtm-sticky-button__btn"
        aria-label={t(copy, 'faq_ask_mtm_label', locale, 'Ask MTM')}
        iconSrc={askMtmIconPath}
        iconAlt="Ask MTM"
    >
        {t(copy, 'faq_ask_mtm_label', locale, 'Ask MTM')}
    </Button>
</div>

<script is:inline>
    (() => {
        const chatbotId = 'EdK2rLimZ6FDYc_PYkug6';

        // Install Chatbase's command queue before loading its script so an
        // early click can still be handled once the widget is ready.
        if (!window.chatbase || window.chatbase('getState') !== 'initialized') {
            window.chatbase = (...args) => {
                window.chatbase.q = window.chatbase.q || [];
                window.chatbase.q.push(args);
            };

            window.chatbase = new Proxy(window.chatbase, {
                get(target, property) {
                    if (property === 'q') return target.q;
                    return (...args) => target(property, ...args);
                },
            });
        }

        const loadChatbase = () => {
            if (document.getElementById(chatbotId)) return;

            const script = document.createElement('script');
            script.src = 'https://www.chatbase.co/embed.min.js';
            script.id = chatbotId;
            script.domain = 'www.chatbase.co';
            document.body.appendChild(script);
        };

        if (document.readyState === 'complete') {
            loadChatbase();
        } else {
            window.addEventListener('load', loadChatbase, { once: true });
        }

        document
            .querySelectorAll('.ask-mtm-sticky-button__btn, .home-faqs__ask-mtm-button')
            .forEach((trigger) => {
                trigger.addEventListener('click', () => window.chatbase.open());
            });
    })();
</script>

<style>
    .ask-mtm-sticky-button {
        position: fixed;
        right: var(--space-7);
        bottom: var(--space-7);
        z-index: 500;
    }

    .ask-mtm-sticky-button :global(.ask-mtm-sticky-button__btn) {
        display: inline-flex;
        align-items: center;
        justify-content: flex-start;
        overflow: hidden;
        gap: var(--space-3);
        color: var(--text-white);
        height: var(--space-10);
        max-width: var(--space-10);
        padding: 0 var(--space-2);
        border-radius: var(--radius-full);
        background: var(--neutral-black);
        border: none;
        box-shadow: var(--shadow-card);
        transition:
            max-width var(--motion-duration-card) var(--motion-ease-standard),
            padding-right var(--motion-duration-card) var(--motion-ease-standard);
    }

    .ask-mtm-sticky-button :global(.ask-mtm-sticky-button__btn:hover),
    .ask-mtm-sticky-button :global(.ask-mtm-sticky-button__btn:focus-visible) {
        max-width: 16rem;
        padding-right: var(--space-5);
        background: var(--neutral-black);
        box-shadow: var(--shadow-card);
        transform: none;
    }

    .ask-mtm-sticky-button :global(.btn-secondary-icon-label) {
        flex-shrink: 0;
        white-space: nowrap;
        opacity: 0;
        transition: opacity var(--motion-duration-card) var(--motion-ease-standard);
    }

    .ask-mtm-sticky-button :global(.ask-mtm-sticky-button__btn:hover .btn-secondary-icon-label),
    .ask-mtm-sticky-button
        :global(.ask-mtm-sticky-button__btn:focus-visible .btn-secondary-icon-label) {
        opacity: 1;
    }

    .ask-mtm-sticky-button :global(.btn-secondary-icon-wrap) {
        flex-shrink: 0;
    }

    .ask-mtm-sticky-button :global(.btn-secondary-icon-asset) {
        flex-shrink: 0;
        width: var(--icon-xl);
        height: var(--icon-xl);
    }

    /* The site supplies its own Ask MTM trigger, so suppress Chatbase's
       injected launcher while leaving the chat window available to open(). */
    :global(#chatbase-bubble-button),
    :global(#chatbase-bubble-label) {
        display: none !important;
    }

    @media (max-width: 767px) {
        .ask-mtm-sticky-button {
            bottom: var(--space-5);
        }
    }
</style>
