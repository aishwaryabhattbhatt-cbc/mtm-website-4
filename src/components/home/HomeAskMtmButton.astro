---
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { t } from '../../lib/i18n/t';
import Button from '../shared/Button.astro';
import { icons } from '../../lib/icons/registry';

interface Props {
    locale: Locale;
    copy: CMSDictionary;
}

const { locale, copy } = Astro.props as Props;
const base = import.meta.env.BASE_URL;
const askMtmIconPath = `${base}${icons.tool.askMtm}`;
---

<div class="ask-mtm-sticky-button">
    <Button
        variant="secondary-icon"
        class="ask-mtm-sticky-button__btn"
        aria-label={t(copy, 'faq_ask_mtm_label', locale, 'Ask MTM')}
        iconSrc={askMtmIconPath}
        iconAlt="Ask MTM"
    />
</div>

<style>
    .ask-mtm-sticky-button {
        position: fixed;
        right: var(--space-7);
        bottom: var(--space-7);
        z-index: 500;
    }

    .ask-mtm-sticky-button :global(.ask-mtm-sticky-button__btn) {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: var(--space-11);
        height: var(--space-11);
        padding: 0;
        border-radius: var(--radius-full);
        background: var(--surface-blue);
        border: none;
        box-shadow: var(--shadow-card);
    }

    .ask-mtm-sticky-button :global(.ask-mtm-sticky-button__btn:hover) {
        background: color-mix(in srgb, var(--surface-blue) 80%, var(--neutral-black));
    }

    .ask-mtm-sticky-button :global(.btn-secondary-icon-label) {
        display: none;
    }

    @media (max-width: 767px) {
        .ask-mtm-sticky-button {
            bottom: var(--space-5);
        }
    }
</style>
