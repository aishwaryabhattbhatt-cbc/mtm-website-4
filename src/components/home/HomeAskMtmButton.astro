---
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { t } from '../../lib/i18n/t';
import Button from '../shared/Button.astro';

interface Props {
    locale: Locale;
    copy: CMSDictionary;
}

const { locale, copy } = Astro.props as Props;
const base = import.meta.env.BASE_URL;
// White-fill reversed icon, paired with this button's black background.
const askMtmIconPath = `${base}icons/products/AskMTM-REV.svg`;
---

<div class="ask-mtm-sticky-button">
    <Button
        variant="secondary-icon"
        class="ask-mtm-sticky-button__btn"
        aria-label={t(copy, 'faq_ask_mtm_label', locale, 'Ask MTM')}
        iconSrc={askMtmIconPath}
        iconAlt="Ask MTM"
    />
</div>

<style>
    .ask-mtm-sticky-button {
        position: fixed;
        right: var(--space-7);
        bottom: var(--space-7);
        z-index: 500;
    }

    .ask-mtm-sticky-button :global(.ask-mtm-sticky-button__btn) {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: var(--space-11);
        height: var(--space-11);
        padding: 0;
        border-radius: var(--radius-full);
        background: var(--neutral-black);
        border: none;
        box-shadow: var(--shadow-card);
    }

    .ask-mtm-sticky-button :global(.ask-mtm-sticky-button__btn:hover) {
        background: var(--neutral-grey-1);
    }

    .ask-mtm-sticky-button :global(.btn-secondary-icon-label) {
        display: none;
    }

    .ask-mtm-sticky-button :global(.btn-secondary-icon-asset) {
        width: var(--icon-xl);
        height: var(--icon-xl);
    }

    @media (max-width: 767px) {
        .ask-mtm-sticky-button {
            bottom: var(--space-5);
        }
    }
</style>
