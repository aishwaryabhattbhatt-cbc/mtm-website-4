---
// src/components/home/HomeHeroSection.astro
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { t } from '../../lib/i18n/t';
import Button from '../shared/Button.astro';
import { icons } from '../../lib/icons/registry';

interface Props {
    locale: Locale;
    copy: CMSDictionary;
}

const { locale, copy } = Astro.props as Props;

const base = import.meta.env.BASE_URL;

const copyKeys = {
    title: 'hero_title',
    subtitle: 'hero_description',
    ctaPrimary: 'hero_cta_1',
    ctaSecondary: 'hero_cta_2',
};

/* Hero collage: 5 pre-composed image assets from public/images/home/hero-collage-new/
   (each one is its own finished card — text, photo, and any badges already
   baked in), positioned as plain absolutely-placed <img> tags. Decorative,
   so the collage stays aria-hidden rather than run through t(). */
const collageSrc = `${base}images/home/hero-collage-new/`;

/* Mobile-only collage: 1 pre-composed image (badges/cards for the top row,
   both photos for the bottom row, already baked in) from
   public/images/home/hero-collage-mobile/. Swapped in for the desktop
   collage above at ≤767px; see .collage-mobile-row. */
const collageMobileSrc = `${base}images/home/hero-collage-mobile/`;

/* Product badges scattered around the couple photo (collage-image-5): a
   rounded panel background (same treatment as ProductsHeroSection/
   SolutionsHeroSection) with each product line's badge icon centered on
   top. No orbit-float here — they grow in and stay put; script.js times
   them to appear only once the rest of the collage has finished settling
   (see the .collage-badge handling in runTitleAnimation). */
type CollageBadge = { left: number; top: number; size: string; icon: string };
const collageBadges: CollageBadge[] = [
    { left: 40, top: 430, size: '3rem', icon: icons['product-18-plus'].badge },
    { left: 160, top: 430, size: '3rem', icon: icons['product-newcomers'].badge },
    { left: 100, top: 430, size: '3rem', icon: icons['product-juniors'].badge },
    { left: 220, top: 430, size: '3rem', icon: icons['product-census'].badgeNoBrackets },
];
const panelSvg = `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 91 91'><defs><radialGradient id='g' cx='50%' cy='42%' r='78%'><stop offset='0%' stop-color='#ffffff'/><stop offset='60%' stop-color='#fdfeff'/><stop offset='100%' stop-color='#f5f8fc'/></radialGradient></defs><rect x='4' y='4' width='83' height='83' rx='10' fill='url(#g)' stroke='#eef2f8' stroke-width='1'/></svg>`;
const panelUrl = `url("data:image/svg+xml,${encodeURIComponent(panelSvg)}")`;

function badgeEntryStyle(badge: CollageBadge) {
    return `left: ${badge.left}px; top: ${badge.top}px; --badge-size: ${badge.size};`;
}
---

<!-- Home Section 1: Hero with WebGL Noise Warp Background -->
<section class="hero-section home-section-1">
    <!-- WebGL Noise Warp Canvas (Three.js) -->
    <div
        id="webgl-background-11"
        class="webgl-background"
        data-webgl-variant="home"
        aria-hidden="true"
    >
    </div>

    <!-- Grain Overlay for Texture -->
    <div class="grain-overlay-11 grain-overlay" aria-hidden="true"></div>

    <!-- Hero Content and Collage -->
    <div class="hero-container">
        <div class="hero-content">
            <h1 class="hero-title" data-copy-key={copyKeys.title}>
                {t(copy, copyKeys.title, locale, 'The Standard for Media & Tech Insights')}
            </h1>
            <p class="hero-subtitle text-body-p0" data-copy-key={copyKeys.subtitle}>
                {
                    t(
                        copy,
                        copyKeys.subtitle,
                        locale,
                        "Real data on how Canadians consume tech, content, and media. Built for leaders who don't guess."
                    )
                }
            </p>
            <div class="hero-buttons">
                <Button
                    variant="primary"
                    size="lg"
                    href={`${base}${locale}/request-demo/`}
                    data-copy-key={copyKeys.ctaPrimary}
                    >{t(copy, copyKeys.ctaPrimary, locale, 'REQUEST A DEMO')}</Button
                >
                <Button
                    variant="scroll"
                    size="lg"
                    id="hero-scroll-btn"
                    data-copy-key={copyKeys.ctaSecondary}
                    >{t(copy, copyKeys.ctaSecondary, locale, 'EXPLORE MORE')}</Button
                >
            </div>
        </div>
        <div class="hero-image-collage" aria-hidden="true">
            <!-- Badges + image 1 grouped for mobile only: on mobile they lay out
                 together as one row (see .collage-row-top); on desktop this div
                 is unstyled/position:static so it's transparent to its
                 position:absolute children, which still position themselves
                 relative to .hero-image-collage exactly as before. -->
            <div class="collage-row-top">
                {
                    collageBadges.map((badge) => (
                        <span class="collage-badge" style={badgeEntryStyle(badge)}>
                            <img src={`${base}${badge.icon}`} alt="" class="collage-badge-icon" />
                        </span>
                    ))
                }
                <img
                    src={`${collageSrc}1.svg`}
                    alt=""
                    class="collage-image collage-image-1"
                    loading="lazy"
                    decoding="async"
                />
            </div>
            <img
                src={`${collageSrc}3-update.svg`}
                alt=""
                class="collage-image collage-image-3"
                loading="lazy"
                decoding="async"
            />
            <img
                src={`${collageSrc}4-hero-charting.webp`}
                alt=""
                class="collage-image collage-image-4"
                loading="lazy"
                decoding="async"
            />
            <!-- Grouped for mobile only, same transparent-wrapper approach as
                 .collage-row-top: unstyled/position:static on desktop, so
                 .collage-image-2/5's position:absolute still positions them
                 relative to .hero-image-collage exactly as before there. -->
            <div class="collage-row-bottom">
                <img
                    src={`${collageSrc}2-hero-main.webp`}
                    alt=""
                    class="collage-image collage-image-2"
                    loading="lazy"
                    decoding="async"
                />
                <!-- 5-hero-secondary.webp's visible card fills only ~83-87%
                     of its own canvas (vs. ~96-99% for 2-hero-main.webp), so
                     at an equal box size it visibly reads smaller.
                     .collage-image-5-crop clips the ~16% scale-up applied to
                     the image below to compensate. -->
                <div class="collage-image-5-crop">
                    <img
                        src={`${collageSrc}5-hero-secondary.webp`}
                        alt=""
                        class="collage-image collage-image-5"
                        loading="lazy"
                        decoding="async"
                    />
                </div>
            </div>

            <!-- Mobile-only: replaces everything above at ≤767px (see
                 .collage-mobile-row / .collage-row-top / .collage-image-3 etc.
                 in the mobile media query). Hidden on desktop. -->
            <img
                src={`${collageMobileSrc}hero-mobile.webp`}
                alt=""
                class="collage-mobile-row"
                loading="lazy"
                decoding="async"
            />
        </div>
    </div>

    <!-- Bottom White Gradient Overlay -->
    <div class="hero11-bottom-gradient" aria-hidden="true"></div>
</section>

<style is:global define:vars={{ 'panel-url': panelUrl }}>
    .hero-section.home-section-1 {
        position: relative;
        margin-bottom: 0 !important;
        /* Same height contract as home-section-2: fill the screen when the
           viewport is ≥ 900px tall, hold a 900px floor below that. min-height
           (not height) so content can still grow it rather than clip.
           svh line after vh: mobile browsers that support svh use it (avoids
           overflowing behind the address bar on load); older browsers treat
           the svh calc as invalid and keep the vh line above. */
        height: auto;
        min-height: calc(max(100vh, 900px) - var(--navbar-height));
        min-height: calc(max(100svh, 900px) - var(--navbar-height));
        display: flex;
        flex-direction: column;
        justify-content: center;
        overflow: hidden;
    }

    .hero11-gradient-gui {
        position: absolute;
        left: 20px;
        bottom: 20px;
        z-index: 30;
        background: rgba(255, 255, 255, 0.95);
        border-radius: var(--radius-s);
        box-shadow: var(--shadow-e2);
        padding: 14px 18px 10px 18px;
        min-width: 210px;
        max-width: 260px;
        user-select: none;
    }

    .hero11-bottom-gradient {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        width: 100%;
        height: 10vh;
        pointer-events: none;
        z-index: 10;
        background: linear-gradient(to top, rgba(255, 255, 255, 1) 0%, rgba(255, 255, 255, 0) 100%);
    }

    .home-section-1 .hero-container {
        position: relative;
        z-index: 20;
        width: 100%;
        padding: 0 var(--content-margin-inline);
        display: flex;
        align-items: center;
        gap: auto;
        justify-content: space-between;
    }

    .home-section-1 .hero-content {
        /* 640px, not 40rem: the max must stay pixel-locked so it doesn't jump
           when html's root font-size steps up to 18px at 1920px (see
           design-system.css) — --collage-scale below assumes this exact
           640px when computing how much room the collage has left. */
        width: clamp(32rem, 38vw, 640px);
        flex-shrink: 0;
        display: flex;
        flex-direction: column;
        align-self: center;
        gap: var(--hero-stack-gap);
    }

    .hero-image-collage {
        position: relative;
        width: 620px;
        /* Tight fit to the lowest card's actual bottom edge (card 4: top 310
           + height 175 = 485). overflow:visible means shrinking this never
           risks clipping anything. */
        height: 486px;
        opacity: 0;
        animation: fadeInUp var(--motion-duration-heading) var(--motion-ease-standard) forwards;
        overflow: visible;
        padding-top: 0 !important;
        margin-top: 0 !important;
    }

    /* Mobile-only pre-composed row image — hidden on desktop, shown at
       ≤767px (see the mobile media query, which hides the desktop collage
       above in exchange). Same fadeInUp used by .hero-subtitle/.hero-buttons;
       script.js's runTitleAnimation() sets its delay to fire once the
       buttons' own entrance has fully finished (see collageMobileRow there)
       and flips animation-play-state to running, same pattern as those. */
    .collage-mobile-row {
        display: none;
        opacity: 0;
        animation: fadeInUp var(--motion-duration-heading) var(--motion-ease-standard) forwards;
        animation-play-state: paused;
    }

    .collage-image {
        position: absolute;
        /* contain (not cover): each asset now bakes in its own drop shadow
           near the card edges — cover would crop into that shadow whenever
           the box's aspect ratio doesn't land pixel-exact on the source's. */
        object-fit: contain;
        opacity: 0;
        /* Same grow-from-scale(0) idea as .collage-badge below, but with the
           established card-entrance spring (animation-conventions.md's
           .card-fly-in curve) instead of the badge's punchier overshoot —
           these cards are much bigger than a badge, so that curve read as
           too bouncy/fast at this size. Duration/delay are still set
           per-card by script.js's stagger. */
        animation: collage-card-grow-in cubic-bezier(0.22, 1, 0.36, 1) forwards;
        animation-play-state: paused;
        border-radius: var(--radius-s);
    }

    @keyframes collage-card-grow-in {
        from {
            /* Starting from scale(0) (badges' full pop) reads as a sudden
               jump at this size — these cards are 3-5x a badge's footprint,
               so a subtler starting scale keeps the "grow" feel without the
               jarring snap. */
            opacity: 0;
            transform: scale(0.85);
        }
        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    /* Each card's own SVG/PNG already bakes in its card frame and drop
       shadow (see the filter on each export), so box sizes below are just
       matched to each asset's natural aspect ratio — no extra chrome or
       box-shadow layered on top here. */
    .collage-image-1 {
        width: 240px;
        height: 112.5px;
        left: 96px;
        top: 18px;
        z-index: 5;
    }

    .collage-image-2 {
        width: 321px;
        height: 340px;
        left: 306px;
        top: -20px;
        z-index: 5;
    }

    .collage-image-3 {
        width: 162px;
        height: 90px;
        left: 410px;
        top: 296px;
        z-index: 5;
    }

    .collage-image-4 {
        width: 183px;
        height: 175px;
        left: 250px;
        top: 310px;
        z-index: 10;
    }

    .collage-image-5 {
        width: 328px;
        height: 328px;
        left: 15px;
        top: 96px;
        z-index: 1;
    }

    .collage-badge {
        position: absolute;
        width: var(--badge-size);
        height: var(--badge-size);
        opacity: 0;
        z-index: 6;
        background-image: var(--panel-url);
        background-repeat: no-repeat;
        background-size: 100% 100%;
        border-radius: var(--radius-s);
        box-shadow: var(--shadow-eyebrow);
        /* Grow/appear in place, matching ProductsHeroSection's badge entrance
           minus its infinite orbit-float loop. script.js sets each badge's
           animation-delay once the rest of the collage has settled, then
           flips this to running (see the .collage-badge handling in
           runTitleAnimation). */
        animation-name: collage-badge-grow-in;
        animation-duration: 1.1s;
        animation-timing-function: cubic-bezier(0.22, 0.72, 0.36, 1.35);
        animation-fill-mode: forwards;
        animation-play-state: paused;
    }

    @keyframes collage-badge-grow-in {
        from {
            opacity: 0;
            transform: translate(-50%, -50%) scale(0);
        }
        to {
            opacity: 1;
            transform: translate(-50%, -50%) scale(1);
        }
    }

    .collage-badge-icon {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: calc(var(--badge-size) * 0.75);
        height: calc(var(--badge-size) * 0.75);
    }

    @media (prefers-reduced-motion: reduce) {
        .collage-badge {
            animation: none;
            opacity: 1;
            transform: translate(-50%, -50%);
        }
    }

    .hero-title-word {
        display: inline-block;
        opacity: 0;
        transform: translateY(20px);
        /* Kept in sync with wordAnimationDuration in js/runtime/script.js */
        animation: wordAppear 0.48s ease-out forwards;
        animation-play-state: paused;
    }

    .hero-subtitle {
        color: var(--text-primary);
        margin: 0;
        opacity: 0;
        animation: fadeInUp var(--motion-duration-heading) var(--motion-ease-standard) forwards;
        animation-play-state: paused;
    }

    .hero-buttons {
        display: flex;
        margin-top: var(--space-5);
        gap: var(--space-4);
        flex-wrap: wrap;
        opacity: 0;
        animation: fadeInUp var(--motion-duration-heading) var(--motion-ease-standard) forwards;
        animation-play-state: paused;
    }

    @keyframes wordAppear {
        0% {
            opacity: 0;
            transform: translateY(20px);
        }
        100% {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes fadeInUp {
        0% {
            opacity: 0;
            transform: translateY(20px);
        }
        100% {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Desktop scaling: both columns scale via --hero-scale so proportions are preserved.
       Title uses clamp() only to cap growth above 1555px; everywhere else it tracks the scale. */

    /* Scale-up: 1555px and up. Content and collage share one --hero-natural-scale
       factor (both are `base-width * scale`) so their 640:620 ratio stays locked
       at every viewport — previously only the collage scaled while .hero-content
       stayed pinned at 640px, so the collage kept outgrowing the content column
       the wider the screen got. Title font-size still grows on its own separate
       (gentler) formula below — that's a deliberate typographic choice, not
       part of the box-width ratio this fixes.

       No separate 1920px+ rule: --content-margin-inline eventually reaches its
       240px ceiling (see design-system.css) while html's root font-size also
       steps up at 1920px, which would otherwise make the pair overflow past the
       now-wider margins. Rather than hardcode a compensating scale for that one
       viewport, --hero-fit-scale compares their natural combined width against
       the actual space left after the live --content-margin-inline, and — only
       when that's tight — shrinks both by the same extra factor, preserving the
       640:620 ratio through the squeeze too. */
    @media (min-width: 1555px) {
        .home-section-1 .hero-container {
            --hero-natural-scale: min(1.45, calc(1 + (100vw - 1555px) / 1000px));
            --hero-content-natural: calc(640px * var(--hero-natural-scale));
            --hero-collage-natural: calc(620px * var(--hero-natural-scale));
            --hero-fit-scale: min(
                1,
                calc(
                    (100vw - 2 * var(--content-margin-inline)) /
                        (var(--hero-content-natural) + var(--hero-collage-natural))
                )
            );
            --collage-scale: calc(var(--hero-natural-scale) * var(--hero-fit-scale));
        }

        .home-section-1 .hero-content {
            width: calc(var(--hero-content-natural) * var(--hero-fit-scale));
        }

        .hero-title {
            /* stays at 4.5rem baseline, grows to 5.25rem max at 1920px */
            font-size: clamp(var(--fs-hero), calc(4.5rem + (100vw - 1555px) * 0.00211), 5.25rem);
        }

        .hero-subtitle {
            font-size: clamp(var(--fs-body-xl), calc(1.5rem + (100vw - 1555px) * 0.00068), 1.75rem);
        }

        .hero-image-collage {
            zoom: var(--collage-scale);
            flex-shrink: 0;
        }
    }

    /* Scale-down: 1555px → 1440px */
    @media (min-width: 1440px) and (max-width: 1554px) {
        .home-section-1 .hero-container {
            --hero-scale: calc(0.913 + (100vw - 1440px) / 1321px);
        }

        .hero-title {
            font-size: calc(var(--fs-hero) * var(--hero-scale));
        }

        .hero-subtitle {
            font-size: calc(var(--fs-body-xl) * var(--hero-scale));
        }

        .hero-image-collage {
            zoom: var(--hero-scale);
            flex-shrink: 0;
        }
    }

    /* Scale-down: 1439px → 1024px */
    @media (min-width: 1024px) and (max-width: 1439px) {
        .home-section-1 .hero-container {
            --hero-scale: calc(0.7 + (100vw - 1024px) / 1949px);
        }

        .hero-title {
            font-size: calc(var(--fs-hero) * var(--hero-scale));
        }

        .hero-subtitle {
            font-size: calc(var(--fs-body-xl) * var(--hero-scale));
        }

        .hero-image-collage {
            zoom: var(--hero-scale);
            flex-shrink: 0;
        }
    }

    @media (max-width: 1023px) {
        /* screen height is a minimum, not a cap — the collage may extend past it */
        .hero-section.home-section-1 {
            /* column mode keeps top-down block flow, no 900px floor */
            display: block;
            height: auto;
            min-height: var(--section-height-100);
        }

        .home-section-1 .hero-container {
            flex-direction: column;
            justify-content: flex-start;
            align-items: flex-start;
            gap: var(--space-8);
            padding-top: var(--section-pad-block);
            padding-bottom: var(--space-9);
            overflow: hidden;
        }

        .home-section-1 .hero-content {
            /* container already provides horizontal padding — no double indent */
            padding: 0;
            max-width: 100%;
            width: 100%;
            text-align: center;
        }

        .hero-buttons {
            display: grid;
            grid-template-columns: max-content;
            justify-content: center;
            gap: var(--space-3);
        }

        .hero-buttons .btn-size-lg {
            text-align: center;
            justify-content: center;
        }

        .hero-image-collage {
            align-self: center;
            flex-shrink: 0;
        }
    }

    /* Scale collage to fit within the content width in column layout */
    @media (max-width: 1023px) {
        .hero-image-collage {
            zoom: min(1, calc((100vw - 2 * var(--content-margin-inline)) / 620px));
        }
    }

    @media (max-width: 767px) {
        /* ≤1023px forces a full-viewport min-height (var(--section-height-100)),
           meant for taller tablet content — on phones the actual content
           (title/subtitle/button/collage) is well short of that, leaving a
           large empty gap below the collage before the next section. Let
           the section just hug its content here instead. */
        .hero-section.home-section-1 {
            min-height: auto;
        }

        .home-section-1 .hero-container {
            padding-top: var(--space-9);
            gap: var(--space-5);
            /* Compensates for display:contents below: .hero-content used to
               carry text-align:center and an explicit width:100% for its
               children. Once it's display:contents those children become
               direct flex items here instead, under align-items:flex-start
               (set at ≤1023px) — without this override they'd shrink to
               fit-content instead of staying full width and centered. */
            align-items: stretch;
            text-align: center;
        }

        /* Reorder to title → subtitle → button → image on mobile only.
           .hero-content is a wrapper around title/subtitle/buttons, but the
           collage is its sibling — display:contents removes the wrapper's
           own box so its children become direct flex items of
           .hero-container alongside .hero-image-collage, letting all four
           share one `order` sequence without touching the DOM. */
        .home-section-1 .hero-content {
            display: contents;
        }

        .hero-title {
            order: 1;
        }

        .hero-subtitle {
            order: 2;
        }

        .hero-buttons {
            order: 3;
        }

        .hero-image-collage {
            order: 4;
        }

        #hero-scroll-btn {
            display: none;
        }

        .hero-buttons {
            margin-top: var(--space-0);
        }

        /* Mobile collage: 1 pre-composed image (both rows already baked in)
           instead of the desktop's individually-positioned cards + badges —
           swap one set of elements for the other outright rather than
           re-laying-out the same DOM. */
        .collage-row-top,
        .collage-image-3,
        .collage-image-4,
        .collage-row-bottom {
            display: none;
        }

        .hero-image-collage {
            zoom: 1;
            position: relative;
            width: 100%;
            height: auto;
        }

        .collage-mobile-row {
            display: block;
            /* Breaks out of .hero-container's padding to bleed full-width,
               regardless of --content-margin-inline's value at this breakpoint. */
            width: calc(100% + 2 * var(--content-margin-inline));
            margin-inline: calc(-1 * var(--content-margin-inline));
            height: auto;
        }
    }
</style>

<script>
    const btn = document.getElementById('hero-scroll-btn');
    if (btn) {
        btn.addEventListener('click', () => {
            const target = document.querySelector('.home-section-2') as HTMLElement | null;
            target?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
    }

    // Card 1 has 4 stat variants (1A-1D) baked as separate SVGs; pick one at random per load.
    const card1 = document.querySelector<HTMLImageElement>('.collage-image-1');
    if (card1) {
        const variants = ['1A', '1B', '1C', '1D'];
        const pick = variants[Math.floor(Math.random() * variants.length)];
        card1.src = card1.src.replace(/1\.svg$/, `${pick}.svg`);
    }
</script>
