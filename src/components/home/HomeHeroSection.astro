---
// src/components/home/HomeHeroSection.astro
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { t } from '../../lib/i18n/t';
import Button from '../shared/Button.astro';
import collage1 from '../../assets/svg/1.svg?url';
import collage2 from '../../assets/svg/2.svg?url';
import collage3 from '../../assets/svg/3.svg?url';
import collage4 from '../../assets/svg/4.svg?url';
import collage5 from '../../assets/svg/5.svg?url';

interface Props {
    locale: Locale;
    copy: CMSDictionary;
}

const { locale, copy } = Astro.props as Props;

const base = import.meta.env.BASE_URL;

const copyKeys = {
    title: 'hero_title',
    subtitle: 'hero_description',
    ctaPrimary: 'hero_cta_1',
    ctaSecondary: 'hero_cta_2',
};
---

<!-- Home Section 1: Hero with WebGL Noise Warp Background -->
<section class="hero-section home-section-1">
    <!-- WebGL Noise Warp Canvas (Three.js) -->
    <div
        id="webgl-background-11"
        class="webgl-background"
        data-webgl-variant="home"
        aria-hidden="true"
    >
    </div>

    <!-- Grain Overlay for Texture -->
    <div class="grain-overlay-11 grain-overlay" aria-hidden="true"></div>

    <!-- Hero Content and Collage -->
    <div class="hero-container">
        <div class="hero-content">
            <h1 class="hero-title" data-copy-key={copyKeys.title}>
                {t(copy, copyKeys.title, locale, 'The Standard for Media & Tech Insights')}
            </h1>
            <p class="hero-subtitle text-body-p0" data-copy-key={copyKeys.subtitle}>
                {
                    t(
                        copy,
                        copyKeys.subtitle,
                        locale,
                        "Real data on how Canadians consume tech, content, and media. Built for leaders who don't guess."
                    )
                }
            </p>
            <div class="hero-buttons">
                <Button
                    variant="primary"
                    size="lg"
                    href={`${base}${locale}/request-demo/`}
                    data-copy-key={copyKeys.ctaPrimary}
                    >{t(copy, copyKeys.ctaPrimary, locale, 'REQUEST A DEMO')}</Button
                >
                <Button
                    variant="scroll"
                    size="lg"
                    id="hero-scroll-btn"
                    data-copy-key={copyKeys.ctaSecondary}
                    >{t(copy, copyKeys.ctaSecondary, locale, 'EXPLORE MORE')}</Button
                >
            </div>
        </div>
        <div class="hero-image-collage">
            <img
                src={collage1}
                alt=""
                class="collage-image collage-image-1"
                loading="lazy"
                decoding="async"
            />
            <img
                src={collage2}
                alt=""
                class="collage-image collage-image-2"
                loading="lazy"
                decoding="async"
            />
            <img
                src={collage3}
                alt=""
                class="collage-image collage-image-3"
                loading="lazy"
                decoding="async"
            />
            <img
                src={collage4}
                alt=""
                class="collage-image collage-image-4"
                loading="lazy"
                decoding="async"
            />
            <img
                src={collage5}
                alt=""
                class="collage-image collage-image-5"
                loading="lazy"
                decoding="async"
            />
        </div>
    </div>

    <!-- Bottom White Gradient Overlay -->
    <div class="hero11-bottom-gradient" aria-hidden="true"></div>
</section>

<style is:global>
    .hero-section.home-section-1 {
        position: relative;
        margin-bottom: 0 !important;
        /* Same height contract as home-section-2: fill the screen when the
           viewport is ≥ 900px tall, hold a 900px floor below that. min-height
           (not height) so content can still grow it rather than clip. */
        height: auto;
        min-height: calc(max(100vh, 900px) - var(--navbar-height));
        display: flex;
        flex-direction: column;
        justify-content: center;
        overflow: hidden;
    }

    .hero11-gradient-gui {
        position: absolute;
        left: 20px;
        bottom: 20px;
        z-index: 30;
        background: rgba(255, 255, 255, 0.95);
        border-radius: var(--radius-s);
        box-shadow: var(--shadow-e2);
        padding: 14px 18px 10px 18px;
        min-width: 210px;
        max-width: 260px;
        user-select: none;
    }

    .hero11-bottom-gradient {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        width: 100%;
        height: 10vh;
        pointer-events: none;
        z-index: 10;
        background: linear-gradient(to top, rgba(255, 255, 255, 1) 0%, rgba(255, 255, 255, 0) 100%);
    }

    .home-section-1 .hero-container {
        position: relative;
        z-index: 20;
        width: 100%;
        padding: 0 var(--content-margin-inline);
        display: flex;
        align-items: center;
        gap: auto;
        justify-content: space-between;
    }

    .home-section-1 .hero-content {
        width: clamp(32rem, 38vw, 40rem);
        flex-shrink: 0;
        display: flex;
        flex-direction: column;
        align-self: center;
        gap: var(--hero-stack-gap);
    }

    .hero-image-collage {
        position: relative;
        width: 620px;
        height: 530px;
        opacity: 0;
        animation: fadeInUp 0.8s ease-out forwards;
        overflow: visible;
        padding-top: 0 !important;
        margin-top: 0 !important;
    }

    .collage-image {
        position: absolute;
        object-fit: cover;
        opacity: 0;
        animation: fadeInUp forwards;
        animation-play-state: paused;
        transition:
            transform 0.3s ease-out,
            box-shadow 0.3s ease-out;
        border-radius: var(--radius-s);
    }

    .collage-image:hover {
        transform: scale(1.08);
        box-shadow: var(--shadow-card);
    }

    .collage-image-1 {
        width: 141px;
        height: 122px;
        left: 153px;
        top: 0;
        z-index: 5;
    }

    .collage-image-2 {
        width: 314px;
        height: 348px;
        left: 306px;
        top: 0;
        z-index: 5;
    }

    .collage-image-3 {
        width: 211px;
        height: 31px;
        left: 409px;
        top: 360px;
        z-index: 5;
    }

    .collage-image-4 {
        width: 158px;
        height: 170px;
        left: 239px;
        top: 355px;
        z-index: 10;
    }

    .collage-image-5 {
        width: 287px;
        height: 346px;
        left: 7px;
        top: 134px;
        z-index: 1;
    }

    .hero-title-word {
        display: inline-block;
        opacity: 0;
        transform: translateY(20px);
        animation: wordAppear 0.6s ease-out forwards;
        animation-play-state: paused;
    }

    .hero-subtitle {
        color: var(--text-primary);
        margin: 0;
        opacity: 0;
        animation: fadeInUp 0.8s ease-out forwards;
        animation-play-state: paused;
    }

    .hero-buttons {
        display: flex;
        margin-top: var(--space-5);
        gap: var(--space-4);
        flex-wrap: wrap;
        opacity: 0;
        animation: fadeInUp 0.8s ease-out forwards;
        animation-play-state: paused;
    }

    @keyframes wordAppear {
        0% {
            opacity: 0;
            transform: translateY(20px);
        }
        100% {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes fadeInUp {
        0% {
            opacity: 0;
            transform: translateY(20px);
        }
        100% {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Desktop scaling: both columns scale via --hero-scale so proportions are preserved.
       Title uses clamp() only to cap growth above 1555px; everywhere else it tracks the scale. */

    /* At 1920px: root font jumps to 18px AND margins jump to 240px (inner width = 1440px).
       Without this cap, hero-content reaches 720px and zoomed collage hits 846px → 126px overflow.
       Fix: set a scale that keeps total items comfortably within 1440px. */
    @media (min-width: 1920px) {
        .home-section-1 .hero-container {
            --collage-scale: 1.1;
        }
        .home-section-1 .hero-content {
            width: 36rem; /* 648px at 18px root ≈ 45% of 1440px inner width */
        }
        .hero-image-collage {
            zoom: var(--collage-scale);
            flex-shrink: 0;
        }
    }

    /* Scale-up: 1555px → 1919px — collage grows faster, title grows gently */
    @media (min-width: 1555px) and (max-width: 1919px) {
        .home-section-1 .hero-container {
            --collage-scale: min(1.45, calc(1 + (100vw - 1555px) / 1000px));
        }

        .hero-title {
            /* stays at 4.5rem baseline, grows to 5.25rem max at 1920px */
            font-size: clamp(var(--fs-hero), calc(4.5rem + (100vw - 1555px) * 0.00211), 5.25rem);
        }

        .hero-subtitle {
            font-size: clamp(var(--fs-body-xl), calc(1.5rem + (100vw - 1555px) * 0.00068), 1.75rem);
        }

        .hero-image-collage {
            zoom: var(--collage-scale);
            flex-shrink: 0;
        }
    }

    /* Scale-down: 1555px → 1440px */
    @media (min-width: 1440px) and (max-width: 1554px) {
        .home-section-1 .hero-container {
            --hero-scale: calc(0.913 + (100vw - 1440px) / 1321px);
        }

        .hero-title {
            font-size: calc(var(--fs-hero) * var(--hero-scale));
        }

        .hero-subtitle {
            font-size: calc(var(--fs-body-xl) * var(--hero-scale));
        }

        .hero-image-collage {
            zoom: var(--hero-scale);
            flex-shrink: 0;
        }
    }

    /* Scale-down: 1439px → 1024px */
    @media (min-width: 1024px) and (max-width: 1439px) {
        .home-section-1 .hero-container {
            --hero-scale: calc(0.7 + (100vw - 1024px) / 1949px);
        }

        .hero-title {
            font-size: calc(var(--fs-hero) * var(--hero-scale));
        }

        .hero-subtitle {
            font-size: calc(var(--fs-body-xl) * var(--hero-scale));
        }

        .hero-image-collage {
            zoom: var(--hero-scale);
            flex-shrink: 0;
        }
    }

    @media (max-width: 1023px) {
        /* screen height is a minimum, not a cap — the collage may extend past it */
        .hero-section.home-section-1 {
            /* column mode keeps top-down block flow, no 900px floor */
            display: block;
            height: auto;
            min-height: var(--section-height-100);
        }

        .home-section-1 .hero-container {
            flex-direction: column;
            justify-content: flex-start;
            align-items: flex-start;
            gap: var(--space-8);
            padding-top: var(--section-pad-block);
            padding-bottom: var(--space-9);
            overflow: hidden;
        }

        .home-section-1 .hero-content {
            /* container already provides horizontal padding — no double indent */
            padding: 0;
            max-width: 100%;
            width: 100%;
            text-align: center;
        }

        .hero-buttons {
            display: grid;
            grid-template-columns: max-content;
            justify-content: center;
            gap: var(--space-3);
        }

        .hero-buttons .btn-size-lg {
            text-align: center;
            justify-content: center;
        }

        .hero-image-collage {
            align-self: center;
            flex-shrink: 0;
        }
    }

    /* Scale collage to fit within the content width in column layout */
    @media (max-width: 1023px) {
        .hero-image-collage {
            zoom: min(1, calc((100vw - 2 * var(--content-margin-inline)) / 620px));
        }
    }

    @media (max-width: 767px) {
        .home-section-1 .hero-container {
            padding-top: var(--space-7);
        }
    }
</style>

<script>
    const btn = document.getElementById('hero-scroll-btn');
    if (btn) {
        btn.addEventListener('click', () => {
            const target = document.querySelector('.home-section-2') as HTMLElement | null;
            target?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
    }
</script>
