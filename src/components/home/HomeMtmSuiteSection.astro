---
// src/components/home/HomeMtmSuiteSection.astro
// Figma node: 2:7413 — "Data Products" suite showcase with interactive product tabs
import { Image } from 'astro:assets';
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { t } from '../../lib/i18n/t';
import { icons } from '../../lib/icons/registry';
import Button from '../shared/Button.astro';
import Eyebrow from '../shared/Eyebrow.astro';
import ProductPill, { type ProductVariant } from '../shared/ProductPill.astro';
import ReportsTickerCard from './reports/ReportsTickerCard.astro';
import bg18 from '../../assets/images/home/mtm-suite/bg-product-18.webp';
import segments18 from '../../assets/images/home/mtm-suite/fg-product-18.webp';
import segments18Center from '../../assets/images/home/mtm-suite/fg-product-18-center.webp';
import line18 from '../../assets/images/home/mtm-suite/line-product-18.webp';
import bgJr from '../../assets/images/home/mtm-suite/bg-product-jr.webp';
import segmentsJr from '../../assets/images/home/mtm-suite/fg-product-jr.webp';
import segmentsJrCenter from '../../assets/images/home/mtm-suite/fg-product-jr-center.webp';
import lineJr from '../../assets/images/home/mtm-suite/line-product-jr.webp';
import bgNc from '../../assets/images/home/mtm-suite/bg-product-nc.webp';
import segmentsNc from '../../assets/images/home/mtm-suite/fg-product-nc.webp';
import segmentsNcCenter from '../../assets/images/home/mtm-suite/fg-product-nc-center.webp';
import lineNc from '../../assets/images/home/mtm-suite/line-product-nc.webp';
import bgCs from '../../assets/images/home/mtm-suite/bg-product-cs.webp';
import segmentsCs from '../../assets/images/home/mtm-suite/fg-product-cs.webp';
import segmentsCsCenter from '../../assets/images/home/mtm-suite/fg-product-cs-center.webp';
import lineCs from '../../assets/images/home/mtm-suite/line-product-cs.webp';

interface Props {
    locale: Locale;
    copy: CMSDictionary;
}

const { locale, copy } = Astro.props as Props;

const base = import.meta.env.BASE_URL;
// Lets the download-success page's "Go Back to Exploring" CTA return
// here instead of a hardcoded destination.
const reportDownloadHref = `${base}${locale}/insights/report-download/?from=${encodeURIComponent(`${base}${locale}/#reports-library`)}`;

const products = [
    {
        id: 'mtm18plus',
        nameKey: 'product_1_title',
        nameFallback: 'MTM 18+',
        descKey: 'product_1_description',
        descFallback:
            'Comprehensive data on Canadians aged 18 and older, covering media consumption, technology adoption, and digital behaviours',
        href: `${base}${locale}/products/mtm-18-plus`,
        bg: bg18,
        people: segments18,
        peopleCenter: segments18Center,
        line: line18,
    },
    {
        id: 'junior',
        nameKey: 'product_2_title',
        nameFallback: 'MTM Junior',
        descKey: 'product_2_description',
        descFallback: 'Insights into the media and technology habits of Canadians aged 2–17',
        href: `${base}${locale}/products/juniors`,
        bg: bgJr,
        people: segmentsJr,
        peopleCenter: segmentsJrCenter,
        line: lineJr,
        chevronFill: 'var(--badge-juniors)',
    },
    {
        id: 'newcomer',
        nameKey: 'product_3_title',
        nameFallback: 'MTM Newcomers',
        descKey: 'product_3_description',
        descFallback:
            'Research focused on Canadians who have arrived within the past five years, offering insights into settlement, media usage, and technology adoption',
        href: `${base}${locale}/products/newcomers`,
        bg: bgNc,
        people: segmentsNc,
        peopleCenter: segmentsNcCenter,
        line: lineNc,
        chevronFill: 'var(--badge-newcomers)',
    },
    {
        id: 'census',
        nameKey: 'product_4_title',
        nameFallback: 'MTM Census Tool',
        descKey: 'product_4_description',
        descFallback:
            'Comprehensive demographic and population data for enhanced analysis and targeting',
        href: `${base}${locale}/tools/census-tool`,
        bg: bgCs,
        people: segmentsCs,
        peopleCenter: segmentsCsCenter,
        line: lineCs,
        chevronFill: 'var(--badge-census)',
    },
];
---

<section class="mtm-suite-section">
    <div class="suite-section-header">
        <h2 class="suite-section-heading suite-fly-in" data-copy-key="package_title">
            {t(copy, 'package_title', locale, 'The MTM Suite')}
        </h2>
        <p class="suite-section-desc text-body-p0 suite-fly-in" data-copy-key="package_description">
            {t(copy, 'package_description', locale, 'Description about the MTM suite')}
        </p>
    </div>
    <div class="data-products row suite-fly-in">
        <!-- LEFT: Heading + product tabs -->
        <div class="products-left col col-12 col-lg-5">
            <Eyebrow>{t(copy, 'package_1_eyebrow', locale, 'Data Products')}</Eyebrow>

            <h3 class="suite-heading">
                {t(copy, 'package_1_title', locale, '41 Million Canadians Mapped')}
            </h3>

            <p class="products-desc text-body-p1" data-copy-key="package_1_description">
                {t(copy, 'package_1_description', locale, 'Description about the data products')}
            </p>

            <div class="suite-products" id="suiteProducts">
                {
                    products.map((product, i) => (
                        <div
                            class={`product-row${i === 0 ? ' active' : ''}`}
                            data-idx={i}
                            role="button"
                            tabindex="0"
                        >
                            <div class="product-row-inner">
                                <span class="product-chevron" aria-hidden="true">
                                    <svg
                                        width="100%"
                                        height="100%"
                                        viewBox="0 0 15 22"
                                        fill="none"
                                        xmlns="http://www.w3.org/2000/svg"
                                    >
                                        <g clip-path={`url(#clip-${product.id})`}>
                                            <path
                                                d="M3.86782 5.53252C4.79584 5.53252 5.54815 4.78021 5.54815 3.8522C5.54815 2.92418 4.79584 2.17188 3.86782 2.17188C2.93981 2.17188 2.1875 2.92418 2.1875 3.8522C2.1875 4.78021 2.93981 5.53252 3.86782 5.53252Z"
                                                fill={product.chevronFill ?? '#026BC4'}
                                            />
                                            <path
                                                d="M7.64712 9.31231C8.57514 9.31231 9.32744 8.56 9.32744 7.63198C9.32744 6.70397 8.57514 5.95166 7.64712 5.95166C6.7191 5.95166 5.9668 6.70397 5.9668 7.63198C5.9668 8.56 6.7191 9.31231 7.64712 9.31231Z"
                                                fill={product.chevronFill ?? '#026BC4'}
                                            />
                                            <path
                                                d="M3.86782 20.6502C4.79584 20.6502 5.54815 19.8979 5.54815 18.9699C5.54815 18.0419 4.79584 17.2896 3.86782 17.2896C2.93981 17.2896 2.1875 18.0419 2.1875 18.9699C2.1875 19.8979 2.93981 20.6502 3.86782 20.6502Z"
                                                fill={product.chevronFill ?? '#026BC4'}
                                            />
                                            <path
                                                d="M7.64712 16.8714C8.57514 16.8714 9.32744 16.1191 9.32744 15.1911C9.32744 14.263 8.57514 13.5107 7.64712 13.5107C6.7191 13.5107 5.9668 14.263 5.9668 15.1911C5.9668 16.1191 6.7191 16.8714 7.64712 16.8714Z"
                                                fill={product.chevronFill ?? '#026BC4'}
                                            />
                                            <path
                                                d="M11.4284 13.0921C12.3564 13.0921 13.1087 12.3398 13.1087 11.4118C13.1087 10.4838 12.3564 9.73145 11.4284 9.73145C10.5004 9.73145 9.74805 10.4838 9.74805 11.4118C9.74805 12.3398 10.5004 13.0921 11.4284 13.0921Z"
                                                fill={product.chevronFill ?? '#026BC4'}
                                            />
                                        </g>
                                        <defs>
                                            <clipPath id={`clip-${product.id}`}>
                                                <rect width="14.2353" height="22" fill="white" />
                                            </clipPath>
                                        </defs>
                                    </svg>
                                </span>
                                <ProductPill
                                    class="product-name"
                                    variant={
                                        (product.id === 'newcomer'
                                            ? 'newcomers'
                                            : product.id) as ProductVariant
                                    }
                                    size="large"
                                />
                                <Button
                                    variant="tertiary"
                                    href={product.href}
                                    tabindex="-1"
                                    aria-label={`Explore ${product.nameFallback}`}
                                >
                                    {t(copy, 'mtm_suite_cta', locale, 'EXPLORE MORE')}
                                </Button>
                            </div>
                            <div class="product-divider" aria-hidden="true">
                                <div class="product-progress" aria-hidden="true" />
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>

        <!-- RIGHT: Product image card -->
        <div class="products-right col col-12 col-lg-7" id="suiteRight">
            {
                products.map((product, i) => (
                    <div
                        class={`card-panel${i === 0 ? ' active' : ''}`}
                        data-idx={i}
                        aria-hidden={i !== 0 ? 'true' : 'false'}
                    >
                        <Image class="card-bg" src={product.bg} alt="" loading="lazy" />
                        {product.line && (
                            <Image
                                class="card-chart-svg"
                                src={product.line}
                                alt=""
                                aria-hidden="true"
                                loading="lazy"
                            />
                        )}
                        <p class="card-desc text-body-p0" data-copy-key={product.descKey}>
                            {t(copy, product.descKey, locale, product.descFallback)}
                        </p>
                        {product.people && (
                            <Image
                                class="card-people"
                                src={product.people}
                                alt={product.nameFallback}
                                loading="lazy"
                            />
                        )}
                    </div>
                ))
            }
        </div>
    </div>

    <!-- MOBILE: Data Products — vertical card stack, hidden on desktop -->
    <div class="data-products-mobile suite-fly-in">
        <div class="mobile-products-header">
            <Eyebrow>{t(copy, 'package_1_eyebrow', locale, 'Data Products')}</Eyebrow>
            <h3>
                {t(copy, 'package_1_title', locale, '41 Million Canadians Mapped')}
            </h3>
            <p class="products-desc text-body-p1" data-copy-key="package_1_description">
                {t(copy, 'package_1_description', locale, 'Description about the data products')}
            </p>
        </div>
        <div class="mobile-products-list">
            {
                products.map((product) => (
                    <a class="mobile-product-card" href={product.href}>
                        <div class="mobile-card-image">
                            <Image class="mobile-card-bg" src={product.bg} alt="" loading="lazy" />
                            {product.line && (
                                <Image
                                    class="mobile-card-chart"
                                    src={product.line}
                                    alt=""
                                    aria-hidden="true"
                                    loading="lazy"
                                />
                            )}
                            {product.peopleCenter && (
                                <Image
                                    class="mobile-card-people"
                                    src={product.peopleCenter}
                                    alt={product.nameFallback}
                                    loading="lazy"
                                />
                            )}
                        </div>
                        <div class="mobile-card-info">
                            <div class="mobile-card-text">
                                <div class="mobile-card-title-row">
                                    <span
                                        class="mobile-card-name text-body-p1-bold"
                                        data-copy-key={product.nameKey}
                                    >
                                        {t(copy, product.nameKey, locale, product.nameFallback)}
                                    </span>
                                    <span class="mobile-card-arrow" aria-hidden="true">
                                        <svg
                                            width="100%"
                                            height="100%"
                                            viewBox="0 0 20 20"
                                            fill="none"
                                            xmlns="http://www.w3.org/2000/svg"
                                        >
                                            <path
                                                d="M3 10H17M12 5L17 10L12 15"
                                                stroke="currentColor"
                                                stroke-width="1.5"
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                            />
                                        </svg>
                                    </span>
                                </div>
                                <span
                                    class="mobile-card-desc text-body-p2"
                                    data-copy-key={product.descKey}
                                >
                                    {t(copy, product.descKey, locale, product.descFallback)}
                                </span>
                            </div>
                        </div>
                    </a>
                ))
            }
        </div>
    </div>

    <div class="reports-library-bg suite-fly-in" id="reports-library">
        <div class="reports-library row">
            <!-- LEFT: Heading + description -->
            <div class="products-left col col-12 col-lg-5 reports-content">
                <Eyebrow>{t(copy, 'package_2_eyebrow', locale, 'Reports Library')}</Eyebrow>

                <h3 class="suite-heading">
                    {t(copy, 'package_2_title', locale, '70+ Reports every year')}
                </h3>

                <p class="reports-desc text-body-p1" data-copy-key="package_2_description">
                    {
                        t(
                            copy,
                            'package_2_description',
                            locale,
                            'Instantly tap into our repository of 70+ reports and infographics each year on a wide range of trends and demographic groups written in both official languages. Explore our latest report or download a free sneak peek report.'
                        )
                    }
                </p>

                <div class="reports-ctas reports-ctas-desktop">
                    <Button
                        variant="primary"
                        size="md"
                        href={reportDownloadHref}
                        data-copy-key="package_2_cta_2"
                    >
                        <span class="reports-cta-btn-inner">
                            {t(copy, 'package_2_cta_2', locale, 'SNEAK PEEK REPORT')}
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="16"
                                height="16"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true"
                            >
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                <polyline points="7 10 12 15 17 10"></polyline>
                                <line x1="12" y1="15" x2="12" y2="3"></line>
                            </svg>
                        </span>
                    </Button>
                    <Button
                        variant="tertiary"
                        href={`${base}${locale}/insights/`}
                        data-copy-key="package_2_cta_1"
                    >
                        {t(copy, 'package_2_cta_1', locale, 'GO TO INSIGHTS')}
                    </Button>
                </div>
            </div>

            <!-- RIGHT: Reports static image card -->
            <div class="products-right col col-12 col-lg-7">
                <div class="reports-image-card">
                    <img
                        class="reports-bg"
                        src={`${import.meta.env.BASE_URL}images/home/mtm-suite/reports-bg-dots.webp`}
                        alt=""
                        aria-hidden="true"
                        loading="lazy"
                        decoding="async"
                    />
                    <div class="reports-ticker-wrapper">
                        <ReportsTickerCard />
                    </div>
                    <img
                        class="reports-fg"
                        src={`${import.meta.env.BASE_URL}images/home/mtm-suite/reports-woman-fg.webp`}
                        alt=""
                        loading="lazy"
                        decoding="async"
                    />
                </div>
            </div>

            <!-- Bottom: CTAs -->
            <div class="col col-12 reports-ctas-row reports-ctas-mobile-row">
                <div class="reports-ctas">
                    <Button
                        variant="primary"
                        size="md"
                        href={reportDownloadHref}
                        data-copy-key="package_2_cta_2"
                    >
                        <span class="reports-cta-btn-inner">
                            {t(copy, 'package_2_cta_2', locale, 'SNEAK PEEK REPORT')}
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="16"
                                height="16"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true"
                            >
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                <polyline points="7 10 12 15 17 10"></polyline>
                                <line x1="12" y1="15" x2="12" y2="3"></line>
                            </svg>
                        </span>
                    </Button>
                    <Button
                        variant="tertiary"
                        href={`${base}${locale}/insights/`}
                        data-copy-key="package_2_cta_1"
                    >
                        {t(copy, 'package_2_cta_1', locale, 'GO TO INSIGHTS')}
                    </Button>
                </div>
            </div>
        </div>
    </div>
    <div class="tools-suite row suite-fly-in">
        <!-- LEFT: Heading + tool items -->
        <div class="products-left col col-12 col-lg-5">
            <Eyebrow>{t(copy, 'package_3_eyebrow', locale, 'Tools Suite')}</Eyebrow>

            <h3 class="suite-heading">
                {t(copy, 'package_3_title', locale, 'Your Data, Your Way.')}
            </h3>

            <p class="tools-description text-body-p1" data-copy-key="package_3_description">
                {
                    t(
                        copy,
                        'package_3_description',
                        locale,
                        "Don't just read the trends, discover them. Our proprietary toolset allows you to build custom views, forecast future shifts, and benchmark your audience against the national average."
                    )
                }
            </p>

            <div class="tools-items">
                {
                    [
                        {
                            titleKey: 'tools_item_1_title',
                            titleFallback: 'Data Analysis Tool',
                            variants: ['mtm18plus', 'junior', 'newcomers'] as const,
                            iconPath: icons.tool.dat,
                            href: `${base}${locale}/tools/analytic-tools/`,
                        },
                        {
                            titleKey: 'tools_item_2_title',
                            titleFallback: 'Trending Tool',
                            variants: ['mtm18plus', 'junior'] as const,
                            iconPath: icons.tool.trending,
                            href: `${base}${locale}/tools/analytic-tools/#trending-tool`,
                        },
                        {
                            titleKey: 'tools_item_3_title',
                            titleFallback: 'Forecasting Tool',
                            variants: ['mtm18plus'] as const,
                            iconPath: icons.tool.forecast,
                            href: `${base}${locale}/tools/analytic-tools/#forecasting-tool`,
                        },
                        {
                            titleKey: 'tools_item_4_title',
                            titleFallback: 'Census Tool',
                            variants: ['census'] as const,
                            iconPath: icons.tool.census,
                            href: `${base}${locale}/tools/census-tool/`,
                        },
                    ].map((tool) => (
                        <a class="tool-item" href={tool.href}>
                            <div class="tool-icon" aria-hidden="true">
                                <img
                                    src={`${import.meta.env.BASE_URL}${tool.iconPath}`}
                                    alt=""
                                    class="icon icon-4xl"
                                />
                            </div>
                            <div class="tool-content">
                                <div class="tool-header">
                                    <h4
                                        class="tool-title text-body-p1-bold"
                                        data-copy-key={tool.titleKey}
                                    >
                                        {t(copy, tool.titleKey, locale, tool.titleFallback)}
                                    </h4>
                                </div>
                                <div class="tool-tags">
                                    {tool.variants.map((variant) => (
                                        <ProductPill variant={variant} size="small" />
                                    ))}
                                </div>
                            </div>
                            <div class="tool-arrow" aria-hidden="true">
                                <svg
                                    width="100%"
                                    height="100%"
                                    viewBox="0 0 20 20"
                                    fill="none"
                                    xmlns="http://www.w3.org/2000/svg"
                                >
                                    <path
                                        d="M3 10H17M12 5L17 10L12 15"
                                        stroke="currentColor"
                                        stroke-width="1.5"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    />
                                </svg>
                            </div>
                        </a>
                    ))
                }
            </div>
        </div>

        <!-- RIGHT: Video card -->
        <div class="products-right col col-12 col-lg-7">
            <div class="tools-video-container">
                {/* TODO: Connect video asset when available */}
                <video
                    class="tools-video"
                    loop
                    muted
                    playsinline
                    aria-label="Tools suite demonstration"
                >
                    <source
                        src={`${import.meta.env.BASE_URL}images/home/tools-video.mp4`}
                        type="video/mp4"
                    />
                </video>
                <button
                    class="tools-video-play-btn"
                    aria-label="Play/pause video"
                    title="Play/pause"
                >
                    <svg
                        class="play-icon"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                    >
                        <path d="M8 5v14l11-7z" fill="currentColor"></path>
                    </svg>
                    <svg
                        class="pause-icon"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                    >
                        <path d="M6 4h4v16H6V4zm8 0h4v16h-4V4z" fill="currentColor"></path>
                    </svg>
                </button>
            </div>
        </div>
    </div>
</section>

<style>
    /* 12-column grid rows used by this section (moved from the deleted
       styles.css grid system — this was its only consumer) */
    .row {
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        gap: var(--space-5);
        margin-bottom: var(--space-6);
    }

    .col {
        display: flex;
        flex-direction: column;
    }

    .col-12 {
        grid-column: span 12;
    }

    @media (min-width: 768px) {
        .row {
            gap: var(--space-6);
        }
    }

    @media (min-width: 1024px) {
        .row {
            gap: var(--space-7);
        }

        .col-lg-5 {
            grid-column: span 5;
        }

        .col-lg-7 {
            grid-column: span 7;
        }
    }

    .pause-icon {
        display: none;
    }

    .suite-section-header {
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
    }

    .suite-section-heading {
        color: var(--text-primary);
        margin: 0;
    }

    .suite-section-desc {
        color: var(--text-primary);
        margin: 0;
        width: 60%;
    }

    .suite-fly-in {
        opacity: 0;
        transform: translateY(1.625rem);
        transition:
            opacity var(--motion-duration-heading) ease,
            transform var(--motion-duration-heading) var(--motion-ease-standard);
    }

    .suite-fly-in.is-visible {
        opacity: 1;
        transform: translateY(0);
    }

    /* Pause after h2 before data products appears */
    .data-products.suite-fly-in,
    .data-products-mobile.suite-fly-in {
        transition:
            opacity var(--motion-duration-heading) ease 0.9s,
            transform var(--motion-duration-heading) var(--motion-ease-standard) 0.9s;
    }

    .mtm-suite-section {
        width: 100%;
        /* top deliberately shallow — sits directly under the hero's animated background */
        padding: var(--space-5) var(--content-margin-inline) var(--section-pad-block);
        background: var(--surface-white);
        display: flex;
        flex-direction: column;
        /* references the same alias as reports-library-bg's own padding-block,
           so the two can't drift out of sync */
        gap: var(--section-pad-block);
    }

    .data-products {
        margin-bottom: 0;
        align-items: start;
    }

    .reports-library-bg {
        background: var(--surface-blue);
        margin-inline: calc(-1 * var(--content-margin-inline));
        padding-inline: var(--content-margin-inline);
        padding-block: var(--section-pad-block);
        scroll-margin-top: var(--navbar-height);
    }

    .reports-library {
        margin-bottom: 0;
        align-items: start;
        --reports-card-ratio: 16 / 10;
    }

    .reports-library .products-right {
        order: 1;
        height: auto;
        aspect-ratio: var(--reports-card-ratio);
    }

