</style>

<script>
    // h2 + data products fly in together; CSS transition-delay on data products creates the pause
    const suiteSection = document.querySelector<HTMLElement>('.mtm-suite-section');
    const suiteHeading = suiteSection?.querySelector<HTMLElement>('.suite-section-heading');
    const suiteDesc = suiteSection?.querySelector<HTMLElement>('.suite-section-desc');
    const dataProductsEls = suiteSection?.querySelectorAll<HTMLElement>(
        '.data-products, .data-products-mobile'
    );

    if (suiteHeading) {
        const headingObserver = new IntersectionObserver(
            ([entry]) => {
                if (entry.isIntersecting) {
                    suiteHeading.classList.add('is-visible');
                    suiteDesc?.classList.add('is-visible');
                    dataProductsEls?.forEach((el) => el.classList.add('is-visible'));
                    headingObserver.disconnect();
                }
            },
            { threshold: 0.5 }
        );
        headingObserver.observe(suiteHeading);
    }

    // Reports library and tools suite each trigger independently on scroll
    const remainingFlyIns = suiteSection?.querySelectorAll<HTMLElement>(
        '.reports-library-bg.suite-fly-in, .tools-suite.suite-fly-in'
    );
    const flyInObserver = new IntersectionObserver(
        (entries) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('is-visible');
                    flyInObserver.unobserve(entry.target);
                }
            });
        },
        { threshold: 0.5 }
    );
    remainingFlyIns?.forEach((el) => flyInObserver.observe(el));

    // Tools video play/pause control
    const toolsVideoContainers = document.querySelectorAll<HTMLElement>('.tools-video-container');
    toolsVideoContainers.forEach((container) => {
        const video = container.querySelector<HTMLVideoElement>('video');
        const playBtn = container.querySelector<HTMLButtonElement>('.tools-video-play-btn');
        const playIcon = playBtn?.querySelector<SVGElement>('.play-icon');
        const pauseIcon = playBtn?.querySelector<SVGElement>('.pause-icon');

        if (video && playBtn && playIcon && pauseIcon) {
            let manuallyPaused = false;

            const updateButton = () => {
                if (video.paused) {
                    playIcon.style.display = 'block';
                    pauseIcon.style.display = 'none';
                } else {
                    playIcon.style.display = 'none';
                    pauseIcon.style.display = 'block';
                }
            };

            playBtn.addEventListener('click', () => {
                if (video.paused) {
                    manuallyPaused = false;
                    video.play();
                } else {
                    manuallyPaused = true;
                    video.pause();
                }
            });

            video.addEventListener('play', updateButton);
            video.addEventListener('pause', updateButton);
            video.addEventListener('ended', updateButton);
            updateButton();

            // Play when video container is fully in view; pause when it leaves
            const videoObserver = new IntersectionObserver(
                (entries) => {
                    entries.forEach((entry) => {
                        if (entry.isIntersecting && !manuallyPaused) {
                            video.play();
                        } else if (!entry.isIntersecting) {
                            video.pause();
                        }
                    });
                },
                { threshold: 1.0 }
            );
            videoObserver.observe(container);
        }
    });

    // Original product carousel script
    const AUTO_ADVANCE_DELAY = 3000; // ms between auto-advances — change this to adjust timing

    const section = document.querySelector<HTMLElement>('.mtm-suite-section');
    if (section) {
        const rows = section.querySelectorAll<HTMLElement>('.product-row');
        const panels = section.querySelectorAll<HTMLElement>('.card-panel');
        let autoTimer: ReturnType<typeof setTimeout> | null = null;
        let autoLoopDone = false;

        function setProduct(idx: number) {
            rows.forEach((row, i) => {
                row.classList.toggle('active', i === idx);
                row.setAttribute('aria-selected', String(i === idx));
            });
            panels.forEach((panel, i) => {
                panel.classList.toggle('active', i === idx);
                panel.setAttribute('aria-hidden', String(i !== idx));
                const cta = rows[i]?.querySelector<HTMLAnchorElement>('.btn');
                if (cta) cta.tabIndex = i === idx ? 0 : -1;
            });
        }

        function resetProgress() {
            rows.forEach((row) => {
                const bar = row.querySelector<HTMLElement>('.product-progress');
                if (!bar) return;
                bar.style.transition = 'transform 0ms linear';
                bar.style.transform = 'scaleX(0)';
            });
        }

        function startProgress(idx: number) {
            const bar = rows[idx]?.querySelector<HTMLElement>('.product-progress');
            if (!bar) return;
            bar.getBoundingClientRect(); // force reflow so the scaleX(0) reset lands before transition starts
            bar.style.transition = `transform ${AUTO_ADVANCE_DELAY}ms linear`;
            bar.style.transform = 'scaleX(1)';
        }

        function scheduleNext(currentIdx: number) {
            if (currentIdx >= rows.length - 1) {
                setTimeout(() => {
                    autoLoopDone = true;
                }, AUTO_ADVANCE_DELAY);
                return;
            }
            autoTimer = setTimeout(() => {
                const next = currentIdx + 1;
                resetProgress();
                setProduct(next);
                startProgress(next);
                scheduleNext(next);
            }, AUTO_ADVANCE_DELAY);
        }

        function stopAuto() {
            if (autoTimer !== null) {
                clearTimeout(autoTimer);
                autoTimer = null;
            }
        }

        rows.forEach((row, idx) => {
            row.addEventListener('mouseenter', () => {
                if (!autoLoopDone) return;
                stopAuto();
                resetProgress();
                setProduct(idx);
            });
            row.addEventListener('keydown', (e) => {
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    stopAuto();
                    resetProgress();
                    setProduct(idx);
                }
            });
        });

        // Keyboard: arrow keys to navigate products
        section.addEventListener('keydown', (e) => {
            const active = [...rows].findIndex((r) => r.classList.contains('active'));
            if (e.key === 'ArrowDown' && active < rows.length - 1) {
                e.preventDefault();
                stopAuto();
                resetProgress();
                setProduct(active + 1);
                rows[active + 1].focus();
            } else if (e.key === 'ArrowUp' && active > 0) {
                e.preventDefault();
                stopAuto();
                resetProgress();
                setProduct(active - 1);
                rows[active - 1].focus();
            }
        });

        // Start auto-advance when section enters the viewport
        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        const current = [...rows].findIndex((r) => r.classList.contains('active'));
                        startProgress(current);
                        scheduleNext(current);
                    } else {
                        stopAuto();
                        resetProgress();
                    }
                });
            },
            { threshold: 0.3 }
        );
        observer.observe(section);
    }
</script>
