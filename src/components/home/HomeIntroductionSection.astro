---
// src/components/home/HomeIntroductionSection.astro
import ResearchTabsSection from './ResearchTabsSection.astro';
import type { CMSDictionary, Locale } from '../../lib/cms/types';

interface Props {
    locale: Locale;
    copy: CMSDictionary;
}

const { locale, copy } = Astro.props as Props;
---

<!-- Home Section 2: Hero with WebGL Noise Warp Background -->
<section class="hero-section home-section-2">
    <!-- WebGL Noise Warp Canvas (Three.js) -->
    <div
        id="webgl-background-10"
        class="webgl-background"
        data-webgl-variant="research"
        aria-hidden="true"
    >
    </div>

    <!-- Grain Overlay for Texture -->
    <div class="grain-overlay-10 grain-overlay" aria-hidden="true"></div>

    <!-- Top White Gradient Overlay -->
    <div class="hero10-top-gradient" aria-hidden="true"></div>

    <!-- Bottom White Gradient Overlay -->
    <div class="hero10-bottom-gradient" aria-hidden="true"></div>

    <ResearchTabsSection locale={locale} copy={copy} />
</section>

<style is:global>
    .hero10-top-gradient {
        position: absolute;
        left: 0;
        right: 0;
        top: 0;
        width: 100%;
        height: 30vh;
        pointer-events: none;
        z-index: 10;
        background: linear-gradient(
            to bottom,
            rgba(255, 255, 255, 1) 0%,
            rgba(255, 255, 255, 0) 100%
        );
    }

    .hero10-bottom-gradient {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        width: 100%;
        height: 10vh;
        pointer-events: none;
        z-index: 10;
        background: linear-gradient(to top, rgba(255, 255, 255, 1) 0%, rgba(255, 255, 255, 0) 100%);
    }

    .home-section-2 {
        position: relative;
        margin-top: 0 !important;
        width: 100%;
        /* Fill the screen above 900px viewport height; below that, hold at a
           900px floor instead of shrinking further. Still grows past either
           if content ever needs more — a hard height would clip it. */
        height: auto;
        min-height: calc(max(100vh, 900px) - var(--navbar-height));
        display: flex;
        flex-direction: column;
        justify-content: center;
        overflow: hidden;
        scroll-margin-top: calc(var(--navbar-height) + 2rem);
    }

    @media (max-width: 1023px) {
        .home-section-2 {
            min-height: 0;
        }
    }
</style>
