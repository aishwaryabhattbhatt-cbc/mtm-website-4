---
// src/components/home/reports/ReportsRow.astro
// Figma node: 1391:11858 — Single report row: thumbnail + title/date + product pill

import ProductPill from '../../shared/ProductPill.astro';
import DatePill from '../../shared/DatePill.astro';
import type { ProductVariant } from '../../shared/ProductPill.astro';
import type { CMSDictionary, Locale } from '../../../lib/cms/types';

interface Props {
    /** Report title */
    title: string;
    /** Publication date — string (e.g. "Dec 11, 2025") or Date object */
    date: string | Date;
    /** One or more product tag variants */
    products: ProductVariant | ProductVariant[];
    /** Thumbnail image URL */
    thumbnail: string;
    /** Alt text for thumbnail */
    thumbnailAlt?: string;
    /** Link URL for the row */
    href?: string;
    class?: string;
    copy?: CMSDictionary;
    locale?: Locale;
}

const {
    title,
    date,
    products,
    thumbnail,
    thumbnailAlt = '',
    href,
    class: className = '',
    copy,
    locale,
} = Astro.props;

const productList = Array.isArray(products) ? products : [products];

const Tag = href ? 'a' : 'div';
---

<Tag class={`reports-row${className ? ` ${className}` : ''}`} {...href ? { href } : {}}>
    <div class="reports-row__thumbnail">
        <img src={thumbnail} alt={thumbnailAlt} loading="lazy" decoding="async" />
    </div>

    <div class="reports-row__content">
        <div class="reports-row__top">
            <span class="reports-row__title text-body-p2">{title}</span>
            <DatePill date={date} responsive={true} />
        </div>
        <div class="reports-row__pills">
            {
                productList.map((v) => (
                    <ProductPill
                        variant={v}
                        size="small"
                        responsive={true}
                        copy={copy}
                        locale={locale}
                    />
                ))
            }
        </div>
    </div>
</Tag>

<style>
    .reports-row {
        display: flex;
        align-items: center;
        gap: calc(var(--card-pad-thin) * var(--reports-scale, 1));
        padding-block: calc(var(--card-pad-thin) * var(--reports-scale, 1));
        border-bottom: 0.75px solid var(--neutral-grey-3);
        text-decoration: none;
        color: inherit;
        width: 100%;
    }

    a.reports-row:hover .reports-row__title {
        text-decoration: underline;
    }

    /* Thumbnail */
    .reports-row__thumbnail {
        flex-shrink: 0;
        width: calc(7rem * var(--reports-scale, 1));
        height: calc(3.75rem * var(--reports-scale, 1));
        border-radius: var(--radius-xs);
        overflow: hidden;
        background: var(--neutral-grey-2, #e0e0e0);
    }

    .reports-row__thumbnail img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    /* Content column */
    .reports-row__content {
        flex: 1 0 0;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: calc(var(--title-desc-gap) * var(--reports-scale, 1));
    }

    /* Title + date row */
    .reports-row__top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: calc(var(--space-4) * var(--reports-scale, 1));
        white-space: nowrap;
    }

    .reports-row__title {
        color: var(--text-primary);
        font-size: calc(var(--fs-body-m) * var(--reports-scale, 1));
        line-height: var(--lh-relaxed);
        letter-spacing: var(--ls-body-md);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        min-width: 0;
    }

    .reports-row__pills {
        display: flex;
        flex-wrap: wrap;
        gap: calc(var(--space-2) * var(--reports-scale, 1));
    }
</style>
