---
import type { CMSDictionary, Locale } from '../../../lib/cms/types';
import RuntimeReportTemplate from '../../insights/RuntimeReportTemplate.astro';
import InsightsRuntime from '../../insights/InsightsRuntime.astro';
interface Props {
    class?: string;
    copy?: CMSDictionary;
    locale?: Locale;
}
const { class: className = '', copy = {}, locale = 'en' } = Astro.props;
---

<div class={`reports-ticker-card${className ? ` ${className}` : ''}`} data-insights-kind="ticker">
    <InsightsRuntime locale={locale} />
    <div class="reports-ticker-viewport">
        <div class="reports-ticker-track" data-insights-list></div>
    </div>
    <button
        type="button"
        class="insights-ticker-pause"
        data-ticker-pause
        aria-pressed="false"
        hidden
    >
        {locale === 'fr' ? 'Pause' : 'Pause'}
    </button>
    <RuntimeReportTemplate locale={locale} copy={copy} kind="row" />
</div>
<style>
    /* Card fills the wrapper exactly — height is controlled by the wrapper, not the ticker */
    .reports-ticker-card {
        background: var(--surface-white);
        border-radius: var(--radius-m) var(--radius-m) 0 0;
        padding-inline: var(--space-5);
        padding-top: var(--space-5);
        width: 100%;
        height: 100%;
    }

    /* Viewport fills the card's content area (below padding-top) */
    .reports-ticker-viewport {
        height: 100%;
        overflow: hidden;
        position: relative;
    }

    /* Fade out bottom edge */
    .reports-ticker-viewport::after {
        content: '';
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 3rem;
        pointer-events: none;
        z-index: 1;
        background: linear-gradient(to top, var(--surface-white), transparent);
    }

    .reports-ticker-track {
        display: flex;
        flex-direction: column;
        will-change: transform;
    }
</style>
