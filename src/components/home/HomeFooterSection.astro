---
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { t } from '../../lib/i18n/t';
import Button from '../shared/Button.astro';
import FormField from '../shared/FormField.astro';
import mtmLogo from '../../assets/svg/mtm-logo.svg?url';

interface Props {
    locale: Locale;
    copy: CMSDictionary;
}

const { locale, copy } = Astro.props as Props;
const base = import.meta.env.BASE_URL;
const currentYear = new Date().getFullYear();

const footerMenus = [
    {
        title: locale === 'fr' ? 'Entreprise' : 'Company',
        items: [
            { label: locale === 'fr' ? 'Accueil' : 'Home', href: `${base}${locale}/` },
            {
                label: locale === 'fr' ? 'À propos' : 'About Us',
                href: `${base}${locale}/about-us/`,
            },
            { label: locale === 'fr' ? 'Nouvelles' : 'News', href: `${base}${locale}/insights/` },
            {
                label: locale === 'fr' ? 'Contactez-nous' : 'Contact Us',
                href: `${base}${locale}/contact/`,
            },
        ],
    },
    {
        title: locale === 'fr' ? 'Produits' : 'Products',
        items: [
            { label: 'MTM 18+', href: `${base}${locale}/products/mtm-18-plus/` },
            { label: 'MTM Juniors', href: `${base}${locale}/products/juniors/` },
            { label: 'MTM Newcomers', href: `${base}${locale}/products/newcomers/` },
            {
                label: locale === 'fr' ? 'Census' : 'Census',
                href: `${base}${locale}/products/census/`,
            },
        ],
    },
    {
        title: locale === 'fr' ? 'Outils' : 'Tools',
        items: [
            {
                label: locale === 'fr' ? 'Analyse des données' : 'Data Analysis',
                href: `${base}${locale}/tools/`,
            },
            { label: locale === 'fr' ? 'Tendances' : 'Trending', href: `${base}${locale}/tools/` },
            {
                label: locale === 'fr' ? 'Prévisions' : 'Forecasting',
                href: `${base}${locale}/tools/`,
            },
            {
                label: locale === 'fr' ? 'Recensement' : 'Census',
                href: `${base}${locale}/products/census/`,
            },
        ],
    },
    {
        title: locale === 'fr' ? 'Solutions' : 'Solutions',
        items: [
            {
                label: t(copy, 'solutions_item_2', locale, 'Media'),
                href: `${base}${locale}/solutions/media/`,
            },
            {
                label: t(copy, 'solutions_item_3', locale, 'Advertising'),
                href: `${base}${locale}/solutions/advertising/`,
            },
            {
                label: t(copy, 'solutions_item_5', locale, 'Gov & NGOs'),
                href: `${base}${locale}/solutions/government-ngos/`,
            },
            {
                label: t(copy, 'solutions_item_4', locale, 'Education'),
                href: `${base}${locale}/solutions/education/`,
            },
            {
                label: t(copy, 'solutions_item_1', locale, 'Industry'),
                href: `${base}${locale}/solutions/industry/`,
            },
        ],
    },
    {
        title: locale === 'fr' ? 'Perspectives' : 'Insights',
        items: [
            {
                label: locale === 'fr' ? 'Vos perspectives' : 'Your Insights',
                href: `${base}${locale}/insights/`,
            },
        ],
    },
];
---

<footer class="home-footer">
    <img
        src={`${base}images/home/footer/footer-right.png`}
        class="home-footer__bg-right"
        aria-hidden="true"
        alt=""
    />
    <img
        src={`${base}images/home/footer/footer-left-center.png`}
        class="home-footer__bg-left-center"
        aria-hidden="true"
        alt=""
    />
    <img
        src={`${base}images/home/footer/footer-bottom-left.png`}
        class="home-footer__bg-bottom-left"
        aria-hidden="true"
        alt=""
    />

    <div class="home-footer__cta">
        <div class="home-footer__cta-card">
            <div class="home-footer__cta-copy">
                <p
                    class="home-footer__cta-eyebrow text-body-p1 footer-eyebrow-fly-in"
                    data-copy-key="cta_subtitle"
                >
                    {t(copy, 'cta_subtitle', locale, 'Ready to Get Started?')}
                </p>
                <h2
                    class="home-footer__cta-title text-subsection-h2 footer-title-fly-in"
                    data-copy-key="cta_title"
                >
                    {t(copy, 'cta_title', locale, 'Request a Demo Now.')}
                </h2>
            </div>

            <form
                class="home-footer__cta-form footer-form-fly-in"
                aria-label="Request a demo"
                data-submit-href={`${base}${locale}/contact/`}
            >
                <FormField
                    locale={locale}
                    copy={copy}
                    variant="field-only"
                    type="email"
                    name="email"
                    placeholderKey="footer_cta_email_placeholder"
                    placeholder="Enter your work email"
                    ariaLabel={t(copy, 'footer_cta_email_label', locale, 'Work email')}
                    emailValidation="submit-only"
                    required
                    class="home-footer__cta-email-field"
                />
                <Button variant="primary" type="submit" class="home-footer__cta-button">
                    {t(copy, 'cta_button', locale, 'Request a demo')}
                </Button>
            </form>
        </div>
    </div>

    <div class="home-footer__newsletter">
        <div class="home-footer__newsletter-container">
            <div class="home-footer__newsletter-content">
                <h2
                    class="home-footer__newsletter-title text-tertiary-h3"
                    data-copy-key="newsletter_title"
                >
                    {t(copy, 'newsletter_title', locale, 'Subscribe to our Newsletter')}
                </h2>
                <p
                    class="home-footer__newsletter-description text-body-p1"
                    data-copy-key="newsletter_description"
                >
                    {
                        t(
                            copy,
                            'newsletter_description',
                            locale,
                            'Subscribe to receive our exclusive insights, reports, and analysis directly to your inbox. Join the community of industry leaders staying ahead with MTM.'
                        )
                    }
                </p>
            </div>

            <form class="home-footer__newsletter-form" novalidate aria-label="Newsletter signup">
                <FormField
                    locale={locale}
                    copy={copy}
                    variant="field-with-label"
                    type="email"
                    name="email"
                    labelKey="newsletter_email_label"
                    label="Work Email"
                    placeholderKey="newsletter_email_placeholder"
                    placeholder="Enter your work email"
                    emailValidation="none"
                    required
                />

                <div class="home-footer__newsletter-controls">
                    <FormField
                        locale={locale}
                        copy={copy}
                        variant="field-only"
                        type="select"
                        name="industry"
                        placeholder="Select your industry"
                        options={[
                            {
                                value: '',
                                label: 'Select your industry',
                                labelKey: 'newsletter_industry_placeholder',
                            },
                            { value: 'media', label: 'Media', labelKey: 'solutions_item_2' },
                            {
                                value: 'advertising',
                                label: 'Advertising',
                                labelKey: 'solutions_item_3',
                            },
                            { value: 'govngo', label: 'Gov & NGOs', labelKey: 'solutions_item_5' },
                            {
                                value: 'education',
                                label: 'Education',
                                labelKey: 'solutions_item_4',
                            },
                            { value: 'industry', label: 'Industry', labelKey: 'solutions_item_1' },
                            {
                                value: 'other',
                                label: 'Other',
                                labelKey: 'newsletter_industry_other',
                            },
                        ]}
                    />
                    <Button variant="primary" type="submit" class="home-footer__newsletter-submit">
                        {t(copy, 'newsletter_submit', locale, 'Submit')}
                    </Button>

                    <p
                        class="home-footer__newsletter-email-error text-body-p3-small"
                        data-newsletter-email-error
                        aria-live="polite"
                        aria-hidden="true"
                    >
                        {
                            locale === 'fr'
                                ? 'Veuillez saisir une adresse courriel valide.'
                                : 'Please enter a valid email address.'
                        }
                    </p>
                </div>
            </form>
        </div>
    </div>

    <div class="home-footer__footer">
        <div class="home-footer__footer-container">
            <div class="home-footer__footer-left">
                <div class="home-footer__footer-menus">
                    {
                        footerMenus.map((menu) => (
                            <nav class="home-footer__footer-menu" aria-label={menu.title}>
                                <h3 class="home-footer__footer-menu-title text-body-p2">
                                    {menu.title}
                                </h3>
                                <ul class="home-footer__footer-menu-list">
                                    {menu.items.map((item) => (
                                        <li>
                                            <a
                                                class="home-footer__footer-menu-link text-body-p3"
                                                href={item.href}
                                            >
                                                {item.label}
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            </nav>
                        ))
                    }
                </div>
            </div>

            <div class="home-footer__footer-right">
                <a
                    href={`${base}${locale}/`}
                    class="home-footer__footer-logo"
                    aria-label="MTM home"
                >
                    <img src={mtmLogo} alt="MTM - Media Technology Monitor" />
                </a>

                <div class="home-footer__footer-address text-body-p2">
                    <span>Media Technology Monitor,</span>
                    <span>181 Queen St, Ottawa, Ontario, K1P1K9</span>
                    <a href="tel:1-855-898-4999">1-855-898-4999</a>
                </div>

                <a
                    class="home-footer__footer-linkedin text-body-p2"
                    href="https://www.linkedin.com/company/media-technology-monitor/"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="LinkedIn"
                >
                    in
                </a>

                <div
                    class="home-footer__footer-policies home-footer__footer-policies--mobile text-body-p2"
                >
                    <a href={`${base}${locale}/contact/`}>Site Policies</a>
                    <a href={`${base}${locale}/contact/`}>Privacy Policy</a>
                    <a href={`${base}${locale}/contact/`}>Terms &amp; Conditions</a>
                </div>
            </div>
        </div>

        <div class="home-footer__footer-meta">
            <p class="home-footer__footer-copyright text-body-p2">
                © {currentYear} Media Technology Monitor. All Rights Reserved. A division of CBC/Radio-Canada.
            </p>

            <div class="home-footer__footer-policies text-body-p2">
                <a href={`${base}${locale}/contact/`}>Site Policies</a>
                <span aria-hidden="true">|</span>
                <a href={`${base}${locale}/contact/`}>Privacy Policy</a>
                <span aria-hidden="true">|</span>
                <a href={`${base}${locale}/contact/`}>Terms &amp; Conditions</a>
            </div>
        </div>
    </div>
</footer>

<style>
    .home-footer {
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        background: var(--surface-white);
    }

    .home-footer__bg-right,
    .home-footer__bg-left-center,
    .home-footer__bg-bottom-left {
        position: absolute;
        pointer-events: none;
        z-index: 0;
    }

    .home-footer__bg-right {
        bottom: 0;
        right: 0;
        width: clamp(351px, 34.3vw, 658px);
        height: auto;
    }

    .home-footer__bg-left-center {
        left: 0;
        top: 33%;
        transform: translateY(-50%);
        width: clamp(1024px, 100vw, 1920px);
        height: auto;
    }

    .home-footer__bg-bottom-left {
        bottom: 0;
        left: 0;
        width: clamp(278px, 27.2vw, 522px);
        height: auto;
    }

    @media (max-width: 1023px) {
        .home-footer__bg-right,
        .home-footer__bg-left-center,
        .home-footer__bg-bottom-left {
            display: none;
        }
    }

    .home-footer__cta {
        position: relative;
        z-index: 1;
        padding: var(--space-12) var(--content-margin-inline);
        display: flex;
        justify-content: center;
    }

    .home-footer__cta-card {
        display: flex;
        width: min(100%, 90rem);
        padding: var(--space-12) var(--space-12);
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: var(--space-15);
        border-radius: var(--layout-card-radius);
        border: var(--stroke-1) solid rgba(255, 255, 255, 0.37);
        background: rgba(255, 255, 255, 0.39);
        backdrop-filter: blur(10px);
        box-shadow: var(--shadow-beautiful);
    }

    .home-footer__cta-copy {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--space-2);
        text-align: center;
    }

    .home-footer__cta-eyebrow,
    .home-footer__cta-title {
        margin: 0;
        color: var(--text-primary);
    }

    .home-footer__cta-title {
        max-width: 50rem;
    }

    .home-footer__cta-form {
        display: flex;
        align-items: flex-start;
        justify-content: center;
        gap: var(--space-5);
        width: 100%;
        max-width: 38rem;
    }

    .home-footer__cta-email-field {
        flex: 1;
        min-width: 0;
    }

    .home-footer__cta-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        white-space: nowrap;
        align-self: flex-start;
    }

    .home-footer__newsletter {
        position: relative;
        z-index: 1;
        padding: var(--space-12) var(--content-margin-inline);
        display: flex;
        justify-content: center;
    }

    .home-footer__newsletter-container {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        width: 100%;
        max-width: 90rem;
        gap: var(--space-11);
        align-items: start;
    }

    .home-footer__newsletter-content {
        grid-column: span 8;
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
    }

    .home-footer__newsletter-title {
        margin: 0;
        color: var(--text-primary);
    }

    .home-footer__newsletter-description {
        margin: 0;
        color: var(--text-secondary);
        max-width: 40rem;
    }

    .home-footer__newsletter-form {
        grid-column: span 4;
        display: flex;
        flex-direction: column;
        gap: var(--space-5);
        width: 100%;
    }

    .home-footer__newsletter-controls {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        column-gap: var(--space-5);
        row-gap: var(--space-2);
        align-items: center;
    }

    .home-footer__newsletter-controls > :first-child {
        flex: 1;
        min-width: 0;
    }

    .home-footer__newsletter-submit {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        white-space: nowrap;
        align-self: flex-end;
    }

    .home-footer__newsletter-email-error {
        grid-column: 1 / -1;
        margin: 0;
        padding: 0;
        color: var(--feedback-error);
        min-height: 1.4em;
        visibility: hidden;
        opacity: 0;
        transition: opacity 180ms ease;
    }

    .home-footer__newsletter-email-error.is-visible {
        visibility: visible;
        opacity: 1;
    }

    .home-footer__footer {
        position: relative;
        z-index: 1;
        padding: var(--space-11) var(--content-margin-inline) var(--space-12);
    }

    .home-footer__footer-container {
        width: min(100%, 90rem);
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: var(--space-11);
    }

    .home-footer__footer-left {
        grid-column: span 8;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        min-width: 0;
        gap: var(--space-9);
    }

    .home-footer__footer-menus {
        display: grid;
        grid-template-columns:
            minmax(0, 0.95fr) minmax(0, 0.9fr) minmax(0, 0.9fr) minmax(0, 1.35fr)
            minmax(0, 0.7fr);
        gap: var(--space-5);
    }

    .home-footer__footer-menu {
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
    }

    .home-footer__footer-menu-title {
        margin: 0;
        color: var(--text-primary);
    }

    .home-footer__footer-menu-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: var(--space-1);
    }

    .home-footer__footer-menu-link {
        color: var(--text-secondary);
        text-decoration: none;
    }

    .home-footer__footer-menu-link:hover {
        color: var(--text-primary);
    }

    .home-footer__footer-copyright {
        margin: 0;
        color: var(--neutral-grey-2);
    }

    .home-footer__footer-meta {
        width: min(100%, 90rem);
        margin: var(--space-8) auto 0;
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        align-items: center;
        gap: var(--space-11);
    }

    .home-footer__footer-meta .home-footer__footer-copyright {
        grid-column: span 8;
    }

    .home-footer__footer-right {
        grid-column: span 4;
        width: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: var(--space-3);
    }

    .home-footer__footer-logo {
        display: inline-flex;
        width: 9.5rem;
    }

    .home-footer__footer-logo img {
        width: 100%;
        height: auto;
        display: block;
    }

    .home-footer__footer-address {
        display: flex;
        flex-direction: column;
        gap: 0;
        color: var(--text-primary);
        margin: 0;
    }

    .home-footer__footer-address a {
        color: inherit;
        text-decoration: none;
    }

    .home-footer__footer-linkedin {
        width: 2rem;
        height: 2rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: var(--text-primary);
        color: var(--text-white);
        text-decoration: none;
        border-radius: var(--radius-s);
    }

    .home-footer__footer-policies {
        grid-column: span 4;
        display: flex;
        align-items: center;
        justify-content: flex-start;
        gap: var(--space-2);
        color: var(--neutral-grey-2);
        white-space: nowrap;
    }

    .home-footer__footer-policies--mobile {
        display: none;
    }

    .home-footer__footer-policies a {
        color: inherit;
        text-decoration: none;
    }

    .home-footer__footer-policies a:hover {
        color: var(--text-secondary);
    }

    @media (max-width: 1300px) {
        .home-footer__newsletter-container {
            grid-template-columns: 1fr;
            gap: var(--space-6);
        }

        .home-footer__newsletter-content {
            grid-column: auto;
        }

        .home-footer__newsletter-form {
            grid-column: auto;
            max-width: 25rem;
        }

        .home-footer__footer {
            padding-top: var(--space-9);
            padding-bottom: var(--space-8);
        }

        .home-footer__footer-container {
            grid-template-columns: 1fr;
            gap: var(--space-8);
        }

        .home-footer__footer-right {
            order: 1;
            grid-column: auto;
            width: 100%;
            gap: var(--space-5);
        }

        .home-footer__footer-logo {
            width: 6.625rem;
        }

        .home-footer__footer-address {
            gap: var(--space-0);
        }

        .home-footer__footer-policies--mobile {
            display: none;
        }

        .home-footer__footer-left {
            order: 2;
            grid-column: auto;
            gap: 0;
        }

        .home-footer__footer-menus {
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: var(--space-6) var(--space-6);
        }

        .home-footer__footer-meta {
            order: 3;
            margin-top: var(--space-8);
            grid-template-columns: 1fr;
            align-items: start;
            gap: var(--space-4);
        }

        .home-footer__footer-meta .home-footer__footer-copyright {
            grid-column: auto;
        }

        .home-footer__footer-meta .home-footer__footer-policies {
            display: flex;
            flex-direction: row;
            align-items: center;
            gap: var(--space-2);
            grid-column: auto;
            white-space: nowrap;
        }
    }

    @media (max-width: 767px) {
        .home-footer__cta {
            padding-top: var(--space-9);
            padding-bottom: var(--space-9);
        }

        .home-footer__cta-card {
            padding: var(--space-8) var(--space-5);
            gap: var(--space-7);
        }

        .home-footer__cta-form {
            flex-direction: column;
            align-items: stretch;
            gap: var(--space-3);
        }

        .home-footer__cta-button {
            width: 100%;
            text-align: center;
        }

        .home-footer__newsletter {
            padding-top: var(--space-9);
            padding-bottom: var(--space-9);
        }

        .home-footer__newsletter-container {
            grid-template-columns: 1fr;
            gap: var(--space-6);
        }

        .home-footer__newsletter-form {
            max-width: 100%;
            gap: var(--space-4);
        }

        .home-footer__newsletter-controls {
            grid-template-columns: 1fr;
            row-gap: var(--space-6);
        }

        .home-footer__newsletter-submit {
            align-self: stretch;
        }

        .home-footer__footer-menus {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: var(--space-6);
        }

        .home-footer__footer-right {
            gap: var(--space-4);
        }

        .home-footer__footer-policies {
            gap: var(--space-1);
        }

        .home-footer__footer-meta {
            margin-top: var(--space-6);
            align-items: flex-start;
            gap: var(--space-3);
        }
    }

    .footer-eyebrow-fly-in {
        opacity: 0;
        transform: translateY(1.625rem);
        transition:
            opacity 1.1s ease,
            transform 1.1s cubic-bezier(0.2, 0.7, 0.2, 1);
    }

    .footer-eyebrow-fly-in.is-visible {
        opacity: 1;
        transform: translateY(0);
    }

    .footer-title-fly-in {
        opacity: 0;
    }

    :global(.footer-title-word) {
        display: inline-block;
        opacity: 0;
        transform: translateY(8px);
        animation: footerWordAppear 1.4s cubic-bezier(0.22, 1, 0.36, 1) forwards;
        animation-play-state: paused;
    }

    @keyframes footerWordAppear {
        0% {
            opacity: 0;
            transform: translateY(8px);
        }
        100% {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .footer-form-fly-in {
        opacity: 0;
        transform: translateY(1.625rem);
        transition:
            opacity 1.1s ease,
            transform 1.1s cubic-bezier(0.2, 0.7, 0.2, 1);
    }

    .footer-form-fly-in.is-visible {
        opacity: 1;
        transform: translateY(0);
    }
</style>

<script>
    const ctaCard = document.querySelector<HTMLElement>('.home-footer__cta-card');
    const eyebrow = ctaCard?.querySelector<HTMLElement>('.footer-eyebrow-fly-in');
    const title = ctaCard?.querySelector<HTMLElement>('.footer-title-fly-in');
    const form = ctaCard?.querySelector<HTMLElement>('.footer-form-fly-in');

    const WORD_DELAY = 0.12;
    const WORD_DURATION = 1.4;

    if (ctaCard && eyebrow && title && form) {
        const ctaObserver = new IntersectionObserver(
            ([entry]) => {
                if (entry.isIntersecting) {
                    ctaObserver.disconnect();

                    // Split title into word spans immediately so plain text never flashes
                    title.removeAttribute('data-copy-key');
                    const words = (title.textContent ?? '').trim().split(/\s+/);
                    title.textContent = '';
                    words.forEach((word, i) => {
                        const span = document.createElement('span');
                        span.className = 'footer-title-word';
                        span.textContent = word;
                        span.style.animationDelay = `${i * WORD_DELAY}s`;
                        title.appendChild(span);
                        if (i < words.length - 1) title.appendChild(document.createTextNode(' '));
                    });
                    const totalTitleDuration = (words.length - 1) * WORD_DELAY + WORD_DURATION;

                    // 1. Eyebrow flies in and title typing start together
                    eyebrow.classList.add('is-visible');
                    (title as HTMLElement).style.opacity = '1';
                    setTimeout(() => {
                        title.querySelectorAll<HTMLElement>('.footer-title-word').forEach((el) => {
                            el.style.animationPlayState = 'running';
                        });

                        // 2. Form appears as last word lands (subtract drift buffer)
                        setTimeout(
                            () => form.classList.add('is-visible'),
                            totalTitleDuration * 1000 - 990
                        );
                    }, 10);
                }
            },
            { threshold: 0.3 }
        );
        ctaObserver.observe(ctaCard);
    }

    const ctaForm = document.querySelector<HTMLFormElement>('.home-footer__cta-form');
    if (ctaForm) {
        ctaForm.addEventListener('submit', (event) => {
            event.preventDefault();

            const emailInput = ctaForm.querySelector<HTMLInputElement>('input[type="email"]');
            if (emailInput?.checkValidity()) {
                const submitHref = ctaForm.dataset.submitHref;
                if (submitHref) {
                    window.location.href = submitHref;
                }
            } else {
                emailInput?.reportValidity();
            }
        });
    }

    const newsletterForm = document.querySelector<HTMLFormElement>('.home-footer__newsletter-form');
    if (newsletterForm) {
        const newsletterEmailInput =
            newsletterForm.querySelector<HTMLInputElement>('input[type="email"]');
        const newsletterEmailError = newsletterForm.querySelector<HTMLElement>(
            '[data-newsletter-email-error]'
        );

        function setNewsletterEmailError(visible: boolean) {
            if (!newsletterEmailError) return;
            newsletterEmailError.classList.toggle('is-visible', visible);
            newsletterEmailError.setAttribute('aria-hidden', visible ? 'false' : 'true');
        }

        newsletterForm.addEventListener('submit', (event) => {
            event.preventDefault();
            if (!newsletterEmailInput) return;

            if (newsletterEmailInput.checkValidity()) {
                setNewsletterEmailError(false);
            } else {
                setNewsletterEmailError(true);
            }
        });

        newsletterEmailInput?.addEventListener('input', () => {
            if (newsletterEmailInput.checkValidity()) {
                setNewsletterEmailError(false);
            }
        });
    }
</script>
