---
// ResearchTabsSection.astro
// Figma node: 1:9423 — "Access credible research on" animated section
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { t } from '../../lib/i18n/t';
import { icons } from '../../lib/icons/registry';

const base = import.meta.env.BASE_URL;
const techBox1Src = `${base}images/home/trusted/tab-1/dat-tool.webp`;
const techBox2Src = `${base}images/home/trusted/tab-1/chart-smartphone.webp`;
const techBox3Src = `${base}images/home/trusted/tab-1/chart-export-options.webp`;
const mediaBox1Src = `${base}images/home/trusted/tab-2/chart-audio-streaming.webp`;
const mediaBox2Src = `${base}images/home/trusted/tab-2/report-jr.webp`;

// Same badge-panel treatment as ProductsHeroSection/HomeHeroSection: a white
// rounded-square panel behind a centered line icon. Standing in for the
// bespoke "5,000+ variables" PNGs — a random draw from the shared icon
// library at build time instead of one custom asset per icon.
const panelSvg = `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 91 91'><defs><radialGradient id='g' cx='50%' cy='42%' r='78%'><stop offset='0%' stop-color='#ffffff'/><stop offset='60%' stop-color='#fdfeff'/><stop offset='100%' stop-color='#f5f8fc'/></radialGradient></defs><rect x='4' y='4' width='83' height='83' rx='10' fill='url(#g)' stroke='#eef2f8' stroke-width='1'/></svg>`;
const panelUrl = `url("data:image/svg+xml,${encodeURIComponent(panelSvg)}")`;

const variableIconPool = [
    icons['device-audio'].headphones,
    icons['device-audio'].smartSpeakers,
    icons['device-cellphone'].gaming,
    icons['device-cellphone'].selfie,
    icons['device-gaming'].online,
    icons['device-tablet'].brands,
    icons['device-tv'].connectedTv,
    icons['service-audio-podcast'].premium,
    icons['service-video-svod'].avod,
    icons['service-video-shortform'].like,
    icons['service-social'].likes,
    icons['service-news'].social,
    icons['demographics-group'].age,
    icons['demographics-group'].kid,
    icons['demographics-household'].withKids,
    icons.gen.trends,
    icons.gen.ai,
    icons.gen.multitasking,
    icons.gen.landline,
    icons.tool.dashboard,
    icons.tool.trending,
];

function pickRandomIcons(count: number): string[] {
    const shuffled = [...variableIconPool].sort(() => Math.random() - 0.5);
    return Array.from({ length: count }, (_, i) => shuffled[i % shuffled.length]);
}

const [varIcon1, varIcon2, varIcon3, varIcon4, varIcon5, ...extraVarIcons] = pickRandomIcons(
    13
).map((icon) => `${base}${icon}`);

interface Props {
    locale: Locale;
    copy: CMSDictionary;
}

const { locale, copy } = Astro.props as Props;

const tabs = [
    {
        labelKey: 'access_item_1_title',
        labelFallback: 'Technology Trends',
        bodyKey: 'access_item_1_description',
        bodyFallback:
            'Track rapid shifts across AI, devices, and platforms. Identify where consumer demand is moving next.',
    },
    {
        labelKey: 'access_item_2_title',
        labelFallback: 'Media Behaviour',
        bodyKey: 'access_item_2_description',
        bodyFallback:
            'Understand attention, viewing patterns, and engagement signals. See how audience habits evolve across channels.',
    },
    {
        labelKey: 'access_item_3_title',
        labelFallback: '5000+ variables',
        bodyKey: 'access_item_3_description',
        bodyFallback:
            'Explore a deep dataset spanning demographics, intent, and usage. Connect variables to uncover high-value opportunities.',
    },
];
---

<section class="research-section">
    <div class="content content-fly-in">
        <!-- LEFT: Heading + Topic Tabs -->
        <div class="left-text">
            <h2 class="heading heading-fly-in" data-copy-key="access_title">
                {t(copy, 'access_title', locale, 'Access credible research on')}
            </h2>
            <div class="tabs-panel">
                {
                    tabs.map((tab, i) => (
                        <div class="tab-item" data-tab={i}>
                            <span class="tab-label text-body-p0-bold" data-copy-key={tab.labelKey}>
                                {t(copy, tab.labelKey, locale, tab.labelFallback)}
                            </span>
                            <span class="tab-body-clip">
                                <span class="tab-body text-body-p1" data-copy-key={tab.bodyKey}>
                                    {t(copy, tab.bodyKey, locale, tab.bodyFallback)}
                                </span>
                            </span>
                        </div>
                    ))
                }
            </div>
        </div>

        <!-- RIGHT: Visual -->
        <div class="right-visual" id="rightVisual">
            <!-- Tab 0 + 1 + 2: shared boxes — positions/sizes animate between tabs -->
            <div class="custom-box-layout" id="boxVisual">
                <div
                    class="box box-lg box1"
                    data-tech={techBox1Src}
                    data-media={mediaBox1Src}
                    data-variables={varIcon1}
                >
                    <img src={techBox1Src} alt="Box 1" />
                </div>
                <div
                    class="box box-lg box2"
                    data-tech={techBox2Src}
                    data-media={mediaBox2Src}
                    data-variables={varIcon2}
                >
                    <img src={techBox2Src} alt="Box 2" />
                </div>
                <!-- Box 4-5: always the badge+icon treatment (same panel look
                     as the tab-2 variable badges below, just slightly
                     bigger). Box 3 is badge+icon everywhere EXCEPT tab 0
                     (Technology Trends), where it shows its own chart image
                     — data-tech/data-variables are read by setTab() to swap
                     it, and #boxVisual.tab0 .box3 below switches its visual
                     treatment from panel-badge to full-bleed image. -->
                <div class="box box-badge box3" data-tech={techBox3Src} data-variables={varIcon3}>
                    <img src={varIcon3} alt="" />
                </div>
                <div class="box box-badge box4">
                    <img src={varIcon4} alt="" />
                </div>
                <div class="box box-badge box5">
                    <img src={varIcon5} alt="" />
                </div>
                {
                    extraVarIcons.map((icon, i) => (
                        <div class={`box box-xs box${i + 6} box-variables-${i + 6}`}>
                            <img src={icon} alt="" />
                        </div>
                    ))
                }
            </div>
        </div>
    </div>
</section>

<style define:vars={{ 'panel-url': panelUrl }}>
    .research-section {
        width: 100%;
        padding: var(--space-9) var(--content-margin-inline);
        position: relative;
        z-index: 20;
    }

    @media (max-height: 750px) {
        .content {
            gap: var(--space-5);
        }

        .tabs-panel {
            gap: 0.625rem;
        }

        .tab-item {
            gap: var(--space-1);
        }
    }

    .heading {
        white-space: nowrap;
    }

    .heading-fly-in {
        opacity: 0;
        transform: translateY(1.625rem);
        transition:
            opacity var(--motion-duration-heading) ease,
            transform var(--motion-duration-heading) var(--motion-ease-standard);
        will-change: opacity, transform;
    }

    /* Restated locally: the global .is-visible in design-system.css has the same
       specificity as this component's scoped base rule above, so on a tie the
       component's `opacity: 0` wins on source order and the element never
       reveals. */
    .heading-fly-in.is-visible {
        opacity: 1;
        transform: translateY(0);
    }

    .content {
        display: flex;
        align-items: center;
        width: 100%;
        gap: var(--space-7);
    }

    .content-fly-in {
        opacity: 0;
        transform: translateY(1.625rem);
        transition:
            opacity var(--motion-duration-heading) ease 1s,
            transform var(--motion-duration-heading) var(--motion-ease-standard) 1s;
        will-change: opacity, transform;
    }

    .content-fly-in.is-visible {
        opacity: 1;
        /* `none` (not translateY(0)) and releasing will-change: a transformed
           ancestor blocks the tabs card's backdrop-filter from sampling the
           WebGL background behind it, so the glass blur silently stops working. */
        transform: none;
        will-change: auto;
    }

    .box-variables-6,
    .box-variables-7,
    .box-variables-8,
    .box-variables-9,
    .box-variables-10,
    .box-variables-11,
    .box-variables-12,
    .box-variables-13 {
        opacity: 0;
    }

    .box-variables-6 {
        left: 507px;
        top: 165px;
    }

    .box-variables-7 {
        left: 507px;
        top: 275px;
    }

    .box-variables-8 {
        left: 507px;
        top: 385px;
    }

    .box-variables-9 {
        left: 617px;
        top: 145px;
    }

    .box-variables-10 {
        left: 617px;
        top: 255px;
    }

    .box-variables-11 {
        left: 617px;
        top: 365px;
    }

    .box-variables-12 {
        left: 727px;
        top: 200px;
    }

    .box-variables-13 {
        left: 727px;
        top: 310px;
    }

    /* LEFT COLUMN: heading sits above the tabs panel */
    .left-text {
        display: flex;
        flex-direction: column;
        gap: var(--space-8);
        flex: 1 1 auto;
        /* No min-width: 0 here on purpose — .heading is white-space: nowrap,
           and the default flex min-width: auto keeps this column from ever
           shrinking narrower than the nowrap heading needs. Without it the
           heading silently overflows its box instead of the box growing to
           fit (confirmed happening with the live copy at ~1440-1620px). */
        max-width: 40rem;
    }

    /* TABS PANEL */
    .tabs-panel {
        position: relative;
        --tab-progress: 0%;
        --tab-progress-duration: 3000ms;
        display: flex;
        flex-direction: column;
        gap: var(--space-5);
        padding-left: var(--space-6);
    }

    .tabs-panel::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 0.375rem;
        border-radius: var(--radius-full);
        background: var(--color-divider);
    }

    .tabs-panel::after {
        content: '';
        position: absolute;
        left: 0;
        top: 0;
        width: 0.375rem;
        height: var(--tab-progress);
        border-radius: var(--radius-full);
        background: linear-gradient(
            to bottom,
            var(--color-chart-teal) 0%,
            var(--highcharts-color-5) 35.0962%,
            var(--brand-indigo) 65%,
            var(--badge-juniors) 90%
        );
        transition: height var(--tab-progress-duration) linear;
    }

    /* Row mode: glass card wraps heading + tabs panel, matching the footer CTA card */
    @media (min-width: 1024px) {
        .left-text {
            padding: var(--card-pad);
            border-radius: var(--layout-card-radius);
            border: var(--stroke-1) solid color-mix(in srgb, var(--surface-white) 37%, transparent);
            background: color-mix(in srgb, var(--surface-white) 39%, transparent);
            backdrop-filter: blur(10px);
        }

        .tabs-panel {
            /* left-text's own card padding already insets the panel by
               1x card-pad; add one more so text clears the progress bar
               the same as before the card padding moved up a level. */
            padding-left: var(--card-pad);
        }
    }

    .tab-item {
        color: var(--neutral-grey-3);
        cursor: pointer;
        transition: color 0.4s ease;
        user-select: none;
        white-space: normal;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        /* label↔body spacing lives inside the clip (as .tab-body padding-top)
           so collapsed tabs don't carry a phantom gap */
        gap: 0;
    }

    .tab-label {
        white-space: nowrap;
    }

    /* FAQ-accordion glide: clip animates height between 0 and the body's
       measured height (set from JS in setTab) */
    .tab-body-clip {
        display: block;
        width: 100%;
        height: 0;
        overflow: hidden;
        transition: height 450ms cubic-bezier(0.4, 0, 0.2, 1);
    }

    .tab-body {
        display: block;
        padding-top: 0.625rem;
        color: var(--text-secondary);
        max-width: none;
        width: 100%;
    }

    .tab-item:hover {
        color: var(--neutral-grey-2);
    }

    .tab-item.active {
        color: var(--text-primary);
    }

    .tab-item.is-disabled {
        color: var(--neutral-grey-3);
        pointer-events: none;
    }

    /* RIGHT VISUAL */
    .right-visual {
        position: relative;
        /* Matches normalizeBoxVisual()'s contentWidth (774px worst-case
           content span + 12px shadow margin) instead of the box canvas's
           full 860px — the boxes only ever occupied ~786px of that, so the
           container no longer carries dead space that used to sit between
           the content and the section's right margin.

           px, not rem — this whole canvas (this width, custom-box-layout,
           box-lg/xs/badge below) has to stay in lockstep with the box
           left/top positions the script sets, which are raw px and don't
           know about root font-size. Above 1920px the project's root font
           jumps to 18px, which would scale a rem-based canvas up ~12.5%
           while the positions stayed put — confirmed this clips box2 in
           tab 0 at 2036px. px keeps the whole illustration pixel-locked
           regardless of root font-size, matching #boxVisual.tab2 .box
           below, which was already px for the same reason. */
        flex: 0 0 786px;
        width: 786px;
        max-width: none;
        min-width: 0;
        margin-left: auto;
        overflow: hidden;
    }

    .custom-box-layout {
        position: relative;
        width: 860px;
        max-width: none;
        height: 600px;
        min-height: 400px;
        margin-left: 0;
    }
    .custom-box-layout .box {
        position: absolute;
        background: var(--color-box-bg);
        border: var(--stroke-1) solid var(--color-box-border);
        color: var(--text-white);
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        opacity: 0.85;
        overflow: hidden;
        /* Same drop-shadow as the tab-2 variable badges below (box-shadow
           tokens all carry a spread-radius, which filter: drop-shadow()
           doesn't support — hence the literal value here, matching that
           existing exception rather than introducing a mismatched one). */
        filter: drop-shadow(0 2px 4px rgba(27, 28, 29, 0.16));
        transition:
            left 1s cubic-bezier(0.25, 0.46, 0.45, 0.94),
            top 1s cubic-bezier(0.25, 0.46, 0.45, 0.94),
            width 0.75s cubic-bezier(0.25, 0.46, 0.45, 0.94),
            height 0.75s cubic-bezier(0.25, 0.46, 0.45, 0.94),
            opacity 0.6s ease;
    }

    .custom-box-layout .box img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        opacity: 1;
        transition: opacity 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }

    /* Remove box styling for image boxes (box1-13) */
    .custom-box-layout .box1,
    .custom-box-layout .box2,
    .custom-box-layout .box3,
    .custom-box-layout .box4,
    .custom-box-layout .box5,
    .custom-box-layout .box6,
    .custom-box-layout .box7,
    .custom-box-layout .box8,
    .custom-box-layout .box9,
    .custom-box-layout .box10,
    .custom-box-layout .box11,
    .custom-box-layout .box12,
    .custom-box-layout .box13 {
        background: transparent;
        border: none;
        opacity: 1;
        padding: 0;
        margin: 0;
        display: block;
        align-items: unset;
        justify-content: unset;
    }
    /* Tab 2: all boxes shrink to XS, no card — just the image */
    /* Same badge-panel look as ProductsHeroSection/HomeHeroSection's floating
       badges: a white rounded-square panel (--panel-url) behind a centered
       icon, instead of a full-bleed photo — only in the variables tab, so
       tab0/tab1's real screenshots on box1-5 are untouched. */
    #boxVisual.tab2 .box {
        /* 1.25x the original 90px — positions/stride below are unchanged,
           so badges sit slightly closer together than the grid comment's
           110px stride assumed (112.5px box vs 110px stride). */
        width: 112.5px;
        height: 112.5px;
        background-image: var(--panel-url);
        background-repeat: no-repeat;
        background-size: 100% 100%;
        border: none;
        border-radius: var(--radius-s);
        filter: drop-shadow(0 2px 4px rgba(27, 28, 29, 0.16));
        opacity: 1;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* box1-13: all badge-panel boxes in tab2 */
    #boxVisual.tab2 .box1,
    #boxVisual.tab2 .box2,
    #boxVisual.tab2 .box3,
    #boxVisual.tab2 .box4,
    #boxVisual.tab2 .box5,
    #boxVisual.tab2 .box6,
    #boxVisual.tab2 .box7,
    #boxVisual.tab2 .box8,
    #boxVisual.tab2 .box9,
    #boxVisual.tab2 .box10,
    #boxVisual.tab2 .box11,
    #boxVisual.tab2 .box12,
    #boxVisual.tab2 .box13 {
        background-image: var(--panel-url);
        background-repeat: no-repeat;
        background-size: 100% 100%;
        border: none;
        opacity: 1;
        padding: 0;
        margin: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* Icon centered at ~55% of the badge, matching ProductsHeroSection's
       badge-icon ratio, instead of filling the box edge-to-edge. */
    #boxVisual.tab2 .box img {
        object-fit: contain;
        padding: 0;
        width: 55%;
        height: 55%;
    }

    /* Hide label text when in grid mode */
    #boxVisual.tab2 .box span {
        opacity: 0;
        transition: opacity 0.25s ease;
    }
    .custom-box-layout .box-lg {
        width: 400px;
        height: 400px;
    }
    .custom-box-layout .box-xs {
        width: 90px;
        height: 90px;
    }

    /* Boxes 3-5: the same badge-panel look as the tab-2 variable badges
       (#boxVisual.tab2 .box below), just slightly bigger (7rem vs their
       5.625rem) since only 2-3 of these sit alongside the big screenshot
       here instead of a tight 13-badge grid. Box 3 overrides back to a
       full-bleed image in tab 0 only — see #boxVisual.tab0 .box3 below. */
    .custom-box-layout .box-badge {
        width: 112px;
        height: 112px;
        background-image: var(--panel-url);
        background-repeat: no-repeat;
        background-size: 100% 100%;
        border: none;
        border-radius: var(--radius-s);
        /* .box3/.box4/.box5 above resets display to block (meant for the
           full-bleed screenshot boxes, where centering doesn't matter) —
           same specificity, so re-declare centering here to win by source
           order and actually center the icon. */
        display: flex;
        align-items: center;
        justify-content: center;
        /* These are small icon badges, not 400px screenshot cards — the
           base .box transition above (1s/0.75s, tuned for box1/2's heavy
           dramatic reveal) reads as sluggish at this size, and doesn't
           cover transform at all. Lighter weight gets a lighter, quicker
           transition, using the project's own card-motion tokens. */
        transform: scale(1);
        transition:
            left var(--motion-duration-card) var(--motion-ease-standard),
            top var(--motion-duration-card) var(--motion-ease-standard),
            width var(--motion-duration-card) var(--motion-ease-standard),
            height var(--motion-duration-card) var(--motion-ease-standard),
            opacity var(--motion-duration-card) var(--motion-ease-standard),
            transform var(--motion-duration-card) var(--motion-ease-standard);
    }

    /* Slightly smaller than the other badges (6rem vs 7rem) — only applies
       outside tab 2, where #boxVisual.tab2 .box's 90px override still wins
       for the shared 13-badge grid. */
    .custom-box-layout .box-badge.box4 {
        width: 96px;
        height: 96px;
    }

    /* Tab 0 only: box5 has no content there (tech tab has no 5th image),
       so it's hidden instead of repositioned. A scale+opacity fade (not
       display:none, which can't transition) so it settles in/out smoothly
       like every other box, instead of hard-cutting in when leaving tab0. */
    .custom-box-layout.tab0 .box5 {
        opacity: 0;
        transform: scale(0.7);
        pointer-events: none;
    }

    .custom-box-layout .box-badge img {
        object-fit: contain;
        width: 55%;
        height: 55%;
    }

    /* Tab 0 only: box 3 switches from panel-badge to a full-bleed chart
       image — no card background/border framing it, just the image itself.
       #boxVisual gets .tab0 in setTab(), giving this the ID specificity to
       win over .box-badge. */
    #boxVisual.tab0 .box3 {
        /* 1.5x .box-badge's 112px */
        width: 168px;
        height: 168px;
        background-image: none;
        background: transparent;
        border: none;
    }

    #boxVisual.tab0 .box3 img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    /* Tab 2 still shrinks everything (including box3-5) to the shared
       90px badge grid size via #boxVisual.tab2 .box below, so no override
       needed here for that state. */

    /* Positioning for demo, adjust as needed */
    .custom-box-layout .box1 {
        left: 199px;
        top: 139px;
    }
    .custom-box-layout .box2 {
        left: 529px;
        top: 86px;
    }
    .custom-box-layout .box3 {
        left: 349px;
        top: 56px;
    }
    .custom-box-layout .box4 {
        left: 247px;
        top: 480px;
    }
    .custom-box-layout .box5 {
        left: 740px;
        top: 439px;
    }

    /* ─── Row-mode proportional scale-down ─── */
    /* Only .right-visual gets an explicit shrink formula — the box images
       need to visually get smaller (normalizeBoxVisual() below reads this
       width to scale/position them), text doesn't. .left-text stays
       flex: 1 1 auto (its base rule), so it just fills whatever width is
       left after .right-visual and the gap are subtracted, and its text
       reflows normally at full size within that. No transform anywhere in
       this range.

       Giving .left-text its own independent width formula (instead of
       filling the remainder) was tried and reverted — two independently
       shrinking widths don't sum back to the row's available width, and
       the leftover became dead space via .right-visual's margin-left:
       auto, visibly disconnecting the two columns at the narrow end of
       the range. Filling the remainder is what guarantees no leftover gap
       and no overflow, at the cost of not shrinking at exactly the same
       rate as .right-visual — an acceptable trade next to a broken layout.

       .heading is white-space: nowrap outside this range for a one-line
       title, but that can't hold while .left-text's fluid width is being
       squeezed by .right-visual's shrink — confirmed the real heading
       copy overflows its own box (not just wraps) right at the edges of
       this range. Allowing wrap here, same as mobile, is what keeps that
       safe without re-introducing the leftover-gap problem a min-width
       floor would cause. */

    /* Range 1: 1440–1554px. Scale interpolates 1.0 → 0.913 */
    @media (min-width: 1440px) and (max-width: 1554px) {
        .research-section {
            --research-scale: calc(0.913 + (100vw - 1440px) / 1321px);
        }
        .right-visual {
            flex: 0 0 auto;
            width: calc(var(--research-scale) * 786px);
            max-width: none;
        }
        .heading {
            white-space: normal;
        }
    }

    /* Range 2: 1024–1439px. Scale interpolates 0.913 → 0.541 */
    @media (min-width: 1024px) and (max-width: 1439px) {
        .research-section {
            --research-scale: calc(0.541 + (100vw - 1024px) / 1115px);
        }
        .right-visual {
            flex: 0 0 auto;
            width: calc(var(--research-scale) * 786px);
            max-width: none;
        }
        .heading {
            white-space: normal;
        }
    }

    /* ─── Column mode: ≤ 1023px ─── */
    @media (max-width: 1023px) {
        .research-section {
            padding-top: var(--section-pad-block);
            padding-bottom: var(--section-pad-block);
        }

        .content {
            flex-direction: column;
            gap: 1.875rem;
        }

        .right-visual {
            flex: 0 0 auto;
            width: 100%;
            max-width: 100%;
            height: auto;
            overflow: hidden;
            order: -1;
        }

        .custom-box-layout {
            width: 100%;
            min-height: 20rem;
        }

        .heading {
            text-align: center;
            white-space: normal;
        }

        .left-text {
            width: 23.4375rem;
            max-width: 100%;
            /* .tab-label is still nowrap here (heading isn't, it's reset
               above) — restore the default flex min-width guard so a long
               label can't force the column past 100% on narrow phones. */
            min-width: 0;
            align-self: center;
        }

        .tabs-panel {
            padding-left: 0;
            padding-top: var(--space-6);
            align-items: center;
        }

        /* Rotate progress bar to horizontal, placed above tabs */
        .tabs-panel::before {
            left: 0;
            right: 0;
            top: 0;
            bottom: auto;
            width: 100%;
            height: 0.375rem;
        }

        .tabs-panel::after {
            left: 0;
            top: 0;
            bottom: auto;
            width: var(--tab-progress);
            height: 0.375rem;
            background: linear-gradient(
                to right,
                var(--color-chart-teal) 0%,
                var(--highcharts-color-5) 35.0962%,
                var(--brand-indigo) 65%,
                var(--badge-juniors) 90%
            );
            transition: width var(--tab-progress-duration) linear;
        }

        .tab-item {
            align-items: center;
        }

        .tab-body {
            text-align: center;
        }
    }

    @media (max-width: 767px) {
        .research-section {
            padding-top: var(--space-8);
            padding-bottom: var(--space-8);
        }

        .tabs-panel {
            padding-left: 0;
            padding-top: var(--space-6);
            gap: var(--space-4);
        }
    }
</style>

<script>
    let currentTab = -1;
    const TAB_DURATION_MS = 3000;
    const tabs = document.querySelectorAll<HTMLElement>('.tab-item');
    const section = document.querySelector<HTMLElement>('.research-section');
    const heading = section?.querySelector<HTMLElement>('.heading-fly-in');
    const contentBlock = section?.querySelector<HTMLElement>('.content-fly-in');
    const tabsPanel = section?.querySelector<HTMLElement>('.tabs-panel');

    function normalizeBoxVisual() {
        const boxVisual = document.getElementById('boxVisual') as HTMLElement | null;
        const container = document.getElementById('rightVisual') as HTMLElement | null;
        if (!boxVisual || !container) return;

        // Content spans x=176 (tab0 box1) to x=950 (tab1 box2: left 550 +
        // 400 width) across every tab state. shadowMargin reserves room past
        // that tightest edge for the boxes' drop-shadow — container
        // overflow:hidden was clipping it when the edge landed exactly on
        // the crop bounds with zero spare pixels. Now that the container is
        // sized tight to the content (no leftover centering slack to absorb
        // slop), this has to be the true worst-case edge across all three
        // tabs, not just tab0's.
        const shadowMargin = 12;
        const contentMinX = 176;
        const contentWidth = 950 - contentMinX + shadowMargin;
        const containerWidth = container.clientWidth || boxVisual.clientWidth || 860;
        const scale = Math.min(1, containerWidth / contentWidth);
        // Flush right against the container's right edge instead of centered —
        // the same uniform translateX still shifts every box by one shared
        // amount, so their positions relative to each other are untouched.
        const offsetX = containerWidth - (contentMinX + contentWidth) * scale;

        boxVisual.style.transformOrigin = 'top left';
        boxVisual.style.transform = `translateX(${offsetX}px) scale(${scale})`;

        // 610px covers the tallest content (tab1 box4 bottom = 482+120 = 602px)
        container.style.height = Math.ceil((610 + shadowMargin) * scale) + 'px';
    }

    function syncTabBodyHeights(activeIdx: number) {
        tabs.forEach((t, i) => {
            const clip = t.querySelector<HTMLElement>('.tab-body-clip');
            const body = t.querySelector<HTMLElement>('.tab-body');
            if (!clip || !body) return;
            // scrollHeight, not getBoundingClientRect() — the latter is
            // transform-aware, and .content gets scaled down by an ancestor
            // in the row-mode breakpoints below. Reading a post-transform
            // height back into an inline style on a descendant of that same
            // transform double-shrinks it, clipping the text.
            clip.style.height = i === activeIdx ? body.scrollHeight + 'px' : '0';
        });
    }

    function setTab(idx: number, progressDurationMs = TAB_DURATION_MS) {
        if (idx === currentTab) return;
        currentTab = idx;
        tabs.forEach((t, i) => t.classList.toggle('active', i === idx));
        syncTabBodyHeights(idx);

        const boxVisual = document.getElementById('boxVisual');
        const extraBoxIds = ['box6', 'box7', 'box8', 'box9', 'box10', 'box11', 'box12', 'box13'];

        if (idx === 0 || idx === 1) {
            // Leave tab2 mode — restore sizes, hide extra boxes
            boxVisual?.classList.remove('tab2');
            boxVisual?.classList.toggle('tab0', idx === 0);
            extraBoxIds.forEach((id) => {
                const box = document.querySelector<HTMLElement>(`#boxVisual .${id}`);
                if (box) box.style.opacity = '0';
            });
            // Animate boxes 1-5 to their tab positions
            const targetPositions = idx === 0 ? boxPositions : tab1BoxPositions;
            (Object.keys(targetPositions) as BoxId[]).forEach((id) =>
                updateBoxPosition(id, idx as 0 | 1)
            );

            // Switch images based on tab with crossfade effect. Box4/5 are
            // permanent badge+icon, so only box1-3 have sources to swap.
            // Box3 has no data-media — it falls back to its badge icon
            // (data-variables) for tab 1, since it's only a real chart in
            // tab 0 (see the #boxVisual.tab0 .box3 CSS override below).
            ['box1', 'box2', 'box3'].forEach((id) => {
                const box = document.querySelector<HTMLElement>(`#boxVisual .${id}`);
                if (!box) return;
                const img = box.querySelector<HTMLImageElement>('img');
                if (!img) return;

                // Fade out
                img.style.opacity = '0';

                // Switch source after fade starts (300ms for longer crossfade)
                setTimeout(() => {
                    if (idx === 0) {
                        img.src = box.getAttribute('data-tech') || img.src;
                    } else if (idx === 1) {
                        img.src =
                            box.getAttribute('data-media') ||
                            box.getAttribute('data-variables') ||
                            img.src;
                    }
                    // Fade back in
                    img.style.opacity = '1';
                }, 300);
            });
        } else {
            // Tab 2: shrink all boxes, stagger into 5-column grid (2|3|3|3|2)
            boxVisual?.classList.add('tab2');
            boxVisual?.classList.remove('tab0');

            // Crossfade box1-3 images to their variables icons (same timing
            // as tab0→1) — box3 needs this too since a direct tab0→tab2
            // click would otherwise leave its chart image loaded underneath
            // the badge styling. Box4/5 already show their icon permanently.
            ['box1', 'box2', 'box3'].forEach((id) => {
                const box = document.querySelector<HTMLElement>(`#boxVisual .${id}`);
                if (!box) return;
                const img = box.querySelector<HTMLImageElement>('img');
                if (!img) return;
                img.style.opacity = '0';
                setTimeout(() => {
                    img.src = box.getAttribute('data-variables') || img.src;
                    img.style.opacity = '1';
                }, 300);
            });

            // Col 1 (box1, box2) — immediate
            (['box1', 'box2'] as BoxId[]).forEach((id) => {
                const box = document.querySelector<HTMLElement>(`#boxVisual .${id}`);
                if (box) {
                    box.style.left = tab2BoxPositions[id].left + 'px';
                    box.style.top = tab2BoxPositions[id].top + 'px';
                }
            });

            // Col 2 (box3, box4, box5) — shortly after
            setTimeout(() => {
                (['box3', 'box4', 'box5'] as BoxId[]).forEach((id) => {
                    const box = document.querySelector<HTMLElement>(`#boxVisual .${id}`);
                    if (box) {
                        box.style.left = tab2BoxPositions[id].left + 'px';
                        box.style.top = tab2BoxPositions[id].top + 'px';
                    }
                });
            }, 80);

            // Col 3 CENTER (box6, box7, box8) — slightly delayed for center stagger
            ['box6', 'box7', 'box8'].forEach((id, i) => {
                const box = document.querySelector<HTMLElement>(`#boxVisual .${id}`);
                const pos = tab2ExtraPositions[id];
                if (!box || !pos) return;
                box.style.left = pos.left + 'px';
                box.style.top = pos.top + 'px';
                setTimeout(
                    () => {
                        box.style.opacity = '1';
                    },
                    300 + i * 80
                );
            });

            // Col 4 (box9, box10, box11)
            ['box9', 'box10', 'box11'].forEach((id, i) => {
                const box = document.querySelector<HTMLElement>(`#boxVisual .${id}`);
                const pos = tab2ExtraPositions[id];
                if (!box || !pos) return;
                box.style.left = pos.left + 'px';
                box.style.top = pos.top + 'px';
                setTimeout(
                    () => {
                        box.style.opacity = '1';
                    },
                    470 + i * 80
                );
            });

            // Col 5 (box12, box13)
            ['box12', 'box13'].forEach((id, i) => {
                const box = document.querySelector<HTMLElement>(`#boxVisual .${id}`);
                const pos = tab2ExtraPositions[id];
                if (!box || !pos) return;
                box.style.left = pos.left + 'px';
                box.style.top = pos.top + 'px';
                setTimeout(
                    () => {
                        box.style.opacity = '1';
                    },
                    650 + i * 80
                );
            });
        }

        // Switch GUI section
        ['guiTab0', 'guiTab1', 'guiTab2'].forEach((id, i) => {
            const el = document.getElementById(id);
            if (el) el.style.display = i === idx ? '' : 'none';
        });
        const guiTabLabel = document.getElementById('guiTabLabel');
        const tabNames = ['Technology Trends', 'Media Behaviour', '5000+ variables'];
        if (guiTabLabel) guiTabLabel.textContent = tabNames[idx] ?? '';

        updateTabProgressBar(idx, progressDurationMs);
    }

    function updateTabProgressBar(idx: number, durationMs = TAB_DURATION_MS, immediate = false) {
        if (!tabsPanel) return;
        const progress = ((idx + 1) / 3) * 100;
        tabsPanel.style.setProperty('--tab-progress-duration', `${immediate ? 0 : durationMs}ms`);
        tabsPanel.style.setProperty('--tab-progress', `${progress}%`);
        tabsPanel.style.setProperty('--tab-progress-scale', String(progress / 100));
    }

    // Attach click listeners
    tabs.forEach((tab, i) => {
        tab.addEventListener('click', () => {
            if (!hasPlaybackUnlocked) return;
            hasCompletedSingleLoop = true;
            stopAutoRotate();
            setTab(i, 220);
        });
    });

    let autoTimer: number | null = null;
    let isInView = false;
    let hasCompletedSingleLoop = false;
    let hasStartedPlayback = false;
    let hasPlaybackUnlocked = false;

    function setTabsEnabled(enabled: boolean) {
        tabs.forEach((tab) => tab.classList.toggle('is-disabled', !enabled));
    }

    function startAutoRotate() {
        if (!isInView || autoTimer !== null || tabs.length <= 1 || hasCompletedSingleLoop) return;
        autoTimer = window.setInterval(() => {
            // Run one forward cycle only: tab1 -> tab2 -> tab3, then stop.
            if (currentTab >= tabs.length - 1) {
                hasCompletedSingleLoop = true;
                stopAutoRotate();
                return;
            }
            const nextTab = currentTab + 1;
            setTab(nextTab, TAB_DURATION_MS);
        }, TAB_DURATION_MS);
    }

    function stopAutoRotate() {
        if (autoTimer === null) return;
        window.clearInterval(autoTimer);
        autoTimer = null;
    }

    // Pause on hover
    section?.addEventListener('mouseenter', stopAutoRotate);
    section?.addEventListener('mouseleave', () => {
        startAutoRotate();
    });

    // Init default state: no active tab interactions.
    setTabsEnabled(false);
    // Start at 0 and wait for full in-view before beginning playback.
    updateTabProgressBar(-1, 0, true);

    // Start animation only when section is in viewport
    if (section) {
        // Heading reveal: trigger sooner as user scrolls from Hero 1 into Hero 2.
        const headingObserver = new IntersectionObserver(
            ([entry]) => {
                if (entry.isIntersecting) {
                    heading?.classList.add('is-visible');
                    contentBlock?.classList.add('is-visible');
                    headingObserver.disconnect();
                }
            },
            { threshold: 0.25 }
        );

        headingObserver.observe(section);

        const observer = new IntersectionObserver(
            ([entry]) => {
                const ratio = entry.intersectionRatio;
                if (entry.isIntersecting && ratio >= 0.5) {
                    isInView = true;
                    if (!hasStartedPlayback) {
                        hasStartedPlayback = true;
                        hasPlaybackUnlocked = true;
                        setTabsEnabled(true);
                        setTab(0, TAB_DURATION_MS);
                    }
                    startAutoRotate();
                } else if (ratio < 0.1) {
                    // Only truly stop when section is nearly gone — prevents layout-shift jitter
                    isInView = false;
                    stopAutoRotate();
                }
            },
            {
                threshold: [0, 0.1, 0.5, 1],
            }
        );

        observer.observe(section);
    }

    // Box position GUI for custom layout
    type BoxId = 'box1' | 'box2' | 'box3' | 'box4' | 'box5';
    type BoxPositions = Record<BoxId, { left: number; top: number }>;

    const boxPositions: BoxPositions = {
        box1: { left: 176, top: 58 },
        box2: { left: 529, top: 128 },
        box3: { left: 314, top: 402 },
        box4: { left: 750, top: 60 },
        box5: { left: 740, top: 439 },
    };

    const tab1BoxPositions: BoxPositions = {
        box1: { left: 188, top: 100 },
        box2: { left: 550, top: 50 },
        box3: { left: 790, top: 16 },
        box4: { left: 450, top: 460 },
        box5: { left: 760, top: 400 },
    };

    // Tab 2: 5-column staggered grid — 2|3|3|3|2
    // Box size 112.5px, gap 25px, stride 137.5px (both 1.25x the original
    // 90px/20px/110px) — every position below is the original grid scaled
    // 1.25x around its center (507, 265) so it grows in place symmetrically.
    // 3-box columns baseline top=115; center 3-box column is slightly staggered down
    const tab2BoxPositions: BoxPositions = {
        // Col 1 (2 boxes, vertically centered)
        box1: { left: 232, top: 184 },
        box2: { left: 232, top: 321 },
        // Col 2 (3 boxes)
        box3: { left: 370, top: 115 },
        box4: { left: 370, top: 253 },
        box5: { left: 370, top: 390 },
    };
    const tab2ExtraPositions: Record<string, { left: number; top: number }> = {
        // Col 3 (center, 3 boxes) — slightly staggered down
        box6: { left: 507, top: 140 },
        box7: { left: 507, top: 278 },
        box8: { left: 507, top: 415 },
        // Col 4 (3 boxes)
        box9: { left: 645, top: 115 },
        box10: { left: 645, top: 253 },
        box11: { left: 645, top: 390 },
        // Col 5 (2 boxes, vertically centered)
        box12: { left: 782, top: 184 },
        box13: { left: 782, top: 321 },
    };

    function updateBoxPosition(boxId: BoxId, tabIdx: 0 | 1 = 0) {
        const box = document.querySelector<HTMLElement>(`#boxVisual .${boxId}`);
        if (!box) return;
        const positions = tabIdx === 0 ? boxPositions : tab1BoxPositions;
        box.style.left = positions[boxId].left + 'px';
        box.style.top = positions[boxId].top + 'px';
    }

    function updateGuiValues(boxId: BoxId, tabIdx: 0 | 1 = 0) {
        const prefix = tabIdx === 0 ? '' : 't1';
        const boxLeft = document.getElementById(`${prefix}boxLeft`) as HTMLInputElement | null;
        const boxTop = document.getElementById(`${prefix}boxTop`) as HTMLInputElement | null;
        const boxLeftValue = document.getElementById(`${prefix}boxLeftValue`);
        const boxTopValue = document.getElementById(`${prefix}boxTopValue`);
        const positions = tabIdx === 0 ? boxPositions : tab1BoxPositions;
        if (boxLeft) boxLeft.value = String(positions[boxId].left);
        if (boxTop) boxTop.value = String(positions[boxId].top);
        if (boxLeftValue) boxLeftValue.textContent = positions[boxId].left + 'px';
        if (boxTopValue) boxTopValue.textContent = positions[boxId].top + 'px';
    }

    window.addEventListener('DOMContentLoaded', () => {
        // Set initial box positions (tab 0 is default active)
        (Object.keys(boxPositions) as BoxId[]).forEach((id) => updateBoxPosition(id, 0));
        updateGuiValues('box1', 0);

        // ── Tab 0: Box position controls ──
        const boxSelect = document.getElementById('boxSelect') as HTMLSelectElement | null;
        const boxLeft = document.getElementById('boxLeft') as HTMLInputElement | null;
        const boxTop = document.getElementById('boxTop') as HTMLInputElement | null;
        let selectedBox: BoxId = 'box1';

        boxSelect?.addEventListener('change', (e) => {
            selectedBox = (e.target as HTMLSelectElement).value as BoxId;
            updateGuiValues(selectedBox, 0);
        });
        boxLeft?.addEventListener('input', (e) => {
            boxPositions[selectedBox].left = parseInt((e.target as HTMLInputElement).value, 10);
            updateBoxPosition(selectedBox, 0);
            updateGuiValues(selectedBox, 0);
        });
        boxTop?.addEventListener('input', (e) => {
            boxPositions[selectedBox].top = parseInt((e.target as HTMLInputElement).value, 10);
            updateBoxPosition(selectedBox, 0);
            updateGuiValues(selectedBox, 0);
        });

        // ── Tab 1: Box position controls ──
        const t1boxSelect = document.getElementById('t1boxSelect') as HTMLSelectElement | null;
        const t1boxLeft = document.getElementById('t1boxLeft') as HTMLInputElement | null;
        const t1boxTop = document.getElementById('t1boxTop') as HTMLInputElement | null;
        let selectedT1Box: BoxId = 'box1';

        t1boxSelect?.addEventListener('change', (e) => {
            selectedT1Box = (e.target as HTMLSelectElement).value as BoxId;
            updateGuiValues(selectedT1Box, 1);
        });
        t1boxLeft?.addEventListener('input', (e) => {
            tab1BoxPositions[selectedT1Box].left = parseInt(
                (e.target as HTMLInputElement).value,
                10
            );
            updateBoxPosition(selectedT1Box, 1);
            updateGuiValues(selectedT1Box, 1);
        });
        t1boxTop?.addEventListener('input', (e) => {
            tab1BoxPositions[selectedT1Box].top = parseInt(
                (e.target as HTMLInputElement).value,
                10
            );
            updateBoxPosition(selectedT1Box, 1);
            updateGuiValues(selectedT1Box, 1);
        });

        // ── Toggle / Copy / Download ──
        const guiPanel = document.getElementById('boxGuiPanel');
        const guiBody = document.getElementById('guiBody');
        const guiToggle = document.getElementById('boxGuiToggle');
        const guiCopy = document.getElementById('boxGuiCopy') as HTMLButtonElement | null;
        const guiDownload = document.getElementById('boxGuiDownload') as HTMLButtonElement | null;

        function buildPositionsJson(): string {
            if (currentTab === 0) return JSON.stringify(boxPositions, null, 2);
            if (currentTab === 1) return JSON.stringify(tab1BoxPositions, null, 2);
            return JSON.stringify({ row1: tab2BoxPositions, row2: tab2ExtraPositions }, null, 2);
        }

        guiCopy?.addEventListener('click', async () => {
            await navigator.clipboard.writeText(buildPositionsJson());
            if (guiCopy) {
                guiCopy.textContent = '✅ Copied!';
                setTimeout(() => {
                    guiCopy.textContent = '📋 Copy JSON';
                }, 1500);
            }
        });

        guiDownload?.addEventListener('click', () => {
            const names = ['tab0-box-positions.json', 'tab1-box-positions.json', 'tab2-grid.json'];
            const blob = new Blob([buildPositionsJson()], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = names[currentTab] ?? 'positions.json';
            a.click();
            URL.revokeObjectURL(url);
        });

        let guiExpanded = false;
        guiToggle?.addEventListener('click', () => {
            guiExpanded = !guiExpanded;
            if (guiBody) guiBody.style.display = guiExpanded ? '' : 'none';
            if (guiToggle) guiToggle.textContent = guiExpanded ? '−' : '+';
            guiPanel?.classList.toggle('is-collapsed', !guiExpanded);
        });

        normalizeBoxVisual();

        window.addEventListener('resize', () => {
            normalizeBoxVisual();
            // re-measure the open body — line wrapping changes with width
            if (currentTab >= 0) syncTabBodyHeights(currentTab);
        });
    });
</script>
