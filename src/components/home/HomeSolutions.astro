---
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { t } from '../../lib/i18n/t';
import { icons } from '../../lib/icons/registry';
import Button from '../shared/Button.astro';
import HomeSolutionsCard from './solutions/HomeSolutionsCard.astro';

interface Props {
    locale: Locale;
    copy: CMSDictionary;
}

const { locale, copy } = Astro.props as Props;
const base = import.meta.env.BASE_URL;
const chevronIconSrc = `${base}icons/icon-chevron.svg`;
const logoBase = `${base}images/home/solutions/logos`;

const logoSets = {
    media: [
        { src: `${logoBase}/media/abc.svg`, alt: 'ABC' },
        { src: `${logoBase}/media/ami-tv.svg`, alt: 'AMI-tv' },
        { src: `${logoBase}/media/aqpm.svg`, alt: 'AQPM' },
        { src: `${logoBase}/media/bbc.svg`, alt: 'BBC' },
        { src: `${logoBase}/media/bell.svg`, alt: 'Bell' },
        { src: `${logoBase}/media/nexxen.svg`, alt: 'Nexxen' },
        { src: `${logoBase}/media/pelmorex.svg`, alt: 'Pelmorex' },
        { src: `${logoBase}/media/quebecor.svg`, alt: 'Quebecor' },
        { src: `${logoBase}/media/rogers.svg`, alt: 'Rogers' },
        { src: `${logoBase}/media/tele-quebec.svg`, alt: 'Télé-Québec' },
        { src: `${logoBase}/media/telus.svg`, alt: 'TELUS' },
        { src: `${logoBase}/media/tfo.svg`, alt: 'TFO' },
        { src: `${logoBase}/media/tv5.svg`, alt: 'TV5' },
        { src: `${logoBase}/media/tva.svg`, alt: 'TVA' },
        { src: `${logoBase}/media/tvo.svg`, alt: 'TVO' },
        { src: `${logoBase}/media/videotron.svg`, alt: 'Vidéotron' },
        { src: `${logoBase}/media/wildbrain-television.svg`, alt: 'WildBrain Television' },
    ],
    advertising: [
        { src: `${logoBase}/advertising/cosette.svg`, alt: 'Cosette' },
        { src: `${logoBase}/advertising/essencemediacom.jpeg`, alt: 'EssenceMediacom' },
        { src: `${logoBase}/advertising/group-m.svg`, alt: 'GroupM' },
        { src: `${logoBase}/advertising/hearts-and-science.png`, alt: 'Hearts & Science' },
        { src: `${logoBase}/advertising/initiative.png`, alt: 'Initiative' },
        { src: `${logoBase}/advertising/jungle.svg`, alt: 'Jungle Media' },
        { src: `${logoBase}/advertising/media-experts.svg`, alt: 'Media Experts' },
        { src: `${logoBase}/advertising/mindshare.svg`, alt: 'Mindshare' },
        { src: `${logoBase}/advertising/omnicom.svg`, alt: 'Omnicom' },
        { src: `${logoBase}/advertising/phd.svg`, alt: 'PHD' },
        { src: `${logoBase}/advertising/time-space-media.png`, alt: 'Time & Space Media' },
        { src: `${logoBase}/advertising/touche.SVG`, alt: 'Touché!' },
        { src: `${logoBase}/advertising/um-worldwide.svg`, alt: 'UM Worldwide' },
    ],
    govngo: [
        { src: `${logoBase}/gov-ngo/R613-EN-RGB-Colour.svg`, alt: 'Radio 613' },
        { src: `${logoBase}/gov-ngo/Telefilm_Canada.svg`, alt: 'Telefilm Canada' },
        { src: `${logoBase}/gov-ngo/canada.svg`, alt: 'Government of Canada' },
        { src: `${logoBase}/gov-ngo/crtc.svg`, alt: 'CRTC' },
        { src: `${logoBase}/gov-ngo/first-nation-market.svg`, alt: 'First Nations Market' },
        { src: `${logoBase}/gov-ngo/quebec.svg`, alt: 'Gouvernement du Québec' },
    ],
    education: [
        { src: `${logoBase}/education/HEC_Montreal.svg`, alt: 'HEC Montréal' },
        { src: `${logoBase}/education/Mount-Royal-University.svg`, alt: 'Mount Royal University' },
        { src: `${logoBase}/education/humber-polytechnic.svg`, alt: 'Humber Polytechnic' },
        {
            src: `${logoBase}/education/toronto-metro-univerity-logo.svg`,
            alt: 'Toronto Metropolitan University',
        },
        { src: `${logoBase}/education/uOttawa.svg`, alt: 'University of Ottawa' },
        { src: `${logoBase}/education/universite-de-montreal.svg`, alt: 'Université de Montréal' },
        { src: `${logoBase}/education/university-of-manitoba.svg`, alt: 'University of Manitoba' },
    ],
    industry: [
        { src: `${logoBase}/industry/EBU-European_Broadcasting_Union.svg`, alt: 'EBU' },
        { src: `${logoBase}/industry/Shaw-Rocket-Fund.svg`, alt: 'Shaw Rocket Fund' },
        { src: `${logoBase}/industry/cmf-blk.svg`, alt: 'Canada Media Fund' },
        { src: `${logoBase}/industry/nfb.svg`, alt: 'NFB' },
        { src: `${logoBase}/industry/numeris.png`, alt: 'Numeris' },
    ],
};

const cards = [
    {
        solutionId: 'media',
        titleKey: 'solutions_item_2',
        title: t(copy, 'solutions_item_2', locale, 'Media'),
        imageSrc: `${base}images/home/solutions/cards/solutions-media.jpg`,
        imageAlt: t(copy, 'solutions_item_2_image_alt', locale, 'Professional using a laptop'),
        iconPath: `${base}${icons.solutions.media}`,
        href: `${base}${locale}/solutions/media/`,
        ctaLabel: t(copy, 'solutions_cta', locale, 'Learn more'),
    },
    {
        solutionId: 'advertising',
        titleKey: 'solutions_item_3',
        title: t(copy, 'solutions_item_3', locale, 'Advertising'),
        imageSrc: `${base}images/home/solutions/cards/solutions-advertising.png`,
        imageAlt: t(copy, 'solutions_item_3_image_alt', locale, 'Professional using a laptop'),
        iconPath: `${base}${icons.solutions.advertising}`,
        href: `${base}${locale}/solutions/advertising/`,
        ctaLabel: t(copy, 'solutions_cta', locale, 'Learn more'),
    },
    {
        solutionId: 'govngo',
        titleKey: 'solutions_item_5',
        title: t(copy, 'solutions_item_5', locale, 'Gov & NGOs'),
        imageSrc: `${base}images/home/solutions/cards/solutions-govngo.png`,
        imageAlt: t(copy, 'solutions_item_5_image_alt', locale, 'Professional using a laptop'),
        // Source photo is a wide banner crop with the subject right-of-center;
        // shifting the visible window right (higher %) re-centers her once
        // object-fit: cover crops it down into the card's portrait frame.
        imagePosition: '58% center',
        iconPath: `${base}${icons.solutions.govNgo}`,
        href: `${base}${locale}/solutions/gov-ngos/`,
        ctaLabel: t(copy, 'solutions_cta', locale, 'Learn more'),
    },
    {
        solutionId: 'education',
        titleKey: 'solutions_item_4',
        title: t(copy, 'solutions_item_4', locale, 'Education'),
        imageSrc: `${base}images/home/solutions/cards/solutions-education.png`,
        imageAlt: t(copy, 'solutions_item_4_image_alt', locale, 'Professional using a laptop'),
        iconPath: `${base}${icons.solutions.education}`,
        href: `${base}${locale}/solutions/education/`,
        ctaLabel: t(copy, 'solutions_cta', locale, 'Learn more'),
    },
    {
        solutionId: 'industry',
        titleKey: 'solutions_item_1',
        title: t(copy, 'solutions_item_1', locale, 'Industry'),
        imageSrc: `${base}images/home/solutions/cards/solutions-industry.png`,
        imageAlt: t(copy, 'solutions_item_1_image_alt', locale, 'Professional using a laptop'),
        iconPath: `${base}${icons.solutions.industry}`,
        href: `${base}${locale}/solutions/industry/`,
        ctaLabel: t(copy, 'solutions_cta', locale, 'Learn more'),
    },
];
---

<section class="home-solutions" aria-label={t(copy, 'solutions_title', locale, 'Solutions')}>
    <div class="home-solutions__heading">
        <h2 class="home-solutions__title solutions-fly-in" data-copy-key="solutions_title">
            {t(copy, 'solutions_title', locale, 'Solutions for Every Decision-Maker')}
        </h2>
    </div>
    <div class="home-solutions__content home-solutions__content--desktop">
        <div class="home-solutions__inner">
            {
                cards.map((card) => (
                    <div
                        class="home-solutions__item solutions-card-fly-in"
                        data-solution={card.solutionId}
                    >
                        <HomeSolutionsCard
                            titleKey={card.titleKey}
                            title={card.title}
                            imageSrc={card.imageSrc}
                            imageAlt={card.imageAlt}
                            imagePosition={card.imagePosition}
                            iconPath={card.iconPath}
                            href={card.href}
                            ctaLabel={card.ctaLabel}
                            state="default"
                        />
                    </div>
                ))
            }
        </div>

        <div class="home-solutions__indicator" aria-hidden="true">
            {
                cards.map((card, idx) => (
                    <div class="home-solutions__indicator-cell">
                        <span
                            class={`home-solutions__indicator-icon icon-m${idx === 0 ? ' is-active' : ''}`}
                            data-solution-arrow={card.solutionId}
                        >
                            <img src={chevronIconSrc} alt="" loading="lazy" decoding="async" />
                        </span>
                    </div>
                ))
            }
        </div>

        <div
            class="home-solutions__logos"
            aria-label={t(copy, 'solutions_logos_aria_label', locale, 'Client logos')}
        >
            {
                Object.entries(logoSets).map(([solutionId, logos], idx) => (
                    <div
                        class={`home-solutions__logos-grid${idx === 0 ? ' is-active' : ''}`}
                        data-solution-logos={solutionId}
                        data-logos={JSON.stringify(logos)}
                        aria-hidden={idx === 0 ? 'false' : 'true'}
                    >
                        {logos.slice(0, 5).map((logo) => (
                            <div class="home-solutions__logo-placeholder">
                                <img
                                    class="home-solutions__logo-img"
                                    src={logo.src}
                                    alt={logo.alt}
                                    loading="lazy"
                                    decoding="async"
                                />
                            </div>
                        ))}
                    </div>
                ))
            }
        </div>
    </div>

    <div class="home-solutions__mobile" data-solutions-mobile>
        <div
            class="home-solutions__tabs"
            role="tablist"
            aria-label={t(copy, 'solutions_title', locale, 'Solutions')}
        >
            {
                cards.map((card, idx) => (
                    <button
                        type="button"
                        class={`home-solutions__tab${idx === 0 ? ' is-active' : ''}`}
                        data-solution-tab={card.solutionId}
                        role="tab"
                        aria-selected={idx === 0 ? 'true' : 'false'}
                        tabindex={idx === 0 ? '0' : '-1'}
                        aria-controls={`home-solutions-panel-${card.solutionId}`}
                    >
                        <span
                            class="home-solutions__tab-label text-body-p3"
                            data-copy-key={card.titleKey}
                        >
                            {card.title}
                        </span>
                    </button>
                ))
            }
        </div>

        <div class="home-solutions__carousel" data-solutions-carousel>
            {
                cards.map((card, idx) => (
                    <div
                        class={`home-solutions__carousel-item${idx === 0 ? ' is-active' : ''}`}
                        data-solution-panel={card.solutionId}
                        id={`home-solutions-panel-${card.solutionId}`}
                        role="tabpanel"
                        aria-hidden={idx === 0 ? 'false' : 'true'}
                    >
                        <HomeSolutionsCard
                            titleKey={card.titleKey}
                            title={card.title}
                            imageSrc={card.imageSrc}
                            imageAlt={card.imageAlt}
                            imagePosition={card.imagePosition}
                            iconPath={card.iconPath}
                            href={card.href}
                            ctaLabel={card.ctaLabel}
                            state="carousel"
                        />
                    </div>
                ))
            }
        </div>

        <div class="home-solutions__tablet-indicator" aria-hidden="true">
            <span class="home-solutions__tablet-arrow icon-s">
                <img src={chevronIconSrc} alt="" />
            </span>
        </div>

        <div
            class="home-solutions__mobile-logos"
            aria-label={t(copy, 'solutions_logos_aria_label', locale, 'Client logos')}
        >
            {
                Object.entries(logoSets).map(([solutionId, logos], idx) => (
                    <div
                        class={`home-solutions__mobile-logos-grid${idx === 0 ? ' is-active' : ''}`}
                        data-mobile-solution-logos={solutionId}
                        aria-hidden={idx === 0 ? 'false' : 'true'}
                    >
                        {logos.slice(0, 3).map((logo) => (
                            <div class="home-solutions__mobile-logo-item">
                                <img
                                    class="home-solutions__mobile-logo-img"
                                    src={logo.src}
                                    alt={logo.alt}
                                    loading="lazy"
                                    decoding="async"
                                />
                            </div>
                        ))}
                    </div>
                ))
            }
        </div>
    </div>

    <div class="home-solutions__accordion" data-solutions-accordion>
        {
            cards.map((card, idx) => {
                const logos = logoSets[card.solutionId as keyof typeof logoSets];
                return (
                    <div
                        class={`home-solutions__accordion-item${idx === 0 ? ' is-open' : ''}`}
                        data-accordion-item={card.solutionId}
                    >
                        <button
                            type="button"
                            class="home-solutions__accordion-trigger"
                            aria-expanded={idx === 0 ? 'true' : 'false'}
                            aria-controls={`home-solutions-accordion-body-${card.solutionId}`}
                            data-accordion-trigger={card.solutionId}
                        >
                            <div class="home-solutions__accordion-trigger-inner">
                                <img
                                    class="home-solutions__accordion-icon icon-4xl"
                                    src={card.iconPath}
                                    alt=""
                                    aria-hidden="true"
                                />
                                <span
                                    class="home-solutions__accordion-title text-body-p1-bold"
                                    data-copy-key={card.titleKey}
                                >
                                    {card.title}
                                </span>
                            </div>
                            <span class="home-solutions__accordion-chevron" aria-hidden="true">
                                <svg
                                    width="100%"
                                    height="100%"
                                    viewBox="0 0 20 20"
                                    fill="none"
                                    xmlns="http://www.w3.org/2000/svg"
                                >
                                    <path
                                        d="M5 7.5L10 12.5L15 7.5"
                                        stroke="currentColor"
                                        stroke-width="1.5"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    />
                                </svg>
                            </span>
                        </button>
                        <div
                            class="home-solutions__accordion-body"
                            id={`home-solutions-accordion-body-${card.solutionId}`}
                            data-accordion-body={card.solutionId}
                        >
                            <div class="home-solutions__accordion-body-inner">
                                <img
                                    class="home-solutions__accordion-image"
                                    src={card.imageSrc}
                                    alt={card.imageAlt}
                                    loading="lazy"
                                    decoding="async"
                                    style={`--image-position: ${card.imagePosition ?? 'center'}`}
                                />
                                <Button
                                    variant="tertiary"
                                    href={card.href}
                                    class="home-solutions__accordion-cta"
                                >
                                    {card.ctaLabel}
                                </Button>
                                <div class="home-solutions__accordion-logos">
                                    {logos.slice(0, 3).map((logo) => (
                                        <div class="home-solutions__accordion-logo-item">
                                            <img
                                                class="home-solutions__accordion-logo-img"
                                                src={logo.src}
                                                alt={logo.alt}
                                                loading="lazy"
                                                decoding="async"
                                            />
                                        </div>
                                    ))}
                                </div>
                            </div>
                        </div>
                    </div>
                );
            })
        }
    </div>
</section>

<style>
    .home-solutions {
        background: var(--surface-blue);
        padding: var(--section-pad-block) var(--content-margin-inline);
        display: flex;
        align-items: center;
        justify-content: flex-start;
        flex-direction: column;
        gap: var(--space-12);
    }

    .home-solutions__content {
        width: min(100%, 90rem);
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
    }

    .home-solutions__mobile {
        display: none;
    }

    .home-solutions__accordion {
        display: none;
    }

    .home-solutions__heading {
        width: min(100%, 90rem);
        text-align: center;
    }

    .home-solutions__title {
        margin: 0;
        color: var(--text-primary);
    }

    .home-solutions__inner {
        width: 100%;
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: var(--space-6);
    }

    .home-solutions__item {
        min-width: 0;
    }

    .solutions-fly-in {
        opacity: 0;
        transform: translateY(1.625rem);
        transition:
            opacity var(--motion-duration-heading) ease,
            transform var(--motion-duration-heading) var(--motion-ease-standard);
    }

    .solutions-fly-in.is-visible {
        opacity: 1;
        transform: translateY(0);
    }

    .solutions-card-fly-in {
        opacity: 0;
        transform: translateY(1.625rem);
        /* Spring-settle easing (distinct from --motion-ease-standard) is
           intentional here, not part of the duration consolidation. */
        transition:
            opacity var(--motion-duration-card) cubic-bezier(0.22, 1, 0.36, 1) 0.9s,
            transform var(--motion-duration-card) cubic-bezier(0.22, 1, 0.36, 1) 0.9s;
    }

    .solutions-card-fly-in.is-visible {
        opacity: 1;
        transform: translateY(0);
    }

    .home-solutions__logos {
        width: 100%;
        border-top: var(--stroke-1) solid var(--border-tertiary);
        border-bottom: var(--stroke-1) solid var(--border-tertiary);
        padding: var(--space-4) 0;
        opacity: 0;
        transform: translateY(1.625rem);
        transition:
            opacity var(--motion-duration-card) cubic-bezier(0.22, 1, 0.36, 1),
            transform var(--motion-duration-card) cubic-bezier(0.22, 1, 0.36, 1);
    }

    .home-solutions__logos.is-visible {
        opacity: 1;
        transform: translateY(0);
    }

    .home-solutions__indicator {
        width: 100%;
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: var(--space-6);
        opacity: 0;
        transform: translateY(1.625rem);
        transition:
            opacity var(--motion-duration-card) cubic-bezier(0.22, 1, 0.36, 1),
            transform var(--motion-duration-card) cubic-bezier(0.22, 1, 0.36, 1);
    }

    .home-solutions__indicator.is-visible {
        opacity: 1;
        transform: translateY(0);
    }

    .home-solutions__indicator-cell {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: var(--space-6);
    }

    .home-solutions__indicator-icon {
        opacity: 0;
        transition: opacity 180ms ease;
    }

    .home-solutions__indicator-icon.is-active {
        opacity: 1;
    }

    .home-solutions__indicator-icon img {
        width: 100%;
        height: 100%;
        display: block;
    }

    .home-solutions__logos-grid {
        width: 100%;
        display: none;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: var(--space-6);
    }

    .home-solutions__logos-grid.is-active {
        display: grid;
    }

    .home-solutions__logo-placeholder {
        border-radius: var(--radius-s);
        min-height: var(--space-10);
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        /* horizontal matches --card-pad-thin; vertical stays --space-7 for a taller logo box */
        padding: var(--space-7) var(--card-pad-thin);
    }

    .home-solutions__logo-img {
        width: 100%;
        height: calc(var(--space-7) * 1.15);
        object-fit: contain;
        object-position: center;
        display: block;
    }

    @media (max-width: 1200px) {
        .home-solutions {
            padding-top: var(--space-9);
            padding-bottom: var(--space-9);
            gap: var(--space-9);
            overflow-x: hidden;
        }

        .home-solutions__heading {
            width: 100%;
            text-align: left;
        }

        .home-solutions__content--desktop {
            display: none;
        }

        .home-solutions__mobile {
            display: flex;
            flex-direction: column;
            gap: var(--space-6);
            width: 100%;
        }

        /* Pills hidden on tablet — carousel only */
        .home-solutions__tabs {
            display: none;
        }

        .home-solutions__tablet-indicator {
            width: min(75vw, 22rem);
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: var(--space-5);
        }

        .home-solutions__tablet-arrow img {
            width: 100%;
            height: 100%;
            display: block;
        }

        .home-solutions__carousel {
            margin-inline: calc(-1 * var(--content-margin-inline));
            padding-inline: var(--content-margin-inline);
            scroll-padding-inline-start: var(--content-margin-inline);
            display: flex;
            gap: var(--layout-card-gap);
            overflow-x: auto;
            scroll-snap-type: x mandatory;
            -webkit-overflow-scrolling: touch;
            scrollbar-width: none;
        }

        .home-solutions__carousel::-webkit-scrollbar {
            display: none;
        }

        /* Card is 75% of viewport width; height via aspect ratio 3:4 to match desktop proportions */
        .home-solutions__carousel-item {
            flex: 0 0 min(75vw, 22rem);
            height: calc(min(75vw, 22rem) * 1.333);
            scroll-snap-align: start;
        }

        /* Logos below carousel: 3 per row, no carousel */
        .home-solutions__mobile-logos {
            border-top: var(--stroke-1) solid var(--border-tertiary);
            border-bottom: var(--stroke-1) solid var(--border-tertiary);
            padding: var(--space-7) 0;
        }

        .home-solutions__mobile-logos-grid {
            display: none;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: var(--space-4);
        }

        .home-solutions__mobile-logos-grid.is-active {
            display: grid;
        }

        .home-solutions__mobile-logo-item {
            display: flex;
            align-items: center;
            justify-content: center;
            /* horizontal matches --card-pad-thin; vertical stays --space-4 for tablet logo box height */
            padding: var(--space-4) var(--card-pad-thin);
        }

        .home-solutions__mobile-logo-img {
            width: 100%;
            height: var(--space-9);
            object-fit: contain;
            object-position: center;
            display: block;
        }
    }

    @media (max-width: 767px) {
        .home-solutions__mobile {
            display: none;
        }

        .home-solutions__accordion {
            display: flex;
            flex-direction: column;
            width: 100%;
            border-top: var(--stroke-1) solid var(--border-tertiary);
        }

        .home-solutions__accordion-item {
            border-bottom: var(--stroke-1) solid var(--border-tertiary);
        }

        .home-solutions__accordion-trigger {
            appearance: none;
            background: none;
            border: none;
            color: var(--neutral-black);
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: var(--space-3);
            padding: var(--space-4) 0;
            cursor: pointer;
        }

        .home-solutions__accordion-trigger:focus-visible {
            outline: var(--stroke-2) solid var(--border-primary);
            outline-offset: var(--space-1);
        }

        .home-solutions__accordion-trigger-inner {
            display: flex;
            align-items: center;
            gap: var(--space-3);
        }

        .home-solutions__accordion-icon {
            flex-shrink: 0;
        }

        .home-solutions__accordion-title {
            color: var(--text-primary);
        }

        .home-solutions__accordion-chevron {
            width: 1.5rem;
            height: 1.5rem;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: transform 350ms cubic-bezier(0.4, 0, 0.2, 1);
        }

        .home-solutions__accordion-item.is-open .home-solutions__accordion-chevron {
            transform: rotate(180deg);
        }

        .home-solutions__accordion-body {
            overflow: hidden;
            height: 0;
            transition: height 450ms cubic-bezier(0.4, 0, 0.2, 1);
        }

        .home-solutions__accordion-body-inner {
            display: flex;
            flex-direction: column;
            gap: var(--space-5);
            padding-bottom: var(--space-5);
        }

        .home-solutions__accordion-image {
            width: 100%;
            aspect-ratio: 1 / 1;
            object-fit: cover;
            object-position: var(--image-position, center);
            border-radius: var(--radius-m);
            display: block;
        }

        .home-solutions__accordion-cta {
            align-self: flex-start;
        }

        .home-solutions__accordion-logos {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: var(--space-4);
            border-top: var(--stroke-1) solid var(--border-tertiary);
            padding: var(--space-5) 0 0;
        }

        .home-solutions__accordion-logo-item {
            display: flex;
            align-items: center;
            justify-content: center;
            /* vertical matches --card-pad-thin; horizontal stays --space-2 for tighter mobile logo tiles */
            padding: var(--card-pad-thin) var(--space-2);
        }

        .home-solutions__accordion-logo-img {
            width: 100%;
            height: var(--space-6);
            object-fit: contain;
            object-position: center;
            display: block;
        }
    }
</style>

<script>
    // Fly-in: heading + staggered cards
    const solutionsFlyInSection = document.querySelector('.home-solutions');
    if (solutionsFlyInSection) {
        const heading = solutionsFlyInSection.querySelector<HTMLElement>('.solutions-fly-in');
        const cards = solutionsFlyInSection.querySelectorAll<HTMLElement>('.solutions-card-fly-in');
        const logos = solutionsFlyInSection.querySelector<HTMLElement>('.home-solutions__logos');
        const indicator = solutionsFlyInSection.querySelector<HTMLElement>(
            '.home-solutions__indicator'
        );
        const flyObserver = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        flyObserver.unobserve(entry.target);
                        if (heading) heading.classList.add('is-visible');
                        cards.forEach((card, i) => {
                            setTimeout(() => card.classList.add('is-visible'), i * 140);
                        });
                        // stagger end + cards' 900ms CSS delay + partial overlap into the
                        // card's settle. 244ms ≈ 37.5% into --motion-duration-card (650ms),
                        // preserving the original 600ms-into-1600ms overlap ratio this was
                        // tuned to before the card duration moved onto the shared token.
                        const sweepDelay = (cards.length - 1) * 140 + 900 + 244;
                        setTimeout(() => {
                            logos?.classList.add('is-visible');
                            indicator?.classList.add('is-visible');
                        }, sweepDelay);
                    }
                });
            },
            { threshold: 0.15 }
        );
        flyObserver.observe(solutionsFlyInSection);
    }

    const solutionsSection = document.querySelector('.home-solutions');

    if (solutionsSection) {
        const solutionItems = solutionsSection.querySelectorAll(
            '.home-solutions__item[data-solution]'
        );
        const logoGrids = solutionsSection.querySelectorAll(
            '.home-solutions__logos-grid[data-solution-logos]'
        );
        const arrows = solutionsSection.querySelectorAll(
            '.home-solutions__indicator-icon[data-solution-arrow]'
        );
        const tabs = solutionsSection.querySelectorAll('.home-solutions__tab[data-solution-tab]');
        const carouselItems = solutionsSection.querySelectorAll<HTMLElement>(
            '.home-solutions__carousel-item[data-solution-panel]'
        );
        const carousel = solutionsSection.querySelector<HTMLElement>('.home-solutions__carousel');
        const mobileLogoGrids = solutionsSection.querySelectorAll(
            '.home-solutions__mobile-logos-grid[data-mobile-solution-logos]'
        );
        const defaultSolution = 'media';

        type LogoItem = { src: string; alt: string };

        const rotateLogos = (container: Element | null, count: number) => {
            if (!container) return;
            const all: LogoItem[] = JSON.parse((container as HTMLElement).dataset.logos ?? '[]');
            if (all.length <= count) return;
            const picked = [...all].sort(() => Math.random() - 0.5).slice(0, count);
            container
                .querySelectorAll<HTMLImageElement>('.home-solutions__logo-img')
                .forEach((img, i) => {
                    if (picked[i]) {
                        img.src = picked[i].src;
                        img.alt = picked[i].alt;
                    }
                });
        };

        const setActiveSolution = (solutionId: string, scrollCarousel = false) => {
            logoGrids.forEach((grid) => {
                const isActive = grid.getAttribute('data-solution-logos') === solutionId;
                grid.classList.toggle('is-active', isActive);
                grid.setAttribute('aria-hidden', String(!isActive));
            });

            arrows.forEach((arrow) => {
                const isActive = arrow.getAttribute('data-solution-arrow') === solutionId;
                arrow.classList.toggle('is-active', isActive);
            });

            tabs.forEach((tab) => {
                const isActive = tab.getAttribute('data-solution-tab') === solutionId;
                tab.classList.toggle('is-active', isActive);
                tab.setAttribute('aria-selected', String(isActive));
                tab.setAttribute('tabindex', isActive ? '0' : '-1');
            });

            carouselItems.forEach((item) => {
                const isActive = item.getAttribute('data-solution-panel') === solutionId;
                item.classList.toggle('is-active', isActive);
                item.setAttribute('aria-hidden', String(!isActive));
            });

            mobileLogoGrids.forEach((grid) => {
                const isActive = grid.getAttribute('data-mobile-solution-logos') === solutionId;
                grid.classList.toggle('is-active', isActive);
                grid.setAttribute('aria-hidden', String(!isActive));
            });

            // Rotate desktop logo row
            rotateLogos(solutionsSection.querySelector(`[data-solution-logos="${solutionId}"]`), 5);

            // Scroll carousel to active card (snap to start, respecting scroll-padding)
            if (scrollCarousel && carousel) {
                const activeItem = carousel.querySelector<HTMLElement>(
                    `[data-solution-panel="${solutionId}"]`
                );
                if (activeItem) {
                    carousel.scrollTo({ left: activeItem.offsetLeft, behavior: 'smooth' });
                }
            }
        };

        solutionItems.forEach((item) => {
            const solutionId = item.getAttribute('data-solution');
            if (!solutionId) return;
            item.addEventListener('mouseenter', () => setActiveSolution(solutionId));
            item.addEventListener('focusin', () => setActiveSolution(solutionId));
        });

        tabs.forEach((tab) => {
            const solutionId = tab.getAttribute('data-solution-tab');
            if (!solutionId) return;
            tab.addEventListener('click', () => setActiveSolution(solutionId, true));
        });

        // Sync active pill + logos while user swipes carousel (rAF-throttled)
        let rafPending = false;
        let lastActiveSolution = defaultSolution;
        carousel?.addEventListener('scroll', () => {
            if (rafPending) return;
            rafPending = true;
            requestAnimationFrame(() => {
                rafPending = false;
                if (!carousel) return;
                const carouselMid = carousel.scrollLeft + carousel.offsetWidth / 2;
                let closest: HTMLElement | undefined;
                let minDist = Infinity;
                carouselItems.forEach((item) => {
                    const itemMid = item.offsetLeft + item.offsetWidth / 2;
                    const dist = Math.abs(itemMid - carouselMid);
                    if (dist < minDist) {
                        minDist = dist;
                        closest = item;
                    }
                });
                const solutionId = closest ? closest.getAttribute('data-solution-panel') : null;
                if (solutionId && solutionId !== lastActiveSolution) {
                    lastActiveSolution = solutionId;
                    setActiveSolution(solutionId, false);
                }
            });
        });

        solutionsSection.addEventListener('mouseleave', () => setActiveSolution(defaultSolution));
        setActiveSolution(defaultSolution);
    }

    // Accordion (mobile only)
    const accordionEl = document.querySelector<HTMLElement>('[data-solutions-accordion]');
    if (accordionEl) {
        const measureHeight = (body: HTMLElement): number => {
            // Temporarily remove height constraint to read true content height
            const prev = body.style.height;
            body.style.height = 'auto';
            const h = body.offsetHeight;
            body.style.height = prev;
            return h;
        };

        const openItem = (item: HTMLElement) => {
            const body = item.querySelector<HTMLElement>('[data-accordion-body]');
            if (!body) return;
            item.classList.add('is-open');
            item.querySelector('[data-accordion-trigger]')?.setAttribute('aria-expanded', 'true');
            const h = measureHeight(body);
            body.style.height = '0';
            requestAnimationFrame(() => {
                body.style.height = `${h}px`;
            });
        };

        const closeItem = (item: HTMLElement) => {
            const body = item.querySelector<HTMLElement>('[data-accordion-body]');
            if (!body) return;
            // Lock to current rendered height before animating to 0
            body.style.height = `${body.offsetHeight}px`;
            item.classList.remove('is-open');
            item.querySelector('[data-accordion-trigger]')?.setAttribute('aria-expanded', 'false');
            requestAnimationFrame(() => {
                body.style.height = '0';
            });
        };

        // Open first item without animation on load
        const firstItem = accordionEl.querySelector<HTMLElement>('[data-accordion-item]');
        if (firstItem) {
            const body = firstItem.querySelector<HTMLElement>('[data-accordion-body]');
            firstItem.classList.add('is-open');
            firstItem
                .querySelector('[data-accordion-trigger]')
                ?.setAttribute('aria-expanded', 'true');
            if (body) body.style.height = 'auto';
        }

        accordionEl.querySelectorAll<HTMLElement>('[data-accordion-trigger]').forEach((trigger) => {
            trigger.addEventListener('click', () => {
                const item = trigger.closest<HTMLElement>('[data-accordion-item]');
                if (!item) return;
                const isOpen = item.classList.contains('is-open');
                accordionEl
                    .querySelectorAll<HTMLElement>('[data-accordion-item]')
                    .forEach(closeItem);
                if (!isOpen) openItem(item);
            });
        });

        accordionEl.querySelectorAll<HTMLElement>('[data-accordion-body]').forEach((body) => {
            body.addEventListener('transitionend', () => {
                if (body.style.height !== '0px') body.style.height = 'auto';
            });
        });
    }
</script>
