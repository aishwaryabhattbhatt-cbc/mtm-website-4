---
import Button from '../../shared/Button.astro';

interface Props {
    titleKey?: string;
    title: string;
    imageSrc: string;
    imageAlt?: string;
    iconPath: string;
    href?: string;
    ctaLabel?: string;
    state?: 'default' | 'hover';
}

const {
    titleKey,
    title,
    imageSrc,
    imageAlt = '',
    iconPath,
    href = '#',
    ctaLabel = 'LEARN MORE',
    state = 'default',
} = Astro.props as Props;

const forceHover = state === 'hover';
---

<article class={`solutions-card${forceHover ? ' is-hover' : ''}`} data-state={state}>
    <div class="solutions-card__image-wrap">
        <img class="solutions-card__image" src={imageSrc} alt={imageAlt} loading="lazy" decoding="async" />
    </div>

    <div class="solutions-card__content">
        <div class="solutions-card__header">
            <img class="solutions-card__icon icon icon-l" src={iconPath} alt="" aria-hidden="true" />
            <h3 class="product-name text-body-p2" data-copy-key={titleKey}>{title}</h3>
        </div>

        <Button variant="tertiary" href={href} class="solutions-card__cta">
            {ctaLabel}
        </Button>
    </div>
</article>

<style>
    .solutions-card {
        background: var(--surface-white);
        border-radius: var(--radius-m);
        box-shadow: var(--shadow-e1);
        overflow: hidden;
        width: 100%;
        min-width: 0;
        display: flex;
        flex-direction: column;
        height: 24.625rem;
        --card-image-height-default: 80%;
        --card-image-height-hover: 72%;
    }

    .solutions-card__image-wrap {
        height: var(--card-image-height-default);
        overflow: hidden;
        transition: height 220ms ease;
    }

    .solutions-card__image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 220ms ease;
    }

    .solutions-card__content {
        display: flex;
        flex-direction: column;
        gap: var(--space-0);
        padding: var(--space-4);
        background: var(--surface-white);
        height: calc(100% - var(--card-image-height-default));
        transition: height 220ms ease, gap 200ms ease;
    }

    .solutions-card__header {
        display: flex;
        align-items: flex-start;
        gap: var(--space-2);
    }

    .solutions-card__header.is-single-line {
        align-items: center;
    }

    .solutions-card__icon {
        width: 2rem;
        height: 2rem;
        flex-shrink: 0;
        align-self: flex-start;
        object-fit: contain;
    }

    .product-name {
        margin: 0;
        color: var(--text-primary);
        white-space: normal;
        overflow-wrap: break-word;
        word-break: normal;
    }

    .solutions-card__cta {
        align-self: flex-start;
        margin-top: var(--space-0);
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        color: var(--text-primary);
        text-decoration: none;
        opacity: 0;
        max-height: 0;
        overflow: hidden;
        pointer-events: none;
        transition: opacity 200ms ease, max-height 200ms ease, margin-top 200ms ease;
    }

    .solutions-card__cta.btn-tertiary {
        justify-content: flex-start;
    }

    .solutions-card:hover .solutions-card__image,
    .solutions-card.is-hover .solutions-card__image {
        transform: scale(1.1);
    }

    .solutions-card:hover .solutions-card__image-wrap,
    .solutions-card.is-hover .solutions-card__image-wrap {
        height: var(--card-image-height-hover);
    }

    .solutions-card:hover .solutions-card__content,
    .solutions-card.is-hover .solutions-card__content {
        height: calc(100% - var(--card-image-height-hover));
    }

    .solutions-card:hover .solutions-card__content,
    .solutions-card.is-hover .solutions-card__content {
        gap: var(--space-2);
    }

    .solutions-card:hover .solutions-card__cta,
    .solutions-card.is-hover .solutions-card__cta {
        opacity: 1;
        max-height: 1.5rem;
        margin-top: var(--space-1);
        pointer-events: auto;
    }
</style>

<script>
    const syncWindow = window as Window & { __solutionsCardLineSyncInit?: boolean };

    if (!syncWindow.__solutionsCardLineSyncInit) {
        syncWindow.__solutionsCardLineSyncInit = true;

        const syncSolutionsCardTitleAlignment = () => {
            const cards = document.querySelectorAll('.solutions-card');
            cards.forEach((card) => {
                const header = card.querySelector('.solutions-card__header');
                const title = card.querySelector('.product-name');
                if (!header || !title) return;

                const styles = window.getComputedStyle(title);
                const lineHeight = Number.parseFloat(styles.lineHeight);
                const titleHeight = title.getBoundingClientRect().height;
                const isSingleLine = Number.isFinite(lineHeight) && titleHeight <= lineHeight * 1.35;

                header.classList.toggle('is-single-line', isSingleLine);
            });
        };

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', syncSolutionsCardTitleAlignment, {
                once: true,
            });
        } else {
            syncSolutionsCardTitleAlignment();
        }

        window.addEventListener('resize', syncSolutionsCardTitleAlignment);
    }
</script>
