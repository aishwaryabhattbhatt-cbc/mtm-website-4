---
import Button from '../../shared/Button.astro';

interface LogoItem {
    src: string;
    alt: string;
}

interface Props {
    titleKey?: string;
    title: string;
    imageSrc: string;
    imageAlt?: string;
    iconPath: string;
    href?: string;
    ctaLabel?: string;
    state?: 'default' | 'hover' | 'carousel';
    logos?: LogoItem[];
}

const {
    titleKey,
    title,
    imageSrc,
    imageAlt = '',
    iconPath,
    href = '#',
    ctaLabel = 'LEARN MORE',
    state = 'default',
    logos,
} = Astro.props as Props;

const forceHover = state === 'hover';
const isCarousel = state === 'carousel';
---

<article
    class={`solutions-card${forceHover ? ' is-hover' : ''}${isCarousel ? ' is-carousel' : ''}`}
    data-state={state}
>
    <div class="solutions-card__image-wrap">
        <img
            class="solutions-card__image"
            src={imageSrc}
            alt={imageAlt}
            loading="lazy"
            decoding="async"
        />
    </div>

    <div class="solutions-card__content">
        <div class="solutions-card__header">
            <img
                class="solutions-card__icon icon icon-l"
                src={iconPath}
                alt=""
                aria-hidden="true"
            />
            <h4 class="product-name text-body-p2" data-copy-key={titleKey}>{title}</h4>
        </div>

        {
            logos && logos.length > 0 && (
                <div class="solutions-card__logos">
                    {logos.map((logo) => (
                        <div class="solutions-card__logo-item">
                            <img
                                class="solutions-card__logo-img"
                                src={logo.src}
                                alt={logo.alt}
                                loading="lazy"
                                decoding="async"
                            />
                        </div>
                    ))}
                </div>
            )
        }

        <Button variant="tertiary" href={href} class="solutions-card__cta">
            {ctaLabel}
        </Button>
    </div>
</article>

<style>
    .solutions-card {
        background: var(--surface-white);
        border-radius: var(--layout-card-radius);
        box-shadow: var(--shadow-e1);
        width: 100%;
        min-width: 0;
        display: flex;
        flex-direction: column;
        height: 24.625rem;
        --card-image-height-default: 80%;
        --card-image-height-hover: 70%;
    }

    .solutions-card.is-hover {
        height: auto;
    }

    .solutions-card.is-carousel {
        height: 100%;
        width: 100%;
    }

    .solutions-card.is-carousel .solutions-card__image-wrap {
        flex: 1;
        height: unset;
        transition: none;
    }

    .solutions-card.is-carousel .solutions-card__content {
        flex: 0 0 auto;
        height: auto;
        gap: var(--space-2);
        transition: none;
    }

    .solutions-card.is-carousel .solutions-card__cta {
        opacity: 1;
        max-height: none;
        overflow: visible;
        margin-top: 0;
        pointer-events: auto;
    }

    .solutions-card__image-wrap {
        height: var(--card-image-height-default);
        overflow: hidden;
        border-radius: var(--layout-card-radius) var(--layout-card-radius) 0 0;
        transition: height 220ms ease;
    }

    .solutions-card.is-hover .solutions-card__image-wrap {
        height: var(--card-image-height-hover);
    }

    .solutions-card__image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 220ms ease;
    }

    .solutions-card__content {
        display: flex;
        flex-direction: column;
        gap: var(--space-0);
        padding: var(--space-4);
        background: var(--surface-white);
        height: calc(100% - var(--card-image-height-default));
        border-radius: 0 0 var(--layout-card-radius) var(--layout-card-radius);
        transition:
            height 220ms ease,
            gap 200ms ease;
    }

    .solutions-card.is-hover .solutions-card__content {
        height: calc(100% - var(--card-image-height-hover));
        gap: var(--space-2);
    }

    .solutions-card__header {
        display: flex;
        align-items: flex-start;
        gap: var(--space-2);
    }

    .solutions-card__header.is-single-line {
        align-items: center;
    }

    .solutions-card__icon {
        flex-shrink: 0;
        align-self: flex-start;
        object-fit: contain;
    }

    .product-name {
        margin: 0;
        color: var(--text-primary);
        white-space: normal;
        overflow-wrap: break-word;
        word-break: normal;
    }

    .solutions-card__logos {
        display: flex;
        gap: var(--space-3);
        border-top: var(--stroke-1) solid var(--border-tertiary);
        padding-top: var(--space-2);
        opacity: 0;
        max-height: 0;
        overflow: hidden;
        transition:
            opacity 200ms ease,
            max-height 200ms ease,
            padding-top 200ms ease;
    }

    .solutions-card:not(.is-carousel):hover .solutions-card__logos {
        opacity: 1;
        max-height: 3rem;
        padding-top: var(--space-2);
    }

    .solutions-card.is-hover .solutions-card__logos {
        opacity: 1;
        max-height: 3rem;
        padding-top: var(--space-2);
        overflow: visible;
    }

    .solutions-card__logo-item {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .solutions-card__logo-img {
        width: 100%;
        height: var(--space-6);
        object-fit: contain;
        object-position: center;
        display: block;
    }

    .solutions-card__cta {
        align-self: flex-start;
        margin-top: var(--space-0);
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        color: var(--text-primary);
        text-decoration: none;
        opacity: 0;
        max-height: 0;
        overflow: hidden;
        pointer-events: none;
        transition:
            opacity 200ms ease,
            max-height 200ms ease,
            margin-top 200ms ease;
    }

    .solutions-card__cta.btn-tertiary {
        justify-content: flex-start;
    }

    .solutions-card:not(.is-carousel):hover .solutions-card__image,
    .solutions-card.is-hover .solutions-card__image {
        transform: scale(1.1);
    }

    .solutions-card:not(.is-carousel):hover .solutions-card__image-wrap {
        height: var(--card-image-height-hover);
    }

    .solutions-card:not(.is-carousel):hover .solutions-card__content {
        height: calc(100% - var(--card-image-height-hover));
        gap: var(--space-2);
    }

    .solutions-card:not(.is-carousel):hover .solutions-card__cta {
        opacity: 1;
        max-height: 1.5rem;
        margin-top: var(--space-1);
        pointer-events: auto;
    }

    .solutions-card.is-hover .solutions-card__cta {
        opacity: 1;
        max-height: none;
        overflow: visible;
        margin-top: var(--space-1);
        pointer-events: auto;
    }
</style>

<script>
    const syncWindow = window as Window & { __solutionsCardLineSyncInit?: boolean };

    if (!syncWindow.__solutionsCardLineSyncInit) {
        syncWindow.__solutionsCardLineSyncInit = true;

        const syncSolutionsCardTitleAlignment = () => {
            const cards = document.querySelectorAll('.solutions-card');
            cards.forEach((card) => {
                const header = card.querySelector('.solutions-card__header');
                const title = card.querySelector('.product-name');
                if (!header || !title) return;

                const styles = window.getComputedStyle(title);
                const lineHeight = Number.parseFloat(styles.lineHeight);
                const titleHeight = title.getBoundingClientRect().height;
                const isSingleLine =
                    Number.isFinite(lineHeight) && titleHeight <= lineHeight * 1.35;

                header.classList.toggle('is-single-line', isSingleLine);
            });
        };

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', syncSolutionsCardTitleAlignment, {
                once: true,
            });
        } else {
            syncSolutionsCardTitleAlignment();
        }

        window.addEventListener('resize', syncSolutionsCardTitleAlignment);
    }
</script>
