---
// src/components/sign-in/SignInBackgroundScripts.astro
// Drop inside the sign-in page's <Fragment slot="scripts"> alongside <SignInBackground />.
// Loads Three.js + the WebGL liquid-gradient effect
// (public/js/backgrounds/liquid-gradient-background.js, variant "sign-in").
const base = import.meta.env.BASE_URL;
---

<script is:inline type="importmap">
    {
        "imports": {
            "three": "https://cdn.jsdelivr.net/npm/three@0.128.0/build/three.module.js"
        }
    }
</script>
<script is:inline type="module" src={`${base}js/backgrounds/liquid-gradient-background.js`}
></script>
