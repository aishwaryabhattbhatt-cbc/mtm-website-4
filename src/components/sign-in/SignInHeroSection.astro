---
// src/components/sign-in/SignInHeroSection.astro
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { t } from '../../lib/i18n/t';
import Button from '../shared/Button.astro';
import FormField from '../shared/FormField.astro';
import LiquidGradientBackground from '../shared/LiquidGradientBackground.astro';

interface Props {
    locale: Locale;
    copy: CMSDictionary;
}

const { locale, copy } = Astro.props as Props;
const base = import.meta.env.BASE_URL;
---

<section class="sign-in-hero section-height-100">
    <LiquidGradientBackground id="webgl-background-sign-in" />

    <div class="sign-in-hero__content">
        <div class="sign-in-hero__stack">
            <div class="sign-in-hero__intro hero-fade-in" style="animation-delay: 0.1s">
                <h1 class="sign-in-hero__title" data-copy-key="sign_in_hero_title">
                    {t(copy, 'sign_in_hero_title', locale, 'Sign In')}
                </h1>

                <p
                    class="text-body-p2 sign-in-hero__subtitle"
                    data-copy-key="sign_in_hero_subtitle"
                >
                    {
                        t(
                            copy,
                            'sign_in_hero_subtitle',
                            locale,
                            'Sign in to access your MTM dashboard, tools, and reports.'
                        )
                    }
                </p>
            </div>

            <div class="sign-in-hero__card hero-fade-in" style="animation-delay: 0.2s">
                <form
                    class="sign-in-hero__form"
                    aria-label={t(copy, 'sign_in_hero_form_aria_label', locale, 'Sign in')}
                >
                    <FormField
                        locale={locale}
                        copy={copy}
                        variant="field-with-label"
                        type="email"
                        name="email"
                        labelKey="sign_in_hero_form_email_label"
                        label="Email"
                        placeholderKey="sign_in_hero_form_email_placeholder"
                        placeholder="john@workmail.com"
                        emailValidation="none"
                        labelColor="primary"
                        required
                    />
                    <div class="sign-in-hero__field-group">
                        <div class="sign-in-hero__field-row">
                            <label
                                for="sign-in-password"
                                class="form-field__label form-field__label--primary text-body-p3"
                            >
                                {t(copy, 'sign_in_hero_form_password_label', locale, 'Password')}
                                <span class="form-field__required">*</span>
                            </label>

                            <a
                                href={`${base}${locale}/forgot-password/`}
                                class="sign-in-hero__forgot text-body-p3-small"
                                data-copy-key="sign_in_hero_form_forgot_password"
                            >
                                {
                                    t(
                                        copy,
                                        'sign_in_hero_form_forgot_password',
                                        locale,
                                        'Forgot Password?'
                                    )
                                }
                            </a>
                        </div>

                        <FormField
                            locale={locale}
                            copy={copy}
                            variant="field-only"
                            type="password"
                            id="sign-in-password"
                            name="password"
                            placeholderKey="sign_in_hero_form_password_placeholder"
                            placeholder="Enter your password"
                            ariaLabel={t(
                                copy,
                                'sign_in_hero_form_password_label',
                                locale,
                                'Password'
                            )}
                            required
                        />
                    </div>

                    <div class="sign-in-hero__actions">
                        <Button
                            variant="primary"
                            size="lg"
                            type="submit"
                            class="sign-in-hero__submit"
                        >
                            {t(copy, 'sign_in_hero_form_submit', locale, 'Log In')}
                        </Button>
                    </div>
                </form>
            </div>

            <div class="sign-in-hero__register hero-fade-in" style="animation-delay: 0.3s">
                <h4
                    class="text-h4 sign-in-hero__register-text"
                    data-copy-key="sign_in_hero_form_register_text"
                >
                    {
                        t(
                            copy,
                            'sign_in_hero_form_register_text',
                            locale,
                            'Signing in first time? Register to gain access'
                        )
                    }
                </h4>
                <Button
                    variant="secondary"
                    size="lg"
                    href={`${base}${locale}/register/`}
                    class="sign-in-hero__register-cta"
                    data-copy-key="sign_in_hero_form_create_account_cta"
                >
                    {t(copy, 'sign_in_hero_form_create_account_cta', locale, 'Register')}
                </Button>
            </div>
        </div>
    </div>
</section>

<style>
    .sign-in-hero {
        position: relative;
        width: 100%;
        overflow: clip;
        background: var(--surface-white);
        margin-top: var(--navbar-height);
        padding: var(--section-pad-block) var(--content-margin-inline);
        display: flex;
        /* Top-aligned, not centred: these four pages have different content
           heights, and centring put their titles up to 118px apart. Aligning
           to the top pins the title and the form to the same y on all of
           them. */
        align-items: flex-start;
        justify-content: center;
        /* .section-height-100 sets height AND min-height. Keep the floor but
           let the box grow — the section is overflow:clip, so a fixed height
           cuts off any form taller than a short viewport. */
        height: auto;
    }

    .hero-fade-in {
        opacity: 0;
        animation: hero-fade-in-up var(--motion-duration-heading) var(--motion-ease-standard)
            forwards;
    }

    @keyframes hero-fade-in-up {
        from {
            opacity: 0;
            transform: translateY(1.625rem);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .hero-fade-in {
            animation: none;
            opacity: 1;
        }
    }

    /* __intro centers itself via transform: translateX(-50%) (it's
       position: absolute; left: 50%) — animating transform here too (even a
       matching translateX(-50%) translateY(...) keyframe) risks the browser
       reconciling two transform sources on the same paint and flashing the
       pre-animation position for a frame. Fade opacity only so the element's
       transform never changes throughout. */
    .sign-in-hero__intro.hero-fade-in {
        animation-name: fade-in-opacity-only;
    }

    @keyframes fade-in-opacity-only {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }

    .sign-in-hero__content {
        position: relative;
        z-index: 1;
        width: 100%;
        display: flex;
        justify-content: center;
    }

    .sign-in-hero__stack {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        /* Matches contact's heading-to-card gap so the four form pages space
           their description and form identically. */
        gap: var(--space-6);
        width: 100%;
    }

    .sign-in-hero__card {
        display: flex;
        flex-direction: column;
        gap: var(--space-6);
        width: 100%;
        max-width: 37.5rem;
        padding: var(--space-9);
        border-radius: var(--radius-m);
        background: var(--surface-blue);
        box-shadow: var(--shadow-card);
    }

    .sign-in-hero__register {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--space-4);
        width: 100%;
        max-width: 37.5rem;
        text-align: center;
        /* Restores the --space-9 separation this had before the stack gap
           tightened to --space-6 for the description-to-form rule above. */
        margin-top: var(--space-6);
    }

    .sign-in-hero__register-text {
        margin: 0;
        color: var(--text-primary);
    }

    .sign-in-hero__register-cta {
        text-align: center;
    }

    .sign-in-hero__intro {
        /* In the stack's normal flow, not hung above it: the title has to
           reserve its own space so it lands at the same y as the other
           form pages once the section is top-aligned. */
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--space-4);
        max-width: 40rem;
        text-align: center;
    }

    .sign-in-hero__title {
        margin: 0;
        font-family: var(--font-heading);
        font-size: var(--fs-subsection-h2);
        font-weight: var(--fw-semibold);
        line-height: var(--lh-tight);
        letter-spacing: var(--ls-heading-lg);
        color: var(--text-primary);
    }

    .sign-in-hero__subtitle {
        margin: 0;
        color: var(--text-secondary);
    }

    .sign-in-hero__form {
        display: flex;
        flex-direction: column;
        gap: var(--space-5);
    }

    .sign-in-hero__field-group {
        display: flex;
        flex-direction: column;
        gap: var(--space-1);
    }

    .sign-in-hero__field-row {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: var(--space-4);
    }

    .sign-in-hero__field-row .form-field__required {
        color: var(--feedback-error);
        margin-left: var(--space-1);
    }

    .sign-in-hero__actions {
        display: flex;
        margin-top: var(--space-3);
    }

    .sign-in-hero__submit {
        width: 100%;
        text-align: center;
    }

    .sign-in-hero__forgot {
        flex-shrink: 0;
        color: var(--text-secondary);
        text-decoration: none;
    }

    .sign-in-hero__forgot:hover {
        text-decoration: underline;
    }

    @media (max-width: 1023px) {
        .sign-in-hero {
            height: auto;
            min-height: var(--section-height-100);
            margin-top: 0;
        }
    }

    @media (max-width: 767px) {
        .sign-in-hero {
            align-items: flex-start;
            padding: var(--space-11) var(--content-margin-inline) var(--space-9);
        }

        .sign-in-hero__intro {
            position: static;
            transform: none;
        }

        .sign-in-hero__card {
            padding: var(--space-6);
        }
    }
</style>

<script>
    const form = document.querySelector<HTMLFormElement>('.sign-in-hero__form');

    form?.addEventListener('submit', (event) => {
        event.preventDefault();

        if (!form.checkValidity()) {
            form.reportValidity();
        }
    });

    const emailInput = form?.querySelector<HTMLInputElement>('input[name="email"]');
    const forgotLink = document.querySelector<HTMLAnchorElement>('.sign-in-hero__forgot');

    if (emailInput && forgotLink) {
        const baseHref = forgotLink.getAttribute('href') || '';
        const syncForgotLink = () => {
            const email = emailInput.value.trim();
            forgotLink.href = email ? `${baseHref}?email=${encodeURIComponent(email)}` : baseHref;
        };

        emailInput.addEventListener('input', syncForgotLink);
        syncForgotLink();
    }
</script>
