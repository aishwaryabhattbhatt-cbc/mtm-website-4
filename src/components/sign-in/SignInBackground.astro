---
// src/components/sign-in/SignInBackground.astro
// WebGL liquid-gradient canvas container. Pair with <SignInBackgroundScripts />
// in the page's `scripts` slot to initialize it
// (public/js/backgrounds/liquid-gradient-background.js, variant "sign-in").
interface Props {
    id: string;
}

const { id } = Astro.props as Props;
---

<div id={id} class="webgl-background" data-webgl-variant="sign-in" aria-hidden="true"></div>
