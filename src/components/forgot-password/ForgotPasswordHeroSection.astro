---
// src/components/forgot-password/ForgotPasswordHeroSection.astro
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { t } from '../../lib/i18n/t';
import Button from '../shared/Button.astro';
import FormField from '../shared/FormField.astro';
import LiquidGradientBackground from '../shared/LiquidGradientBackground.astro';

interface Props {
    locale: Locale;
    copy: CMSDictionary;
}

const { locale, copy } = Astro.props as Props;
const base = import.meta.env.BASE_URL;
---

<section class="forgot-password-hero section-height-100">
    <LiquidGradientBackground id="webgl-background-forgot-password" />

    <div class="forgot-password-hero__content">
        <div class="forgot-password-hero__stack">
            <div class="forgot-password-hero__intro hero-fade-in" style="animation-delay: 0.1s">
                <h1 class="forgot-password-hero__title" data-copy-key="forgot_password_hero_title">
                    {t(copy, 'forgot_password_hero_title', locale, 'Forgot Password?')}
                </h1>

                <p
                    class="text-body-p2 forgot-password-hero__subtitle"
                    data-copy-key="forgot_password_hero_subtitle"
                >
                    {
                        t(
                            copy,
                            'forgot_password_hero_subtitle',
                            locale,
                            "Enter your email and we'll send you a link to reset your password."
                        )
                    }
                </p>
            </div>

            <div class="forgot-password-hero__card hero-fade-in" style="animation-delay: 0.2s">
                <form
                    class="forgot-password-hero__form"
                    aria-label={t(
                        copy,
                        'forgot_password_hero_form_aria_label',
                        locale,
                        'Forgot password'
                    )}
                >
                    <FormField
                        locale={locale}
                        copy={copy}
                        variant="field-with-label"
                        type="email"
                        name="email"
                        labelKey="forgot_password_hero_form_email_label"
                        label="Email"
                        placeholderKey="forgot_password_hero_form_email_placeholder"
                        placeholder="john@workmail.com"
                        emailValidation="none"
                        labelColor="primary"
                        required
                    />

                    <div class="forgot-password-hero__actions">
                        <Button
                            variant="primary"
                            size="lg"
                            type="submit"
                            class="forgot-password-hero__submit"
                        >
                            {t(copy, 'forgot_password_hero_form_submit', locale, 'Submit')}
                        </Button>
                    </div>
                </form>

                <p class="text-body-p3 forgot-password-hero__remember">
                    <a
                        href={`${base}${locale}/sign-in/`}
                        data-copy-key="forgot_password_hero_form_remember_cta"
                    >
                        {
                            t(
                                copy,
                                'forgot_password_hero_form_remember_cta',
                                locale,
                                'Go Back to Sign In'
                            )
                        }
                    </a>
                </p>
            </div>
        </div>
    </div>
</section>

<style>
    .forgot-password-hero {
        position: relative;
        width: 100%;
        overflow: clip;
        background: var(--surface-white);
        margin-top: var(--navbar-height);
        padding: var(--section-pad-block) var(--content-margin-inline);
        display: flex;
        /* Top-aligned, not centred: these four pages have different content
           heights, and centring put their titles up to 118px apart. Aligning
           to the top pins the title and the form to the same y on all of
           them. */
        align-items: flex-start;
        justify-content: center;
        /* .section-height-100 sets height AND min-height. Keep the floor but
           let the box grow — the section is overflow:clip, so a fixed height
           cuts off any form taller than a short viewport. */
        height: auto;
    }

    .hero-fade-in {
        opacity: 0;
        animation: hero-fade-in-up var(--motion-duration-heading) var(--motion-ease-standard)
            forwards;
    }

    @keyframes hero-fade-in-up {
        from {
            opacity: 0;
            transform: translateY(1.625rem);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .hero-fade-in {
            animation: none;
            opacity: 1;
        }
    }

    /* __intro centers itself via transform: translateX(-50%) (it's
       position: absolute; left: 50%) — animating transform here too (even a
       matching translateX(-50%) translateY(...) keyframe) risks the browser
       reconciling two transform sources on the same paint and flashing the
       pre-animation position for a frame. Fade opacity only so the element's
       transform never changes throughout. */
    .forgot-password-hero__intro.hero-fade-in {
        animation-name: fade-in-opacity-only;
    }

    @keyframes fade-in-opacity-only {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }

    .forgot-password-hero__content {
        position: relative;
        z-index: 1;
        width: 100%;
        display: flex;
        justify-content: center;
    }

    .forgot-password-hero__stack {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 100%;
        /* Matches contact's heading-to-card gap so the four form pages space
           their description and form identically. */
        gap: var(--space-6);
    }

    .forgot-password-hero__card {
        display: flex;
        flex-direction: column;
        gap: var(--space-6);
        width: 100%;
        max-width: 37.5rem;
        padding: var(--space-9);
        border-radius: var(--radius-m);
        background: var(--surface-blue);
        box-shadow: var(--shadow-card);
    }

    .forgot-password-hero__intro {
        /* In the stack's normal flow, not hung above it: the title has to
           reserve its own space so it lands at the same y as the other
           form pages once the section is top-aligned. */
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--space-4);
        max-width: 40rem;
        text-align: center;
    }

    .forgot-password-hero__title {
        margin: 0;
        font-family: var(--font-heading);
        font-size: var(--fs-subsection-h2);
        font-weight: var(--fw-semibold);
        line-height: var(--lh-tight);
        letter-spacing: var(--ls-heading-lg);
        color: var(--text-primary);
    }

    .forgot-password-hero__subtitle {
        margin: 0;
        color: var(--text-secondary);
    }

    .forgot-password-hero__form {
        display: flex;
        flex-direction: column;
        gap: var(--space-5);
    }

    .forgot-password-hero__actions {
        display: flex;
        margin-top: var(--space-3);
    }

    .forgot-password-hero__submit {
        width: 100%;
        text-align: center;
    }

    .forgot-password-hero__remember {
        margin: 0;
        text-align: left;
        color: var(--text-secondary);
    }

    .forgot-password-hero__remember a {
        color: var(--text-primary);
    }

    @media (max-width: 1023px) {
        .forgot-password-hero {
            height: auto;
            min-height: var(--section-height-100);
            margin-top: 0;
        }
    }

    @media (max-width: 767px) {
        .forgot-password-hero {
            align-items: flex-start;
            padding: var(--space-11) var(--content-margin-inline) var(--space-9);
        }

        .forgot-password-hero__intro {
            position: static;
            transform: none;
        }

        .forgot-password-hero__card {
            padding: var(--space-6);
        }
    }
</style>

<script>
    const form = document.querySelector<HTMLFormElement>('.forgot-password-hero__form');
    const emailInput = form?.querySelector<HTMLInputElement>('input[name="email"]');

    const prefillEmail = new URLSearchParams(window.location.search).get('email');
    if (emailInput && prefillEmail) {
        emailInput.value = prefillEmail;
    }

    form?.addEventListener('submit', (event) => {
        event.preventDefault();

        if (!form.checkValidity()) {
            form.reportValidity();
        }
    });
</script>
