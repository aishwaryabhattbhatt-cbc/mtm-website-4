---
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import CensusToolCard from './CensusToolCard.astro';
import { icons } from '../../lib/icons/registry';
import SplitFrameStat from '../shared/SplitFrameStat.astro';

interface Props {
    locale: Locale;
    copy: CMSDictionary;
}

const { locale, copy } = Astro.props;
const base = import.meta.env.BASE_URL;

const tools = [
    {
        id: 'census-snapshot',
        titleKey: 'tool_1_title',
        titleFb: 'Snapshot',
        subtitleKey: 'tool_1_subtitle',
        subtitleFb: 'Understand any region at a glance',
        descKey: 'tool_1_description',
        descFb: 'Population, age, income, language, immigration, indigenous identity. Any Canadian geography. In seconds.',
        iconSrc: `${base}${icons['census-tool'].snapshot}`,
        imageSrc: `${base}images/tools/census-tool/Snapshot-Tool.webp`,
        imageAlt: 'Snapshot tool preview',
        features: [
            {
                titleKey: 'tool_1_benefit_1',
                titleFb: 'Quick Insights',
                descKey: 'tool_1_benefit_1_des',
                descFb: 'Generate instant "Community Portraits" for any Canadian geography.',
            },
            {
                titleKey: 'tool_1_benefit_2',
                titleFb: 'Key Metrics',
                descKey: 'tool_1_benefit_2_des',
                descFb: 'Analyze population, age, income, and language in seconds.',
            },
            {
                titleKey: 'tool_1_benefit_3',
                titleFb: 'Data Exports',
                descKey: 'tool_1_benefit_3_des',
                descFb: 'Easily export data tables for quick analysis and sharing.',
            },
        ],
    },
    {
        id: 'census-drilldown',
        titleKey: 'tool_2_title',
        titleFb: 'Drilldown',
        subtitleKey: 'tool_2_subtitle',
        subtitleFb: 'Dig deeper into any demographic',
        descKey: 'tool_2_description',
        descFb: 'Move beyond surface-level data. Explore nested demographic breakdowns across hundreds of variables for any Canadian geography.',
        iconSrc: `${base}${icons['census-tool'].drilldown}`,
        imageSrc: `${base}images/tools/census-tool/Drilldown-Tool.webp`,
        imageAlt: 'Drilldown tool preview',
        features: [
            {
                titleKey: 'tool_2_benefit_1',
                titleFb: 'Deep Filtering',
                descKey: 'tool_2_benefit_1_des',
                descFb: 'Layer multiple filters to isolate the exact audience segment you need.',
            },
            {
                titleKey: 'tool_2_benefit_2',
                titleFb: 'Cross-Tabulation',
                descKey: 'tool_2_benefit_2_des',
                descFb: 'Compare demographic variables side by side with automatic breakdowns.',
            },
            {
                titleKey: 'tool_2_benefit_3',
                titleFb: 'Trend Tracking',
                descKey: 'tool_2_benefit_3_des',
                descFb: 'Trace how demographic patterns shift across census years.',
            },
        ],
    },
    {
        id: 'census-ranker',
        titleKey: 'tool_3_title',
        titleFb: 'Ranker',
        subtitleKey: 'tool_3_subtitle',
        subtitleFb: 'Rank geographies by any metric',
        descKey: 'tool_3_description',
        descFb: 'Find out which cities, regions, or postal areas lead on any demographic variable — instantly ranked and sortable.',
        iconSrc: `${base}${icons['census-tool'].ranker}`,
        imageSrc: `${base}images/tools/census-tool/Ranker-Tool.webp`,
        imageAlt: 'Ranker tool preview',
        features: [
            {
                titleKey: 'tool_3_benefit_1',
                titleFb: 'Custom Rankings',
                descKey: 'tool_3_benefit_1_des',
                descFb: 'Sort any geography by any variable to surface the top or bottom performers.',
            },
            {
                titleKey: 'tool_3_benefit_2',
                titleFb: 'Benchmark Comparisons',
                descKey: 'tool_3_benefit_2_des',
                descFb: 'Compare ranked geographies against the Canadian national average.',
            },
            {
                titleKey: 'tool_3_benefit_3',
                titleFb: 'Export Results',
                descKey: 'tool_3_benefit_3_des',
                descFb: 'Download ranked tables for reports and presentations.',
            },
        ],
    },
    {
        id: 'census-demographic-explorer',
        titleKey: 'tool_4_title',
        titleFb: 'Demographic Explorer',
        subtitleKey: 'tool_4_subtitle',
        subtitleFb: 'Visualize demographic distribution',
        descKey: 'tool_4_description',
        descFb: "Map and visualize how age, language, income, and hundreds of other variables distribute across Canada's diverse regions.",
        iconSrc: `${base}${icons['census-tool'].demographicExplorer}`,
        imageSrc: `${base}images/tools/census-tool/Demo-Explorer-Tool.webp`,
        imageAlt: 'Demographic Explorer tool preview',
        features: [
            {
                titleKey: 'tool_4_benefit_1',
                titleFb: 'Interactive Maps',
                descKey: 'tool_4_benefit_1_des',
                descFb: "Visualize demographic variables across Canada's geographic areas.",
            },
            {
                titleKey: 'tool_4_benefit_2',
                titleFb: 'Variable Explorer',
                descKey: 'tool_4_benefit_2_des',
                descFb: 'Browse and search 2,000+ demographic variables with instant previews.',
            },
            {
                titleKey: 'tool_4_benefit_3',
                titleFb: 'Distribution Charts',
                descKey: 'tool_4_benefit_3_des',
                descFb: 'See how a demographic breaks down across provinces and cities.',
            },
        ],
    },
    {
        id: 'census-compare',
        titleKey: 'tool_5_title',
        titleFb: 'Compare',
        subtitleKey: 'tool_5_subtitle',
        subtitleFb: 'Compare regions side by side',
        descKey: 'tool_5_description',
        descFb: 'Place two or more geographies next to each other and identify what makes each one unique — or where they converge.',
        iconSrc: `${base}${icons['census-tool'].compare}`,
        imageSrc: `${base}images/tools/census-tool/Compare-Tool.webp`,
        imageAlt: 'Compare tool preview',
        features: [
            {
                titleKey: 'tool_5_benefit_1',
                titleFb: 'Side-by-Side View',
                descKey: 'tool_5_benefit_1_des',
                descFb: 'Compare up to five geographies on any demographic variable.',
            },
            {
                titleKey: 'tool_5_benefit_2',
                titleFb: 'Difference Highlights',
                descKey: 'tool_5_benefit_2_des',
                descFb: 'Automatically surface the most significant differences between regions.',
            },
            {
                titleKey: 'tool_5_benefit_3',
                titleFb: 'Shareable Snapshots',
                descKey: 'tool_5_benefit_3_des',
                descFb: 'Export comparison views as clean tables or visual summaries.',
            },
        ],
    },
    {
        id: 'census-canada-score',
        titleKey: 'tool_6_title',
        titleFb: 'Canada Score',
        subtitleKey: 'tool_6_subtitle',
        subtitleFb: 'Benchmark against the national standard',
        descKey: 'tool_6_description',
        descFb: 'Understand how any Canadian geography performs relative to the national average across key demographic indicators.',
        iconSrc: `${base}${icons['census-tool'].canadaScore}`,
        imageSrc: `${base}images/tools/census-tool/Canada-Score-Tool.webp`,
        imageAlt: 'Canada Score tool preview',
        features: [
            {
                titleKey: 'tool_6_benefit_1',
                titleFb: 'National Benchmarks',
                descKey: 'tool_6_benefit_1_des',
                descFb: "Instantly compare any region's metrics against Canada-wide averages.",
            },
            {
                titleKey: 'tool_6_benefit_2',
                titleFb: 'Score Cards',
                descKey: 'tool_6_benefit_2_des',
                descFb: 'Get a summarized score for how a region ranks on key indicators.',
            },
            {
                titleKey: 'tool_6_benefit_3',
                titleFb: 'Historical Comparison',
                descKey: 'tool_6_benefit_3_des',
                descFb: "Track how a region's Canada Score has changed over census cycles.",
            },
        ],
    },
];
---

<section class="census-tool-features">
    {
        tools.map((tool, i) => (
            <>
                <CensusToolCard
                    locale={locale}
                    copy={copy}
                    id={tool.id}
                    titleKey={tool.titleKey}
                    titleFb={tool.titleFb}
                    subtitleKey={tool.subtitleKey}
                    subtitleFb={tool.subtitleFb}
                    descKey={tool.descKey}
                    descFb={tool.descFb}
                    iconSrc={tool.iconSrc}
                    imageSrc={tool.imageSrc}
                    imageAlt={tool.imageAlt}
                    features={tool.features}
                    reversed={i % 2 !== 0}
                />
                {i < tools.length - 1 &&
                    (i === 1 ? (
                        <>
                            <div class="section-gap section-gap-lg" aria-hidden="true" />
                            <SplitFrameStat
                                locale={locale}
                                copy={copy}
                                imageSrc={`${base}images/tools/census-tool/split-frame-1.webp`}
                                mobileImageSrc={`${base}images/tools/census-tool/split-frame-1-mobile.webp`}
                                align="right"
                                valueKey="stat_callout_1_value"
                                fallbackValue="63%"
                                descriptionKey="stat_callout_1_description"
                                fallbackDescription="In Toronto, 63% of women aged 18-34 make less than $40,000/year"
                            />
                            <div class="section-gap section-gap-lg" aria-hidden="true" />
                        </>
                    ) : i === 3 ? (
                        <>
                            <div class="section-gap section-gap-lg" aria-hidden="true" />
                            <SplitFrameStat
                                locale={locale}
                                copy={copy}
                                imageSrc={`${base}images/tools/census-tool/split-frame-2.webp`}
                                mobileImageSrc={`${base}images/tools/census-tool/split-frame-2-mobile.webp`}
                                align="left"
                                valueKey="stat_callout_2_value"
                                descriptionKey="stat_callout_2_description"
                            />
                            <div class="section-gap section-gap-lg" aria-hidden="true" />
                        </>
                    ) : (
                        <div class="section-gap section-gap-lg" aria-hidden="true" />
                    ))}
            </>
        ))
    }
</section>

<style>
    .census-tool-features {
        width: 100%;
        padding: 0 var(--content-margin-inline) var(--section-pad-block);
        display: flex;
        flex-direction: column;
    }

    /* Split-frame stat callouts (formerly inlined here) now live in the
       shared SplitFrameStat component — see src/components/shared/. */
</style>
