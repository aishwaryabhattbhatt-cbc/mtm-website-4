---
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import CensusToolCard from './CensusToolCard.astro';
import { icons } from '../../lib/icons/registry';
import { t } from '../../lib/i18n/t';

interface Props {
    locale: Locale;
    copy: CMSDictionary;
}

const { locale, copy } = Astro.props;
const base = import.meta.env.BASE_URL;

const tools = [
    {
        id: 'census-snapshot',
        titleKey: 'census_nav_snapshot',
        titleFb: 'Snapshot',
        subtitleKey: 'snapshot_subtitle',
        subtitleFb: 'Understand any region at a glance',
        descKey: 'snapshot_desc',
        descFb: 'Population, age, income, language, immigration, indigenous identity. Any Canadian geography. In seconds.',
        iconSrc: `${base}${icons['census-tool'].snapshot}`,
        imageSrc: `${base}images/tools/census/Snapshot-Tool.svg`,
        imageAlt: 'Snapshot tool preview',
        features: [
            {
                titleKey: 'snapshot_feature_1_title',
                titleFb: 'Quick Insights',
                descKey: 'snapshot_feature_1_desc',
                descFb: 'Generate instant "Community Portraits" for any Canadian geography.',
            },
            {
                titleKey: 'snapshot_feature_2_title',
                titleFb: 'Key Metrics',
                descKey: 'snapshot_feature_2_desc',
                descFb: 'Analyze population, age, income, and language in seconds.',
            },
            {
                titleKey: 'snapshot_feature_3_title',
                titleFb: 'Data Exports',
                descKey: 'snapshot_feature_3_desc',
                descFb: 'Easily export data tables for quick analysis and sharing.',
            },
        ],
    },
    {
        id: 'census-drilldown',
        titleKey: 'census_nav_drilldown',
        titleFb: 'Drilldown',
        subtitleKey: 'drilldown_subtitle',
        subtitleFb: 'Dig deeper into any demographic',
        descKey: 'drilldown_desc',
        descFb: 'Move beyond surface-level data. Explore nested demographic breakdowns across hundreds of variables for any Canadian geography.',
        iconSrc: `${base}${icons['census-tool'].drilldown}`,
        imageSrc: `${base}images/tools/census/Drilldown-Tool.svg`,
        imageAlt: 'Drilldown tool preview',
        features: [
            {
                titleKey: 'drilldown_feature_1_title',
                titleFb: 'Deep Filtering',
                descKey: 'drilldown_feature_1_desc',
                descFb: 'Layer multiple filters to isolate the exact audience segment you need.',
            },
            {
                titleKey: 'drilldown_feature_2_title',
                titleFb: 'Cross-Tabulation',
                descKey: 'drilldown_feature_2_desc',
                descFb: 'Compare demographic variables side by side with automatic breakdowns.',
            },
            {
                titleKey: 'drilldown_feature_3_title',
                titleFb: 'Trend Tracking',
                descKey: 'drilldown_feature_3_desc',
                descFb: 'Trace how demographic patterns shift across census years.',
            },
        ],
    },
    {
        id: 'census-ranker',
        titleKey: 'census_nav_ranker',
        titleFb: 'Ranker',
        subtitleKey: 'ranker_subtitle',
        subtitleFb: 'Rank geographies by any metric',
        descKey: 'ranker_desc',
        descFb: 'Find out which cities, regions, or postal areas lead on any demographic variable — instantly ranked and sortable.',
        iconSrc: `${base}${icons['census-tool'].ranker}`,
        imageSrc: `${base}images/tools/census/Ranker-Tool.svg`,
        imageAlt: 'Ranker tool preview',
        features: [
            {
                titleKey: 'ranker_feature_1_title',
                titleFb: 'Custom Rankings',
                descKey: 'ranker_feature_1_desc',
                descFb: 'Sort any geography by any variable to surface the top or bottom performers.',
            },
            {
                titleKey: 'ranker_feature_2_title',
                titleFb: 'Benchmark Comparisons',
                descKey: 'ranker_feature_2_desc',
                descFb: 'Compare ranked geographies against the Canadian national average.',
            },
            {
                titleKey: 'ranker_feature_3_title',
                titleFb: 'Export Results',
                descKey: 'ranker_feature_3_desc',
                descFb: 'Download ranked tables for reports and presentations.',
            },
        ],
    },
    {
        id: 'census-demographic-explorer',
        titleKey: 'census_nav_demographic_explorer',
        titleFb: 'Demographic Explorer',
        subtitleKey: 'demographic_explorer_subtitle',
        subtitleFb: 'Visualize demographic distribution',
        descKey: 'demographic_explorer_desc',
        descFb: "Map and visualize how age, language, income, and hundreds of other variables distribute across Canada's diverse regions.",
        iconSrc: `${base}${icons['census-tool'].demographicExplorer}`,
        imageSrc: `${base}images/tools/census/Demo-Explorer-Tool.svg`,
        imageAlt: 'Demographic Explorer tool preview',
        features: [
            {
                titleKey: 'demographic_explorer_feature_1_title',
                titleFb: 'Interactive Maps',
                descKey: 'demographic_explorer_feature_1_desc',
                descFb: "Visualize demographic variables across Canada's geographic areas.",
            },
            {
                titleKey: 'demographic_explorer_feature_2_title',
                titleFb: 'Variable Explorer',
                descKey: 'demographic_explorer_feature_2_desc',
                descFb: 'Browse and search 2,000+ demographic variables with instant previews.',
            },
            {
                titleKey: 'demographic_explorer_feature_3_title',
                titleFb: 'Distribution Charts',
                descKey: 'demographic_explorer_feature_3_desc',
                descFb: 'See how a demographic breaks down across provinces and cities.',
            },
        ],
    },
    {
        id: 'census-compare',
        titleKey: 'census_nav_compare',
        titleFb: 'Compare',
        subtitleKey: 'compare_subtitle',
        subtitleFb: 'Compare regions side by side',
        descKey: 'compare_desc',
        descFb: 'Place two or more geographies next to each other and identify what makes each one unique — or where they converge.',
        iconSrc: `${base}${icons['census-tool'].compare}`,
        imageSrc: `${base}images/tools/census/Compare-Tool.svg`,
        imageAlt: 'Compare tool preview',
        features: [
            {
                titleKey: 'compare_feature_1_title',
                titleFb: 'Side-by-Side View',
                descKey: 'compare_feature_1_desc',
                descFb: 'Compare up to five geographies on any demographic variable.',
            },
            {
                titleKey: 'compare_feature_2_title',
                titleFb: 'Difference Highlights',
                descKey: 'compare_feature_2_desc',
                descFb: 'Automatically surface the most significant differences between regions.',
            },
            {
                titleKey: 'compare_feature_3_title',
                titleFb: 'Shareable Snapshots',
                descKey: 'compare_feature_3_desc',
                descFb: 'Export comparison views as clean tables or visual summaries.',
            },
        ],
    },
    {
        id: 'census-canada-score',
        titleKey: 'census_nav_canada_score',
        titleFb: 'Canada Score',
        subtitleKey: 'canada_score_subtitle',
        subtitleFb: 'Benchmark against the national standard',
        descKey: 'canada_score_desc',
        descFb: 'Understand how any Canadian geography performs relative to the national average across key demographic indicators.',
        iconSrc: `${base}${icons['census-tool'].canadaScore}`,
        imageSrc: `${base}images/tools/census/Canada-Score-Tool.svg`,
        imageAlt: 'Canada Score tool preview',
        features: [
            {
                titleKey: 'canada_score_feature_1_title',
                titleFb: 'National Benchmarks',
                descKey: 'canada_score_feature_1_desc',
                descFb: "Instantly compare any region's metrics against Canada-wide averages.",
            },
            {
                titleKey: 'canada_score_feature_2_title',
                titleFb: 'Score Cards',
                descKey: 'canada_score_feature_2_desc',
                descFb: 'Get a summarized score for how a region ranks on key indicators.',
            },
            {
                titleKey: 'canada_score_feature_3_title',
                titleFb: 'Historical Comparison',
                descKey: 'canada_score_feature_3_desc',
                descFb: "Track how a region's Canada Score has changed over census cycles.",
            },
        ],
    },
];
---

<section class="census-tool-features">
    {
        tools.map((tool, i) => (
            <>
                <CensusToolCard
                    locale={locale}
                    copy={copy}
                    id={tool.id}
                    titleKey={tool.titleKey}
                    titleFb={tool.titleFb}
                    subtitleKey={tool.subtitleKey}
                    subtitleFb={tool.subtitleFb}
                    descKey={tool.descKey}
                    descFb={tool.descFb}
                    iconSrc={tool.iconSrc}
                    imageSrc={tool.imageSrc}
                    imageAlt={tool.imageAlt}
                    features={tool.features}
                    reversed={i % 2 !== 0}
                />
                {i < tools.length - 1 &&
                    (i === 1 ? (
                        <>
                            <div class="section-gap section-gap-lg" aria-hidden="true" />
                            <div class="split-frame">
                                <img
                                    src={`${base}images/tools/census/split-frame-1.png`}
                                    alt=""
                                    loading="lazy"
                                />
                                <div class="split-frame-callout split-frame-callout--right">
                                    <span class="text-hero split-callout-value split-callout-value--lg">
                                        {t(copy, 'stat_callout_1_value', locale, '63%')}
                                    </span>
                                    <span class="text-metrics split-callout-value split-callout-value--sm">
                                        {t(copy, 'stat_callout_1_value', locale, '63%')}
                                    </span>
                                    <span class="text-body-p1 split-callout-desc">
                                        {t(
                                            copy,
                                            'stat_callout_1_description',
                                            locale,
                                            'In Toronto, 63% of women aged 18-34 make less than $40,000/year'
                                        )}
                                    </span>
                                </div>
                            </div>
                            <div class="section-gap section-gap-lg" aria-hidden="true" />
                        </>
                    ) : i === 3 ? (
                        <>
                            <div class="section-gap section-gap-lg" aria-hidden="true" />
                            <div class="split-frame">
                                <img
                                    src={`${base}images/tools/census/split-frame-2.png`}
                                    alt=""
                                    loading="lazy"
                                />
                                <div class="split-frame-callout split-frame-callout--left">
                                    <span class="text-hero split-callout-value split-callout-value--lg">
                                        {t(copy, 'stat_callout_2_value', locale, '')}
                                    </span>
                                    <span class="text-metrics split-callout-value split-callout-value--sm">
                                        {t(copy, 'stat_callout_2_value', locale, '')}
                                    </span>
                                    <span class="text-body-p1 split-callout-desc">
                                        {t(copy, 'stat_callout_2_description', locale, '')}
                                    </span>
                                </div>
                            </div>
                            <div class="section-gap section-gap-lg" aria-hidden="true" />
                        </>
                    ) : (
                        <div class="section-gap section-gap-lg" aria-hidden="true" />
                    ))}
            </>
        ))
    }
</section>

<style>
    .census-tool-features {
        width: 100%;
        padding: 0 var(--content-margin-inline);
        display: flex;
        flex-direction: column;
    }

    .split-frame {
        display: grid;
        width: calc(100% + 2 * var(--content-margin-inline));
        margin-inline: calc(-1 * var(--content-margin-inline));
        overflow: hidden;
    }

    .split-frame img {
        grid-area: 1 / 1;
        width: 100%;
        height: auto;
        display: block;
    }

    .split-frame-callout {
        grid-area: 1 / 1;
        align-self: center;
        margin-top: var(--space-6);
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
        max-width: 22rem;
    }

    .split-frame-callout--right {
        justify-self: end;
        margin-right: var(--content-margin-inline);
        align-items: flex-end;
        text-align: right;
    }

    .split-frame-callout--left {
        justify-self: start;
        margin-left: var(--content-margin-inline);
        align-items: flex-start;
        text-align: left;
    }

    .split-callout-value {
        color: var(--text-primary);
    }

    .split-callout-value--sm {
        display: none;
    }

    .split-callout-desc {
        color: var(--text-secondary);
    }

    @media (max-width: 1023px) {
        .split-callout-value--lg {
            display: none;
        }

        .split-callout-value--sm {
            display: block;
        }
    }

    @media (max-width: 767px) {
        .split-frame img {
            height: 14rem;
            object-fit: cover;
        }

        .split-callout-desc {
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
    }

    @media (max-width: 599px) {
        .split-frame-callout {
            max-width: 60%;
        }
    }
</style>
