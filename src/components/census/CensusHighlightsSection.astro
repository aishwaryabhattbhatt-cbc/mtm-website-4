---
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { t } from '../../lib/i18n/t';

interface Props {
    locale: Locale;
    copy: CMSDictionary;
}

const { locale, copy } = Astro.props;
const base = import.meta.env.BASE_URL;

const rows = [
    {
        id: 'geo',
        iconSrc: `${base}icons/demographics/region.svg`,
        statKey: 'highlights_stat_1_value',
        statFb: '70,000+ Geographic Areas',
        descKey: 'highlights_stat_1_description',
        descFb: 'Analyze audiences across 70,000+ Geographic Areas, by region, city, or postal area to pinpoint where media and tech trends emerge.',
        imgSrc: `${base}images/tools/census-tool/census-geo-filters.webp`,
        imgAlt: locale === 'fr' ? 'Aperçu des filtres géographiques' : 'Geographic filters preview',
    },
    {
        id: 'demo',
        iconSrc: `${base}icons/gen/multiple-variables.svg`,
        statKey: 'highlights_stat_2_value',
        statFb: '2,000+ Demographic Variables',
        descKey: 'highlights_stat_2_description',
        descFb: "Segment by 2,000+ Demographic Variables like age, gender, income, or language to reveal who's driving adoption and change.",
        imgSrc: `${base}images/tools/census-tool/census-demo-filters.webp`,
        imgAlt:
            locale === 'fr' ? 'Aperçu des filtres démographiques' : 'Demographic filters preview',
    },
];
---

<section class="census-highlights">
    <h2 class="census-highlights__title heading-fly-in" data-copy-key="highlights_title">
        {t(copy, 'highlights_title', locale, 'Explore with Precision')}
    </h2>
    <div class="census-highlights__layout content-fly-in">
        <div class="census-highlights__nav">
            {
                rows.map((row, i) => (
                    <div
                        class={`census-highlights__row${i === 0 ? ' census-highlights__row--active' : ''}`}
                        data-index={i}
                    >
                        <div class="census-highlights__stat-row">
                            <img
                                class="icon-2xl census-highlights__row-icon"
                                src={row.iconSrc}
                                alt=""
                                aria-hidden="true"
                                loading="lazy"
                            />
                            <p class="text-h4 census-highlights__stat" data-copy-key={row.statKey}>
                                {t(copy, row.statKey, locale, row.statFb)}
                            </p>
                        </div>
                        <p class="text-body-p1 census-highlights__desc" data-copy-key={row.descKey}>
                            {t(copy, row.descKey, locale, row.descFb)}
                        </p>
                        <div class="census-highlights__row-progress-divider" aria-hidden="true">
                            <div class="census-highlights__row-progress-fill" aria-hidden="true" />
                        </div>
                    </div>
                ))
            }
        </div>

        <div class="census-highlights__preview">
            {
                rows.map((row, i) => (
                    <div
                        class={`census-highlights__panel${i === 0 ? ' is-active' : ''}`}
                        id={`census-panel-${row.id}`}
                    >
                        <img
                            class="census-highlights__screenshot"
                            src={row.imgSrc}
                            alt={row.imgAlt}
                            loading="lazy"
                        />
                    </div>
                ))
            }
        </div>
    </div>
</section>

<style>
    /* ─── Section shell ───────────────────────────────── */

    .census-highlights {
        width: 100%;
        padding: var(--section-pad-block) var(--content-margin-inline) 0;
    }

    .census-highlights__title {
        margin-bottom: var(--section-header-gap);
    }

    .census-highlights__layout {
        display: grid;
        grid-template-columns: 1fr 1.75fr;
        gap: var(--space-10);
        align-items: stretch;
    }

    /* ─── Nav (left panel) ───────────────────────────── */

    .census-highlights__nav {
        display: flex;
        flex-direction: column;
    }

    .census-highlights__row {
        display: flex;
        flex-direction: column;
        gap: var(--space-5);
        padding: var(--space-6) 0;
    }

    .census-highlights__row-progress-divider {
        position: relative;
        height: var(--stroke-2);
        width: 100%;
        border-radius: var(--radius-full);
        background: rgba(211, 211, 211, 0.58);
        overflow: hidden;
    }

    .census-highlights__row-progress-fill {
        position: absolute;
        inset: 0;
        width: 100%;
        transform: scaleX(0);
        transform-origin: left;
        border-radius: var(--radius-full);
        background: linear-gradient(
            to right,
            var(--color-chart-teal) 0%,
            var(--highcharts-color-5) 35%,
            var(--brand-indigo) 65%,
            var(--badge-juniors) 90%
        );
        transition: width 0ms linear;
    }

    .census-highlights__row-icon,
    .census-highlights__stat,
    .census-highlights__desc {
        transition: opacity 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* Inactive rows: fade content */
    .census-highlights__row:not(.census-highlights__row--active) .census-highlights__row-icon,
    .census-highlights__row:not(.census-highlights__row--active) .census-highlights__stat,
    .census-highlights__row:not(.census-highlights__row--active) .census-highlights__desc {
        opacity: 0.3;
    }

    .census-highlights__stat-row {
        display: flex;
        align-items: center;
        gap: var(--space-3);
    }

    .census-highlights__stat {
        margin: 0;
        color: var(--text-primary);
    }

    .census-highlights__desc {
        margin: 0;
        color: var(--text-secondary);
    }

    /* ─── Preview (right panel) ──────────────────────── */

    /* Mirrors .census-tool-card__slot — blue slot, image centered inside it
       carrying its own radius + shadow. Grid (not flex) only because the two
       panels stack in one cell to cross-fade; the centering below is the
       slot's. No min-height: the layout's `align-items: stretch` already
       matches this column to the nav's height, so padding here only shrinks
       the screenshot — it never resizes the box. */
    .census-highlights__preview {
        background: var(--surface-blue);
        border-radius: var(--radius-s);
        display: grid;
        padding: var(--space-12);
    }

    /* Stack all panels in the same grid cell so they cross-fade */
    .census-highlights__panel {
        grid-area: 1 / 1;
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transform: translateY(var(--space-2));
        pointer-events: none;
        transition:
            opacity 0.45s cubic-bezier(0.4, 0, 0.2, 1),
            transform 0.45s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .census-highlights__panel.is-active {
        opacity: 1;
        transform: translateY(0);
        pointer-events: auto;
    }

    /* Matches .census-tool-card__screenshot */
    .census-highlights__screenshot {
        display: block;
        max-width: 100%;
        height: auto;
        border-radius: var(--radius-s);
        box-shadow: var(--shadow-card);
    }

    /* ─── Responsive ─────────────────────────────────── */

    /* Narrow desktop: the two-column layout is still on, but the preview
       column is small enough that --space-12 eats too much of the screenshot.
       Lower bound is 1024px rather than 1020px because below that the layout
       is the carousel and this padding no longer applies. */
    @media (min-width: 1024px) and (max-width: 1220px) {
        .census-highlights__preview {
            padding: var(--space-6);
        }
    }

    @media (max-width: 1023px) {
        .census-highlights__title {
            margin-bottom: var(--space-5);
        }

        /* Touch has no hover, so the desktop cross-fade leaves the inactive
           slide unreachable once autoplay ends. Below 1024px the whole layout
           becomes a swipeable carousel: one column per slide, text on the top
           row and its image on the bottom row, so both move together.

           `display: contents` on the two wrappers drops their boxes and lifts
           the rows and panels into this grid as direct children — the native
           way to re-pair them across a breakpoint without duplicating DOM. */
        .census-highlights__nav,
        .census-highlights__preview {
            display: contents;
        }

        .census-highlights__layout {
            grid-template-columns: none;
            grid-template-rows: auto auto;
            grid-auto-columns: 88%;
            /* row gap = text→image; column gap = slide→slide */
            gap: var(--space-4) var(--layout-card-gap);
            min-width: 0;
            overflow-x: auto;
            overscroll-behavior-x: contain;
            scroll-snap-type: x mandatory;
            -webkit-overflow-scrolling: touch;
            scrollbar-width: none;
        }

        .census-highlights__layout::-webkit-scrollbar {
            display: none;
        }

        /* Explicit placement: auto-flow would fill column 1 with both rows
           (they're adjacent in the DOM) instead of pairing each with its image. */
        .census-highlights__row {
            grid-row: 1;
            scroll-snap-align: start;
            border-bottom: none;
            display: flex;
            flex-direction: column;
            gap: var(--space-3);
            padding: 0;
        }

        .census-highlights__row:nth-child(1) {
            grid-column: 1;
        }

        .census-highlights__row:nth-child(2) {
            grid-column: 2;
        }

        .census-highlights__panel {
            grid-row: 2;
            background: var(--surface-blue);
            border-radius: var(--radius-s);
            padding: var(--space-6);
            opacity: 1;
            transform: none;
            pointer-events: auto;
        }

        .census-highlights__panel:nth-child(1) {
            grid-column: 1;
        }

        .census-highlights__panel:nth-child(2) {
            grid-column: 2;
        }

        /* Every slide is on screen now — nothing to fade out */
        .census-highlights__row:not(.census-highlights__row--active) .census-highlights__row-icon,
        .census-highlights__row:not(.census-highlights__row--active) .census-highlights__stat,
        .census-highlights__row:not(.census-highlights__row--active) .census-highlights__desc {
            opacity: 1;
            transition: none;
        }
    }

    .heading-fly-in {
        opacity: 0;
        transform: translateY(1.625rem);
        transition:
            opacity var(--motion-duration-heading) ease,
            transform var(--motion-duration-heading) var(--motion-ease-standard);
    }

    .heading-fly-in.is-visible {
        opacity: 1;
        transform: translateY(0);
    }

    .content-fly-in {
        opacity: 0;
        transform: translateY(1.625rem);
        transition:
            opacity var(--motion-duration-heading) ease,
            transform var(--motion-duration-heading) var(--motion-ease-standard);
    }

    .content-fly-in.is-visible {
        opacity: 1;
        transform: translateY(0);
    }
</style>

<script>
    document.querySelectorAll<HTMLElement>('.census-highlights').forEach((el) => {
        const heading = el.querySelector<HTMLElement>('.heading-fly-in');
        if (heading) {
            const headingObserver = new IntersectionObserver(
                ([entry]) => {
                    if (entry.isIntersecting) {
                        heading.classList.add('is-visible');
                        headingObserver.disconnect();
                    }
                },
                { threshold: 0.15 }
            );
            headingObserver.observe(heading);
        }

        const contentObserver = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('is-visible');
                        contentObserver.unobserve(entry.target);
                    }
                });
            },
            { threshold: 0.15 }
        );
        el.querySelectorAll<HTMLElement>('.content-fly-in').forEach((c) => {
            contentObserver.observe(c);
        });
    });
</script>

<script>
    const section = document.querySelector<HTMLElement>('.census-highlights');
    const rows = section?.querySelectorAll<HTMLElement>('.census-highlights__row') ?? [];
    const panels = section?.querySelectorAll<HTMLElement>('.census-highlights__panel') ?? [];
    // ≤1023px the layout itself is the carousel scroller (the nav/preview
    // wrappers are display:contents there, so they have no box to scroll).
    const scroller = section?.querySelector<HTMLElement>('.census-highlights__layout');

    // Drives both the dwell time per slide and the progress bar's fill duration.
    const AUTO_ADVANCE_DELAY = 2500;
    const carouselQuery = window.matchMedia('(max-width: 1023px)');

    let autoTimer: ReturnType<typeof setTimeout> | null = null;
    let autoLoopDone = false;

    /* Sets which row's text is showing. Deliberately does NOT scroll — the
       carousel's own observer calls this while the user swipes, so scrolling
       here would fight the gesture. Use goTo() to move the carousel. */
    function setActive(index: number) {
        rows.forEach((r, i) => {
            r.classList.toggle('census-highlights__row--active', i === index);
        });
        panels.forEach((p, i) => {
            p.classList.toggle('is-active', i === index);
        });
    }

    function goTo(index: number) {
        setActive(index);
        if (!carouselQuery.matches || !scroller || !panels[index] || !panels[0]) return;
        scroller.scrollTo({
            left: panels[index].offsetLeft - panels[0].offsetLeft,
            behavior: 'smooth',
        });
    }

    function resetProgress() {
        rows.forEach((row) => {
            const bar = row.querySelector<HTMLElement>('.census-highlights__row-progress-fill');
            if (!bar) return;
            bar.style.transition = 'transform 0ms linear';
            bar.style.transform = 'scaleX(0)';
        });
    }

    function startProgress(idx: number) {
        const bar = rows[idx]?.querySelector<HTMLElement>('.census-highlights__row-progress-fill');
        if (!bar) return;
        bar.getBoundingClientRect();
        bar.style.transition = `transform ${AUTO_ADVANCE_DELAY}ms linear`;
        bar.style.transform = 'scaleX(1)';
    }

    /* Once the loop has run its course the gradient is no longer indicating
       anything, so fade it off and leave the plain grey track behind. Sets the
       transition inline because startProgress() left a transform-only one
       there, which would make the opacity change jump. */
    function fadeProgressToIdle() {
        rows.forEach((row) => {
            const bar = row.querySelector<HTMLElement>('.census-highlights__row-progress-fill');
            if (!bar) return;
            bar.style.transition = 'opacity 0.45s ease';
            bar.style.opacity = '0';
        });
    }

    function scheduleNext(currentIdx: number) {
        if (currentIdx >= rows.length - 1) {
            setTimeout(() => {
                autoLoopDone = true;
                fadeProgressToIdle();
            }, AUTO_ADVANCE_DELAY);
            return;
        }

        autoTimer = setTimeout(() => {
            const next = currentIdx + 1;
            resetProgress();
            goTo(next);
            startProgress(next);
            scheduleNext(next);
        }, AUTO_ADVANCE_DELAY);
    }

    function stopAuto() {
        if (autoTimer === null) return;
        clearTimeout(autoTimer);
        autoTimer = null;
    }

    function selectRow(idx: number) {
        stopAuto();
        resetProgress();
        goTo(idx);
        autoLoopDone = true;
    }

    /* Hover and click both hand control to the visitor immediately — pointing
       at a row is intent, so autoplay gets out of the way rather than making
       them wait out the remaining dwell. */
    rows.forEach((row, idx) => {
        row.addEventListener('mouseenter', () => selectRow(idx));
        row.addEventListener('click', () => selectRow(idx));
    });

    /* Carousel (≤1023px): keep the heading text in sync with whichever slide
       the user has swiped to. Observing against the scroller as root means no
       scrollLeft arithmetic and no assumptions about slide width. */
    if (scroller && panels.length) {
        const slideObserver = new IntersectionObserver(
            (entries) => {
                if (!carouselQuery.matches) return;
                entries.forEach((entry) => {
                    if (!entry.isIntersecting) return;
                    const idx = [...panels].indexOf(entry.target as HTMLElement);
                    if (idx >= 0) setActive(idx);
                });
            },
            { root: scroller, threshold: 0.6 }
        );
        panels.forEach((p) => slideObserver.observe(p));

        // A real swipe means the visitor has taken over — stop fighting them.
        scroller.addEventListener(
            'pointerdown',
            () => {
                stopAuto();
                resetProgress();
                autoLoopDone = true;
            },
            { passive: true }
        );
    }

    // Start auto-advance when section enters the viewport
    if (section) {
        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        if (autoTimer !== null || autoLoopDone) return;
                        const current = [...rows].findIndex((r) =>
                            r.classList.contains('census-highlights__row--active')
                        );
                        startProgress(current >= 0 ? current : 0);
                        scheduleNext(current >= 0 ? current : 0);
                    } else {
                        stopAuto();
                        resetProgress();
                    }
                });
            },
            { threshold: 0.3 }
        );
        observer.observe(section);
    }
</script>
