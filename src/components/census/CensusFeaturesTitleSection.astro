---
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { t } from '../../lib/i18n/t';

interface Props {
    locale: Locale;
    copy: CMSDictionary;
}

const { locale, copy } = Astro.props;
---

<section class="census-features-title">
    <h2 class="heading-fly-in" data-copy-key="census_tool_features">
        {t(copy, 'census_tool_features', locale, 'Tool Features')}
    </h2>
</section>

<style>
    .census-features-title {
        width: 100%;
        padding: 0 var(--content-margin-inline);
    }
</style>

<script>
    document.querySelectorAll<HTMLElement>('.census-features-title').forEach((section) => {
        const heading = section.querySelector<HTMLElement>('.heading-fly-in');
        if (!heading) return;
        const headingObserver = new IntersectionObserver(
            ([entry]) => {
                if (entry.isIntersecting) {
                    heading.classList.add('is-visible');
                    headingObserver.disconnect();
                }
            },
            { threshold: 0.15 }
        );
        headingObserver.observe(heading);
    });
</script>
