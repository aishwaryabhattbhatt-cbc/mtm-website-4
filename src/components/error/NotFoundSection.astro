---
// src/components/error/NotFoundSection.astro
// 404 body — mirrors ContactSuccessSection.astro's glass-card layout.
import type { CMSDictionary, Locale } from '../../lib/cms/types';
import { t } from '../../lib/i18n/t';
import Button from '../shared/Button.astro';

interface Props {
    locale: Locale;
    copy: CMSDictionary;
}

const { locale, copy } = Astro.props as Props;
const base = import.meta.env.BASE_URL;
---

<section class="not-found">
    <div class="not-found__pattern" aria-hidden="true">
        <img
            src={`${base}images/request-demo/hero-pattern.png`}
            alt=""
            class="not-found__pattern-img"
        />
    </div>

    <div class="not-found__card">
        <div class="not-found__content">
            <span class="not-found__code text-metrics" data-copy-key="not_found_code">
                {t(copy, 'not_found_code', locale, '404')}
            </span>

            <h2 data-copy-key="not_found_title">
                {t(copy, 'not_found_title', locale, 'Page Not Found')}
            </h2>

            <p class="text-body-p1 not-found__description" data-copy-key="not_found_description">
                {
                    t(
                        copy,
                        'not_found_description',
                        locale,
                        'The page you are looking for has moved or no longer exists. Head back to the homepage to keep exploring.'
                    )
                }
            </p>

            <Button variant="primary" size="lg" href={`${base}${locale}/`}>
                {t(copy, 'not_found_cta', locale, 'Back to Home')}
            </Button>
        </div>
    </div>
</section>

<style>
    .not-found {
        position: relative;
        width: 100%;
        overflow: clip;
        padding: var(--section-pad-block-lg) var(--content-margin-inline);
        margin-top: var(--navbar-height);
        background: var(--surface-white);
    }

    .not-found__pattern {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        pointer-events: none;
        z-index: 0;
    }

    .not-found__pattern-img {
        width: 100%;
        height: auto;
        display: block;
    }

    .not-found__card {
        position: relative;
        z-index: 1;
        width: min(100%, 90rem);
        margin: 0 auto;
        padding: var(--space-12) var(--space-12);
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: var(--layout-card-radius);
        background: rgba(255, 255, 255, 0.39);
        border: var(--stroke-1) solid rgba(255, 255, 255, 0.37);
        backdrop-filter: blur(10px);
        box-shadow: var(--shadow-beautiful);
    }

    .not-found__content {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: var(--space-4);
        max-width: 32rem;
    }

    .not-found__code {
        color: var(--text-primary);
    }

    .not-found__content h2 {
        margin: 0;
        color: var(--text-primary);
    }

    .not-found__description {
        margin: 0;
        color: var(--text-primary);
    }

    @media (max-width: 1023px) {
        .not-found {
            margin-top: 0;
        }
    }

    @media (max-width: 767px) {
        .not-found__card {
            padding: var(--space-8) var(--space-5);
        }
    }
</style>
