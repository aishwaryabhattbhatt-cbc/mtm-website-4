---
import '../styles/fonts.css';
import '../styles/styles.css';
import '../styles/design-system.css';
import '../styles/icon-sizes.css';
import { toAbsoluteUrl } from '../lib/i18n/routing';
// Imported for their build-time URLs so the two latin faces can be preloaded.
// The latin-ext faces are deliberately not preloaded — they only cover rarer
// accented glyphs, so paying for them up front on every page is not worth it.
import robotoLatin from '../assets/fonts/roboto-latin.woff2';
import sourceSerifLatin from '../assets/fonts/source-serif-4-latin.woff2';

interface AlternateLinks {
    en?: string;
    fr?: string;
    [key: string]: string | undefined;
}

interface Props {
    title: string;
    description: string;
    locale?: string;
    noindex?: boolean;
    canonicalUrl?: string;
    alternates?: AlternateLinks;
}

const {
    title,
    description,
    locale = 'en',
    noindex = false,
    canonicalUrl,
    alternates = {},
} = Astro.props as Props;

const base = import.meta.env.BASE_URL;
const siteUrl = Astro.site ? new URL(base, Astro.site).toString() : undefined;
const resolvedCanonical =
    canonicalUrl ?? (Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined);
const socialImage = siteUrl ? new URL('images/mtm-favicon.svg', siteUrl).toString() : undefined;
const robotsContent = noindex ? 'noindex, nofollow' : 'index, follow';
const ogLocale = locale === 'fr' ? 'fr_CA' : 'en_CA';
const resolvedAlternateEn = alternates.en ? toAbsoluteUrl(Astro.site, alternates.en) : undefined;
const resolvedAlternateFr = alternates.fr ? toAbsoluteUrl(Astro.site, alternates.fr) : undefined;
---

<!doctype html>
<html lang={locale}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="generator" content={Astro.generator} />

        <!-- Import map for the WebGL background modules (public/js/backgrounds/*).
             MUST stay here, at the top of <head>: the spec rejects an import map
             once any module script has begun loading, and Astro emits its bundled
             module scripts throughout <body>. Firefox enforces this strictly — with
             the map further down, `three` fails to resolve and every WebGL
             background silently dies. -->
        <script is:inline type="importmap">
            {
                "imports": {
                    "three": "https://cdn.jsdelivr.net/npm/three@0.128.0/build/three.module.min.js"
                }
            }
        </script>
        <meta name="description" content={description} />
        <meta name="robots" content={robotsContent} />
        <meta name="theme-color" content="#ffffff" />

        <title>{title}</title>

        {resolvedCanonical && <link rel="canonical" href={resolvedCanonical} />}
        {resolvedAlternateEn && <link rel="alternate" hreflang="en" href={resolvedAlternateEn} />}
        {resolvedAlternateFr && <link rel="alternate" hreflang="fr" href={resolvedAlternateFr} />}
        {
            resolvedAlternateEn && (
                <link rel="alternate" hreflang="x-default" href={resolvedAlternateEn} />
            )
        }

        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        {resolvedCanonical && <meta property="og:url" content={resolvedCanonical} />}
        {socialImage ? <meta property="og:image" content={socialImage} /> : null}
        <meta property="og:locale" content={ogLocale} />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        {socialImage && <meta name="twitter:image" content={socialImage} />}

        <link rel="icon" type="image/svg+xml" href={`${base}images/mtm-favicon.svg`} />
        <link rel="alternate icon" type="image/svg+xml" href={`${base}images/mtm-favicon.svg`} />
        <link rel="preload" href={robotoLatin} as="font" type="font/woff2" crossorigin />
        <link rel="preload" href={sourceSerifLatin} as="font" type="font/woff2" crossorigin />
        <link rel="manifest" href={`${base}site.webmanifest`} />

        <slot name="head" />
    </head>
    <body>
        <slot />
        <slot name="scripts" />
        <script>
            // Shared scroll-in entrances for any section marked data-flyin.
            import '../scripts/flyin';
        </script>
    </body>
</html>
